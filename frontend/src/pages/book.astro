---
import { calBookingUrl } from "../lib/site";
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="description" content="Redirecting to the official CBSE Class 10 tuition trial booking page on Cal.com." />
    <title>Booking has moved | BoardWallah</title>
    <link rel="canonical" href={calBookingUrl} />
    <meta http-equiv="refresh" content={`0; url=${calBookingUrl}`} />
    <script is:inline define:vars={{ calBookingUrl }}>
      window.location.replace(calBookingUrl);
    </script>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #f6f4ee;
        color: #1d2b32;
        font: 16px/1.6 system-ui, sans-serif;
        padding: 1.5rem;
        text-align: center;
      }
      a {
        color: #0f4c5c;
        font-weight: 700;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Booking has moved</h1>
      <p>
        Booking now happens on Cal.com.
        <br />
        <a href={calBookingUrl}>Continue to the booking page</a>
      </p>
    </main>
  </body>
</html>
