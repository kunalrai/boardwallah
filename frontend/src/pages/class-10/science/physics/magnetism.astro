    font-size: clamp(1.5rem, 3.2vw, 2.2rem);
    color: #0f172a;
    font-weight: 800;
    margin: 0 0 0.5rem;
  }
  .mag-lead {
    font-size: 1.02rem;
    color: #475569;
    line-height: 1.6;
    margin: 0;
  }

  .mag-rules-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
  }

  .mag-rule-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.04);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .thumb-card {
    border-top: 4px solid #1a73e8;
  }
  .fleming-card {
    border-top: 4px solid #059669;
  }

  .mag-rule-badge {
    align-self: flex-start;
    padding: 0.2rem 0.65rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    background: #eff6ff;
    color: #1e40af;
  }
  .mag-rule-badge.motor-badge {
    background: #ecfdf5;
    color: #065f46;
  }

  .mag-rule-card h3 {
    font-size: 1.3rem;
    color: #0f172a;
    margin: 0;
  }
