  }

  /* Comparison Card */
  .mag-comparison-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.04);
    margin-bottom: 1.75rem;
  }
  .mag-comparison-card h3 {
    margin: 0 0 1rem;
    font-size: 1.25rem;
    color: #0f172a;
  }
  .mag-comp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }
  .mag-comp-table th {
    background: #f8fafc;
    color: #334155;
    font-weight: 700;
