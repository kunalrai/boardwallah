<!-- Client-side Flashcards Engine -->
<script is:inline define:vars={{ flashcards }}>
  document.addEventListener('DOMContentLoaded', () => {
    let allCards = flashcards || [];
    let currentDeckType = 'all';
    let isWeakOnly = false;
    let filteredCards = [...allCards];
    let currentIndex = 0;
    let isFlipped = false;

    // Track mastered and review status across current browser session
    // Set of IDs
    const masteredSet = new Set();
    const reviewSet = new Set();

    // DOM Elements
    const flipper = document.getElementById('card-flipper');
    const container = document.getElementById('flashcard-container');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const flipBtn = document.getElementById('flip-btn');
    const markReviewBtn = document.getElementById('mark-review-btn');
    const markMasteredBtn = document.getElementById('mark-mastered-btn');
    const shuffleBtn = document.getElementById('shuffle-btn');
    const weakCardsBtn = document.getElementById('weak-cards-btn');
    const weakCountBtn = document.getElementById('weak-count-btn');
    const deckPills = document.querySelectorAll('.deck-pill');

    const cardCounter = document.getElementById('card-counter');
    const masteredCountEl = document.getElementById('mastered-count');
    const reviewCountEl = document.getElementById('review-count');
    const progressBar = document.getElementById('deck-progress-bar');

    // Card face elements
    const frontSubject = document.getElementById('front-subject-tag');
    const frontTopic = document.getElementById('front-topic-tag');
    const frontText = document.getElementById('card-front-text');

    const backSubject = document.getElementById('back-subject-tag');
    const backText = document.getElementById('card-back-text');
    const keywordsList = document.getElementById('card-keywords-list');
    const chapterLink = document.getElementById('card-chapter-link');

    // Completion modal elements
    const completionModal = document.getElementById('completion-modal');
    const finalMastered = document.getElementById('final-mastered');
    const finalReview = document.getElementById('final-review');
    const restartDeckBtn = document.getElementById('restart-deck-btn');
    const reviewWeakFinalBtn = document.getElementById('review-weak-final-btn');

    function applyFilter() {
      let cards = allCards;
      if (currentDeckType !== 'all') {
        cards = cards.filter(c => c.subject === currentDeckType);
      }
      if (isWeakOnly) {
        cards = cards.filter(c => reviewSet.has(c.id));
      }
      filteredCards = cards;
      currentIndex = 0;
      isFlipped = false;
      flipper.classList.remove('is-flipped');
      
      if (filteredCards.length === 0) {
        if (isWeakOnly) {
          alert('You have no cards marked for review in this category! Switching back to all cards in this deck.');
          isWeakOnly = false;
          weakCardsBtn.classList.remove('active');
          applyFilter();
          return;
        }
      }
      
      updateDisplay();
    }

    function updateDisplay() {
      if (filteredCards.length === 0) {
        return;
      }

      completionModal.style.display = 'none';
      document.querySelector('.flashcard-arena').style.display = 'block';

      const card = filteredCards[currentIndex];

      // Update Front
      frontSubject.textContent = card.subjectLabel;
      frontTopic.textContent = card.topic;
      frontText.textContent = card.front;

      // Update Back
      backSubject.textContent = card.subjectLabel;
      // Convert newlines in back text to paragraph or linebreaks
      backText.innerHTML = card.back.replace(/\n/g, '<br/>');

      // Update Keywords
      keywordsList.innerHTML = '';
      if (card.keywords && card.keywords.length > 0) {
        card.keywords.forEach(kw => {
          const span = document.createElement('span');
          span.className = 'keyword-chip';
          span.textContent = kw;
          keywordsList.appendChild(span);
        });
      }

      // Update Chapter Link
      if (card.chapterLink) {
        chapterLink.href = card.chapterLink;
        chapterLink.style.display = 'inline-flex';
      } else {
        chapterLink.style.display = 'none';
      }

      // Ensure front is shown when navigating
      if (isFlipped) {
        isFlipped = false;
        flipper.classList.remove('is-flipped');
      }

      // Update Counter and Progress Bar
      const total = filteredCards.length;
      cardCounter.textContent = `Card ${currentIndex + 1} of ${total}`;
      const pct = Math.round(((currentIndex + 1) / total) * 100);
      progressBar.style.width = `${pct}%`;

      // Update Stats
      masteredCountEl.textContent = masteredSet.size;
      reviewCountEl.textContent = reviewSet.size;
      weakCountBtn.textContent = reviewSet.size;

      // Active state on assessment buttons
      if (masteredSet.has(card.id)) {
        markMasteredBtn.classList.add('selected');
        markReviewBtn.classList.remove('selected');
      } else if (reviewSet.has(card.id)) {
        markReviewBtn.classList.add('selected');
        markMasteredBtn.classList.remove('selected');
      } else {
        markMasteredBtn.classList.remove('selected');
        markReviewBtn.classList.remove('selected');
      }

      // Prev / Next button states
      prevBtn.disabled = currentIndex === 0;
      nextBtn.textContent = currentIndex === total - 1 ? 'Finish Deck ✓' : 'Next →';
    }

    function toggleFlip() {
      isFlipped = !isFlipped;
      flipper.classList.toggle('is-flipped', isFlipped);
    }

    function nextCard() {
      if (currentIndex < filteredCards.length - 1) {
        currentIndex++;
        updateDisplay();
      } else {
        showCompletion();
      }
    }

    function prevCard() {
      if (currentIndex > 0) {
        currentIndex--;
        updateDisplay();
      }
    }

    function markMastered() {
      const card = filteredCards[currentIndex];
      masteredSet.add(card.id);
      reviewSet.delete(card.id);
      updateDisplay();
      setTimeout(() => {
        nextCard();
      }, 180);
    }

    function markReview() {
      const card = filteredCards[currentIndex];
      reviewSet.add(card.id);
      masteredSet.delete(card.id);
      updateDisplay();
      setTimeout(() => {
        nextCard();
      }, 180);
    }

    function shuffle() {
      for (let i = filteredCards.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [filteredCards[i], filteredCards[j]] = [filteredCards[j], filteredCards[i]];
      }
      currentIndex = 0;
      isFlipped = false;
      flipper.classList.remove('is-flipped');
      updateDisplay();
    }

    function showCompletion() {
      document.querySelector('.flashcard-arena').style.display = 'none';
      completionModal.style.display = 'block';
      finalMastered.textContent = masteredSet.size;
      finalReview.textContent = reviewSet.size;
    }

    // Event Listeners
    container.addEventListener('click', (e) => {
      // Don't flip if student clicked on the chapter reference link
      if (e.target.closest('#card-chapter-link')) return;
      toggleFlip();
    });

    flipBtn.addEventListener('click', toggleFlip);
    nextBtn.addEventListener('click', nextCard);
    prevBtn.addEventListener('click', prevCard);
    markMasteredBtn.addEventListener('click', markMastered);
    markReviewBtn.addEventListener('click', markReview);
    shuffleBtn.addEventListener('click', shuffle);

    weakCardsBtn.addEventListener('click', () => {
      if (reviewSet.size === 0) {
        alert('You haven’t marked any cards as "Need Review" yet! Use the "❌ Need Review" button on cards you want to practice again.');
        return;
      }
      isWeakOnly = !isWeakOnly;
      weakCardsBtn.classList.toggle('active', isWeakOnly);
      weakCardsBtn.textContent = isWeakOnly ? '✓ Studying Weak Cards Only' : `Filter: Review Weak Cards (${reviewSet.size})`;
      applyFilter();
    });

    restartDeckBtn.addEventListener('click', () => {
      isWeakOnly = false;
      weakCardsBtn.classList.remove('active');
      currentIndex = 0;
      applyFilter();
    });

    reviewWeakFinalBtn.addEventListener('click', () => {
      if (reviewSet.size === 0) {
        alert('All reviewed cards were mastered! Restarting full deck.');
        currentIndex = 0;
        applyFilter();
      } else {
        isWeakOnly = true;
        weakCardsBtn.classList.add('active');
        weakCardsBtn.textContent = '✓ Studying Weak Cards Only';
        applyFilter();
      }
    });

    // Deck Pills
    deckPills.forEach(pill => {
      pill.addEventListener('click', () => {
        deckPills.forEach(p => {
          p.classList.remove('active');
          p.setAttribute('aria-selected', 'false');
        });
        pill.classList.add('active');
        pill.setAttribute('aria-selected', 'true');
        currentDeckType = pill.getAttribute('data-deck') || 'all';
        isWeakOnly = false;
        weakCardsBtn.classList.remove('active');
        weakCardsBtn.textContent = `Filter: Review Weak Cards (${reviewSet.size})`;
        applyFilter();
      });
    });

    // Keyboard Shortcuts
    document.addEventListener('keydown', (e) => {
      // Ignore when user is focusing an input or textarea
      if (['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) return;

      if (e.code === 'Space' || e.code === 'Enter') {
        e.preventDefault();
        toggleFlip();
      } else if (e.code === 'ArrowRight') {
        e.preventDefault();
        nextCard();
      } else if (e.code === 'ArrowLeft') {
        e.preventDefault();
        prevCard();
      } else if (e.key === '1') {
        e.preventDefault();
        markReview();
      } else if (e.key === '2') {
        e.preventDefault();
        markMastered();
      }
    });

    // Initial render
    applyFilter();
  });
</script>

