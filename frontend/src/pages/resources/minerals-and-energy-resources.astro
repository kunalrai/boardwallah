</Layout>

<script is:inline>
  const questions = [
    {
      q: "1. What are smaller occurrences of minerals in cracks, crevices, faults, or joints of igneous and metamorphic rocks called?",
      options: [
        "Lodes",
        "Veins",
        "Strata",
        "Placers"
      ],
      correct: 1,
      explanation: "In igneous and metamorphic rocks, smaller occurrences are called veins and larger occurrences are called lodes."
    },
    {
      q: "2. Which of the following minerals is formed as a result of surface rock decomposition leaving a residual mass of weathered material?",
      options: [
        "Coal",
        "Bauxite",
        "Gold",
        "Mica"
      ],
      correct: 1,
      explanation: "Bauxite forms through the decomposition of surface rocks leaving a residual mass containing aluminum oxides."
    },
    {
      q: "3. What are mineral deposits occurring in valley-floor sands and base of hills that are not corroded by water called?",
      options: [
        "Veins",
        "Placer deposits",
        "Lodes",
        "Gobar deposits"
      ],
      correct: 1,
      explanation: "Placer deposits are alluvial mineral concentrations (e.g. gold, silver, tin, platinum) in river valley gravels."
    },
    {
      q: "4. What is 'Rat-Hole Mining' practiced in Meghalaya?",
      options: [
        "Mining carried out by training wild rats to dig gold",
        "Coal and limestone extraction by tribal families through long, narrow horizontal tunnels",
        "A biological method of soil fumigation",
        "A government method of digging sewer lines"
      ],
      correct: 1,
      explanation: "In Meghalaya, tribal communities extract coal through primitive, hazardous narrow tunnels called rat-hole mining, declared illegal by the NGT."
    },
    {
      q: "5. Which is the finest iron ore with very high iron content up to 70% and excellent magnetic qualities?",
      options: [
        "Hematite",
        "Magnetite",
        "Siderite",
        "Limonite"
      ],
      correct: 1,
      explanation: "Magnetite is the finest iron ore with up to 70% iron content and strong magnetic properties, valuable for electrical applications."
    },
    {
      q: "6. From which mountain range in Bastar district of Chhattisgarh is super high-grade hematite iron ore exported to Japan and South Korea via Visakhapatnam port?",
      options: [
        "Baba Budan Hills",
        "Bailadila range",
        "Kudremukh range",
        "Khetri range"
      ],
      correct: 1,
      explanation: "The Bailadila hills in Chhattisgarh contain 14 deposits of super high-grade hematite iron ore, exported through Visakhapatnam port."
    },
    {
      q: "7. Why are Kudremukh iron ore mines in Karnataka known for unique transportation engineering?",
      options: [
        "Iron ore is transported as liquid slurry through a long pipeline to a port near Mangaluru",
        "Iron ore is carried on elephants",
        "Iron ore is transported using hot-air balloons",
        "Iron ore is flown on cargo aircraft"
      ],
      correct: 0,
      explanation: "Kudremukh (a 100% export unit) pumps iron ore slurry through a dedicated pipeline across the Western Ghats to Mangaluru port."
    },
    {
      q: "8. Which Indian state is the largest producer of Bauxite (aluminum ore), notably from the Panchpatmali deposits in Koraput district?",
      options: [
        "Jharkhand",
        "Odisha",
        "Rajasthan",
        "Gujarat"
      ],
      correct: 1,
      explanation: "Odisha is the largest bauxite-producing state in India, with rich deposits in the Panchpatmali plateau of Koraput."
    },
    {
      q: "9. Why is Mica considered an indispensable raw material in the electrical and electronic industries?",
      options: [
        "Because it has excellent dielectric strength, low power loss factor, insulating properties, and resistance to high voltage",
        "Because it dissolves into conductive drinking water",
        "Because it is magnetic like iron",
        "Because it burns like coal"
      ],
      correct: 0,
      explanation: "Mica's insulating qualities, low dielectric loss, and thermal stability make it a cornerstone of electronics manufacturing."
    },
    {
      q: "10. Which leading mica belt in Jharkhand is renowned as the primary producer of high-grade ruby mica?",
      options: [
        "Koderma-Gaya-Hazaribagh belt",
        "Bailadila belt",
        "Kudremukh belt",
        "Digboi belt"
      ],
      correct: 0,
      explanation: "The Koderma-Gaya-Hazaribagh belt in Jharkhand is the premier producer of high-grade ruby mica in India."
    },
    {
      q: "11. What is the low-grade brown coal that is soft with high moisture content, mined at Neyveli in Tamil Nadu for electricity generation?",
      options: [
        "Anthracite",
        "Bituminous",
        "Lignite",
        "Peat"
      ],
      correct: 2,
      explanation: "Lignite is a low-grade brown coal with high moisture content; the principal lignite reserves are located at Neyveli in Tamil Nadu."
    },
    {
      q: "12. Which commercial coal is the most popular in India, buried deep, and subjected to increased temperatures, used extensively for smelting iron in blast furnaces?",
      options: [
        "Bituminous coal",
        "Lignite",
        "Peat",
        "Charcoal"
      ],
      correct: 0,
      explanation: "Bituminous coal is the most widely used commercial coal; its high-grade metallurgical variety is essential for blast-furnace steel smelting."
    },
    {
      q: "13. In which river valley is the oldest and major Gondwana coal belt of India (including Jharia, Raniganj, and Bokaro) located?",
      options: [
        "Damodar Valley",
        "Narmada Valley",
        "Godavari Valley",
        "Mahanadi Valley"
      ],
      correct: 0,
      explanation: "The Damodar Valley (Jharkhand-West Bengal) contains India's premier Gondwana coal fields: Raniganj, Jharia, Bokaro, and Giridih."
    },
    {
      q: "14. What proportion of India's petroleum production is generated by the offshore Mumbai High oil fields?",
      options: [
        "About 10%",
        "About 63%",
        "100%",
        "Less than 5%"
      ],
      correct: 1,
      explanation: "Mumbai High produces approximately 63% of India's domestic crude petroleum, followed by Gujarat (18%) and Assam (16%)."
    },
    {
      q: "15. Which is the oldest operating oil field in India, located in Assam?",
      options: [
        "Ankleshwar",
        "Mumbai High",
        "Digboi",
        "Kalol"
      ],
      correct: 2,
      explanation: "Digboi in Assam is the oldest oil-producing field in India, discovered in the late 19th century."
    },
    {
      q: "16. Which monumental 1,700-km gas pipeline connects Hazira in Gujarat to Jagdishpur in Uttar Pradesh via Vijaipur in MP?",
      options: [
        "HVJ Gas Pipeline",
        "TAPI Pipeline",
        "Ganga Urja Pipeline",
        "Indus Pipeline"
      ],
      correct: 0,
      explanation: "The Hazira-Vijaipur-Jagdishpur (HVJ) cross-country pipeline links offshore western gas fields to power and fertilizer complexes in northern India."
    },
    {
      q: "17. Which radioactive element found in the Monazite sands of Kerala is used for generating nuclear energy?",
      options: [
        "Thorium",
        "Silicon",
        "Titanium",
        "Graphite"
      ],
      correct: 0,
      explanation: "The Monazite beach sands of Kerala are rich in Thorium, a key fuel for India's three-stage nuclear power program."
    },
    {
      q: "18. Where was India's very first atomic power station established in 1969?",
      options: [
        "Narora in Uttar Pradesh",
        "Tarapur in Maharashtra",
        "Kalpakkam in Tamil Nadu",
        "Rawatbhata in Rajasthan"
      ],
      correct: 1,
      explanation: "Tarapur Atomic Power Station in Maharashtra was India's first commercial nuclear power facility, commissioned in 1969."
    },
    {
      q: "19. Where is the largest wind farm cluster in India located?",
      options: [
        "From Nagarcoil to Madurai in Tamil Nadu",
        "Along the coast of Odisha",
        "In the foothills of the Himalayas in Himachal",
        "In the Sundarbans of West Bengal"
      ],
      correct: 0,
      explanation: "The Muppandal wind farm cluster stretching from Nagarcoil to Madurai in Tamil Nadu is the largest operational wind energy installation in India."
    },
    {
      q: "20. Where in India have experimental geothermal energy projects been established to harness heat from the Earth's interior?",
      options: [
        "Parvati Valley near Manikaran in Himachal Pradesh and Puga Valley in Ladakh",
        "Thar Desert in Rajasthan",
        "Sunderbans in West Bengal",
        "Rann of Kutch in Gujarat"
      ],
      correct: 0,
      explanation: "Geothermal pilot projects harness hot springs in Manikaran (Himachal Pradesh) and Puga Valley (Ladakh)."
    }
  ];

  function renderQuiz() {
    const container = document.getElementById('quizContainer');
    if (!container) return;
    container.innerHTML = '';

    questions.forEach((item, idx) => {
      const qCard = document.createElement('div');
      qCard.className = 'quiz-card';
      qCard.id = `qCard_${idx}`;

      const title = document.createElement('h3');
      title.className = 'quiz-question';
      title.textContent = item.q;
      qCard.appendChild(title);

      const optList = document.createElement('div');
      optList.className = 'quiz-options';

      item.options.forEach((optText, optIdx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'quiz-opt-btn';
        btn.textContent = optText;
        btn.addEventListener('click', () => handleSelectOption(idx, optIdx));
        optList.appendChild(btn);
      });
      qCard.appendChild(optList);

      const feedback = document.createElement('div');
      feedback.className = 'quiz-feedback';
      feedback.id = `feedback_${idx}`;
      qCard.appendChild(feedback);

      container.appendChild(qCard);
    });
  }

  let userAnswers = {};

  function handleSelectOption(qIdx, optIdx) {
    if (userAnswers[qIdx] !== undefined) return;
    userAnswers[qIdx] = optIdx;

    const q = questions[qIdx];
    const isCorrect = (optIdx === q.correct);
    const card = document.getElementById(`qCard_${qIdx}`);
    const btns = card.querySelectorAll('.quiz-opt-btn');
    const fb = document.getElementById(`feedback_${qIdx}`);

    btns.forEach((btn, i) => {
      btn.disabled = true;
      if (i === q.correct) {
        btn.classList.add('opt-correct');
      } else if (i === optIdx) {
        btn.classList.add('opt-wrong');
      }
    });

    if (isCorrect) {
      fb.className = 'quiz-feedback feedback-correct';
      fb.innerHTML = `<strong>Correct!</strong> ${q.explanation}`;
    } else {
      fb.className = 'quiz-feedback feedback-wrong';
      fb.innerHTML = `<strong>Incorrect.</strong> ${q.explanation}`;
    }

    updateScoreSummary();
  }

  function updateScoreSummary() {
    let score = 0;
    const answeredCount = Object.keys(userAnswers).length;
    for (let qIdx in userAnswers) {
      if (userAnswers[qIdx] === questions[qIdx].correct) {
        score++;
      }
    }
    const badge = document.getElementById('quizScoreBadge');
    if (badge) badge.textContent = `Score: ${score} / ${questions.length}`;

    const prog = document.getElementById('quizProgressText');
    if (prog) prog.textContent = `${answeredCount} of ${questions.length} answered`;
  }

  function resetQuiz() {
    userAnswers = {};
    renderQuiz();
    updateScoreSummary();
  }

  document.addEventListener('DOMContentLoaded', () => {
    renderQuiz();
    const resetBtn = document.getElementById('resetQuizBtn');
    if (resetBtn) resetBtn.addEventListener('click', resetQuiz);
  });
</script>

