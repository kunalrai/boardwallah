---
import Layout from "../../layouts/Layout.astro";
import { loadContent } from "../../lib/content";
import { calBookingUrl } from "../../lib/site";

const { provider } = loadContent();
---

<Layout
  title={`Magnetic Effects of Electric Current | CBSE Class 10 Science | ${provider.name}`}
  description="Complete CBSE Class 10 Science chapter on Magnetic Effects of Electric Current. Covers magnetic field lines, right-hand thumb rule, solenoid, Fleming's left-hand rule, electromagnetic induction, domestic electric circuits, fuse, and 20-question quiz."
>
  <div class="wrap">
    <nav class="small" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/subjects/">Subjects</a> / <a href="/resources/">Resources</a> / Magnetic Effects
    </nav>

    <div class="resource-header">
      <span class="eyebrow">CBSE Class 10 · Science · Physics</span>
      <h1>Magnetic Effects of Electric Current</h1>
      <p class="lead">
        Complete chapter notes, interactive magnetic field &amp; hand rule diagrams, domestic circuit safety, and a 20-question quiz for CBSE Class 10 board exam preparation.
      </p>
    </div>

    <!-- Key concepts -->
    <section class="section">
      <h2>Key Concepts at a Glance</h2>

      <div class="grid two concept-grid">
        <article class="card">
          <h3>🧲 Magnetic Field &amp; Field Lines</h3>
          <ul class="clean-list">
            <li><strong>Magnetic Field (B)</strong>: The region around a magnet where its magnetic force can be experienced. It has both magnitude and direction (vector quantity).</li>
            <li><strong>Properties of Magnetic Field Lines</strong>:
              <ol>
                <li>Emerge from the <strong>North pole</strong> and merge at the <strong>South pole</strong> outside the magnet.</li>
                <li>Inside the magnet, direction is from <strong>South pole to North pole</strong> (form closed continuous loops).</li>
                <li>Closer lines indicate a stronger magnetic field (strongest at poles).</li>
                <li><strong>No two magnetic field lines ever intersect</strong> each other (if they did, a compass needle would point in two different directions at once, which is impossible).</li>
              </ol>
            </li>
          </ul>
        </article>

        <article class="card">
          <h3>👍 Magnetic Field due to Current-Carrying Conductors</h3>
          <ul class="clean-list">
            <li><strong>Straight Conductor</strong>: Field lines form concentric circles centered on the wire. Field strength B ∝ I and B ∝ 1/r.</li>
            <li><strong>Right-Hand Thumb Rule (Maxwell's Corkscrew Rule)</strong>: Imagine holding the conductor in your right hand such that the thumb points in the direction of current; then your curled fingers show the direction of magnetic field lines.</li>
            <li><strong>Circular Loop</strong>: At the center, magnetic field lines appear as straight lines. Field strength B ∝ n (number of turns) and B ∝ I.</li>
            <li><strong>Clock Face Rule</strong>: If current flows clockwise, that face acts as a <strong>South pole</strong>; if counter-clockwise, it acts as a <strong>North pole</strong>.</li>
          </ul>
        </article>

        <article class="card">
          <h3>🌀 Solenoid &amp; Electromagnets</h3>
          <ul class="clean-list">
            <li><strong>Solenoid</strong>: A coil of many circular turns of insulated copper wire wrapped closely in the shape of a cylinder.</li>
            <li>The magnetic field pattern inside a solenoid is <strong>uniform and parallel</strong>, exactly like a <strong>bar magnet</strong>.</li>
            <li>Field strength inside a solenoid increases by:
              <ul>
                <li>Increasing the number of turns per unit length (n).</li>
                <li>Increasing the current (I).</li>
                <li>Inserting a <strong>soft iron core</strong> inside the coil.</li>
              </ul>
            </li>
            <li><strong>Electromagnet</strong>: A temporary magnet created by placing a soft iron core inside a solenoid carrying current. Loses magnetism when current is switched off.</li>
          </ul>
        </article>

        <article class="card">
          <h3>🖐️ Force on Conductor &amp; Fleming's Left-Hand Rule</h3>
          <ul class="clean-list">
            <li>A current-carrying conductor placed in an external magnetic field experiences a mechanical force ($F = B \cdot I \cdot L \cdot \sin\theta$).</li>
            <li>Force is <strong>maximum</strong> when the conductor is perpendicular to the magnetic field ($\theta = 90^\circ$).</li>
            <li>Force is <strong>zero</strong> when the conductor is parallel to the magnetic field ($\theta = 0^\circ$).</li>
            <li><strong>Fleming's Left-Hand Rule (FBI)</strong>: Stretch thumb, forefinger, and middle finger of left hand mutually perpendicular:
              <ul>
                <li><strong>F</strong>orefinger = Magnetic <strong>F</strong>ield</li>
                <li><strong>C</strong>entre finger = <strong>C</strong>urrent</li>
                <li><strong>T</strong>humb = Direction of Motion / <strong>F</strong>orce</li>
              </ul>
            </li>
          </ul>
        </article>

        <article class="card">
          <h3>⚡ Electromagnetic Induction</h3>
          <ul class="clean-list">
            <li>Discovered by <strong>Michael Faraday</strong> in 1831: The production of electric current in a conductor due to a changing magnetic field.</li>
            <li>An electric current induced in a closed loop whenever relative motion occurs between a magnet and coil, or when current in an adjacent coil changes.</li>
            <li><strong>Galvanometer</strong>: Instrument used to detect the presence and direction of tiny electric currents in a circuit.</li>
            <li><strong>Fleming's Right-Hand Rule</strong>: Gives the direction of <strong>induced current</strong> (Thumb = motion of conductor, Forefinger = magnetic field, Middle finger = induced current).</li>
          </ul>
        </article>

        <article class="card">
          <h3>🔌 Domestic Electric Circuits &amp; Safety Devices</h3>
          <ul class="clean-list">
            <li>In India, domestic AC electricity is supplied at <strong>220 V</strong> with a frequency of <strong>50 Hz</strong>.</li>
            <li><strong>Three Wires</strong>:
              <ul>
                <li><strong>Live wire</strong> (Positive, Red/Brown insulation): 220 V.</li>
                <li><strong>Neutral wire</strong> (Negative, Black/Blue insulation): 0 V.</li>
                <li><strong>Earth wire</strong> (Green/Yellow insulation): Safety ground connected to a metal plate deep in the earth.</li>
              </ul>
            </li>
            <li><strong>Earthing</strong>: Protects users from severe electric shocks by conducting leakage current safely to the ground.</li>
            <li><strong>Short-Circuiting</strong>: When live wire and neutral wire come in direct contact; circuit resistance becomes almost zero, causing huge current flow and sparking.</li>
            <li><strong>Electric Fuse / MCB</strong>: Safety device with low melting point connected in series with the live wire to prevent damage from overloading.</li>
          </ul>
        </article>
      </div>
    </section>

    <!-- Visual Diagrams Section -->
    <section class="section" id="visual-magnetic">
      <div class="rules-header">
        <span class="eyebrow">Interactive Diagrams</span>
        <h2>Magnetic Field Patterns &amp; Hand Rules</h2>
        <p class="lead">
          Visual schematics frequently tested in CBSE Class 10 board examination questions:
        </p>
      </div>

      <!-- Tab Switcher -->
      <div class="rules-tabs" role="tablist" aria-label="Magnetic diagram categories">
        <button class="button rules-tab-btn active" id="tab-btn-bar-magnet" type="button" role="tab" aria-selected="true" aria-controls="panel-bar-magnet">
          🧲 Bar Magnet Field Lines
        </button>
        <button class="button secondary rules-tab-btn" id="tab-btn-solenoid" type="button" role="tab" aria-selected="false" aria-controls="panel-solenoid">
          🌀 Solenoid Magnetic Field
        </button>
        <button class="button secondary rules-tab-btn" id="tab-btn-fleming" type="button" role="tab" aria-selected="false" aria-controls="panel-fleming">
          🖐️ Fleming's Left-Hand Rule (FBI)
        </button>
      </div>

      <!-- Panel 1: Bar Magnet -->
      <div class="rules-panel" id="panel-bar-magnet" role="tabpanel" aria-labelledby="tab-btn-bar-magnet">
        <article class="card rule-card" style="max-width:760px;margin-inline:auto">
          <div class="rule-badge">Magnetic Field Lines Around a Bar Magnet</div>
          <div class="rule-diagram">
            <svg viewBox="0 0 460 220" class="ray-svg" aria-label="Magnetic Field Lines Around a Bar Magnet">
              <defs>
                <marker id="mag-arr" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                  <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#0f4c5c" />
                </marker>
              </defs>
              <rect width="460" height="220" rx="8" fill="#f8fafc" />
              <!-- Bar Magnet -->
              <rect x="160" y="85" width="70" height="50" fill="#a12b2b" stroke="#334155" stroke-width="2" />
              <rect x="230" y="85" width="70" height="50" fill="#1e3a8a" stroke="#334155" stroke-width="2" />
              <text x="195" y="116" text-anchor="middle" font-size="16" font-weight="bold" fill="#fff">N</text>
              <text x="265" y="116" text-anchor="middle" font-size="16" font-weight="bold" fill="#fff">S</text>
              <!-- Field lines (Top curves N to S) -->
              <path d="M 175 85 C 175 35 285 35 285 85" stroke="#0f4c5c" stroke-width="2" fill="none" />
              <path d="M 230 46 l 6 0 l -3 -6 z" fill="#0f4c5c" transform="rotate(90, 230, 46)" />
              <path d="M 185 85 C 185 10 275 10 275 85" stroke="#0f4c5c" stroke-width="1.8" fill="none" />
              <!-- Field lines (Bottom curves N to S) -->
              <path d="M 175 135 C 175 185 285 185 285 135" stroke="#0f4c5c" stroke-width="2" fill="none" />
              <path d="M 230 174 l 6 0 l -3 6 z" fill="#0f4c5c" transform="rotate(-90, 230, 174)" />
              <path d="M 185 135 C 185 210 275 210 275 135" stroke="#0f4c5c" stroke-width="1.8" fill="none" />
              <!-- Outer loops -->
              <path d="M 160 100 C 100 80 80 50 20 40" stroke="#0f4c5c" stroke-width="1.8" fill="none" />
              <path d="M 160 120 C 100 140 80 170 20 180" stroke="#0f4c5c" stroke-width="1.8" fill="none" />
              <path d="M 440 40 C 380 50 360 80 300 100" stroke="#0f4c5c" stroke-width="1.8" fill="none" />
              <path d="M 440 180 C 380 170 360 140 300 120" stroke="#0f4c5c" stroke-width="1.8" fill="none" />
              <!-- Labels -->
              <text x="60" y="25" font-size="11" font-weight="bold" fill="#0f4c5c">Emerges from North (N)</text>
              <text x="400" y="25" text-anchor="end" font-size="11" font-weight="bold" fill="#0f4c5c">Enters into South (S)</text>
            </svg>
          </div>
          <div class="rule-body">
            <h4>Continuous Closed Loops (N ⟶ S outside, S ⟶ N inside):</h4>
            <p>Magnetic field lines form continuous closed loops. They never intersect because at any given point, the magnetic field can only have one resultant direction.</p>
          </div>
        </article>
      </div>

      <!-- Panel 2: Solenoid -->
      <div class="rules-panel" id="panel-solenoid" role="tabpanel" aria-labelledby="tab-btn-solenoid" hidden>
        <article class="card rule-card" style="max-width:760px;margin-inline:auto">
          <div class="rule-badge">Magnetic Field Pattern Inside &amp; Around a Solenoid</div>
          <div class="rule-diagram">
            <svg viewBox="0 0 460 220" class="ray-svg" aria-label="Magnetic Field of a Solenoid">
              <rect width="460" height="220" rx="8" fill="#f8fafc" />
              <!-- Uniform internal field lines -->
              <line x1="80" y1="90" x2="380" y2="90" stroke="#0f4c5c" stroke-width="2" stroke-dasharray="4 4" />
              <line x1="80" y1="110" x2="380" y2="110" stroke="#0f4c5c" stroke-width="2.5" />
              <line x1="80" y1="130" x2="380" y2="130" stroke="#0f4c5c" stroke-width="2" stroke-dasharray="4 4" />
              <text x="230" y="103" text-anchor="middle" font-size="11" font-weight="bold" fill="#0f4c5c">Uniform Magnetic Field Inside</text>
              <!-- Helical Coils of Solenoid -->
              <path d="M 120 70 Q 130 110 120 150 M 150 70 Q 160 110 150 150 M 180 70 Q 190 110 180 150 M 210 70 Q 220 110 210 150 M 240 70 Q 250 110 240 150 M 270 70 Q 280 110 270 150 M 300 70 Q 310 110 300 150 M 330 70 Q 340 110 330 150" stroke="#b8561c" stroke-width="4" fill="none" />
              <!-- Outer loops -->
              <path d="M 120 70 C 120 20 340 20 340 70" stroke="#0f4c5c" stroke-width="1.8" fill="none" />
              <path d="M 120 150 C 120 200 340 200 340 150" stroke="#0f4c5c" stroke-width="1.8" fill="none" />
              <!-- Polarity -->
              <text x="100" y="115" font-size="16" font-weight="bold" fill="#a12b2b">N</text>
              <text x="355" y="115" font-size="16" font-weight="bold" fill="#1e3a8a">S</text>
            </svg>
          </div>
          <div class="rule-body">
            <h4>Behaves Exactly Like a Bar Magnet:</h4>
            <p>One end of the solenoid behaves as a magnetic North pole while the other behaves as a South pole. Inside the solenoid, the field lines are parallel straight lines indicating that the magnetic field is <strong>uniform</strong> at all points inside.</p>
          </div>
        </article>
      </div>

      <!-- Panel 3: Fleming's Left-Hand Rule -->
      <div class="rules-panel" id="panel-fleming" role="tabpanel" aria-labelledby="tab-btn-fleming" hidden>
        <article class="card rule-card" style="max-width:760px;margin-inline:auto">
          <div class="rule-badge">Fleming's Left-Hand Rule (The FBI Rule)</div>
          <div class="rule-diagram">
            <svg viewBox="0 0 460 220" class="ray-svg" aria-label="Fleming's Left-Hand Rule Visual Representation">
              <rect width="460" height="220" rx="8" fill="#f8fafc" />
              <!-- Central coordinate origin representing the hand -->
              <circle cx="200" cy="140" r="8" fill="#334155" />
              <!-- Thumb: Force (Upwards) -->
              <line x1="200" y1="140" x2="200" y2="40" stroke="#a12b2b" stroke-width="4" marker-end="url(#m1-arr-out)" />
              <polygon points="200,30 193,48 207,48" fill="#a12b2b" />
              <rect x="135" y="40" width="130" height="28" rx="6" fill="#fef2f2" stroke="#a12b2b" stroke-width="1.5" />
              <text x="200" y="59" text-anchor="middle" font-size="12" font-weight="bold" fill="#a12b2b">Thumb = FORCE (Motion)</text>
              <!-- Forefinger: Magnetic Field (Rightwards) -->
              <line x1="200" y1="140" x2="330" y2="140" stroke="#0f4c5c" stroke-width="4" />
              <polygon points="340,140 322,133 322,147" fill="#0f4c5c" />
              <rect x="310" y="155" width="135" height="28" rx="6" fill="#f0fdfa" stroke="#0f4c5c" stroke-width="1.5" />
              <text x="377" y="174" text-anchor="middle" font-size="11" font-weight="bold" fill="#0f4c5c">Forefinger = FIELD (B)</text>
              <!-- Middle Finger: Current (Angled down-left) -->
              <line x1="200" y1="140" x2="110" y2="185" stroke="#b8561c" stroke-width="4" />
              <polygon points="100,190 115,178 122,192" fill="#b8561c" />
              <rect x="15" y="155" width="150" height="28" rx="6" fill="#fff7ed" stroke="#b8561c" stroke-width="1.5" />
              <text x="90" y="174" text-anchor="middle" font-size="11" font-weight="bold" fill="#b8561c">Middle Finger = CURRENT (I)</text>
              <!-- Angle arc -->
              <text x="215" y="125" font-size="11" font-weight="bold" fill="#64748b">90°</text>
            </svg>
          </div>
          <div class="rule-body">
            <h4>Memory Trick: FBI (Force · Field · Current)</h4>
            <p>Stretch the <strong>F</strong>orefinger (Field), Centre finger (<strong>C</strong>urrent), and <strong>T</strong>humb (Force/Motion) of your left hand at right angles to each other. Used to predict the direction of mechanical force in electric motors.</p>
          </div>
        </article>
      </div>
    </section>

    <!-- Quiz -->
    <section class="section quiz-root" id="quiz-root">
      <h2 class="quiz-heading">🧪 Magnetic Effects Chapter Quiz — 20 Board Questions</h2>
      <p class="muted" style="margin-bottom:1.5rem">Practice with standard questions on magnetic field properties, solenoid, Fleming's rules, induction, and domestic circuits.</p>

      <div class="quiz-progress-bar" id="quiz-progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="20" aria-valuenow="0">
        <div class="quiz-progress-fill" id="quiz-progress-fill"></div>
      </div>
      <p class="quiz-counter" id="quiz-counter">Question 1 of 20</p>

      <div class="quiz-card card" id="quiz-card">
        <p class="quiz-question" id="quiz-question"></p>
        <ul class="quiz-options" id="quiz-options"></ul>
        <p class="quiz-feedback" id="quiz-feedback" aria-live="polite"></p>
        <div class="quiz-actions">
          <button class="button" id="quiz-next" disabled>Next →</button>
        </div>
      </div>

      <div class="quiz-result card" id="quiz-result" hidden>
        <h3 id="quiz-score-heading"></h3>
        <p id="quiz-score-msg"></p>
        <div class="actions" style="justify-content:center;margin-top:1rem">
          <button class="button secondary" id="quiz-retry">↺ Try Again</button>
          <a class="button" href={calBookingUrl} target="_blank" rel="noopener noreferrer">Book Free Trial</a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-banner">
      <h2>Need personalized help with Physics concepts?</h2>
      <p>Book a free {provider.trial.duration_minutes}-minute trial session with {provider.tutor_name} (online or at home) for CBSE Class 10 board preparation.</p>
      <a class="button" href={calBookingUrl} target="_blank" rel="noopener noreferrer">Book Free Trial</a>
    </section>
  </div>
</Layout>

<script>
const questions = [
  {
    q: "The direction of magnetic field lines outside a bar magnet is from:",
    opts: ["South pole to North pole", "North pole to South pole", "East pole to West pole", "Centre to poles"],
    ans: 1,
    exp: "Outside a magnet, magnetic field lines emerge from the North pole and enter the South pole. Inside the magnet, they point from South to North."
  },
  {
    q: "Why do two magnetic field lines never intersect each other?",
    opts: [
      "They are always parallel",
      "At the intersection point, a magnetic compass would point in two different directions at the same time, which is impossible",
      "They repel each other electrostatic-wise",
      "Magnetic field lines exist only in one plane"
    ],
    ans: 1,
    exp: "If two field lines crossed, a compass needle placed at that point would have to point in two different directions simultaneously, which is physically impossible."
  },
  {
    q: "The magnetic field inside a long straight solenoid carrying current is:",
    opts: ["Zero", "Decreases as we move towards its ends", "Increases as we move towards its ends", "Uniform (same at all points)"],
    ans: 3,
    exp: "Inside a long straight current-carrying solenoid, the magnetic field lines are parallel straight lines, indicating that the field is uniform throughout."
  },
  {
    q: "The rule used to find the direction of magnetic field lines around a straight current-carrying wire is:",
    opts: ["Fleming's Left-Hand Rule", "Fleming's Right-Hand Rule", "Maxwell's Right-Hand Thumb Rule", "Faraday's Law"],
    ans: 2,
    exp: "The Right-Hand Thumb Rule states that if thumb points in the direction of electric current, the curled fingers give the direction of magnetic field lines."
  },
  {
    q: "A soft iron core inserted inside a current-carrying solenoid turns it into:",
    opts: ["A permanent bar magnet", "An electromagnet", "A non-magnetic substance", "A resistor"],
    ans: 1,
    exp: "A soft iron core dramatically increases the magnetic field strength inside the solenoid, creating a temporary electromagnet."
  },
  {
    q: "According to Fleming's Left-Hand Rule, the forefinger points in the direction of:",
    opts: ["Force / Motion of conductor", "Electric Current", "Magnetic Field", "Induced Current"],
    ans: 2,
    exp: "In Fleming's Left-Hand Rule: Forefinger represents magnetic Field, Centre finger represents Current, and Thumb represents Force/Motion (FBI)."
  },
  {
    q: "A positively-charged alpha particle projected towards west is deflected towards north by a magnetic field. The direction of the magnetic field is:",
    opts: ["Towards south", "Towards east", "Downward", "Upward"],
    ans: 3,
    exp: "Current is towards west (direction of positive charge). Force is towards north. Using Fleming's left-hand rule, the magnetic field points upward."
  },
  {
    q: "The phenomenon of electromagnetic induction is:",
    opts: [
      "The process of charging a body",
      "The process of generating a magnetic field due to current",
      "Producing induced current in a coil due to relative motion between a magnet and the coil",
      "The process of rotating an electric motor"
    ],
    ans: 2,
    exp: "Electromagnetic induction, discovered by Faraday, is the generation of electric current in a conductor placed in a changing magnetic field."
  },
  {
    q: "The device used for detecting the presence and direction of electric current in a circuit is:",
    opts: ["Ammeter", "Voltmeter", "Galvanometer", "Rheostat"],
    ans: 2,
    exp: "A Galvanometer detects even minute electric currents and shows their direction of flow via needle deflection."
  },
  {
    q: "The direction of induced electric current in a conductor is determined by:",
    opts: ["Right-Hand Thumb Rule", "Fleming's Right-Hand Rule", "Fleming's Left-Hand Rule", "Clock Face Rule"],
    ans: 1,
    exp: "Fleming's Right-Hand Rule gives the direction of induced current in a generator or moving conductor."
  },
  {
    q: "In domestic electric supply in India, the potential difference between the live wire and neutral wire is:",
    opts: ["110 V", "220 V", "440 V", "12 V"],
    ans: 1,
    exp: "In India, domestic alternating current (AC) is supplied at 220 V and 50 Hz."
  },
  {
    q: "The color of insulation on the earth wire in domestic electric circuits is:",
    opts: ["Red", "Black", "Green (or Green/Yellow)", "White"],
    ans: 2,
    exp: "The Earth wire is traditionally insulated with Green (or Green and Yellow stripes). Live is Red/Brown; Neutral is Black/Blue."
  },
  {
    q: "The function of the earth wire in domestic electrical appliances is to:",
    opts: [
      "Supply electrical power to appliances",
      "Prevent overloading of the circuit",
      "Provide a low-resistance path to the ground for any leakage current, preventing electric shocks",
      "Reduce the electricity bill"
    ],
    ans: 2,
    exp: "The earth wire connects the metal casing of appliances to ground, ensuring leakage current flows into earth without shocking the user."
  },
  {
    q: "At the time of a short-circuit, the current in the circuit:",
    opts: ["Reduces substantially", "Does not change", "Increases enormously", "Varies continuously"],
    ans: 2,
    exp: "During a short-circuit, live and neutral wires touch directly. Circuit resistance drops close to zero, causing an enormous surge of current."
  },
  {
    q: "An electric fuse is a safety device based on the principle of:",
    opts: [
      "Magnetic effect of electric current",
      "Heating effect of electric current",
      "Chemical effect of electric current",
      "Electromagnetic induction"
    ],
    ans: 1,
    exp: "A fuse works on Joule's heating effect (H = I²Rt). Excessive current generates enough heat to melt the fuse wire, breaking the circuit."
  },
  {
    q: "A current-carrying conductor placed in a magnetic field experiences NO force when the angle between conductor and magnetic field is:",
    opts: ["0 degrees (parallel)", "45 degrees", "90 degrees (perpendicular)", "180 degrees only"],
    ans: 0,
    exp: "Force F = B·I·L·sin(θ). When θ = 0° (conductor parallel to field lines), sin(0°) = 0, so the force is zero."
  },
  {
    q: "An alternating current (AC) in India changes its direction after every:",
    opts: ["1/50 second", "1/100 second", "1/25 second", "1/200 second"],
    ans: 1,
    exp: "Frequency is 50 Hz (50 cycles/sec). One cycle has 2 direction reversals, so it changes direction 100 times per second, i.e., every 1/100 s."
  },
  {
    q: "Commercial electric motors use an electromagnet instead of a permanent magnet because:",
    opts: [
      "Electromagnets are cheaper than rubber",
      "Electromagnets produce an extremely powerful and adjustable magnetic field",
      "Electromagnets require no electricity",
      "Electromagnets have no North and South poles"
    ],
    ans: 1,
    exp: "Electromagnets produce far stronger magnetic fields than permanent magnets, increasing the motor's power output."
  },
  {
    q: "What is the shape of magnetic field lines around a straight current-carrying wire?",
    opts: ["Concentric circles", "Straight radial lines", "Helical spirals", "Ellipses"],
    ans: 0,
    exp: "Magnetic field lines around a straight conductor form concentric circles centered on the wire."
  },
  {
    q: "Which property of a proton can change while it moves freely in a magnetic field?",
    opts: ["Mass", "Speed", "Velocity and Momentum", "Charge"],
    ans: 2,
    exp: "The magnetic force acts perpendicular to velocity, changing its direction (hence changing velocity and momentum) while keeping kinetic energy and speed constant."
  }
];

let current = 0;
let score = 0;
let answered = false;

const qEl     = document.getElementById('quiz-question') as HTMLElement;
const optsEl  = document.getElementById('quiz-options') as HTMLElement;
const fbEl    = document.getElementById('quiz-feedback') as HTMLElement;
const nextBtn = document.getElementById('quiz-next') as HTMLButtonElement;
const counter = document.getElementById('quiz-counter') as HTMLElement;
const fill    = document.getElementById('quiz-progress-fill') as HTMLElement;
const bar     = document.getElementById('quiz-progress-bar') as HTMLElement;
const result  = document.getElementById('quiz-result') as HTMLElement;
const card    = document.getElementById('quiz-card') as HTMLElement;
const retryBtn = document.getElementById('quiz-retry') as HTMLElement;

function render() {
  answered = false;
  nextBtn.disabled = true;
  fbEl.textContent = '';
  fbEl.className = 'quiz-feedback';

  const q = questions[current];
  counter.textContent = `Question ${current + 1} of ${questions.length}`;
  bar.setAttribute('aria-valuenow', String(current));
  fill.style.width = `${(current / questions.length) * 100}%`;

  qEl.textContent = q.q;
  optsEl.innerHTML = '';
  q.opts.forEach((opt, i) => {
    const li  = document.createElement('li');
    const btn = document.createElement('button');
    btn.className = 'button secondary quiz-opt-btn';
    btn.textContent = opt;
    btn.dataset.idx = String(i);
    btn.addEventListener('click', () => choose(i));
    li.appendChild(btn);
    optsEl.appendChild(li);
  });
}

function choose(idx: number) {
  if (answered) return;
  answered = true;
  const q = questions[current];
  const btns = optsEl.querySelectorAll<HTMLButtonElement>('.quiz-opt-btn');
  btns.forEach((btn, i) => {
    btn.disabled = true;
    if (i === q.ans) btn.classList.add('opt-correct');
    else if (i === idx) btn.classList.add('opt-wrong');
  });
  if (idx === q.ans) {
    score++;
    fbEl.textContent = '✅ Correct! ' + q.exp;
    fbEl.className = 'quiz-feedback feedback-correct';
  } else {
    fbEl.textContent = '❌ ' + q.exp;
    fbEl.className = 'quiz-feedback feedback-wrong';
  }
  nextBtn.disabled = false;
}

nextBtn.addEventListener('click', () => {
  current++;
  if (current >= questions.length) showResult();
  else render();
});

function showResult() {
  card.hidden = true;
  counter.hidden = true;
  result.hidden = false;
  fill.style.width = '100%';
  bar.setAttribute('aria-valuenow', String(questions.length));

  const pct = Math.round((score / questions.length) * 100);
  const scoreHead = document.getElementById('quiz-score-heading') as HTMLElement;
  const scoreMsg  = document.getElementById('quiz-score-msg') as HTMLElement;
  scoreHead.textContent = `You scored ${score} / ${questions.length} (${pct}%)`;
  if      (pct === 100) scoreMsg.textContent = '🏆 Perfect score! Flawless knowledge of magnetic effects & electromagnetic rules.';
  else if (pct >= 80)   scoreMsg.textContent = '🌟 Excellent! Strong command of field lines, solenoids, and Fleming rules.';
  else if (pct >= 60)   scoreMsg.textContent = '👍 Good attempt. Review the field lines and domestic circuit rules and retry.';
  else if (pct >= 40)   scoreMsg.textContent = '📚 Keep revising — check Fleming hand rules and retry.';
  else                  scoreMsg.textContent = "💡 Don't worry! Review the concepts above and give it another shot.";
}

retryBtn.addEventListener('click', () => {
  current = 0; score = 0;
  card.hidden = false;
  counter.hidden = false;
  result.hidden = true;
  render();
});

// Tab switching
const tabMagnet = document.getElementById("tab-btn-bar-magnet");
const tabSolenoid = document.getElementById("tab-btn-solenoid");
const tabFleming = document.getElementById("tab-btn-fleming");
const panelMagnet = document.getElementById("panel-bar-magnet");
const panelSolenoid = document.getElementById("panel-solenoid");
const panelFleming = document.getElementById("panel-fleming");

function activateTab(activeBtn: HTMLElement, activePanel: HTMLElement) {
  [tabMagnet, tabSolenoid, tabFleming].forEach((btn) => {
    if (btn) {
      btn.classList.add("secondary");
      btn.classList.remove("active");
      btn.setAttribute("aria-selected", "false");
    }
  });
  [panelMagnet, panelSolenoid, panelFleming].forEach((p) => {
    if (p) p.hidden = true;
  });
  activeBtn.classList.remove("secondary");
  activeBtn.classList.add("active");
  activeBtn.setAttribute("aria-selected", "true");
  activePanel.hidden = false;
}

if (tabMagnet && panelMagnet) tabMagnet.addEventListener("click", () => activateTab(tabMagnet, panelMagnet));
if (tabSolenoid && panelSolenoid) tabSolenoid.addEventListener("click", () => activateTab(tabSolenoid, panelSolenoid));
if (tabFleming && panelFleming) tabFleming.addEventListener("click", () => activateTab(tabFleming, panelFleming));

render();
</script>

