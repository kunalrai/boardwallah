---
import Layout from "../../layouts/Layout.astro";
import { loadContent } from "../../lib/content";
import { calBookingUrl } from "../../lib/site";

const { provider } = loadContent();
---

<Layout
  title={`Surface Areas and Volumes | CBSE Class 10 Maths | ${provider.name}`}
  description="CBSE Class 10 Maths Chapter 12 notes on Surface Areas and Volumes. Formulas for combination of solids (cubes, cylinders, cones, spheres, hemispheres), melting & recasting, well embankments, and an interactive 20-question board quiz."
>
  <div class="wrap">
    <nav class="small" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/subjects/">Subjects</a> / <a href="/resources/">Resources</a> / Surface Areas and Volumes
    </nav>

    <div class="resource-header">
      <span class="eyebrow">CBSE Class 10 · Mathematics · Chapter 12</span>
      <h1>Surface Areas and Volumes</h1>
      <p class="lead">
        Master 3D mensuration: surface areas and volumes of combinations of solids (capsules, toys, tents), conversion of shapes, and fluid flow rate problems for the CBSE Class 10 Board Exam.
      </p>
    </div>

    <!-- Core Concepts -->
    <section class="section">
      <h2>Key Formulas &amp; 3D Solid Mensuration</h2>

      <div class="grid two concept-grid">
        <article class="card">
          <h3>🧊 Cube and Cuboid</h3>
          <p class="formula">Volume &amp; Surface Area Formulas</p>
          <ul class="clean-list">
            <li><strong>Cuboid (length l, breadth b, height h):</strong>
              <br/>• Lateral (Curved) Surface Area: <code>2h(l + b)</code> (Area of 4 walls)
              <br/>• Total Surface Area (TSA): <code>2(lb + bh + hl)</code>
              <br/>• Volume: <code>l × b × h</code>
              <br/>• Longest Diagonal: <code>√(l² + b² + h²)</code>
            </li>
            <li><strong>Cube (side a):</strong>
              <br/>• CSA: <code>4a²</code> &nbsp;|&nbsp; TSA: <code>6a²</code> &nbsp;|&nbsp; Volume: <code>a³</code> &nbsp;|&nbsp; Diagonal: <code>a√3</code>
            </li>
          </ul>
        </article>

        <article class="card">
          <h3>🥫 Right Circular Cylinder &amp; Cone</h3>
          <p class="formula">Curved Surface Area &amp; Volume</p>
          <ul class="clean-list">
            <li><strong>Cylinder (radius r, height h):</strong>
              <br/>• CSA: <code>2πrh</code> &nbsp;|&nbsp; TSA: <code>2πr(r + h)</code> &nbsp;|&nbsp; Volume: <code>πr²h</code>
            </li>
            <li><strong>Cone (radius r, height h, slant height l):</strong>
              <br/>• Slant Height: <code>l = √(r² + h²)</code>
              <br/>• CSA: <code>πrl</code> &nbsp;|&nbsp; TSA: <code>πr(r + l)</code>
              <br/>• Volume: <code>1/3 πr²h</code> (Exactly 1/3 volume of cylinder of same base and height!)
            </li>
          </ul>
        </article>

        <article class="card">
          <h3>⚽ Sphere and Hemisphere</h3>
          <p class="formula">Complete &amp; Half Spheres</p>
          <ul class="clean-list">
            <li><strong>Sphere (radius r):</strong>
              <br/>• Surface Area (CSA = TSA): <code>4πr²</code>
              <br/>• Volume: <code>4/3 πr³</code>
            </li>
            <li><strong>Hemisphere (radius r):</strong>
              <br/>• Curved Surface Area: <code>2πr²</code>
              <br/>• Total Surface Area: <code>3πr²</code> (Curved surface + flat circular top πr²)
              <br/>• Volume: <code>2/3 πr³</code>
            </li>
          </ul>
        </article>

        <article class="card">
          <h3>🔄 Combinations of Solids &amp; Conversions</h3>
          <p class="formula">Conservation of Volume: V_initial = V_final</p>
          <ul class="clean-list">
            <li><strong>Critical Surface Area Rule:</strong> When two solids are joined together, the total surface area of the combined solid is the sum of their <strong>exposed curved surfaces only</strong> (do NOT add internal hidden bases!).
              <br/>Example (Toy = Cone + Hemisphere): <code>TSA = CSA_cone + CSA_hemisphere = πrl + 2πr²</code>.
            </li>
            <li><strong>Melting &amp; Recasting:</strong> <code>Total Volume remains constant</code>.
              <br/><code>Number of small solids = Volume of large solid / Volume of one small solid</code>.
            </li>
          </ul>
        </article>
      </div>
    </section>

    <!-- Visual Diagrams Section -->
    <section class="section">
      <h2>Visual Concepts: Composite Toy Breakdown &amp; Well Embankment Model</h2>

      <div class="grid two">
        <div class="card visual-card">
          <div class="visual-badge">Visual Diagram 1 · Composite Toy (Cone Mounted on Hemisphere)</div>
          <div class="svg-container">
            <svg viewBox="0 0 460 250" xmlns="http://www.w3.org/2000/svg" aria-label="Composite toy: cone on hemisphere">
              <rect width="460" height="250" fill="#f8fafc" rx="8"/>
              
              <!-- Center Line -->
              <line x1="230" y1="20" x2="230" y2="230" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="4"/>

              <!-- Hemisphere Base: Center (230, 140), radius 60 -->
              <path d="M 170 140 A 60 60 0 0 0 290 140 Z" fill="#bae6fd" stroke="#0284c7" stroke-width="2.5"/>
              <!-- Elliptical base joint -->
              <ellipse cx="230" cy="140" rx="60" ry="14" fill="#e0f2fe" stroke="#0284c7" stroke-width="1.5" stroke-dasharray="4"/>

              <!-- Cone Top: Apex (230, 35) to (170, 140) and (290, 140) -->
              <polygon points="230,35 170,140 290,140" fill="#fef3c7" stroke="#d97706" stroke-width="2.5"/>

              <!-- Dimension Annotations -->
              <!-- Slant height l -->
              <text x="180" y="80" font-size="11" font-weight="700" fill="#d97706">Slant l = √(r²+h²)</text>
              <!-- Cone height h -->
              <line x1="230" y1="35" x2="230" y2="140" stroke="#dc2626" stroke-width="2"/>
              <text x="240" y="85" font-size="11" font-weight="700" fill="#dc2626">h</text>

              <!-- Common radius r -->
              <line x1="230" y1="140" x2="290" y2="140" stroke="#0f766e" stroke-width="2"/>
              <text x="260" y="132" font-size="11" font-weight="700" fill="#0f766e">r</text>

              <!-- Radius of hemisphere downwards -->
              <line x1="230" y1="140" x2="230" y2="200" stroke="#0284c7" stroke-width="2"/>
              <text x="240" y="175" font-size="11" font-weight="700" fill="#0284c7">r</text>

              <!-- Formula Box -->
              <rect x="20" y="195" width="420" height="42" rx="6" fill="#ecfdf5" stroke="#10b981"/>
              <text x="230" y="213" text-anchor="middle" font-size="11" font-weight="700" fill="#065f46">Total Surface Area = CSA_cone + CSA_hemisphere = πrl + 2πr²</text>
              <text x="230" y="228" text-anchor="middle" font-size="10" fill="#047857">Total Volume = 1/3 πr²h + 2/3 πr³</text>
            </svg>
          </div>
          <p class="visual-caption">When surfaces are glued together, their touching circular interface is hidden. Only exposed curved areas count toward TSA.</p>
        </div>

        <div class="card visual-card">
          <div class="visual-badge">Visual Diagram 2 · Earth Dug from Well Spread as Embankment</div>
          <div class="svg-container">
            <svg viewBox="0 0 460 250" xmlns="http://www.w3.org/2000/svg" aria-label="Well with circular embankment">
              <rect width="460" height="250" fill="#f8fafc" rx="8"/>
              
              <!-- Ground Level -->
              <line x1="20" y1="110" x2="440" y2="110" stroke="#64748b" stroke-width="2"/>
              <text x="40" y="105" font-size="10" fill="#64748b">Ground Level</text>

              <!-- Well Cylinder (underground) -->
              <!-- Center x=230, width=80 (r=40), depth=100 (from 110 to 210) -->
              <rect x="190" y="110" width="80" height="100" fill="#fed7aa" stroke="#c2410c" stroke-width="2"/>
              <ellipse cx="230" cy="210" rx="40" ry="10" fill="#ea580c"/>
              <ellipse cx="230" cy="110" rx="40" ry="10" fill="#ffedd5" stroke="#c2410c"/>
              <text x="230" y="160" text-anchor="middle" font-size="11" font-weight="700" fill="#9a3412">Well (r = r₁, h = h₁)</text>
              <text x="230" y="178" text-anchor="middle" font-size="10" fill="#7c2d12">V_earth = π r₁² h₁</text>

              <!-- Embankment above ground (ring of width w) -->
              <!-- Outer radius R = r1 + w -> from 130 to 330 (width 200, height 40: 70 to 110) -->
              <rect x="130" y="70" width="60" height="40" fill="#bbf7d0" stroke="#15803d" stroke-width="2"/>
              <rect x="270" y="70" width="60" height="40" fill="#bbf7d0" stroke="#15803d" stroke-width="2"/>
              <text x="160" y="94" text-anchor="middle" font-size="10" font-weight="700" fill="#166534">Embankment</text>
              <text x="300" y="94" text-anchor="middle" font-size="10" font-weight="700" fill="#166534">Height = H</text>

              <!-- Conservation Formula -->
              <rect x="60" y="22" width="340" height="36" rx="4" fill="#0f766e"/>
              <text x="230" y="44" text-anchor="middle" font-size="11" font-weight="700" fill="#fff">π r₁² h₁ = π (R² - r₁²) × H &nbsp;⟹&nbsp; H = r₁² h₁ / (R² - r₁²)</text>
            </svg>
          </div>
          <p class="visual-caption">Standard board exam conservation problem: Volume of cylindrical earth dug = Volume of hollow circular ring embankment.</p>
        </div>
      </div>
    </section>

    <!-- Solved Step-by-Step Problem -->
    <section class="section">
      <h2>Exemplar Board Problem: Medicine Capsule Surface Area Solved</h2>
      <div class="card" style="padding:1.75rem; background:var(--paper)">
        <h3 style="color:var(--brand);margin-top:0">Problem: A medicine capsule is in the shape of a cylinder with two hemispheres stuck to each of its ends. The length of the entire capsule is 14 mm and the diameter of the capsule is 5 mm. Find its surface area.</h3>
        <div style="font-size:0.95rem; line-height:1.7; color:var(--text)">
          <p><strong>Step 1 (Extract dimensions):</strong>
            <br/>Diameter <code>d = 5 mm ⟹ Radius r = 5/2 = 2.5 mm</code>.
            <br/>The ends are two identical hemispheres, each of radius <code>2.5 mm</code>.
          </p>
          <p><strong>Step 2 (Length of cylindrical portion):</strong>
            <br/>Length of cylinder <code>h = Total length - 2 × (radius of hemisphere)</code>
            <br/><code>h = 14 - (2.5 + 2.5) = 14 - 5 = 9 mm</code>.
          </p>
          <p><strong>Step 3 (Surface area calculation):</strong>
            <br/>Surface Area of capsule = <code>CSA of cylinder + 2 × (CSA of hemisphere)</code>
            <br/><code>SA = 2πrh + 2 × (2πr²) = 2πrh + 4πr² = 2πr(h + 2r)</code>.
          </p>
          <p><strong>Step 4 (Substitute values with π = 22/7):</strong>
            <br/><code>SA = 2 × (22 / 7) × 2.5 × (9 + 2 × 2.5)</code>
            <br/><code>SA = 2 × (22 / 7) × (5/2) × (9 + 5)</code>
            <br/><code>SA = (22 / 7) × 5 × 14 = 22 × 5 × 2 = 220 mm²</code>.
          </p>
          <p><strong>Final Answer:</strong> The surface area of the capsule is <strong>220 mm²</strong>.</p>
        </div>
      </div>
    </section>

    <!-- Interactive 20-Question Quiz -->
    <section class="section">
      <h2>Interactive CBSE Board Exam Quiz (20 Questions)</h2>
      <p class="muted">Test your command over 3D solid surface areas, composite shapes, volume conservation, and melting-recasting problems.</p>

      <div class="quiz-container card" id="quiz-box">
        <div class="quiz-header-bar">
          <span class="quiz-counter" id="quiz-counter">Question 1 of 20</span>
          <span class="quiz-score" id="quiz-score">Score: 0 / 20</span>
        </div>

        <div class="quiz-question-body">
          <p class="quiz-q-text" id="quiz-question">Loading question...</p>
          <div class="quiz-options-list" id="quiz-options"></div>
          <div class="quiz-feedback" id="quiz-feedback"></div>
        </div>

        <div class="quiz-footer-actions">
          <button class="button secondary" id="quiz-prev-btn" disabled>← Previous</button>
          <button class="button" id="quiz-next-btn" disabled>Next Question →</button>
        </div>
      </div>

      <div class="quiz-completed-banner card" id="quiz-result-box" style="display:none; text-align:center; padding:2.5rem;">
        <h3>Quiz Completed! 🎉</h3>
        <p class="quiz-final-score" id="quiz-final-score" style="font-size:1.4rem; font-weight:700; color:var(--brand); margin:1rem 0;"></p>
        <p id="quiz-final-msg" class="muted"></p>
        <button class="button" id="quiz-restart-btn" style="margin-top:1rem;">Retake Quiz</button>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-banner">
      <h2>Need personalized Maths guidance for Class 10?</h2>
      <p>Book a free {provider.trial.duration_minutes}-minute trial session with {provider.tutor_name} (online or at-home) to master surface areas, volumes, and board exam 3D mensuration.</p>
      <a class="button" href={calBookingUrl} target="_blank" rel="noopener noreferrer">Book Free Trial</a>
    </section>
  </div>
</Layout>

<script is:inline>
(function() {
  const quizData = [
    {
      q: "2 cubes each of volume 64 cm³ are joined end to end. The surface area of the resulting cuboid is:",
      options: ["128 cm²", "160 cm²", "192 cm²", "256 cm²"],
      answer: 1,
      explanation: "Edge of each cube = ∛64 = 4 cm. Joining end to end gives a cuboid with l = 8 cm, b = 4 cm, h = 4 cm. Surface area = 2(lb + bh + hl) = 2(32 + 16 + 32) = 2(80) = 160 cm²."
    },
    {
      q: "A solid piece of iron in the form of a cuboid of dimensions 49 cm × 33 cm × 24 cm is moulded into a solid sphere. The radius of the sphere is (π = 22/7):",
      options: ["21 cm", "28 cm", "14 cm", "18 cm"],
      answer: 0,
      explanation: "Volume of cuboid = 49 × 33 × 24 = 38808 cm³. 4/3 πr³ = 38808 ⟹ (4/3) × (22/7) × r³ = 38808 ⟹ r³ = (38808 × 21) / 88 = 441 × 21 = 21³ ⟹ r = 21 cm."
    },
    {
      q: "The curved surface area of a right circular cone of radius 7 cm and height 24 cm is:",
      options: ["550 cm²", "528 cm²", "154 cm²", "440 cm²"],
      answer: 0,
      explanation: "Slant height l = √(7² + 24²) = √(49 + 576) = √625 = 25 cm. CSA = πrl = (22/7) × 7 × 25 = 22 × 25 = 550 cm²."
    },
    {
      q: "If the radius of the base of a right circular cylinder is halved, keeping height same, the ratio of volume of reduced cylinder to original cylinder is:",
      options: ["1 : 2", "1 : 4", "1 : 8", "4 : 1"],
      answer: 1,
      explanation: "V₁ = πr²h. V₂ = π(r/2)²h = 1/4 πr²h. Ratio V₂ / V₁ = 1/4 = 1 : 4."
    },
    {
      q: "A metallic sphere of radius 4.2 cm is melted and recast into the shape of a cylinder of radius 6 cm. The height of the cylinder is:",
      options: ["2.74 cm", "3.24 cm", "2.14 cm", "1.96 cm"],
      answer: 0,
      explanation: "πR²h = 4/3 πr³ ⟹ 6² × h = 4/3 × (4.2)³ ⟹ 36h = 4/3 × 74.088 = 98.784 ⟹ h = 98.784 / 36 = 2.744 cm ≈ 2.74 cm."
    },
    {
      q: "The total surface area of a solid hemisphere of radius r is:",
      options: ["2πr²", "3πr²", "4πr²", "2/3 πr³"],
      answer: 1,
      explanation: "TSA of solid hemisphere = Curved Surface Area (2πr²) + Flat Circular Base (πr²) = 3πr²."
    },
    {
      q: "How many balls, each of radius 1 cm, can be made from a solid sphere of lead of radius 8 cm?",
      options: ["64", "256", "512", "1024"],
      answer: 2,
      explanation: "Number of balls = Volume_large / Volume_small = (4/3 π R³) / (4/3 π r³) = (8 / 1)³ = 512."
    },
    {
      q: "A conical tent is 10 m high and the radius of its base is 24 m. The cost of canvas required to make the tent at ₹70 per m² is (use π = 22/7):",
      options: ["₹1,37,280", "₹1,40,500", "₹1,25,000", "₹1,50,000"],
      answer: 0,
      explanation: "Slant height l = √(10² + 24²) = √(100 + 576) = √676 = 26 m. Canvas area = πrl = (22/7) × 24 × 26 = 13728/7 m². Cost = (13728/7) × 70 = ₹1,37,280."
    },
    {
      q: "Twelve solid spheres of the same size are made by melting a solid metallic cylinder of base diameter 2 cm and height 16 cm. The diameter of each sphere is:",
      options: ["1 cm", "2 cm", "3 cm", "4 cm"],
      answer: 1,
      explanation: "Volume of cylinder = π(1)²(16) = 16π cm³. 12 × (4/3 π r³) = 16π ⟹ 16π r³ = 16π ⟹ r³ = 1 ⟹ r = 1 cm. Diameter = 2r = 2 cm."
    },
    {
      q: "The ratio of total surface area of a sphere to that of a hemisphere of the same radius is:",
      options: ["4 : 3", "2 : 1", "3 : 2", "4 : 1"],
      answer: 0,
      explanation: "TSA of sphere = 4πr². TSA of solid hemisphere = 3πr². Ratio = 4πr² / 3πr² = 4 : 3."
    },
    {
      q: "A solid cylinder of radius r and height h is melted and cast into a cone of same radius. The height of the cone is:",
      options: ["h", "2h", "3h", "h/3"],
      answer: 2,
      explanation: "Volume of cone = Volume of cylinder ⟹ 1/3 πr² H = πr² h ⟹ H = 3h."
    },
    {
      q: "The dimensions of a metallic cuboid are 100 cm × 80 cm × 64 cm. It is melted and recast into a cube. The surface area of the cube is:",
      options: ["38,400 cm²", "24,000 cm²", "42,000 cm²", "36,000 cm²"],
      answer: 0,
      explanation: "Volume = 100 × 80 × 64 = 512,000 cm³. Side of cube a = ∛512,000 = 80 cm. Surface area = 6a² = 6 × (80)² = 6 × 6400 = 38,400 cm²."
    },
    {
      q: "A well of diameter 3 m is dug 14 m deep. The earth taken out of it has been spread evenly all around it in the shape of a circular ring of width 4 m to form an embankment. The height of the embankment is:",
      options: ["1.125 m", "1.25 m", "1.5 m", "2 m"],
      answer: 0,
      explanation: "r₁ = 1.5 m, h = 14 m. V = π(1.5)²(14) = 31.5π m³. Outer radius R = 1.5 + 4 = 5.5 m. Area of ring = π(5.5² - 1.5²) = π(30.25 - 2.25) = 28π m². Height H = 31.5π / 28π = 31.5 / 28 = 1.125 m."
    },
    {
      q: "If the surface area of a sphere is 616 cm², then its diameter is (π = 22/7):",
      options: ["7 cm", "14 cm", "21 cm", "28 cm"],
      answer: 1,
      explanation: "4πr² = 616 ⟹ 4 × (22/7) × r² = 616 ⟹ r² = (616 × 7) / 88 = 7 × 7 = 49 ⟹ r = 7 cm. Diameter = 2r = 14 cm."
    },
    {
      q: "Water flows through a cylindrical pipe of internal diameter 2 cm at 0.7 m/s into a cylindrical tank with base radius 40 cm. The rise in water level in half an hour is:",
      options: ["78.75 cm", "65 cm", "80 cm", "90 cm"],
      answer: 0,
      explanation: "Pipe radius r = 1 cm = 0.01 m. Speed = 0.7 m/s. Time = 30 mins = 1800 s. Length of water L = 0.7 × 1800 = 1260 m. Volume = π(0.01)²(1260) = 0.126π m³. In tank (R = 0.4 m): π(0.4)² h = 0.126π ⟹ 0.16 h = 0.126 ⟹ h = 0.7875 m = 78.75 cm."
    },
    {
      q: "A solid sphere is cut into two equal halves. The percentage increase in the total surface area is:",
      options: ["25%", "50%", "75%", "100%"],
      answer: 1,
      explanation: "Original TSA of sphere = 4πr². Each hemisphere has TSA = 3πr², so two hemispheres have combined TSA = 6πr². Increase = 6πr² - 4πr² = 2πr². Percentage increase = (2πr² / 4πr²) × 100 = 50%."
    },
    {
      q: "If the radius of a cylinder is doubled and height is halved, the curved surface area will:",
      options: ["Be halved", "Double", "Remain same", "Be four times"],
      answer: 2,
      explanation: "CSA₁ = 2πrh. With radius 2r and height h/2: CSA₂ = 2π(2r)(h/2) = 2πrh = CSA₁. It remains unchanged."
    },
    {
      q: "A solid toy is in the form of a hemisphere surmounted by a right circular cone. Height of cone is 2 cm and diameter of base is 4 cm. Volume of the toy is:",
      options: ["8π cm³", "12π cm³", "16π cm³", "24π cm³"],
      answer: 0,
      explanation: "r = 2 cm, h = 2 cm. Volume = Volume_cone + Volume_hemi = 1/3 π(2)²(2) + 2/3 π(2)³ = 1/3 π(8) + 2/3 π(8) = 8/3 π + 16/3 π = 24/3 π = 8π cm³."
    },
    {
      q: "The volume of the largest circular cone that can be cut out from a cube of edge 4.2 cm is:",
      options: ["19.4 cm³", "18.2 cm³", "24.6 cm³", "20.4 cm³"],
      answer: 0,
      explanation: "Base diameter = edge = 4.2 cm ⟹ r = 2.1 cm. Height h = 4.2 cm. Volume = 1/3 πr²h = 1/3 × (22/7) × (2.1)² × 4.2 = 1/3 × (22/7) × 4.41 × 4.2 = 19.404 cm³."
    },
    {
      q: "Three solid cubes of iron whose edges are 3 cm, 4 cm, and 5 cm respectively are melted into a single cube. The edge of the new cube is:",
      options: ["6 cm", "7 cm", "8 cm", "12 cm"],
      answer: 0,
      explanation: "Total Volume = 3³ + 4³ + 5³ = 27 + 64 + 125 = 216 cm³. Edge of new cube a = ∛216 = 6 cm."
    }
  ];

  let currentIdx = 0;
  let userAnswers = new Array(quizData.length).fill(null);

  const qText = document.getElementById("quiz-question");
  const optionsBox = document.getElementById("quiz-options");
  const feedbackBox = document.getElementById("quiz-feedback");
  const counterBox = document.getElementById("quiz-counter");
  const scoreBox = document.getElementById("quiz-score");
  const prevBtn = document.getElementById("quiz-prev-btn");
  const nextBtn = document.getElementById("quiz-next-btn");
  const quizBox = document.getElementById("quiz-box");
  const resultBox = document.getElementById("quiz-result-box");
  const finalScore = document.getElementById("quiz-final-score");
  const finalMsg = document.getElementById("quiz-final-msg");
  const restartBtn = document.getElementById("quiz-restart-btn");

  function renderQuestion(idx) {
    const item = quizData[idx];
    counterBox.textContent = `Question ${idx + 1} of ${quizData.length}`;
    qText.textContent = item.q;
    optionsBox.innerHTML = "";
    feedbackBox.textContent = "";
    feedbackBox.className = "quiz-feedback";

    const selected = userAnswers[idx];

    item.options.forEach((optText, oIdx) => {
      const btn = document.createElement("button");
      btn.className = "quiz-opt-btn";
      btn.textContent = `${String.fromCharCode(65 + oIdx)}. ${optText}`;

      if (selected !== null) {
        btn.disabled = true;
        if (oIdx === item.answer) {
          btn.classList.add("opt-correct");
        } else if (oIdx === selected) {
          btn.classList.add("opt-wrong");
        }
      } else {
        btn.onclick = () => selectOption(oIdx);
      }

      optionsBox.appendChild(btn);
    });

    if (selected !== null) {
      if (selected === item.answer) {
        feedbackBox.textContent = `✓ Correct! ${item.explanation}`;
        feedbackBox.classList.add("feedback-correct");
      } else {
        feedbackBox.textContent = `✗ Incorrect. Correct answer is option ${String.fromCharCode(65 + item.answer)}. ${item.explanation}`;
        feedbackBox.classList.add("feedback-wrong");
      }
    }

    prevBtn.disabled = idx === 0;
    nextBtn.disabled = selected === null;
    nextBtn.textContent = idx === quizData.length - 1 ? "Finish Quiz →" : "Next Question →";
    updateScoreDisplay();
  }

  function selectOption(oIdx) {
    userAnswers[currentIdx] = oIdx;
    renderQuestion(currentIdx);
  }

  function updateScoreDisplay() {
    let score = 0;
    userAnswers.forEach((ans, i) => {
      if (ans === quizData[i].answer) score++;
    });
    scoreBox.textContent = `Score: ${score} / ${quizData.length}`;
  }

  prevBtn.onclick = () => {
    if (currentIdx > 0) {
      currentIdx--;
      renderQuestion(currentIdx);
    }
  };

  nextBtn.onclick = () => {
    if (currentIdx < quizData.length - 1) {
      currentIdx++;
      renderQuestion(currentIdx);
    } else {
      finishQuiz();
    }
  };

  function finishQuiz() {
    quizBox.style.display = "none";
    resultBox.style.display = "block";
    let score = 0;
    userAnswers.forEach((ans, i) => {
      if (ans === quizData[i].answer) score++;
    });
    finalScore.textContent = `Your Final Score: ${score} / ${quizData.length} (${Math.round((score / quizData.length) * 100)}%)`;
    if (score >= 18) {
      finalMsg.textContent = "Spectacular mastery! You have exceptional clarity on solid combinations, conservation of volume, and embankment modeling.";
    } else if (score >= 14) {
      finalMsg.textContent = "Great job! Review pipe rate of flow problems and composite surface areas to achieve full marks.";
    } else {
      finalMsg.textContent = "Review the 3D solid formulas and exemplar capsule problem above, then retry!";
    }
  }

  restartBtn.onclick = () => {
    userAnswers = new Array(quizData.length).fill(null);
    currentIdx = 0;
    resultBox.style.display = "none";
    quizBox.style.display = "block";
    renderQuestion(0);
  };

  renderQuestion(0);
})();
</script>

