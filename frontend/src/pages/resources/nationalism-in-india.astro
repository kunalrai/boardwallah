---
import Layout from "../../layouts/Layout.astro";
import { loadContent } from "../../lib/content";
import { calBookingUrl } from "../../lib/site";

const { provider } = loadContent();
---

<Layout
  title={`Nationalism in India | CBSE Class 10 History | ${provider.name}`}
  description="CBSE Class 10 History Chapter 2 revision notes on Nationalism in India. Covers Satyagraha, Jallianwala Bagh, Non-Cooperation Movement, Civil Disobedience, Dandi Salt March, Poona Pact, sense of collective belonging, and an interactive 20-question board exam quiz."
>
  <div class="wrap">
    <nav class="small" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/subjects/">Subjects</a> / <a href="/resources/">Resources</a> / Nationalism in India
    </nav>

    <div class="resource-header">
      <span class="eyebrow">CBSE Class 10 · Social Science · History Chapter 2</span>
      <h1>Nationalism in India</h1>
      <p class="lead">
        Comprehensive revision notes, movement timelines, differences between Non-Cooperation and Civil Disobedience, participant perspectives, and an interactive 20-question board exam quiz.
      </p>
    </div>

    <!-- Core Concepts -->
    <section class="section">
      <h2>Key Historical Concepts &amp; Chronology</h2>

      <div class="grid two concept-grid">
        <article class="card">
          <h3>🕊️ The Idea of Satyagraha &amp; Early Experiments</h3>
          <p class="formula">Truth, Non-Violence &amp; Soul Force (1915–1918)</p>
          <ul class="clean-list">
            <li>Mahatma Gandhi returned to India from South Africa in <strong>January 1915</strong>.</li>
            <li><strong>Satyagraha:</strong> Emphasized the power of truth and the need to search for truth. It suggested that if the cause was true and the struggle was against injustice, physical force was not necessary to fight the oppressor.</li>
            <li><strong>Early Satyagrahas:</strong>
              <br/>• <strong>1917 (Champaran, Bihar):</strong> Against oppressive indigo plantation system.
              <br/>• <strong>1917 (Kheda, Gujarat):</strong> Demanded revenue collection relaxation due to crop failure and plague epidemic.
              <br/>• <strong>1918 (Ahmedabad, Gujarat):</strong> Cotton mill workers' movement demanding wage hike.
            </li>
          </ul>
        </article>

        <article class="card">
          <h3>🩸 Rowlatt Act &amp; Jallianwala Bagh Massacre (1919)</h3>
          <p class="formula">6 April Hartal to 13 April 1919 Bloodshed</p>
          <ul class="clean-list">
            <li><strong>Rowlatt Act (1919):</strong> Passed hurriedly through the Imperial Legislative Council despite united Indian opposition. It gave the government enormous powers to repress political activities and allowed detention of political prisoners without trial for two years.</li>
            <li><strong>Jallianwala Bagh Massacre (13 April 1919):</strong>
              <br/>• On Baisakhi day, a large crowd gathered in Amritsar—some to protest arrest of leaders (Dr. Saifuddin Kitchlew and Dr. Satyapal), others to attend the annual fair.
              <br/>• <strong>General Dyer</strong> entered, blocked the only narrow exit points, and opened fire on the peaceful gathering, killing hundreds.
              <br/>• Dyer declared his object was to <em>"produce a moral effect, to create in the minds of the satyagrahis a feeling of terror and awe."</em>
            </li>
          </ul>
        </article>

        <article class="card">
          <h3>🚩 Non-Cooperation-Khilafat Movement (1920–1922)</h3>
          <p class="formula">"Hind Swaraj" (1909): British rule survived only because Indians cooperated</p>
          <ul class="clean-list">
            <li><strong>Khilafat Issue:</strong> Harsh peace treaty imposed on the Ottoman Emperor (the spiritual head or Khalifa of Muslims). Muhammad Ali and Shaukat Ali formed the Khilafat Committee in Bombay (March 1919). Gandhiji saw this as an opportunity to unite Hindus and Muslims.</li>
            <li><strong>Movement launched:</strong> Adopted at the Nagpur Congress Session in <strong>December 1920</strong>.</li>
            <li><strong>Strands:</strong>
              <br/>• <strong>Cities:</strong> Boycott of schools, colleges, law courts, foreign goods; picketing of liquor shops; foreign cloth burned in huge bonfires.
              <br/>• <strong>Peasants in Awadh:</strong> Led by Baba Ramchandra (sanyasi) against talukdars and landlords. Oudh Kisan Sabha set up by Jawaharlal Nehru and Baba Ramchandra.
              <br/>• <strong>Tribals in Andhra:</strong> Alluri Sitaram Raju led militant guerrilla movement in Gudem Hills against forest laws.
              <br/>• <strong>Assam Plantations:</strong> Workers demanded freedom to move outside tea gardens (opposing Inland Emigration Act of 1859).
            </li>
            <li><strong>Withdrawal:</strong> Halted in <strong>February 1922</strong> following the violent <strong>Chauri Chaura</strong> incident in Gorakhpur, UP (22 policemen burned in police station).</li>
          </ul>
        </article>

        <article class="card">
          <h3>🧂 Salt March &amp; Civil Disobedience Movement (1930–1934)</h3>
          <p class="formula">Refusing cooperation AND breaking colonial laws</p>
          <ul class="clean-list">
            <li><strong>Dandi March:</strong> Gandhiji sent 11 demands to Viceroy Irwin. Irwin was unwilling to negotiate. Gandhiji started the 240-mile march from Sabarmati Ashram to Dandi with 78 trusted volunteers (12 March to 6 April 1930). On 6 April, he broke the Salt Law by boiling sea water.</li>
            <li><strong>Why Salt?</strong> Salt was consumed by rich and poor alike; tax on salt and government monopoly over its manufacture revealed the most oppressive face of British rule.</li>
            <li><strong>Participants:</strong> Rich peasants (Patidars of Gujarat, Jats of UP), business classes (Purshottamdas Thakurdas, G.D. Birla through FICCI 1927), women participated in large numbers.</li>
            <li><strong>Poona Pact (September 1932):</strong> Signed between Gandhiji and Dr. B.R. Ambedkar; gave reserved seats in provincial and central legislative councils to Depressed Classes, to be voted in by general electorate.</li>
          </ul>
        </article>
      </div>
    </section>

    <!-- Visual Diagrams Section -->
    <section class="section">
      <h2>Visual Concepts: Timeline &amp; NCM vs. CDM Comparison</h2>

      <div class="grid two">
        <div class="card visual-card">
          <div class="visual-badge">Visual Diagram 1 · National Movement Chronology (1915–1932)</div>
          <div class="svg-container">
            <svg viewBox="0 0 460 250" xmlns="http://www.w3.org/2000/svg" aria-label="Chronology of Indian National Movement">
              <rect width="460" height="250" fill="#f8fafc" rx="8"/>
              
              <!-- Timeline Bar -->
              <line x1="30" y1="125" x2="430" y2="125" stroke="#0f766e" stroke-width="4"/>

              <!-- 1915 Node -->
              <circle cx="50" cy="125" r="7" fill="#0f766e"/>
              <text x="50" y="105" text-anchor="middle" font-size="11" font-weight="700" fill="#0f766e">1915</text>
              <text x="50" y="150" text-anchor="middle" font-size="9" fill="#334155">Gandhi returns<br/>from S. Africa</text>

              <!-- 1919 Node -->
              <circle cx="130" cy="125" r="7" fill="#dc2626"/>
              <text x="130" y="105" text-anchor="middle" font-size="11" font-weight="700" fill="#dc2626">1919</text>
              <text x="130" y="150" text-anchor="middle" font-size="9" fill="#7f1d1d">Rowlatt Act &amp;<br/>Jallianwala Bagh</text>

              <!-- 1920-22 Node -->
              <circle cx="215" cy="125" r="7" fill="#0284c7"/>
              <text x="215" y="105" text-anchor="middle" font-size="11" font-weight="700" fill="#0284c7">1920-22</text>
              <text x="215" y="150" text-anchor="middle" font-size="9" fill="#0369a1">Non-Cooperation<br/>Movement</text>

              <!-- 1929 Node -->
              <circle cx="300" cy="125" r="7" fill="#d97706"/>
              <text x="300" y="105" text-anchor="middle" font-size="11" font-weight="700" fill="#d97706">1929</text>
              <text x="300" y="150" text-anchor="middle" font-size="9" fill="#92400e">Lahore Congress<br/>Purna Swaraj</text>

              <!-- 1930-32 Node -->
              <circle cx="390" cy="125" r="7" fill="#10b981"/>
              <text x="390" y="105" text-anchor="middle" font-size="11" font-weight="700" fill="#059669">1930-32</text>
              <text x="390" y="150" text-anchor="middle" font-size="9" fill="#065f46">Dandi March &amp;<br/>Civil Disobedience</text>

              <!-- Bottom Note -->
              <rect x="40" y="195" width="380" height="40" rx="6" fill="#ecfdf5" stroke="#10b981"/>
              <text x="230" y="215" text-anchor="middle" font-size="11" font-weight="700" fill="#065f46">From Satyagraha to Mass Movements: Complete Unification of India</text>
              <text x="230" y="228" text-anchor="middle" font-size="9" fill="#047857">1932: Poona Pact ensures political representation for Depressed Classes</text>
            </svg>
          </div>
          <p class="visual-caption">Key chronological milestones of the Indian National Movement from 1915 to 1932.</p>
        </div>

        <div class="card visual-card">
          <div class="visual-badge">Visual Diagram 2 · Comparison: Non-Cooperation vs. Civil Disobedience</div>
          <div class="svg-container">
            <svg viewBox="0 0 460 250" xmlns="http://www.w3.org/2000/svg" aria-label="NCM vs CDM comparison table">
              <rect width="460" height="250" fill="#f8fafc" rx="8"/>
              
              <!-- Left Column: NCM (1920-22) -->
              <rect x="20" y="20" width="200" height="205" rx="6" fill="#eff6ff" stroke="#3b82f6" stroke-width="1.5"/>
              <text x="120" y="45" text-anchor="middle" font-size="12" font-weight="700" fill="#1d4ed8">Non-Cooperation (1920-22)</text>
              <line x1="30" y1="55" x2="210" y2="55" stroke="#93c5fd" stroke-width="1"/>
              <text x="35" y="75" font-size="10" fill="#1e3a8a">• <strong>Goal:</strong> Swaraj within 1 year</text>
              <text x="35" y="95" font-size="10" fill="#1e3a8a">• <strong>Action:</strong> Refusal to cooperate</text>
              <text x="35" y="110" font-size="9" fill="#3b82f6">  with British administration</text>
              <text x="35" y="130" font-size="10" fill="#1e3a8a">• <strong>Law Breaking:</strong> No breaking of</text>
              <text x="35" y="145" font-size="9" fill="#3b82f6">  colonial laws; passive boycott</text>
              <text x="35" y="165" font-size="10" fill="#1e3a8a">• <strong>Muslim Support:</strong> Very high</text>
              <text x="35" y="180" font-size="9" fill="#3b82f6">  due to Khilafat alliance</text>
              <text x="35" y="200" font-size="9" font-weight="600" fill="#dc2626">• Withdrawn: Chauri Chaura violence</text>

              <!-- Right Column: CDM (1930-34) -->
              <rect x="240" y="20" width="200" height="205" rx="6" fill="#fef2f2" stroke="#ef4444" stroke-width="1.5"/>
              <text x="340" y="45" text-anchor="middle" font-size="12" font-weight="700" fill="#b91c1c">Civil Disobedience (1930-34)</text>
              <line x1="250" y1="55" x2="430" y2="55" stroke="#fca5a5" stroke-width="1"/>
              <text x="255" y="75" font-size="10" fill="#7f1d1d">• <strong>Goal:</strong> Purna Swaraj (Complete Independence)</text>
              <text x="255" y="95" font-size="10" fill="#7f1d1d">• <strong>Action:</strong> Non-cooperation PLUS</text>
              <text x="255" y="110" font-size="9" fill="#b91c1c">  active breaking of colonial laws</text>
              <text x="255" y="130" font-size="10" fill="#7f1d1d">• <strong>Law Breaking:</strong> Salt law, forest</text>
              <text x="255" y="145" font-size="9" fill="#b91c1c">  laws broken; non-payment of taxes</text>
              <text x="255" y="165" font-size="10" fill="#7f1d1d">• <strong>Muslim Support:</strong> Lukewarm /</text>
              <text x="255" y="180" font-size="9" fill="#b91c1c">  alienated after Khilafat collapse</text>
              <text x="255" y="200" font-size="9" font-weight="600" fill="#047857">• High business and women participation</text>
            </svg>
          </div>
          <p class="visual-caption">Key differences between the Non-Cooperation Movement (1920–22) and the Civil Disobedience Movement (1930–34).</p>
        </div>
      </div>
    </section>

    <!-- Sense of Collective Belonging -->
    <section class="section">
      <h2>The Sense of Collective Belonging</h2>
      <div class="grid two">
        <article class="card">
          <h3>🖼️ Bharat Mata &amp; Nationalist Icons</h3>
          <ul class="clean-list">
            <li><strong>Bankim Chandra Chattopadhyay:</strong> In the 1870s, he wrote <em>'Vande Mataram'</em> as a hymn to the motherland. Later included in his novel <em>Anandamath</em> and widely sung during Swadeshi movement in Bengal.</li>
            <li><strong>Abanindranath Tagore:</strong> Painted his famous image of <strong>Bharat Mata</strong> (1905), portraying her as an ascetic figure: calm, composed, divine, and spiritual.</li>
            <li><strong>National Flags:</strong>
              <br/>• Swadeshi tricolour in Bengal (red, green, and yellow) with 8 lotuses representing eight provinces of British India and a crescent moon representing Hindus and Muslims.
              <br/>• In 1921, Gandhiji designed the <strong>Swaraj flag</strong>: a tricolour (red, green, and white) with a spinning wheel (charkha) in the centre representing self-help.
            </li>
          </ul>
        </article>

        <article class="card">
          <h3>📜 Revival of Folklore &amp; Reinterpretation of History</h3>
          <ul class="clean-list">
            <li><strong>Folk Traditions:</strong> Nationalists toured villages to record folk songs and legends to preserve national identity. In Bengal, Rabindranath Tagore led the movement for folk revival; in Madras, <strong>Natesa Sastri</strong> published a massive four-volume collection of Tamil folk tales, <em>The Folklore of Southern India</em>.</li>
            <li><strong>Reinterpretation of History:</strong> British saw Indians as backward, primitive, and incapable of self-governance. In response, Indian nationalists wrote about great achievements in ancient times in art, architecture, science, mathematics, religion, and trade, urging Indians to take pride in their past to fight British subjugation.</li>
          </ul>
        </article>
      </div>
    </section>

    <!-- Interactive 20-Question Quiz -->
    <section class="section">
      <h2>Interactive CBSE Board Exam Quiz (20 Questions)</h2>
      <p class="muted">Test your concepts on the Indian freedom movement with authentic CBSE board questions. Instant explanations provided.</p>

      <div class="quiz-container card" id="quiz-box">
        <div class="quiz-header-bar">
          <span class="quiz-counter" id="quiz-counter">Question 1 of 20</span>
          <span class="quiz-score" id="quiz-score">Score: 0 / 20</span>
        </div>

        <div class="quiz-question-body">
          <p class="quiz-q-text" id="quiz-question">Loading question...</p>
          <div class="quiz-options-list" id="quiz-options"></div>
          <div class="quiz-feedback" id="quiz-feedback"></div>
        </div>

        <div class="quiz-footer-actions">
          <button class="button secondary" id="quiz-prev-btn" disabled>← Previous</button>
          <button class="button" id="quiz-next-btn" disabled>Next Question →</button>
        </div>
      </div>

      <div class="quiz-completed-banner card" id="quiz-result-box" style="display:none; text-align:center; padding:2.5rem;">
        <h3>Quiz Completed! 🎉</h3>
        <p class="quiz-final-score" id="quiz-final-score" style="font-size:1.4rem; font-weight:700; color:var(--brand); margin:1rem 0;"></p>
        <p id="quiz-final-msg" class="muted"></p>
        <button class="button" id="quiz-restart-btn" style="margin-top:1rem;">Retake Quiz</button>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-banner">
      <h2>Need personalized guidance for Class 10 Social Science?</h2>
      <p>Book a free {provider.trial.duration_minutes}-minute trial session with {provider.tutor_name} (online or at-home) to master answer-writing frameworks and score 100% in CBSE Board Exams.</p>
      <a class="button" href={calBookingUrl} target="_blank" rel="noopener noreferrer">Book Free Trial</a>
    </section>
  </div>
</Layout>

<script is:inline>
(function() {
  const quizData = [
    {
      q: "In which year did Mahatma Gandhi return to India from South Africa?",
      options: ["1914", "1915", "1916", "1917"],
      answer: 1,
      explanation: "Mahatma Gandhi returned to India from South Africa in January 1915 after successfully organizing satyagraha against racist laws."
    },
    {
      q: "The Champaran Satyagraha of 1917 was organized to support:",
      options: ["Cotton mill workers", "Peasants against the oppressive indigo plantation system", "Tribal forest rights", "Salt tax abolition"],
      answer: 1,
      explanation: "In 1917, Mahatma Gandhi travelled to Champaran in Bihar to inspire the peasants to struggle against the oppressive tinkathia indigo plantation system."
    },
    {
      q: "Under the Inland Emigration Act of 1859, plantation workers in Assam were not permitted to:",
      options: ["Leave the tea gardens without permission", "Form trade unions", "Work more than 8 hours", "Earn wages in cash"],
      answer: 0,
      explanation: "Under the Inland Emigration Act of 1859, plantation workers were not permitted to leave the tea gardens without permission, and in fact, such permission was rarely given."
    },
    {
      q: "Why did General Dyer order troops to fire at Jallianwala Bagh on 13 April 1919?",
      options: ["To disperse an armed rebellion", "To create a feeling of terror and awe in the minds of satyagrahis", "To capture Mahatma Gandhi", "To enforce the Salt Law"],
      answer: 1,
      explanation: "General Dyer stated later that his objective was to 'produce a moral effect' and strike terror and awe into the minds of Indians."
    },
    {
      q: "Who were the leaders of the Khilafat Movement who approached Gandhiji for a joint mass action?",
      options: ["Muhammad Ali Jinnah and Abul Kalam Azad", "Muhammad Ali and Shaukat Ali (Ali Brothers)", "Khan Abdul Ghaffar Khan and Liaquat Ali", "Sir Syed Ahmed Khan and Badruddin Tyabji"],
      answer: 1,
      explanation: "Young Muslim leaders, the brothers Muhammad Ali and Shaukat Ali, formed the Khilafat Committee in Bombay (March 1919) and discussed joint mass action with Gandhiji."
    },
    {
      q: "In which Congress Session was the Non-Cooperation programme finally adopted?",
      options: ["Calcutta Session (Sept 1920)", "Nagpur Session (Dec 1920)", "Lahore Session (Dec 1929)", "Madras Session (1927)"],
      answer: 1,
      explanation: "At the Congress session at Nagpur in December 1920, a compromise was worked out and the Non-Cooperation programme was adopted."
    },
    {
      q: "Who led the peasant movement in Awadh during the Non-Cooperation Movement?",
      options: ["Baba Ramchandra", "Alluri Sitaram Raju", "Jawaharlal Nehru", "Motilal Nehru"],
      answer: 0,
      explanation: "In Awadh, peasants were led by Baba Ramchandra—a sanyasi who had earlier been to Fiji as an indentured labourer—demanding reduction of revenue and begar."
    },
    {
      q: "Alluri Sitaram Raju led a tribal militant guerrilla movement in which region?",
      options: ["Chota Nagpur plateau", "Gudem Hills of Andhra Pradesh", "Santhal Parganas", "Bastar region"],
      answer: 1,
      explanation: "In the Gudem Hills of Andhra Pradesh, a militant guerrilla movement grew in the early 1920s under the leadership of Alluri Sitaram Raju against colonial forest restrictions."
    },
    {
      q: "Why did Mahatma Gandhi decide to withdraw the Non-Cooperation Movement in February 1922?",
      options: ["Second Round Table Conference failure", "Chauri Chaura violent incident", "Arrest of Jawaharlal Nehru", "Passing of Rowlatt Act"],
      answer: 1,
      explanation: "In February 1922, Mahatma Gandhi decided to withdraw the Non-Cooperation Movement after a peaceful procession turned violent at Chauri Chaura in Gorakhpur, burning 22 policemen alive."
    },
    {
      q: "Who among the following formed the Swaraj Party within the Congress to argue for a return to council politics?",
      options: ["C.R. Das and Motilal Nehru", "Jawaharlal Nehru and Subhas Chandra Bose", "Mahatma Gandhi and Sardar Patel", "Dr. B.R. Ambedkar and Tej Bahadur Sapru"],
      answer: 0,
      explanation: "C.R. Das and Motilal Nehru formed the Swaraj Party within the Congress to argue for entering the provincial legislative councils to oppose British policies from within."
    },
    {
      q: "Why was the Simon Commission boycotted by Indians in 1928?",
      options: ["It did not have a single Indian member", "It recommended partition of India", "It banned the Congress Party", "It increased salt taxes"],
      answer: 0,
      explanation: "The Statutory Commission headed by Sir John Simon did not have a single Indian member; all members were British, which was seen as an insult to Indian self-respect."
    },
    {
      q: "In which historic session was the demand for 'Purna Swaraj' (Complete Independence) formalized?",
      options: ["Belgaum Session 1924", "Karachi Session 1931", "Lahore Session 1929", "Nagpur Session 1920"],
      answer: 2,
      explanation: "In December 1929, under the presidency of Jawaharlal Nehru, the Lahore Congress formalized the demand of 'Purna Swaraj' or full independence, declaring 26 January 1930 as Independence Day."
    },
    {
      q: "The historic Dandi Salt March covered how many miles, and lasted how many days?",
      options: ["240 miles in 24 days", "100 miles in 10 days", "360 miles in 30 days", "150 miles in 15 days"],
      answer: 0,
      explanation: "The march was over 240 miles, from Gandhiji's ashram in Sabarmati to the coastal town of Dandi. The volunteers walked for 24 days, about 10 miles a day."
    },
    {
      q: "Who was known as the 'Frontier Gandhi' and led the Khudai Khidmatgars in Peshawar?",
      options: ["Khan Abdul Ghaffar Khan", "Maulana Abul Kalam Azad", "Muhammad Iqbal", "Sir Syed Ahmed Khan"],
      answer: 0,
      explanation: "Abdul Ghaffar Khan, a devout disciple of Mahatma Gandhi, was popularly known as Frontier Gandhi and organized the non-violent Khudai Khidmatgars."
    },
    {
      q: "The Gandhi-Irwin Pact was signed in:",
      options: ["December 1929", "March 1931", "September 1932", "August 1942"],
      answer: 1,
      explanation: "By the Gandhi-Irwin Pact of 5 March 1931, Gandhiji agreed to participate in the Second Round Table Conference in London and government agreed to release political prisoners."
    },
    {
      q: "Who founded the 'Depressed Classes Association' in 1930?",
      options: ["Jyotirao Phule", "Dr. B.R. Ambedkar", "Periyar E.V. Ramasamy", "Mahatma Gandhi"],
      answer: 1,
      explanation: "Dr. B.R. Ambedkar, who organized the Dalits into the Depressed Classes Association in 1930, clashed with Mahatma Gandhi at the Second Round Table Conference demanding separate electorates."
    },
    {
      q: "What was the main outcome of the Poona Pact of September 1932?",
      options: ["Separate electorates for Dalits", "Reserved seats for Depressed Classes in provincial and central councils, voted by general electorate", "Partition of Bengal", "Abolition of Zamindari"],
      answer: 1,
      explanation: "The Poona Pact gave the Depressed Classes reserved seats in provincial and central legislative councils, but they were to be voted in by the general electorate rather than separate electorates."
    },
    {
      q: "Who created the first visual image of 'Bharat Mata'?",
      options: ["Raja Ravi Varma", "Bankim Chandra Chattopadhyay", "Abanindranath Tagore", "Nandalal Bose"],
      answer: 1,
      explanation: "Bankim Chandra Chattopadhyay first conceptualized Bharat Mata and wrote 'Vande Mataram'. In 1905, Abanindranath Tagore painted the famous iconic visual image of Bharat Mata."
    },
    {
      q: "Who published the four-volume collection of Tamil folk tales titled 'The Folklore of Southern India'?",
      options: ["Subramania Bharati", "Natesa Sastri", "C. Rajagopalachari", "E.V. Ramasamy"],
      answer: 1,
      explanation: "In Madras, Natesa Sastri published a massive four-volume collection of Tamil folk tales, 'The Folklore of Southern India', believing folklore was national literature."
    },
    {
      q: "What did the spinning wheel (charkha) in Gandhiji's Swaraj flag (1921) symbolize?",
      options: ["Industrial power", "The Gandhian ideal of self-reliance and self-help", "Agricultural richness", "Victory over British mills"],
      answer: 1,
      explanation: "The Swaraj tricolour flag designed by Gandhiji in 1921 had a spinning wheel in the centre, representing the Gandhian ideal of self-help and economic self-reliance."
    }
  ];

  let currentIdx = 0;
  let userAnswers = new Array(quizData.length).fill(null);

  const qText = document.getElementById("quiz-question");
  const optionsBox = document.getElementById("quiz-options");
  const feedbackBox = document.getElementById("quiz-feedback");
  const counterBox = document.getElementById("quiz-counter");
  const scoreBox = document.getElementById("quiz-score");
  const prevBtn = document.getElementById("quiz-prev-btn");
  const nextBtn = document.getElementById("quiz-next-btn");
  const quizBox = document.getElementById("quiz-box");
  const resultBox = document.getElementById("quiz-result-box");
  const finalScore = document.getElementById("quiz-final-score");
  const finalMsg = document.getElementById("quiz-final-msg");
  const restartBtn = document.getElementById("quiz-restart-btn");

  function renderQuestion(idx) {
    const item = quizData[idx];
    counterBox.textContent = `Question ${idx + 1} of ${quizData.length}`;
    qText.textContent = item.q;
    optionsBox.innerHTML = "";
    feedbackBox.textContent = "";
    feedbackBox.className = "quiz-feedback";

    const selected = userAnswers[idx];

    item.options.forEach((optText, oIdx) => {
      const btn = document.createElement("button");
      btn.className = "quiz-opt-btn";
      btn.textContent = `${String.fromCharCode(65 + oIdx)}. ${optText}`;

      if (selected !== null) {
        btn.disabled = true;
        if (oIdx === item.answer) {
          btn.classList.add("opt-correct");
        } else if (oIdx === selected) {
          btn.classList.add("opt-wrong");
        }
      } else {
        btn.onclick = () => selectOption(oIdx);
      }

      optionsBox.appendChild(btn);
    });

    if (selected !== null) {
      if (selected === item.answer) {
        feedbackBox.textContent = `✓ Correct! ${item.explanation}`;
        feedbackBox.classList.add("feedback-correct");
      } else {
        feedbackBox.textContent = `✗ Incorrect. Correct answer is option ${String.fromCharCode(65 + item.answer)}. ${item.explanation}`;
        feedbackBox.classList.add("feedback-wrong");
      }
    }

    prevBtn.disabled = idx === 0;
    nextBtn.disabled = selected === null;
    nextBtn.textContent = idx === quizData.length - 1 ? "Finish Quiz →" : "Next Question →";
    updateScoreDisplay();
  }

  function selectOption(oIdx) {
    userAnswers[currentIdx] = oIdx;
    renderQuestion(currentIdx);
  }

  function updateScoreDisplay() {
    let score = 0;
    userAnswers.forEach((ans, i) => {
      if (ans === quizData[i].answer) score++;
    });
    scoreBox.textContent = `Score: ${score} / ${quizData.length}`;
  }

  prevBtn.onclick = () => {
    if (currentIdx > 0) {
      currentIdx--;
      renderQuestion(currentIdx);
    }
  };

  nextBtn.onclick = () => {
    if (currentIdx < quizData.length - 1) {
      currentIdx++;
      renderQuestion(currentIdx);
    } else {
      finishQuiz();
    }
  };

  function finishQuiz() {
    quizBox.style.display = "none";
    resultBox.style.display = "block";
    let score = 0;
    userAnswers.forEach((ans, i) => {
      if (ans === quizData[i].answer) score++;
    });
    finalScore.textContent = `Your Final Score: ${score} / ${quizData.length} (${Math.round((score / quizData.length) * 100)}%)`;
    if (score >= 18) {
      finalMsg.textContent = "Superb mastery! You have exceptional clarity on the Indian National Movement, movements, and key personalities.";
    } else if (score >= 14) {
      finalMsg.textContent = "Well done! Review the differing strands within Non-Cooperation and the Poona Pact to get full marks.";
    } else {
      finalMsg.textContent = "Review the core timelines and comparative tables above, then re-attempt the quiz.";
    }
  }

  restartBtn.onclick = () => {
    userAnswers = new Array(quizData.length).fill(null);
    currentIdx = 0;
    resultBox.style.display = "none";
    quizBox.style.display = "block";
    renderQuestion(0);
  };

  renderQuestion(0);
})();
</script>

