---
import Layout from "../../layouts/Layout.astro";
import { loadContent } from "../../lib/content";
import { calBookingUrl } from "../../lib/site";

const { provider } = loadContent();
---

<Layout
  title={`Introduction to Trigonometry | CBSE Class 10 Maths | ${provider.name}`}
  description="CBSE Class 10 Maths Chapter 8 study notes on Introduction to Trigonometry. Trigonometric ratios, standard angle values table (0°, 30°, 45°, 60°, 90°), fundamental Pythagorean identities, proofs, and an interactive 20-question board exam quiz."
>
  <div class="wrap">
    <nav class="small" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/subjects/">Subjects</a> / <a href="/resources/">Resources</a> / Introduction to Trigonometry
    </nav>

    <div class="resource-header">
      <span class="eyebrow">CBSE Class 10 · Mathematics · Chapter 8</span>
      <h1>Introduction to Trigonometry</h1>
      <p class="lead">
        Master trigonometric ratios (sin, cos, tan, cot, sec, cosec), memorize standard angle values, apply Pythagorean identities, and ace tricky trigonometric proof questions for the CBSE Board Exam.
      </p>
    </div>

    <!-- Core Concepts -->
    <section class="section">
      <h2>Key Concepts &amp; Formulas</h2>

      <div class="grid two concept-grid">
        <article class="card">
          <h3>📐 Trigonometric Ratios (Right Triangle)</h3>
          <p class="formula">sin θ, cos θ, tan θ &amp; Reciprocals</p>
          <ul class="clean-list">
            <li>For an acute angle <em>θ</em> in right triangle ABC (with right angle at B):</li>
            <li><code>sin θ = Perpendicular / Hypotenuse = P / H</code></li>
            <li><code>cos θ = Base / Hypotenuse = B / H</code></li>
            <li><code>tan θ = Perpendicular / Base = P / B = sin θ / cos θ</code></li>
            <li><code>cosec θ = 1 / sin θ = H / P</code></li>
            <li><code>sec θ = 1 / cos θ = H / B</code></li>
            <li><code>cot θ = 1 / tan θ = B / P = cos θ / sin θ</code></li>
          </ul>
        </article>

        <article class="card">
          <h3>📊 Trigonometric Ratios of Standard Angles</h3>
          <p class="formula">0°, 30°, 45°, 60°, 90°</p>
          <ul class="clean-list">
            <li><strong>sin θ:</strong> <code>0, 1/2, 1/√2, √3/2, 1</code></li>
            <li><strong>cos θ:</strong> <code>1, √3/2, 1/√2, 1/2, 0</code> (reverse of sin)</li>
            <li><strong>tan θ:</strong> <code>0, 1/√3, 1, √3, Not Defined</code></li>
            <li><em>Memory Trick:</em> Write <code>√(0/4), √(1/4), √(2/4), √(3/4), √(4/4)</code> to immediately get sin values for 0°, 30°, 45°, 60°, 90°!</li>
          </ul>
        </article>

        <article class="card">
          <h3>🔑 Fundamental Pythagorean Identities</h3>
          <p class="formula">sin²θ + cos²θ = 1</p>
          <ul class="clean-list">
            <li><strong>Identity 1:</strong> <code>sin²θ + cos²θ = 1</code>
              <br/>⟹ <code>sin²θ = 1 - cos²θ</code> &nbsp;|&nbsp; <code>cos²θ = 1 - sin²θ</code>.
            </li>
            <li><strong>Identity 2:</strong> <code>1 + tan²θ = sec²θ</code>
              <br/>⟹ <code>sec²θ - tan²θ = 1</code> &nbsp;|&nbsp; <code>(sec θ - tan θ)(sec θ + tan θ) = 1</code>.
            </li>
            <li><strong>Identity 3:</strong> <code>1 + cot²θ = cosec²θ</code>
              <br/>⟹ <code>cosec²θ - cot²θ = 1</code> &nbsp;|&nbsp; <code>(cosec θ - cot θ)(cosec θ + cot θ) = 1</code>.
            </li>
          </ul>
        </article>

        <article class="card">
          <h3>⚡ Pro-Tips for Proving Identities</h3>
          <p class="formula">Algebraic simplification strategies</p>
          <ul class="clean-list">
            <li><strong>Strategy 1:</strong> Convert all terms (tan, cot, sec, cosec) into <code>sin θ</code> and <code>cos θ</code>.</li>
            <li><strong>Strategy 2:</strong> Take LCM of denominators and look for Pythagorean identities in the numerator.</li>
            <li><strong>Strategy 3:</strong> Rationalize denominators involving <code>(1 ± sin θ)</code> or <code>(1 ± cos θ)</code> by multiplying numerator and denominator by conjugate.</li>
            <li><strong>Strategy 4:</strong> Apply algebraic formulas: <code>a³ ± b³</code>, <code>(a ± b)²</code>.</li>
          </ul>
        </article>
      </div>
    </section>

    <!-- Visual Diagrams Section -->
    <section class="section">
      <h2>Visual Concepts: Right Triangle Reference &amp; Standard Angle Chart</h2>

      <div class="grid two">
        <div class="card visual-card">
          <div class="visual-badge">Visual Diagram 1 · Right Triangle Ratio Reference</div>
          <div class="svg-container">
            <svg viewBox="0 0 460 250" xmlns="http://www.w3.org/2000/svg" aria-label="Right triangle trigonometric ratios">
              <rect width="460" height="250" fill="#f8fafc" rx="8"/>
              
              <!-- Triangle ABC -->
              <polygon points="80,190 320,190 320,50" fill="#f1f5f9" stroke="#0f766e" stroke-width="2.5"/>
              
              <!-- Right angle at B(320, 190) -->
              <rect x="300" y="170" width="20" height="20" fill="none" stroke="#64748b" stroke-width="1.5"/>
              
              <!-- Vertices -->
              <text x="65" y="205" font-size="13" font-weight="700" fill="#0f766e">A</text>
              <text x="330" y="205" font-size="13" font-weight="700" fill="#0f766e">B (90°)</text>
              <text x="330" y="45" font-size="13" font-weight="700" fill="#0f766e">C</text>

              <!-- Angle theta at A -->
              <path d="M 120 190 A 40 40 0 0 0 110 168" fill="none" stroke="#ea580c" stroke-width="2"/>
              <text x="130" y="178" font-size="13" font-weight="700" fill="#ea580c">θ</text>

              <!-- Side Labels -->
              <text x="200" y="212" text-anchor="middle" font-size="12" font-weight="700" fill="#0284c7">Base (Adjacent to θ)</text>
              <text x="380" y="125" text-anchor="middle" font-size="12" font-weight="700" fill="#ef4444">Perpendicular<br/>(Opposite θ)</text>
              <text x="180" y="105" text-anchor="middle" font-size="12" font-weight="700" fill="#0f766e">Hypotenuse (H)</text>

              <!-- Mnemonic Card -->
              <rect x="20" y="20" width="140" height="55" rx="6" fill="#e0f2fe" stroke="#0284c7"/>
              <text x="90" y="42" text-anchor="middle" font-size="11" font-weight="700" fill="#0369a1">P / H = sin θ</text>
              <text x="90" y="60" text-anchor="middle" font-size="11" font-weight="700" fill="#0369a1">B / H = cos θ | P / B = tan</text>
            </svg>
          </div>
          <p class="visual-caption">Perpendicular is always the side opposite to angle θ; Base is adjacent; Hypotenuse is opposite the 90° angle.</p>
        </div>

        <div class="card visual-card">
          <div class="visual-badge">Visual Diagram 2 · Standard Trigonometric Values Matrix</div>
          <div class="svg-container">
            <svg viewBox="0 0 460 250" xmlns="http://www.w3.org/2000/svg" aria-label="Standard trigonometric angles table">
              <rect width="460" height="250" fill="#f8fafc" rx="8"/>
              
              <!-- Table Headers -->
              <rect x="20" y="20" width="420" height="35" rx="4" fill="#0f766e"/>
              <text x="60" y="42" font-size="11" font-weight="700" fill="#fff" text-anchor="middle">Ratio</text>
              <text x="130" y="42" font-size="11" font-weight="700" fill="#fff" text-anchor="middle">0°</text>
              <text x="200" y="42" font-size="11" font-weight="700" fill="#fff" text-anchor="middle">30°</text>
              <text x="270" y="42" font-size="11" font-weight="700" fill="#fff" text-anchor="middle">45°</text>
              <text x="340" y="42" font-size="11" font-weight="700" fill="#fff" text-anchor="middle">60°</text>
              <text x="405" y="42" font-size="11" font-weight="700" fill="#fff" text-anchor="middle">90°</text>

              <!-- Row 1: sin θ -->
              <rect x="20" y="60" width="420" height="32" fill="#fff" stroke="#e2e8f0"/>
              <text x="60" y="81" font-size="12" font-weight="700" fill="#0f766e" text-anchor="middle">sin θ</text>
              <text x="130" y="81" font-size="11" fill="#1e293b" text-anchor="middle">0</text>
              <text x="200" y="81" font-size="11" fill="#1e293b" text-anchor="middle">1/2</text>
              <text x="270" y="81" font-size="11" fill="#1e293b" text-anchor="middle">1/√2</text>
              <text x="340" y="81" font-size="11" fill="#1e293b" text-anchor="middle">√3/2</text>
              <text x="405" y="81" font-size="11" fill="#1e293b" text-anchor="middle">1</text>

              <!-- Row 2: cos θ -->
              <rect x="20" y="96" width="420" height="32" fill="#f8fafc" stroke="#e2e8f0"/>
              <text x="60" y="117" font-size="12" font-weight="700" fill="#0f766e" text-anchor="middle">cos θ</text>
              <text x="130" y="117" font-size="11" fill="#1e293b" text-anchor="middle">1</text>
              <text x="200" y="117" font-size="11" fill="#1e293b" text-anchor="middle">√3/2</text>
              <text x="270" y="117" font-size="11" fill="#1e293b" text-anchor="middle">1/√2</text>
              <text x="340" y="117" font-size="11" fill="#1e293b" text-anchor="middle">1/2</text>
              <text x="405" y="117" font-size="11" fill="#1e293b" text-anchor="middle">0</text>

              <!-- Row 3: tan θ -->
              <rect x="20" y="132" width="420" height="32" fill="#fff" stroke="#e2e8f0"/>
              <text x="60" y="153" font-size="12" font-weight="700" fill="#0f766e" text-anchor="middle">tan θ</text>
              <text x="130" y="153" font-size="11" fill="#1e293b" text-anchor="middle">0</text>
              <text x="200" y="153" font-size="11" fill="#1e293b" text-anchor="middle">1/√3</text>
              <text x="270" y="153" font-size="11" fill="#1e293b" text-anchor="middle">1</text>
              <text x="340" y="153" font-size="11" fill="#1e293b" text-anchor="middle">√3</text>
              <text x="405" y="153" font-size="10" font-weight="600" fill="#dc2626" text-anchor="middle">ND</text>

              <!-- Identity note below table -->
              <rect x="50" y="180" width="360" height="50" rx="6" fill="#ecfdf5" stroke="#10b981"/>
              <text x="230" y="202" text-anchor="middle" font-size="12" font-weight="700" fill="#065f46">Core Identity: sin²θ + cos²θ = 1</text>
              <text x="230" y="219" text-anchor="middle" font-size="11" fill="#047857">sec²θ - tan²θ = 1 &nbsp;|&nbsp; cosec²θ - cot²θ = 1</text>
            </svg>
          </div>
          <p class="visual-caption">The standard trigonometric values matrix: sin increases from 0 to 1, while cos decreases from 1 to 0.</p>
        </div>
      </div>
    </section>

    <!-- Solved Step-by-Step Problem -->
    <section class="section">
      <h2>Exemplar Board Problem: Proving a Core Trigonometric Identity</h2>
      <div class="card" style="padding:1.75rem; background:var(--paper)">
        <h3 style="color:var(--brand);margin-top:0">Problem: Prove that (sin θ - 2 sin³θ) / (2 cos³θ - cos θ) = tan θ.</h3>
        <div style="font-size:0.95rem; line-height:1.7; color:var(--text)">
          <p><strong>Step 1 (Examine LHS):</strong>
            <br/><code>LHS = (sin θ - 2 sin³θ) / (2 cos³θ - cos θ)</code>
          </p>
          <p><strong>Step 2 (Factor out sin θ from numerator and cos θ from denominator):</strong>
            <br/><code>LHS = [sin θ · (1 - 2 sin²θ)] / [cos θ · (2 cos²θ - 1)]</code>
          </p>
          <p><strong>Step 3 (Recall fundamental identity 1 = sin²θ + cos²θ):</strong>
            <br/>Substitute <code>1 = sin²θ + cos²θ</code> into the numerator's bracket:
            <br/><code>1 - 2 sin²θ = (sin²θ + cos²θ) - 2 sin²θ = cos²θ - sin²θ</code>.
          </p>
          <p><strong>Step 4 (Substitute 1 into the denominator's bracket):</strong>
            <br/><code>2 cos²θ - 1 = 2 cos²θ - (sin²θ + cos²θ) = cos²θ - sin²θ</code>.
          </p>
          <p><strong>Step 5 (Cancel common terms):</strong>
            <br/><code>LHS = [sin θ · (cos²θ - sin²θ)] / [cos θ · (cos²θ - sin²θ)]</code>
            <br/><code>LHS = sin θ / cos θ = tan θ = RHS</code>. [Hence Proved]
          </p>
        </div>
      </div>
    </section>

    <!-- Interactive 20-Question Quiz -->
    <section class="section">
      <h2>Interactive CBSE Board Exam Quiz (20 Questions)</h2>
      <p class="muted">Test your concepts on ratio evaluation, angle tables, reciprocal equations, and Pythagorean identities.</p>

      <div class="quiz-container card" id="quiz-box">
        <div class="quiz-header-bar">
          <span class="quiz-counter" id="quiz-counter">Question 1 of 20</span>
          <span class="quiz-score" id="quiz-score">Score: 0 / 20</span>
        </div>

        <div class="quiz-question-body">
          <p class="quiz-q-text" id="quiz-question">Loading question...</p>
          <div class="quiz-options-list" id="quiz-options"></div>
          <div class="quiz-feedback" id="quiz-feedback"></div>
        </div>

        <div class="quiz-footer-actions">
          <button class="button secondary" id="quiz-prev-btn" disabled>← Previous</button>
          <button class="button" id="quiz-next-btn" disabled>Next Question →</button>
        </div>
      </div>

      <div class="quiz-completed-banner card" id="quiz-result-box" style="display:none; text-align:center; padding:2.5rem;">
        <h3>Quiz Completed! 🎉</h3>
        <p class="quiz-final-score" id="quiz-final-score" style="font-size:1.4rem; font-weight:700; color:var(--brand); margin:1rem 0;"></p>
        <p id="quiz-final-msg" class="muted"></p>
        <button class="button" id="quiz-restart-btn" style="margin-top:1rem;">Retake Quiz</button>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-banner">
      <h2>Need personalized Maths guidance for Class 10?</h2>
      <p>Book a free {provider.trial.duration_minutes}-minute trial session with {provider.tutor_name} (online or at-home) to master trigonometry identities, shortcuts, and board exam proofs.</p>
      <a class="button" href={calBookingUrl} target="_blank" rel="noopener noreferrer">Book Free Trial</a>
    </section>
  </div>
</Layout>

<script is:inline>
(function() {
  const quizData = [
    {
      q: "If cos A = 4/5, then the value of tan A is:",
      options: ["3/5", "3/4", "4/3", "5/3"],
      answer: 1,
      explanation: "In a right triangle with Base = 4 and Hypotenuse = 5, Perpendicular = √(5² - 4²) = 3. Therefore, tan A = P / B = 3/4."
    },
    {
      q: "If sin θ + cos θ = √2 cos θ, then the value of cos θ - sin θ is:",
      options: ["√2 sin θ", "sin θ", "√2 cos θ", "1/√2 sin θ"],
      answer: 0,
      explanation: "Squaring both: (sin θ + cos θ)² = 2 cos²θ ⟹ sin²θ + cos²θ + 2 sin θ cos θ = 2 cos²θ ⟹ 1 + 2 sin θ cos θ = 2 cos²θ. Then (cos θ - sin θ)² = cos²θ + sin²θ - 2 sin θ cos θ = 1 - (2 cos²θ - 1) = 2 - 2 cos²θ = 2(1 - cos²θ) = 2 sin²θ. Taking square root gives √2 sin θ."
    },
    {
      q: "The value of (sin 30° + cos 60°) - (sin 60° + cos 30°) is:",
      options: ["0", "1 - √3", "1 + √3", "1 - √3/2"],
      answer: 1,
      explanation: "(1/2 + 1/2) - (√3/2 + √3/2) = 1 - √3."
    },
    {
      q: "If tan θ = a / b, then (a sin θ - b cos θ) / (a sin θ + b cos θ) equals:",
      options: ["(a² + b²) / (a² - b²)", "(a² - b²) / (a² + b²)", "a² / (a² + b²)", "b² / (a² + b²)"],
      answer: 1,
      explanation: "Divide numerator and denominator by cos θ: (a tan θ - b) / (a tan θ + b) = [a(a/b) - b] / [a(a/b) + b] = (a²/b - b) / (a²/b + b) = (a² - b²) / (a² + b²)."
    },
    {
      q: "The value of (1 + tan²θ)(1 - sin θ)(1 + sin θ) is:",
      options: ["0", "1", "-1", "2"],
      answer: 1,
      explanation: "(1 + tan²θ) = sec²θ. (1 - sin θ)(1 + sin θ) = 1 - sin²θ = cos²θ. sec²θ × cos²θ = 1."
    },
    {
      q: "If 4 tan θ = 3, then (4 sin θ - cos θ) / (4 sin θ + cos θ) is:",
      options: ["2/3", "1/3", "1/2", "3/4"],
      answer: 2,
      explanation: "Divide numerator and denominator by cos θ: (4 tan θ - 1) / (4 tan θ + 1) = (3 - 1) / (3 + 1) = 2/4 = 1/2."
    },
    {
      q: "If sec θ + tan θ = x, then tan θ is:",
      options: ["(x² + 1) / x", "(x² - 1) / x", "(x² - 1) / 2x", "(x² + 1) / 2x"],
      answer: 2,
      explanation: "Since sec²θ - tan²θ = 1, sec θ - tan θ = 1/x. Subtracting (sec θ - tan θ) from (sec θ + tan θ): 2 tan θ = x - 1/x = (x² - 1)/x ⟹ tan θ = (x² - 1)/(2x)."
    },
    {
      q: "What is the maximum value of 1 / cosec θ?",
      options: ["0", "1", "1/2", "2"],
      answer: 1,
      explanation: "1 / cosec θ = sin θ. For acute angles (and all real θ), the maximum value of sin θ is 1 (at 90°)."
    },
    {
      q: "If sin A = 1/2, then the value of cot A is:",
      options: ["√3", "1/√3", "1", "√3/2"],
      answer: 0,
      explanation: "If sin A = 1/2, angle A = 30°. cot 30° = √3."
    },
    {
      q: "The value of (cosec²θ - 1) · sin²θ is:",
      options: ["1", "cos²θ", "tan²θ", "sec²θ"],
      answer: 1,
      explanation: "cosec²θ - 1 = cot²θ. cot²θ × sin²θ = (cos²θ / sin²θ) × sin²θ = cos²θ."
    },
    {
      q: "If √3 tan 2θ - 3 = 0, then θ is:",
      options: ["15°", "30°", "45°", "60°"],
      answer: 1,
      explanation: "√3 tan 2θ = 3 ⟹ tan 2θ = 3 / √3 = √3. tan 60° = √3, so 2θ = 60° ⟹ θ = 30°."
    },
    {
      q: "If sin(A - B) = 1/2 and cos(A + B) = 1/2 (where A > B and 0° < A + B ≤ 90°), then A and B are:",
      options: ["A = 45°, B = 15°", "A = 60°, B = 30°", "A = 30°, B = 15°", "A = 45°, B = 30°"],
      answer: 0,
      explanation: "sin(A - B) = 1/2 ⟹ A - B = 30°. cos(A + B) = 1/2 ⟹ A + B = 60°. Adding: 2A = 90° ⟹ A = 45°. Subtracting: 2B = 30° ⟹ B = 15°."
    },
    {
      q: "If x = a cos θ and y = b sin θ, then b²x² + a²y² equals:",
      options: ["a²b²", "a² + b²", "1", "a/b"],
      answer: 0,
      explanation: "b²(a cos θ)² + a²(b sin θ)² = b²a² cos²θ + a²b² sin²θ = a²b²(cos²θ + sin²θ) = a²b²(1) = a²b²."
    },
    {
      q: "Evaluate: (1 + cot θ - cosec θ)(1 + tan θ + sec θ):",
      options: ["1", "2", "-1", "0"],
      answer: 1,
      explanation: "Convert to sin and cos: (1 + cos/sin - 1/sin)(1 + sin/cos + 1/cos) = [(sin + cos - 1)/sin] × [(cos + sin + 1)/cos] = [((sin + cos)² - 1)] / (sin cos) = (sin² + cos² + 2 sin cos - 1) / (sin cos) = (1 + 2 sin cos - 1) / (sin cos) = 2."
    },
    {
      q: "If tan A + cot A = 2, then the value of tan¹⁰ A + cot¹⁰ A is:",
      options: ["1", "2", "20", "2¹⁰"],
      answer: 1,
      explanation: "tan A + 1/tan A = 2 ⟹ tan² A - 2 tan A + 1 = 0 ⟹ (tan A - 1)² = 0 ⟹ tan A = 1 (A = 45°). cot A = 1. Therefore, 1¹⁰ + 1¹⁰ = 1 + 1 = 2."
    },
    {
      q: "The expression (sec A + tan A)(1 - sin A) simplifies to:",
      options: ["sec A", "sin A", "cosec A", "cos A"],
      answer: 3,
      explanation: "(1/cos A + sin A/cos A)(1 - sin A) = [(1 + sin A)/cos A] (1 - sin A) = (1 - sin²A) / cos A = cos²A / cos A = cos A."
    },
    {
      q: "If sin θ - cos θ = 0, then the value of (sin⁴θ + cos⁴θ) is:",
      options: ["1", "3/4", "1/2", "1/4"],
      answer: 2,
      explanation: "sin θ = cos θ ⟹ tan θ = 1 ⟹ θ = 45°. sin 45° = cos 45° = 1/√2. sin⁴θ + cos⁴θ = (1/√2)⁴ + (1/√2)⁴ = 1/4 + 1/4 = 2/4 = 1/2."
    },
    {
      q: "If cos(α + β) = 0, then sin(α - β) can be reduced to:",
      options: ["cos β", "cos 2β", "sin α", "sin 2α"],
      answer: 1,
      explanation: "cos(α + β) = 0 ⟹ α + β = 90° ⟹ α = 90° - β. Then sin(α - β) = sin(90° - β - β) = sin(90° - 2β) = cos 2β."
    },
    {
      q: "Which of the following is an identity?",
      options: ["sin²θ - cos²θ = 1", "1 + tan²θ = sec²θ", "1 + sec²θ = tan²θ", "sin²θ + sec²θ = 1"],
      answer: 1,
      explanation: "1 + tan²θ = sec²θ is one of the three fundamental Pythagorean trigonometric identities."
    },
    {
      q: "If a cos θ + b sin θ = m and a sin θ - b cos θ = n, then a² + b² is:",
      options: ["m² - n²", "m²n²", "m² + n²", "m + n"],
      answer: 2,
      explanation: "Square and add both equations: m² + n² = (a cos θ + b sin θ)² + (a sin θ - b cos θ)² = a²cos²θ + b²sin²θ + 2ab cos θ sin θ + a²sin²θ + b²cos²θ - 2ab sin θ cos θ = a²(cos²θ + sin²θ) + b²(sin²θ + cos²θ) = a² + b²."
    }
  ];

  let currentIdx = 0;
  let userAnswers = new Array(quizData.length).fill(null);

  const qText = document.getElementById("quiz-question");
  const optionsBox = document.getElementById("quiz-options");
  const feedbackBox = document.getElementById("quiz-feedback");
  const counterBox = document.getElementById("quiz-counter");
  const scoreBox = document.getElementById("quiz-score");
  const prevBtn = document.getElementById("quiz-prev-btn");
  const nextBtn = document.getElementById("quiz-next-btn");
  const quizBox = document.getElementById("quiz-box");
  const resultBox = document.getElementById("quiz-result-box");
  const finalScore = document.getElementById("quiz-final-score");
  const finalMsg = document.getElementById("quiz-final-msg");
  const restartBtn = document.getElementById("quiz-restart-btn");

  function renderQuestion(idx) {
    const item = quizData[idx];
    counterBox.textContent = `Question ${idx + 1} of ${quizData.length}`;
    qText.textContent = item.q;
    optionsBox.innerHTML = "";
    feedbackBox.textContent = "";
    feedbackBox.className = "quiz-feedback";

    const selected = userAnswers[idx];

    item.options.forEach((optText, oIdx) => {
      const btn = document.createElement("button");
      btn.className = "quiz-opt-btn";
      btn.textContent = `${String.fromCharCode(65 + oIdx)}. ${optText}`;

      if (selected !== null) {
        btn.disabled = true;
        if (oIdx === item.answer) {
          btn.classList.add("opt-correct");
        } else if (oIdx === selected) {
          btn.classList.add("opt-wrong");
        }
      } else {
        btn.onclick = () => selectOption(oIdx);
      }

      optionsBox.appendChild(btn);
    });

    if (selected !== null) {
      if (selected === item.answer) {
        feedbackBox.textContent = `✓ Correct! ${item.explanation}`;
        feedbackBox.classList.add("feedback-correct");
      } else {
        feedbackBox.textContent = `✗ Incorrect. Correct answer is option ${String.fromCharCode(65 + item.answer)}. ${item.explanation}`;
        feedbackBox.classList.add("feedback-wrong");
      }
    }

    prevBtn.disabled = idx === 0;
    nextBtn.disabled = selected === null;
    nextBtn.textContent = idx === quizData.length - 1 ? "Finish Quiz →" : "Next Question →";
    updateScoreDisplay();
  }

  function selectOption(oIdx) {
    userAnswers[currentIdx] = oIdx;
    renderQuestion(currentIdx);
  }

  function updateScoreDisplay() {
    let score = 0;
    userAnswers.forEach((ans, i) => {
      if (ans === quizData[i].answer) score++;
    });
    scoreBox.textContent = `Score: ${score} / ${quizData.length}`;
  }

  prevBtn.onclick = () => {
    if (currentIdx > 0) {
      currentIdx--;
      renderQuestion(currentIdx);
    }
  };

  nextBtn.onclick = () => {
    if (currentIdx < quizData.length - 1) {
      currentIdx++;
      renderQuestion(currentIdx);
    } else {
      finishQuiz();
    }
  };

  function finishQuiz() {
    quizBox.style.display = "none";
    resultBox.style.display = "block";
    let score = 0;
    userAnswers.forEach((ans, i) => {
      if (ans === quizData[i].answer) score++;
    });
    finalScore.textContent = `Your Final Score: ${score} / ${quizData.length} (${Math.round((score / quizData.length) * 100)}%)`;
    if (score >= 18) {
      finalMsg.textContent = "Spectacular mastery! You have exceptional command over trigonometric ratios, angle evaluation, and Pythagorean identities.";
    } else if (score >= 14) {
      finalMsg.textContent = "Great job! Review algebraic squaring identities and sin/cos conversions to aim for 100%.";
    } else {
      finalMsg.textContent = "Review the fundamental identities and standard angle chart above, then retry!";
    }
  }

  restartBtn.onclick = () => {
    userAnswers = new Array(quizData.length).fill(null);
    currentIdx = 0;
    resultBox.style.display = "none";
    quizBox.style.display = "block";
    renderQuestion(0);
  };

  renderQuestion(0);
})();
</script>

