            <path d="M 575 106 L 625 106" stroke="#f59e0b" stroke-width="2.5" stroke-dasharray="4 2" />
            <text x="600" y="98" text-anchor="middle" font-family="system-ui" font-weight="700" font-size="10" fill="#b45309">UV Split</text>

            <circle cx="655" cy="106" r="16" fill="#fecaca" stroke="#dc2626" stroke-width="2" />
            <text x="655" y="111" text-anchor="middle" font-family="system-ui" font-weight="700" font-size="12" fill="#7f1d1d">Cl•</text>
            <text x="735" y="111" font-family="system-ui" font-weight="600" font-size="11" fill="#b91c1c">Free Chlorine Radical</text>

            <!-- Catalytic Cycle -->
            <!-- Cl• + O3 -> ClO• + O2 -->
            <path d="M 655 125 L 655 170" stroke="#dc2626" stroke-width="2" />
            <circle cx="600" cy="195" r="18" fill="#86efac" stroke="#16a34a" stroke-width="2" />
            <text x="600" y="200" text-anchor="middle" font-family="system-ui" font-weight="700" font-size="12" fill="#14532d">O₃</text>
            <text x="635" y="200" font-family="system-ui" font-weight="700" font-size="14" fill="#991b1b">+</text>
            <circle cx="670" cy="195" r="15" fill="#fecaca" stroke="#dc2626" stroke-width="2" />
            <text x="670" y="200" text-anchor="middle" font-family="system-ui" font-weight="700" font-size="11" fill="#7f1d1d">Cl•</text>

            <path d="M 695 195 L 725 195" stroke="#dc2626" stroke-width="2" />
            <polygon points="730,195 722,191 722,199" fill="#dc2626" />

            <text x="770" y="190" text-anchor="middle" font-family="system-ui" font-weight="700" font-size="12" fill="#991b1b">ClO• + O₂</text>
            <text x="770" y="206" text-anchor="middle" font-family="system-ui" font-size="10" fill="#b91c1c">(Ozone Destroyed!)</text>

            <!-- Regeneration of Cl• -->
            <path d="M 770 215 C 770 265 670 265 655 135" fill="none" stroke="#b91c1c" stroke-width="2" stroke-dasharray="4 2" />
            <text x="710" y="255" text-anchor="middle" font-family="system-ui" font-weight="700" font-size="10" fill="#7f1d1d">ClO• + O &rarr; Cl• + O₂ (Catalytic Regeneration)</text>

            <rect x="480" y="280" width="350" height="50" rx="6" fill="#ffffff" stroke="#fecaca" />
            <text x="655" y="300" text-anchor="middle" font-family="system-ui" font-weight="700" font-size="11" fill="#991b1b">
              1 Chlorine Radical destroys &gt;100,000 Ozone molecules!
            </text>
            <text x="655" y="318" text-anchor="middle" font-family="system-ui" font-size="10" fill="#7f1d1d">
              Montreal Protocol (1987) froze and phased out CFC propellants
            </text>
          </svg>
