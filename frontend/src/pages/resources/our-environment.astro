            <circle cx="160" cy="220" r="18" fill="#bae6fd" stroke="#0284c7" stroke-width="2" />
            <text x="160" y="225" text-anchor="middle" font-family="system-ui" font-weight="700" font-size="12" fill="#0369a1">O₂</text>

            <text x="215" y="225" text-anchor="middle" font-family="system-ui" font-weight="700" font-size="16" fill="#15803d">+</text>

            <circle cx="270" cy="220" r="13" fill="#fef08a" stroke="#ca8a04" stroke-width="2" />
            <text x="270" y="224" text-anchor="middle" font-family="system-ui" font-weight="700" font-size="11" fill="#854d0e">O</text>

