            <text x="365" y="226" text-anchor="middle" font-family="system-ui" font-weight="700" font-size="14" fill="#14532d">O₃</text>
            <text x="365" y="255" text-anchor="middle" font-family="system-ui" font-weight="600" font-size="11" fill="#15803d">Ozone Shield</text>

            <rect x="50" y="280" width="350" height="50" rx="6" fill="#ffffff" stroke="#bbf7d0" />
