<script is:inline>
  const questions = [
    {
      q: "According to Raymond Lindeman's 10% law of energy transfer, how much energy is transferred from one trophic level to the next higher level?",
      opts: [
        "1%",
        "10%",
        "50%",
        "90%"
      ],
      correct: 1,
      exp: "According to the 10% law (Lindeman, 1942), only about 10% of the energy entering a trophic level is incorporated into new biomass and made available to the next trophic level; 90% is dissipated as metabolic heat and respiration."
    },
    {
      q: "What percentage of the total incident solar energy do green terrestrial plants capture and convert into food energy via photosynthesis?",
      opts: [
        "Approximately 1%",
        "Approximately 10%",
        "Approximately 50%",
        "Nearly 100%"
      ],
      correct: 0,
      exp: "NCERT Biology specifies that terrestrial green plants capture merely about 1% of the total incident solar energy falling upon their leaves and convert it into photochemical energy."
    },
    {
      q: "In an ecosystem consisting of: Grass (10,000 J) → Deer → Tiger, what is the amount of energy available to the Tiger?",
      opts: [
        "1,000 J",
        "100 J",
        "10 J",
        "1 J"
      ],
      correct: 1,
      exp: "Grass = 10,000 J. Deer (10% of 10,000 J) = 1,000 J. Tiger (10% of 1,000 J) = 100 J."
    },
    {
      q: "Why are food chains in nature generally limited to a maximum of 3 or 4 trophic levels?",
      opts: [
        "Apex predators refuse to eat herbivores",
        "The loss of energy at each step is so great that very little usable energy remains after 4 trophic levels",
        "Decomposers eliminate higher trophic levels",
        "Solar radiation decreases at higher elevations"
      ],
      correct: 1,
      exp: "Because 90% of energy is lost as heat/metabolism at every successive trophic level, by the 4th level the remaining energy is too small to support another viable reproductive population."
    },
    {
      q: "Which biological process leads to the progressive accumulation of non-biodegradable pesticides (like DDT) at higher trophic levels?",
      opts: [
        "Biofortification",
        "Eutrophication",
        "Biological Magnification (Biomagnification)",
        "Biodegradation"
      ],
      correct: 2,
      exp: "Biological magnification is the progressive bio-accumulation and increasing concentration of toxic non-biodegradable chemicals at successive trophic levels."
    },
    {
      q: "In a lake ecosystem affected by pesticide runoff containing Phytoplankton → Zooplankton → Small Fish → Fish-eating Bird, which organism will harbor the HIGHEST concentration of pesticide?",
      opts: [
