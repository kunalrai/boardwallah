        "500 J",
        "50 J",
        "5 J"
      ],
      correct: 2,
      exp: "Algae = 50,000 J. Protozoa = 5,000 J (10%). Small Fish = 500 J (10%). Big Fish = 50 J (10%)."
    },
    {
      q: "Why is ozone ($O_3$) considered both a deadly poison and an indispensable protector?",
      opts: [
        "It is toxic when inhaled at ground level (troposphere), yet shields Earth from lethal UV radiation in the stratosphere",
        "It creates oxygen at night but absorbs nitrogen during the day",
        "It fertilizes crops in rain but damages clouds",
        "It cools glaciers while heating ocean floors"
      ],
      correct: 0,
      exp: "At tropospheric ground level, ozone is an aggressive oxidizing pollutant toxic to respiratory tissue, but in the upper stratosphere it forms the vital shield filtering lethal UV radiation."
    }
  ];

  let currentQ = 0;
  const userAnswers = new Array(questions.length).fill(null);

  function renderQuiz() {
    const q = questions[currentQ];
    document.getElementById("quiz-progress").textContent = `Question ${currentQ + 1} of ${questions.length}`;
    document.getElementById("quiz-question").textContent = `${currentQ + 1}. ${q.q}`;

    const optsDiv = document.getElementById("quiz-options");
    optsDiv.innerHTML = "";

    const fbDiv = document.getElementById("quiz-feedback");
    fbDiv.style.display = "none";
    fbDiv.className = "quiz-feedback";

    const answered = userAnswers[currentQ] !== null;

    q.opts.forEach((opt, idx) => {
      const btn = document.createElement("button");
      btn.className = "quiz-option";
      btn.textContent = opt;

      if (answered) {
        btn.disabled = true;
        if (idx === q.correct) {
          btn.classList.add("opt-correct");
        }
        if (userAnswers[currentQ] === idx && idx !== q.correct) {
          btn.classList.add("opt-wrong");
        }
      } else {
        btn.onclick = () => selectOption(idx);
      }
      optsDiv.appendChild(btn);
    });

    if (answered) {
      fbDiv.style.display = "block";
      const isCorrect = userAnswers[currentQ] === q.correct;
      fbDiv.className = `quiz-feedback ${isCorrect ? 'feedback-correct' : 'feedback-wrong'}`;
      fbDiv.innerHTML = `<strong>${isCorrect ? '✓ Correct!' : '✗ Incorrect.'}</strong> ${q.exp}`;
    }

    document.getElementById("prev-btn").disabled = currentQ === 0;
    const nextBtn = document.getElementById("next-btn");
    nextBtn.textContent = currentQ === questions.length - 1 ? "Finish" : "Next →";

    updateScore();
  }

  function selectOption(idx) {
    userAnswers[currentQ] = idx;
    renderQuiz();
  }

  function updateScore() {
    let score = 0;
    userAnswers.forEach((ans, idx) => {
      if (ans === questions[idx].correct) score++;
    });
    document.getElementById("quiz-score").textContent = `Score: ${score} / ${questions.length}`;
  }

  document.getElementById("prev-btn").addEventListener("click", () => {
    if (currentQ > 0) {
      currentQ--;
      renderQuiz();
    }
  });

  document.getElementById("next-btn").addEventListener("click", () => {
    if (currentQ < questions.length - 1) {
      currentQ++;
      renderQuiz();
    }
  });

  renderQuiz();
</script>

