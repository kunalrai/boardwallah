    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .rule-body h4 {
    margin: 0;
    font-size: 1.05rem;
    color: var(--ink);
  }

  .rule-body p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .rule-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 0.4rem;
    padding-top: 0.6rem;
