---
import Layout from "../../layouts/Layout.astro";
import { loadContent } from "../../lib/content";
import { calBookingUrl } from "../../lib/site";

const { provider } = loadContent();
---

<Layout
  title={`Endless Board Exam Practice Arena | Unlimited Class 10 Maths & Science Questions | ${provider.name}`}
  description="Practice unlimited, dynamically generated CBSE Class 10 Maths & Science questions with randomized parameters, guaranteed mathematical accuracy, step-by-step marking rubrics, and in-browser AI generation."
>
  <div class="wrap">
    <nav class="small" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/subjects/">Subjects</a> / <a href="/resources/">Resources</a> / Practice Arena
    </nav>

    <div class="resource-header">
      <span class="eyebrow arena-eyebrow">⚡ Endless Question Generator · 100% Free</span>
      <h1>Unlimited CBSE Class 10 Maths &amp; Science Practice Arena</h1>
      <p class="lead">
        Never run out of questions. Every click algorithmically generates fresh numericals and conceptual problems with randomized parameters, zero hallucinations, step-by-step marking rubrics, and optional in-browser WebLLM generation.
      </p>
    </div>

    <!-- Arena Stats & Streak Bar -->
    <div class="card arena-dashboard-bar">
      <div class="stats-group">
        <div class="stat-pill">
          <span class="stat-icon">🔥</span>
          <span class="stat-label">Streak:</span>
          <strong id="streak-counter" class="stat-value">0</strong>
        </div>
        <div class="stat-pill">
          <span class="stat-icon">🏆</span>
          <span class="stat-label">Best Streak:</span>
          <strong id="best-streak" class="stat-value">0</strong>
        </div>
        <div class="stat-pill">
          <span class="stat-icon">🎯</span>
          <span class="stat-label">Solved:</span>
          <strong id="total-solved" class="stat-value">0</strong>
        </div>
        <div class="stat-pill">
          <span class="stat-icon">📊</span>
          <span class="stat-label">Accuracy:</span>
          <strong id="accuracy-rate" class="stat-value">100%</strong>
        </div>
      </div>
      <div class="engine-switch-wrap">
        <span class="engine-label">Generator Engine:</span>
        <div class="engine-toggle-pills" role="radiogroup">
          <button id="engine-algorithmic" class="engine-pill active" data-engine="algorithmic" type="button">
            ⚡ Parametric (Instant &amp; Infinite)
          </button>
          <button id="engine-webllm" class="engine-pill" data-engine="webllm" type="button" title="Use in-browser WebGPU AI for conceptual generation">
            🧠 In-Browser AI (WebLLM)
          </button>
        </div>
      </div>
    </div>

    <!-- Subject & Topic Filter Bar -->
    <div class="card filters-container">
      <div class="subject-pills-row" role="radiogroup" aria-label="Select Subject">
        <button class="filter-pill active" data-subject="all" type="button">
          📚 All Subjects
        </button>
        <button class="filter-pill" data-subject="maths" type="button">
          📐 Mathematics (Numericals &amp; Proofs)
        </button>
        <button class="filter-pill" data-subject="science" type="button">
          🔬 Science (Physics, Chem, Biology)
        </button>
      </div>

      <div class="topic-select-row">
        <label for="topic-dropdown">Target Topic:</label>
        <select id="topic-dropdown" class="topic-select">
          <option value="all">🎲 Random / Mixed Topics</option>
          <optgroup label="Mathematics">
            <option value="maths_quadratic">Quadratic Equations (Roots &amp; Discriminant)</option>
            <option value="maths_ap">Arithmetic Progressions (nth Term &amp; Sum)</option>
            <option value="maths_optics_trig">Trigonometry &amp; Standard Values</option>
            <option value="maths_coordinate">Coordinate Geometry (Distance &amp; Midpoint)</option>
            <option value="maths_real_numbers">Real Numbers (HCF &amp; LCM Formula)</option>
            <option value="maths_circles">Areas Related to Circles (Sectors &amp; Arcs)</option>
            <option value="maths_statistics">Statistics (Mean, Median, Mode Empirical Rule)</option>
            <option value="maths_probability">Probability (Dice, Cards &amp; Tosses)</option>
          </optgroup>
          <optgroup label="Science">
            <option value="sci_optics">Light: Mirror &amp; Lens Formulas</option>
            <option value="sci_circuits">Electricity: Ohm's Law &amp; Circuit Resistors</option>
            <option value="sci_chemical_reactions">Chemical Reactions &amp; Stoichiometry</option>
            <option value="sci_acids">Acids, Bases &amp; pH Indicators</option>
            <option value="sci_life_processes">Life Processes: Enzymes &amp; Circulation</option>
            <option value="sci_genetics">Heredity: Mendelian Monohybrid Ratios</option>
            <option value="sci_environment">Our Environment: 10% Trophic Energy Law</option>
          </optgroup>
        </select>
        <button id="generate-new-btn" class="button generate-btn" type="button">
          <span>✨ Generate New Problem</span>
        </button>
      </div>
    </div>

    <!-- Active Question Card Arena -->
    <div class="arena-card-wrap">
      <article class="card question-arena-card" id="question-card">
        <div class="q-meta-header">
          <div class="q-tags-left">
            <span class="q-badge" id="q-subject-badge">Mathematics</span>
            <span class="q-topic-tag" id="q-topic-tag">Quadratic Equations</span>
          </div>
          <div class="q-marks-pill">
            <span class="marks-text">CBSE Board Exam Format · 1-2 Marks</span>
          </div>
        </div>

        <div class="q-statement">
          <h2 id="q-title">Loading Question...</h2>
        </div>

        <!-- Multiple Choice Options Grid -->
        <div class="options-grid" id="options-grid">
          <!-- Dynamic Buttons injected here -->
        </div>

        <!-- Instant CBSE Step-by-Step Marking Explanation Box -->
        <div class="solution-card" id="solution-box" style="display: none;">
          <div class="solution-header">
            <span class="sol-badge" id="sol-badge">✅ Correct! Step-by-Step Solution</span>
          </div>
          <div class="solution-content" id="solution-content">
            <!-- Dynamic explanation text -->
          </div>
          <div class="next-action-row">
            <button id="next-question-btn" class="button next-btn" type="button">
              Next Question &rarr;
            </button>
          </div>
        </div>
      </article>
    </div>

    <!-- Educational Footer Callout -->
    <div class="study-hub-callout card">
      <div class="hub-callout-content">
        <div class="hub-text">
          <h3>Targeting 95%+ in Class 10 Boards?</h3>
          <p>
            Learn step-by-step problem-solving methods directly with Kunal Rai. Book a free 1-on-1 trial slot online or as a home visit in Gaur City.
          </p>
        </div>
        <div class="hub-links">
          <a href="/resources/sample-papers/" class="button secondary">Full 80-Mark Mock Papers</a>
          <a href="/resources/flashcards/" class="button secondary">80 Flashcards</a>
          <a href={calBookingUrl} target="_blank" rel="noopener noreferrer" class="button">Book Free Trial</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  (function() {
    // ── Local Storage State ──
    const STORAGE_KEY = "boardwallah_arena_stats_v1";
    let stats = {
      streak: 0,
      bestStreak: 0,
      solved: 0,
      correct: 0,
    };

    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        stats = Object.assign(stats, JSON.parse(saved));
      }
    } catch(e) {}

    // ── DOM References ──
    const streakCounter = document.getElementById("streak-counter");
    const bestStreakEl = document.getElementById("best-streak");
    const totalSolvedEl = document.getElementById("total-solved");
    const accuracyRateEl = document.getElementById("accuracy-rate");
    const subjectPills = document.querySelectorAll(".filter-pill");
    const topicDropdown = document.getElementById("topic-dropdown");
    const generateNewBtn = document.getElementById("generate-new-btn");
    const qSubjectBadge = document.getElementById("q-subject-badge");
    const qTopicTag = document.getElementById("q-topic-tag");
    const qTitle = document.getElementById("q-title");
    const optionsGrid = document.getElementById("options-grid");
    const solutionBox = document.getElementById("solution-box");
    const solBadge = document.getElementById("sol-badge");
    const solutionContent = document.getElementById("solution-content");
    const nextQuestionBtn = document.getElementById("next-question-btn");
    const engineAlgorithmicBtn = document.getElementById("engine-algorithmic");
    const engineWebllmBtn = document.getElementById("engine-webllm");

    let currentSubject = "all";
    let currentTopic = "all";
    let activeEngine = "algorithmic";
    let currentQuestion = null;
    let isAnswered = false;

    function saveStats() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(stats));
      } catch(e) {}
      updateStatsUI();
    }

    function updateStatsUI() {
      if (streakCounter) streakCounter.textContent = stats.streak;
      if (bestStreakEl) bestStreakEl.textContent = stats.bestStreak;
      if (totalSolvedEl) totalSolvedEl.textContent = stats.solved;
      if (accuracyRateEl) {
        const rate = stats.solved > 0 ? Math.round((stats.correct / stats.solved) * 100) : 100;
        accuracyRateEl.textContent = `${rate}%`;
      }
    }

    // Helper: Shuffle Array
    function shuffle(arr) {
      const copy = arr.slice();
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        const temp = copy[i];
        copy[i] = copy[j];
        copy[j] = temp;
      }
      return copy;
    }

    // ── PARAMETRIC GENERATORS (100% Accurate & Infinite) ──

    // 1. Quadratic Equations
    function genQuadratic() {
      const r1 = (Math.floor(Math.random() * 8) + 1) * (Math.random() > 0.5 ? 1 : -1);
      let r2 = (Math.floor(Math.random() * 8) + 1) * (Math.random() > 0.5 ? 1 : -1);
      if (r1 === r2) r2 += 1;

      const b = -(r1 + r2);
      const c = r1 * r2;
      const bText = b === 0 ? "" : (b > 0 ? `+ ${b === 1 ? "" : b}x` : `- ${Math.abs(b) === 1 ? "" : Math.abs(b)}x`);
      const cText = c === 0 ? "" : (c > 0 ? `+ ${c}` : `- ${Math.abs(c)}`);

      const question = `Find the roots of the quadratic equation: x² ${bText} ${cText} = 0`;
      const correct = `x = ${r1}, x = ${r2}`;
      const distractors = [
        `x = ${-r1}, x = ${-r2}`,
        `x = ${r1 + 1}, x = ${r2 - 1}`,
        `x = ${r1 * 2}, x = ${r2}`,
      ];

      return {
        subject: "Mathematics",
        topic: "Quadratic Equations",
        question: question,
        options: shuffle([correct, ...distractors]),
        correctAnswer: correct,
        explanation: `<strong>CBSE Marking Rubric:</strong><br/>
1. Given equation: x² ${bText} ${cText} = 0.<br/>
2. Factorization: (x - (${r1}))(x - (${r2})) = 0.<br/>
3. Equating each factor to zero gives <strong>x = ${r1}</strong> and <strong>x = ${r2}</strong>.`
      };
    }

    // 2. Arithmetic Progressions
    function genAP() {
      const a = Math.floor(Math.random() * 15) + 2;
      const d = (Math.floor(Math.random() * 6) + 2) * (Math.random() > 0.4 ? 1 : -1);
      const n = Math.floor(Math.random() * 12) + 6;
      const an = a + (n - 1) * d;

      const question = `In an Arithmetic Progression with first term a = ${a} and common difference d = ${d}, find the ${n}th term (a<sub>${n}</sub>).`;
      const correct = `${an}`;
      const distractors = [
        `${an + d}`,
        `${an - d}`,
        `${a + n * d}`,
      ];

      return {
        subject: "Mathematics",
        topic: "Arithmetic Progressions",
        question: question,
        options: shuffle([correct, ...distractors]),
        correctAnswer: correct,
        explanation: `<strong>CBSE Marking Rubric:</strong><br/>
1. Standard Formula: a<sub>n</sub> = a + (n - 1)d.<br/>
2. Substituting values: a<sub>${n}</sub> = ${a} + (${n} - 1) × (${d}).<br/>
3. a<sub>${n}</sub> = ${a} + ${n - 1} × (${d}) = <strong>${an}</strong>.`
      };
    }

    // 3. Trigonometry
    function genTrig() {
      const angles = [
        { name: "sin² 30° + cos² 30°", ans: "1", exp: "By standard fundamental trigonometric identity: sin² θ + cos² θ = 1 for any angle θ." },
        { name: "2 tan 45° + cos 60° - sin 30°", ans: "2", exp: "Substituting values: 2(1) + (1/2) - (1/2) = 2." },
        { name: "(sin 30° × cos 60°) + (cos 30° × sin 60°)", ans: "1", exp: "sin(30° + 60°) = sin 90° = 1. Or (1/2 × 1/2) + (√3/2 × √3/2) = 1/4 + 3/4 = 1." },
        { name: "sec² 45° - tan² 45°", ans: "1", exp: "(√2)² - (1)² = 2 - 1 = 1. Consistent with identity 1 + tan² θ = sec² θ." },
        { name: "sin 60° / cos 30°", ans: "1", exp: "sin 60° = √3/2 and cos 30° = √3/2. Ratio = 1." },
      ];
      const item = angles[Math.floor(Math.random() * angles.length)];
      const distractors = ["0", "1/2", "√3/2", "2"].filter(x => x !== item.ans).slice(0, 3);

      return {
        subject: "Mathematics",
        topic: "Introduction to Trigonometry",
        question: `Evaluate the numerical value of: ${item.name}`,
        options: shuffle([item.ans, ...distractors]),
        correctAnswer: item.ans,
        explanation: `<strong>CBSE Marking Rubric:</strong><br/>${item.exp}`
      };
    }

    // 4. Real Numbers (HCF / LCM)
    function genRealNumbers() {
      const pairs = [
        { a: 12, b: 18, hcf: 6, lcm: 36 },
        { a: 15, b: 25, hcf: 5, lcm: 75 },
        { a: 24, b: 36, hcf: 12, lcm: 72 },
        { a: 18, b: 45, hcf: 9, lcm: 90 },
        { a: 16, b: 28, hcf: 4, lcm: 112 },
        { a: 20, b: 35, hcf: 5, lcm: 140 },
      ];
      const p = pairs[Math.floor(Math.random() * pairs.length)];
      const question = `If HCF(${p.a}, ${p.b}) = ${p.hcf}, find LCM(${p.a}, ${p.b}) using the Fundamental Theorem of Arithmetic relation.`;
      const correct = `${p.lcm}`;
      const distractors = [`${p.lcm + p.hcf}`, `${p.lcm - p.hcf}`, `${p.a * p.b}`];

      return {
        subject: "Mathematics",
        topic: "Real Numbers",
        question: question,
        options: shuffle([correct, ...distractors]),
        correctAnswer: correct,
        explanation: `<strong>CBSE Marking Rubric:</strong><br/>
1. Fundamental Formula: HCF(a, b) × LCM(a, b) = a × b.<br/>
2. Substituting: ${p.hcf} × LCM = ${p.a} × ${p.b} = ${p.a * p.b}.<br/>
3. LCM = ${p.a * p.b} / ${p.hcf} = <strong>${p.lcm}</strong>.`
      };
    }

    // 5. Coordinate Geometry
    function genCoordinate() {
      const triples = [
        { x1: 0, y1: 0, x2: 3, y2: 4, dist: 5 },
        { x1: 1, y1: 2, x2: 4, y2: 6, dist: 5 },
        { x1: 0, y1: 0, x2: 6, y2: 8, dist: 10 },
        { x1: 2, y1: 3, x2: 7, y2: 15, dist: 13 },
        { x1: -1, y1: -2, x2: 2, y2: 2, dist: 5 },
      ];
      const t = triples[Math.floor(Math.random() * triples.length)];
      const question = `Find the distance between the two points A(${t.x1}, ${t.y1}) and B(${t.x2}, ${t.y2}).`;
      const correct = `${t.dist} units`;
      const distractors = [`${t.dist + 2} units`, `${t.dist - 1} units`, `${Math.pow(t.dist, 2)} units`];

      return {
        subject: "Mathematics",
        topic: "Coordinate Geometry",
        question: question,
        options: shuffle([correct, ...distractors]),
        correctAnswer: correct,
        explanation: `<strong>CBSE Marking Rubric:</strong><br/>
1. Distance formula: d = √[(x₂ - x₁)² + (y₂ - y₁)²].<br/>
2. d = √[(${t.x2} - ${t.x1})² + (${t.y2} - ${t.y1})²].<br/>
3. d = √[${Math.pow(t.x2 - t.x1, 2)} + ${Math.pow(t.y2 - t.y1, 2)}] = √${Math.pow(t.dist, 2)} = <strong>${t.dist} units</strong>.`
      };
    }

    // 6. Areas Related to Circles
    function genCircles() {
      const sectors = [
        { r: 7, theta: 60, area: "25.67", formula: "(60/360) × (22/7) × 7 × 7 = 77/3 ≈ 25.67 cm²" },
        { r: 7, theta: 90, area: "38.5", formula: "(90/360) × (22/7) × 7 × 7 = 77/2 = 38.5 cm²" },
        { r: 14, theta: 45, area: "77", formula: "(45/360) × (22/7) × 14 × 14 = (1/8) × 616 = 77 cm²" },
        { r: 14, theta: 90, area: "154", formula: "(90/360) × (22/7) × 14 × 14 = (1/4) × 616 = 154 cm²" },
        { r: 21, theta: 60, area: "231", formula: "(60/360) × (22/7) × 21 × 21 = (1/6) × 1386 = 231 cm²" },
      ];
      const s = sectors[Math.floor(Math.random() * sectors.length)];
      const question = `Find the area of a sector of a circle of radius r = ${s.r} cm with a central angle θ = ${s.theta}° (Take π = 22/7).`;
      const correct = `${s.area} cm²`;
      const distractors = [`${parseFloat(s.area) * 2} cm²`, `${(parseFloat(s.area) + 12).toFixed(1)} cm²`, `${(parseFloat(s.area) / 2).toFixed(1)} cm²`];

      return {
        subject: "Mathematics",
        topic: "Areas Related to Circles",
        question: question,
        options: shuffle([correct, ...distractors]),
        correctAnswer: correct,
        explanation: `<strong>CBSE Marking Rubric:</strong><br/>
1. Sector Area Formula: Area = (θ / 360°) × πr².<br/>
2. Substituting: Area = (${s.theta}/360) × (22/7) × (${s.r})².<br/>
3. Calculation: <strong>${s.formula}</strong>.`
      };
    }

    // 7. Statistics Empirical Formula
    function genStatistics() {
      const samples = [
        { mean: 20, median: 22, mode: 26 },
        { mean: 30, median: 32, mode: 36 },
        { mean: 15, median: 18, mode: 24 },
        { mean: 25, median: 24, mode: 22 },
      ];
      const sm = samples[Math.floor(Math.random() * samples.length)];
      const question = `If the Mean of a frequency distribution is ${sm.mean} and the Median is ${sm.median}, find its Mode using the empirical relationship.`;
      const correct = `${sm.mode}`;
      const distractors = [`${sm.mode + 4}`, `${sm.mode - 3}`, `${sm.mean + sm.median}`];

      return {
        subject: "Mathematics",
        topic: "Statistics",
        question: question,
        options: shuffle([correct, ...distractors]),
        correctAnswer: correct,
        explanation: `<strong>CBSE Marking Rubric:</strong><br/>
1. Empirical Relationship: 3 Median = Mode + 2 Mean.<br/>
2. Mode = 3 Median - 2 Mean.<br/>
3. Mode = 3(${sm.median}) - 2(${sm.mean}) = ${3 * sm.median} - ${2 * sm.mean} = <strong>${sm.mode}</strong>.`
      };
    }

    // 8. Probability
    function genProbability() {
      const probs = [
        { q: "A card is drawn from a well-shuffled pack of 52 playing cards. What is the probability of getting a Red Face Card?", ans: "3/26", exp: "Total cards = 52. Red face cards = 2 Kings + 2 Queens + 2 Jacks = 6 cards. P = 6/52 = 3/26." },
        { q: "Two unbiased dice are rolled simultaneously. What is the probability of getting a sum of 10?", ans: "1/12", exp: "Total outcomes = 36. Favourable outcomes = (4,6), (5,5), (6,4) = 3. P = 3/36 = 1/12." },
        { q: "A card is drawn from a 52-card deck. What is the probability that it is an Ace?", ans: "1/13", exp: "Total cards = 52. Aces = 4. P = 4/52 = 1/13." },
        { q: "Three fair coins are tossed together. What is the probability of getting at least two heads?", ans: "1/2", exp: "Total outcomes = 8. Favourable (HHH, HHT, HTH, THH) = 4. P = 4/8 = 1/2." },
      ];
      const p = probs[Math.floor(Math.random() * probs.length)];
      const distractors = ["1/4", "3/13", "1/6", "5/36"].filter(x => x !== p.ans).slice(0, 3);

      return {
        subject: "Mathematics",
        topic: "Probability",
        question: p.q,
        options: shuffle([p.ans, ...distractors]),
        correctAnswer: p.ans,
        explanation: `<strong>CBSE Marking Rubric:</strong><br/>${p.exp}`
      };
    }

    // 9. Science: Light (Optics Lens & Mirror)
    function genOptics() {
      const optics = [
        {
          q: "A concave mirror has a focal length of 15 cm. An object is placed 30 cm in front of it. Find the image distance (v) and nature.",
          ans: "v = -30 cm (Real, inverted, same size)",
          exp: "u = -30 cm, f = -15 cm. Since object is at C (2f), image is formed at C. 1/v = 1/f - 1/u = -1/15 - (-1/30) = -1/30 ⇒ v = -30 cm. Real and inverted."
        },
        {
          q: "A convex lens has a focal length of +20 cm. What is the Power of this lens in Dioptres?",
          ans: "+5 D",
          exp: "f = +20 cm = +0.2 m. Power P = 1 / f(in metres) = 1 / 0.2 = +5 Dioptres (D)."
        },
        {
          q: "A concave lens has a focal length of 50 cm. What is its Power in Dioptres?",
          ans: "-2 D",
          exp: "For a concave (diverging) lens, f is negative. f = -50 cm = -0.5 m. Power P = 1 / (-0.5) = -2 D."
        },
        {
          q: "An object is placed between the Focus (F) and Pole (P) of a concave mirror. What is the nature of the image formed?",
          ans: "Virtual, erect and enlarged",
          exp: "This is the only case where a concave mirror forms a virtual and erect image (behind the mirror). Used in shaving and dentist mirrors."
        }
      ];
      const item = optics[Math.floor(Math.random() * optics.length)];
      const distractors = [
        "v = +30 cm (Virtual, erect)",
        "+2 D",
        "-5 D",
        "Real, inverted and diminished"
      ].filter(x => x !== item.ans).slice(0, 3);

      return {
        subject: "Science",
        topic: "Light: Reflection & Refraction",
        question: item.q,
        options: shuffle([item.ans, ...distractors]),
        correctAnswer: item.ans,
        explanation: `<strong>CBSE Marking Rubric:</strong><br/>${item.exp}`
      };
    }

    // 10. Science: Electricity (Ohm's law & circuits)
    function genCircuits() {
      const circuits = [
        {
          q: "Three resistors of 2 Ω, 3 Ω, and 6 Ω are connected in parallel. What is the equivalent resistance of the combination?",
          ans: "1 Ω",
          exp: "1/R_p = 1/2 + 1/3 + 1/6 = (3 + 2 + 1)/6 = 6/6 = 1 ⇒ R_p = 1 Ω."
        },
        {
          q: "An electric heater rated 1000 W is operated for 2 hours daily. How many units of electrical energy (kWh) does it consume in 30 days?",
          ans: "60 kWh (Units)",
          exp: "Power P = 1000 W = 1 kW. Energy per day = 1 kW × 2 h = 2 kWh. Energy in 30 days = 2 × 30 = 60 kWh."
        },
        {
          q: "A wire of resistance R is stretched such that its length is doubled while mass remains constant. What is the new resistance?",
          ans: "4R",
          exp: "When length doubles (l' = 2l), cross-sectional area halves (A' = A/2) because volume is conserved. R' = ρ(2l)/(A/2) = 4(ρl/A) = 4R."
        },
        {
          q: "A current of 0.5 A flows through a conductor of resistance 20 Ω for 2 minutes. Calculate the heat produced (H = I²Rt).",
          ans: "600 J",
          exp: "I = 0.5 A, R = 20 Ω, t = 2 min = 120 s. H = (0.5)² × 20 × 120 = 0.25 × 20 × 120 = 5 × 120 = 600 Joules."
        }
      ];
      const item = circuits[Math.floor(Math.random() * circuits.length)];
      const distractors = ["2 Ω", "11 Ω", "2R", "1200 J"].filter(x => x !== item.ans).slice(0, 3);

      return {
        subject: "Science",
        topic: "Electricity",
        question: item.q,
        options: shuffle([item.ans, ...distractors]),
        correctAnswer: item.ans,
        explanation: `<strong>CBSE Marking Rubric:</strong><br/>${item.exp}`
      };
    }

    // 11. Science: Chemical Reactions
    function genChemicalReactions() {
      const reactions = [
        {
          q: "When green crystals of Ferrous Sulphate (FeSO₄·7H₂O) are heated strongly in a dry boiling tube, what are the characteristic observation and products?",
          ans: "Green color turns reddish-brown Fe₂O₃ with burning sulphur smell (SO₂ + SO₃)",
          exp: "2FeSO₄(s) --Δ--> Fe₂O₃(s) + SO₂(g) + SO₃(g). Fe₂O₃ is reddish-brown solid; SO₂ and SO₃ are suffocating toxic gases with burning sulphur odour."
        },
        {
          q: "What type of reaction occurs when Quicklime (CaO) reacts vigorously with water?",
          ans: "Combination & Exothermic reaction",
          exp: "CaO(s) + H₂O(l) → Ca(OH)₂(aq) + Heat. Two reactants combine to form single product (Combination) with large heat evolution (Exothermic)."
        },
        {
          q: "In the balanced chemical equation a Fe + b H₂O → c Fe₃O₄ + d H₂, what are the stoichiometric coefficients a, b, c, d?",
          ans: "a = 3, b = 4, c = 1, d = 4",
          exp: "Balanced equation: 3Fe + 4H₂O → Fe₃O₄ + 4H₂. Left: 3 Fe, 8 H, 4 O. Right: 3 Fe, 8 H, 4 O."
        },
        {
          q: "Identify the substance oxidized and reduced in: CuO + H₂ → Cu + H₂O.",
          ans: "H₂ is oxidized, CuO is reduced",
          exp: "CuO loses oxygen to form Cu (Reduction). H₂ gains oxygen to form H₂O (Oxidation). It is a Redox reaction."
        }
      ];
      const item = reactions[Math.floor(Math.random() * reactions.length)];
      const distractors = [
        "Turns blue with oxygen gas release",
        "Endothermic decomposition reaction",
        "a = 2, b = 3, c = 1, d = 3",
        "CuO is oxidized, H₂ is reduced"
      ].filter(x => x !== item.ans).slice(0, 3);

      return {
        subject: "Science",
        topic: "Chemical Reactions & Equations",
        question: item.q,
        options: shuffle([item.ans, ...distractors]),
        correctAnswer: item.ans,
        explanation: `<strong>CBSE Marking Rubric:</strong><br/>${item.exp}`
      };
    }

    // 12. Science: Life Processes
    function genLifeProcesses() {
      const life = [
        {
          q: "Which enzyme present in saliva breaks down complex starch molecules into maltose sugar in the mouth?",
          ans: "Salivary Amylase (Ptyalin)",
          exp: "Salivary amylase hydrolyzes starch into maltose at optimal pH 6.8. Digestion of carbohydrates begins in the mouth cavity."
        },
        {
          q: "During vigorous sprint exercise, why do muscle cells experience severe cramps?",
          ans: "Anaerobic breakdown of pyruvate into Lactic Acid due to lack of oxygen",
          exp: "In lack of oxygen in human muscle cells: Pyruvate (3C) → Lactic acid (3C) + Energy. Accumulation of lactic acid causes muscle cramps."
        },
        {
          q: "Which blood vessel carries oxygenated blood from the lungs back to the left atrium of the heart?",
          ans: "Pulmonary Vein",
          exp: "All veins carry deoxygenated blood EXCEPT the Pulmonary Vein, which carries freshly oxygenated blood from the lungs into the left atrium."
        },
        {
          q: "What is the structural and functional filtration unit of the human kidney?",
          ans: "Nephron",
          exp: "Each human kidney contains approximately 1 million nephrons composed of Bowman's capsule, glomerulus, and renal tubules for selective reabsorption."
        }
      ];
      const item = life[Math.floor(Math.random() * life.length)];
      const distractors = [
        "Pepsin",
        "Aerobic production of ethanol and CO₂",
        "Pulmonary Artery",
        "Alveoli"
      ].filter(x => x !== item.ans).slice(0, 3);

      return {
        subject: "Science",
        topic: "Life Processes",
        question: item.q,
        options: shuffle([item.ans, ...distractors]),
        correctAnswer: item.ans,
        explanation: `<strong>CBSE Marking Rubric:</strong><br/>${item.exp}`
      };
    }

    // 13. Science: Heredity (Mendelian Genetics)
    function genGenetics() {
      const genetics = [
        {
          q: "In a Mendelian monohybrid cross between a pure tall pea plant (TT) and a pure dwarf plant (tt), what is the phenotypic ratio in the F₂ generation?",
          ans: "3 Tall : 1 Dwarf (3:1)",
          exp: "F₁ generation is all hybrid tall (Tt). Self-pollinating F₁ produces F₂: 1 TT (pure tall) : 2 Tt (hybrid tall) : 1 tt (dwarf). Phenotypic ratio = 3:1."
        },
        {
          q: "What is the genotypic ratio in the F₂ generation of a Mendelian monohybrid cross?",
          ans: "1 TT : 2 Tt : 1 tt (1:2:1)",
          exp: "Genotypic breakdown: 1 Homozygous dominant (TT) : 2 Heterozygous dominant (Tt) : 1 Homozygous recessive (tt)."
        },
        {
          q: "A human sperm cell contains which sex chromosome?",
          ans: "Either an X or a Y chromosome (50% probability each)",
          exp: "Human males are heterogametic (XY). Sperms are either 22+X or 22+Y. Female ova always carry 22+X. Hence father determines the child's biological sex."
        }
      ];
      const item = genetics[Math.floor(Math.random() * genetics.length)];
      const distractors = ["9:3:3:1", "1:1:1:1", "Always a Y chromosome"].filter(x => x !== item.ans).slice(0, 3);

      return {
        subject: "Science",
        topic: "Heredity",
        question: item.q,
        options: shuffle([item.ans, ...distractors]),
        correctAnswer: item.ans,
        explanation: `<strong>CBSE Marking Rubric:</strong><br/>${item.exp}`
      };
    }

    // 14. Science: Our Environment (10% Law)
    function genEnvironment() {
      const energies = [
        { grass: 20000, deer: 2000, tiger: 200 },
        { grass: 10000, deer: 1000, tiger: 100 },
        { grass: 50000, deer: 5000, tiger: 500 },
        { grass: 30000, deer: 3000, tiger: 300 },
      ];
      const en = energies[Math.floor(Math.random() * energies.length)];
      const question = `According to Lindeman's 10% Law, if ${en.grass} Joules of energy is trapped by producers (green plants) in a forest ecosystem, how much energy is transferred to the top carnivore (Tiger) in the food chain: Grass → Deer → Tiger?`;
      const correct = `${en.tiger} Joules`;
      const distractors = [`${en.deer} Joules`, `${en.tiger / 10} Joules`, `${en.grass / 2} Joules`];

      return {
        subject: "Science",
        topic: "Our Environment",
        question: question,
        options: shuffle([correct, ...distractors]),
        correctAnswer: correct,
        explanation: `<strong>CBSE Marking Rubric:</strong><br/>
1. 10% Law statement: Only 10% of energy entering a trophic level is transferred to the next trophic level; 90% is lost as metabolic heat.<br/>
2. First trophic level (Grass): ${en.grass} J.<br/>
3. Second trophic level (Deer): 10% of ${en.grass} = ${en.deer} J.<br/>
4. Third trophic level (Tiger): 10% of ${en.deer} = <strong>${en.tiger} J</strong>.`
      };
    }

    // Master Dispatcher
    const mathsGenerators = [genQuadratic, genAP, genTrig, genRealNumbers, genCoordinate, genCircles, genStatistics, genProbability];
    const scienceGenerators = [genOptics, genCircuits, genChemicalReactions, genLifeProcesses, genGenetics, genEnvironment];

    function generateQuestion() {
      isAnswered = false;
      if (solutionBox) solutionBox.style.display = "none";

      const topic = topicDropdown ? topicDropdown.value : "all";
      let q = null;

      if (topic === "maths_quadratic") q = genQuadratic();
      else if (topic === "maths_ap") q = genAP();
      else if (topic === "maths_optics_trig") q = genTrig();
      else if (topic === "maths_coordinate") q = genCoordinate();
      else if (topic === "maths_real_numbers") q = genRealNumbers();
      else if (topic === "maths_circles") q = genCircles();
      else if (topic === "maths_statistics") q = genStatistics();
      else if (topic === "maths_probability") q = genProbability();
      else if (topic === "sci_optics") q = genOptics();
      else if (topic === "sci_circuits") q = genCircuits();
      else if (topic === "sci_chemical_reactions") q = genChemicalReactions();
      else if (topic === "sci_acids") q = genChemicalReactions(); // Related
      else if (topic === "sci_life_processes") q = genLifeProcesses();
      else if (topic === "sci_genetics") q = genGenetics();
      else if (topic === "sci_environment") q = genEnvironment();
      else {
        // Random pick based on subject filter
        if (currentSubject === "maths") {
          q = mathsGenerators[Math.floor(Math.random() * mathsGenerators.length)]();
        } else if (currentSubject === "science") {
          q = scienceGenerators[Math.floor(Math.random() * scienceGenerators.length)]();
        } else {
          const allGens = mathsGenerators.concat(scienceGenerators);
          q = allGens[Math.floor(Math.random() * allGens.length)]();
        }
      }

      currentQuestion = q;
      renderQuestion(q);
    }

    function renderQuestion(q) {
      if (qSubjectBadge) {
        qSubjectBadge.textContent = q.subject;
        qSubjectBadge.className = `q-badge ${q.subject === "Mathematics" ? "badge-maths" : "badge-science"}`;
      }
      if (qTopicTag) qTopicTag.textContent = q.topic;
      if (qTitle) qTitle.innerHTML = q.question;

      if (optionsGrid) {
        optionsGrid.innerHTML = "";
        q.options.forEach((optText, idx) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "option-btn";
          btn.innerHTML = `<span class="opt-letter">${String.fromCharCode(65 + idx)}</span> <span class="opt-label">${optText}</span>`;
          btn.addEventListener("click", () => handleSelectOption(optText, btn));
          optionsGrid.appendChild(btn);
        });
      }
    }

    function handleSelectOption(selectedText, selectedBtn) {
      if (isAnswered || !currentQuestion) return;
      isAnswered = true;
      stats.solved++;

      const isCorrect = selectedText === currentQuestion.correctAnswer;
      const allOptionBtns = optionsGrid.querySelectorAll(".option-btn");

      allOptionBtns.forEach(btn => {
        btn.disabled = true;
        const label = btn.querySelector(".opt-label")?.textContent?.trim();
        if (label === currentQuestion.correctAnswer) {
          btn.classList.add("btn-correct");
        }
      });

      if (isCorrect) {
        stats.correct++;
        stats.streak++;
        if (stats.streak > stats.bestStreak) stats.bestStreak = stats.streak;
        selectedBtn.classList.add("btn-correct");
        solBadge.textContent = "✅ Correct! CBSE Step-by-Step Marking Scheme";
        solBadge.className = "sol-badge sol-badge-correct";
      } else {
        stats.streak = 0;
        selectedBtn.classList.add("btn-wrong");
        solBadge.textContent = "❌ Incorrect. Here is the Complete CBSE Model Answer";
        solBadge.className = "sol-badge sol-badge-wrong";
      }

      saveStats();

      // Show Solution Box
      if (solutionContent) solutionContent.innerHTML = currentQuestion.explanation;
      if (solutionBox) solutionBox.style.display = "block";
      solutionBox.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }

    // ── Event Listeners ──
    subjectPills.forEach(pill => {
      pill.addEventListener("click", () => {
        subjectPills.forEach(p => p.classList.remove("active"));
        pill.classList.add("active");
        currentSubject = pill.getAttribute("data-subject") || "all";
        generateQuestion();
      });
    });

    if (topicDropdown) {
      topicDropdown.addEventListener("change", () => {
        generateQuestion();
      });
    }

    if (generateNewBtn) generateNewBtn.addEventListener("click", generateQuestion);
    if (nextQuestionBtn) nextQuestionBtn.addEventListener("click", generateQuestion);

    // Initial Load
    updateStatsUI();
    generateQuestion();
  })();
</script>

