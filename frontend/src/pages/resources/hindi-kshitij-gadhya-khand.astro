---
import Layout from "../../layouts/Layout.astro";
import { loadContent } from "../../lib/content";
import { calBookingUrl } from "../../lib/site";

const { provider } = loadContent();
---

<Layout
  title={`क्षितिज भाग-2 (गद्य खंड) | CBSE Class 10 Hindi Course 'A' | ${provider.name}`}
  description="CBSE कक्षा 10 हिंदी (कोर्स 'अ') पाठ्यपुस्तक क्षितिज भाग-2 गद्य खंड सम्पूर्ण सारांश। नेताजी का चश्मा, बालगोबिन भगत, लखनवी अंदाज़, मानवीय करुणा की दिव्य चमक, एक कहानी यह भी, नौबतखाने में इबादत, संस्कृति के मूल भाव, चरित्र चित्रण, आरेख एवं 20 महत्वपूर्ण बोर्ड परीक्षा प्रश्न।"
>
  <div class="wrap">
    <nav class="small" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/subjects/">Subjects</a> / <a href="/resources/">Resources</a> / क्षितिज भाग-2 गद्य खंड
    </nav>

    <div class="resource-header">
      <span class="eyebrow">CBSE Class 10 · Hindi Course 'A' · पाठ्यपुस्तक क्षितिज भाग-2</span>
      <h1>क्षितिज भाग-2: गद्य खंड (सम्पूर्ण अध्याय सारांश व प्रश्नोत्तरी)</h1>
      <p class="lead">
        सीबीएसई कक्षा 10वीं हिंदी गद्य खंड के सभी अध्यायों का गहन विश्लेषण: देशभक्ति, सामाजिक रूढ़ि-भंजन, नवाबियत पर व्यंग्य, संतों का जीवन, स्वतंत्रता संघर्ष, संगीत साधना और संस्कृति की अवधारणा पर 20 बोर्ड परीक्षा प्रश्नों का संग्रह।
      </p>
    </div>

    <!-- Core Concepts Section -->
    <section class="section">
      <h2>गद्य खंड के प्रमुख अध्याय एवं केन्द्रीय विचार</h2>

      <div class="grid two concept-grid">
        <article class="card">
          <h3>🇮🇳 1. नेताजी का चश्मा (स्वयं प्रकाश)</h3>
          <p class="formula">सच्ची देशभक्ति किसी पद या वर्दी की मोहताज नहीं</p>
          <ul class="clean-list">
            <li><strong>कथा-सार:</strong> हालदार साहब हर पंद्रहवें दिन कस्बे से गुजरते थे। कस्बे के मुख्य चौराहे पर नेताजी सुभाषचंद्र बोस की संगमरमर की मूर्ति स्थापित थी, जिसे मास्टर मोतीलाल ने बनाया था, किंतु वे उस पर चश्मा बनाना भूल गए थे।</li>
            <li><strong>कैप्टन चश्मेवाला:</strong> एक लंगड़ा, बूढ़ा, निर्धन व्यक्ति जो फेरी लगाकर चश्मे बेचता था। वह नेताजी की बिना चश्मे वाली अधूरी मूर्ति पर अपने पास से फ्रेम लगा देता था। ग्राहक द्वारा मांगे जाने पर वह उसे उतारकर दूसरा चश्मा लगा देता।</li>
            <li><strong>पानवाले की व्यंग्यपूर्ण दृष्टि:</strong> पानवाला कैप्टन का मज़ाक उड़ाते हुए उसे 'पागल' कहता था, किंतु हालदार साहब के मन में कैप्टन के प्रति अगाध आदर था।</li>
            <li><strong>सरकंडे का चश्मा:</strong> कैप्टन की मृत्यु के बाद मूर्ति पर किसी छोटे बच्चे द्वारा हाथ से बनाया गया सरकंडे का चश्मा लगा देखकर हालदार साहब भावुक होकर रो पड़े। यह दर्शाता है कि देशभक्ति की भावना नई पीढ़ी में भी जीवित है।</li>
          </ul>
        </article>

        <article class="card">
          <h3>🪕 2. बालगोबिन भगत (रामवृक्ष बेनीपुरी)</h3>
          <p class="formula">गृहस्थ संन्यासी · कबीरपंथी आचरण · रूढ़ि-विरोधी क्रांति</p>
          <ul class="clean-list">
            <li><strong>व्यक्तित्व:</strong> साठ से ऊपर के गोरे-चिट्टे व्यक्ति, कमर में लंगोटी और सिर पर कबीरपंथियों जैसी टोपी। माथे पर रामानंदी चंदन का टीका। वे गृहस्थ होते हुए भी सच्चे अर्थों में 'संन्यासी' थे।</li>
            <li><strong>कबीर के पद और संगीत:</strong> आषाढ़ की रिमझिम में धान रोपते हुए उनका मधुर गायन समूचे गाँव को झूमने पर विवश कर देता था। कार्तिक से फागुन तक उनकी प्रभातियाँ भोर के धुंधलके में नदी स्नान के बाद शुरू होती थीं।</li>
            <li><strong>सामाजिक रूढ़ियों पर प्रहार:</strong>
              <br/>• इकलौते बेटे की मृत्यु पर रोने के बजाय उन्होंने उत्सव मनाया, क्योंकि 'आत्मा परमात्मा से मिल गई'।
              <br/>• बेटे की चिता को अग्नि अपनी पतोहू (पुत्रवधू) से दिलवाई, जो उस समय के समाज में वर्जित था।
              <br/>• पुत्रवधू के भाई को बुलाकर उसका पुनर्विवाह कराने का क्रांतिकारी आदेश दिया।
            </li>
            <li><strong>मृत्यु:</strong> उनकी मृत्यु भी उनके नियमों के अनुरूप ही शांत भाव से 'गंगा स्नान' और उपवास के नियम का पालन करते हुए हुई।</li>
          </ul>
        </article>

        <article class="card">
          <h3>🥒 3. लखनवी अंदाज़ (यशपाल)</h3>
          <p class="formula">पतनशील सामंती वर्ग की दिखावटी जीवन-शैली पर व्यंग्य</p>
          <ul class="clean-list">
            <li><strong>परिवेश:</strong> लेखक ने भीड़ से बचकर एकांत में नई कहानी के संबंध में सोचने के लिए सेकंड क्लास का टिकट लिया। डिब्बे में पहले से एक लखनवी नवाब साहब सफेदपोश पालथी मारे बैठे थे। सामने तौलिए पर दो ताज़े खीरे रखे थे।</li>
            <li><strong>नवाबी नज़ाकत व दिखावा:</strong> नवाब साहब ने लेखक से खीरा खाने का आग्रह (शौक फरमाइए) किया, जिसे लेखक ने संकोचवश अस्वीकार कर दिया। इसके बाद नवाब साहब ने खीरों को बड़े करीने से धोया, पोंछा, काटा, जीरा-नमक और मिर्च बुरकी।</li>
            <li><strong>खीरे को सूंघकर फेंकना:</strong> नवाब साहब ने खीरे की फांकों को मुँह तक ले जाकर केवल सूँघा, स्वाद के आनंद में आँखें मूँदीं और एक-एक फांक को खिड़की से बाहर फेंक दिया! फिर डकार लेकर अपनी 'अमीरी' व 'नफासत' का प्रदर्शन किया।</li>
            <li><strong>व्यंग्यार्थ:</strong> लेखक सोचते हैं कि जब खीरे की केवल सुगंध से पेट भर सकता है, तो बिना विचार, घटना और पात्रों के नई कहानी भी लिखी जा सकती है! यह उस परजीवी सामंती संस्कृति पर कटाक्ष है जो वास्तविकता से कटकर केवल दिखावे में जीती है।</li>
          </ul>
        </article>

        <article class="card">
          <h3>⛪ 4. मानवीय करुणा की दिव्य चमक (सर्वेश्वर दयाल सक्सेना)</h3>
          <p class="formula">फादर कामिल बुल्के · भारतीय संस्कृति में एकाकार विदेशी संन्यासी</p>
          <ul class="clean-list">
            <li><strong>व्यक्तित्व व संन्यास:</strong> बेल्जियम के रेम्सचैपल (इंजीनियरिंग के अंतिम वर्ष) को छोड़कर भारत आए। सफेद चोगा, नीली आँखें, और बाहें खोलकर गले लगाने वाली ममता। संन्यासी होकर भी 'रिश्ते बनाते थे तो तोड़ते नहीं थे'।</li>
            <li><strong>हिंदी प्रेम व शोध:</strong> प्रयाग विश्वविद्यालय से 'रामकथा: उत्पत्ति और विकास' पर शोध प्रबंध लिखा। भारत की पहली प्रामाणिक 'अंग्रेजी-हिंदी शब्दकोश' तैयार की। हिंदी को राष्ट्रभाषा बनाने के लिए सदा अकाट्य तर्क देते और हिंदी भाषियों की उपेक्षा पर दुखी होते थे।</li>
            <li><strong>संस्था 'परिमल' के स्तंभ:</strong> इलाहाबाद की साहित्यिक संस्था 'परिमल' के सभी सदस्यों के लिए वे बड़े भाई व पुरोहित समान थे। लेखकों की रचनाओं पर निर्लिप्त राय देते थे।</li>
            <li><strong>संदेश:</strong> वे भारत को केवल कर्मभूमि नहीं, बल्कि अपनी आत्मिक मातृभूमि मानते थे। कश्मीरी गेट के निकलसन कब्रगाह में उनकी अंत्येष्टि पर नम आँखों की कोई गिनती नहीं थी।</li>
          </ul>
        </article>

        <article class="card">
          <h3>✍️ 5. एक कहानी यह भी (मन्नू भंडारी)</h3>
          <p class="formula">आत्मकथ्य · स्वाधीनता आंदोलन · स्त्री अस्मिता एवं व्यक्तित्व संघर्ष</p>
          <ul class="clean-list">
            <li><strong>पारिवारिक पृष्ठभूमि व पितृ-प्रभाव:</strong> अजमेर के ब्रह्मपुरी मोहल्ले में बीता बचपन। पिता का अंतर्विरोधी व्यक्तित्व—एक ओर उदार, समाज-सुधारक, दूसरी ओर शक्की, क्रोधी और दकियानूसी। बड़ी बहन सुशीला से तुलना के कारण लेखिका में हीनभावना।</li>
            <li><strong>शीला अग्रवाल की प्रेरणा:</strong> कॉलेज में हिंदी प्राध्यापिका शीला अग्रवाल ने लेखिका के साहित्य-बोध को बदला और स्वाधीनता संग्राम में कूदने के लिए प्रेरित किया।</li>
            <li><strong>1942 का जनांदोलन:</strong> सड़कों पर जोशीले भाषण, प्रभातफेरियां और हड़तालें। अजमेर के मुख्य चौराहे पर लेखिका के ओजस्वी भाषण को सुनकर पिता के पुरातनपंथी मित्रों ने शिकायत की, किंतु डॉ. अंबालाल जी की प्रशंसा सुनकर पिता गर्व से भर उठे।</li>
            <li><strong>संदेश:</strong> एक साधारण लड़की के असाधारण लेखिका और स्वाधीनता सेनानी बनने की प्रेरणादायी गाथा।</li>
          </ul>
        </article>

        <article class="card">
          <h3>📚 6. स्त्री शिक्षा के विरोधी कुतर्कों का खंडन (महावीर प्रसाद द्विवेदी)</h3>
          <p class="formula">प्रगतिशील वैचारिक निबंध · प्राचीन साक्ष्यों से स्त्री-अधिकारों का समर्थन</p>
          <ul class="clean-list">
            <li><strong>कुतर्कवादियों पर प्रहार:</strong> उन पुरातनपंथियों की तीखी भर्त्सना जो मानते थे कि स्त्रियों को पढ़ाने से घर का अनर्थ और विनाश होता है।</li>
            <li><strong>पौराणिक व ऐतिहासिक प्रमाण:</strong>
              <br/>• शकुंतला द्वारा दुष्यंत को कटु वचन कहना शिक्षा का दुष्प्रभाव नहीं, बल्कि अन्याय के विरुद्ध स्वाभाविक प्रतिकार था।
              <br/>• अत्रि की पत्नी अनसूया, गार्गी (जिन्होंने ब्रह्मसभा में याज्ञवल्क्य को निरुत्तर किया), और मंडन मिश्र की पत्नी (जिन्होंने शंकराचार्य से शास्त्रार्थ किया) प्रकांड विदुषियां थीं।
            </li>
            <li><strong>प्राकृत भाषा का सत्य:</strong> प्राचीन नाटकों में स्त्रियों का प्राकृत बोलना उनके अनपढ़ होने का प्रमाण नहीं है—प्राकृत उस समय की जनसाधारण की लोकभाषा थी, ठीक जैसे आज हिंदी या बांग्ला है।</li>
            <li><strong>संदेश:</strong> स्त्रियों को अनपढ़ रखना समाज और राष्ट्र के लिए सबसे बड़ा सामाजिक अपराध व अन्याय है।</li>
          </ul>
        </article>

        <article class="card">
          <h3>📯 7. नौबतखाने में इबादत (यतीन्द्र मिश्र)</h3>
          <p class="formula">उस्ताद बिस्मिल्लाह खाँ · साझी संस्कृति · सुर और साधना का समर्पण</p>
          <ul class="clean-list">
            <li><strong>शहनाई के मंगलनायक:</strong> अमीरुद्दीन (बिस्मिल्लाह खाँ) का जन्म डुमराँव (बिहार) में हुआ, किंतु कर्मस्थली काशी बनी। उनके मामा सादिक हुसैन और अलीबख्श खाँ नौबतखाने में रियाज़ करते थे।</li>
            <li><strong>रसूलनबाई और बतूलनबाई का प्रभाव:</strong> बालाजी मंदिर जाने के रास्ते में इन दोनों गायिकाओं की ठुमरी, टप्पे और दादरा सुनकर उनके बालमन में संगीत की सच्ची लगन जागी।</li>
            <li><strong>गंगा-जमुनी साझी तहज़ीब:</strong> पक्के नमाज़ी मुस्लिम होते हुए भी बाबा विश्वनाथ और बालाजी के प्रति अटूट आस्था। मुहर्रम की आठवीं तारीख को दालमंडी से फातमान तक 8 कि.मी. रोते हुए नोहा बजाते पैदल जाना।</li>
            <li><strong>सच्चा धन—'सुर':</strong> भारत रत्न मिलने के बाद भी फटी तहमद (धोती) पहनना। शिष्या द्वारा नई धोती पहनने के आग्रह पर बोले—'मालिक से फटा सुर न माँगे, लुंगिया का क्या है, आज फटी है तो कल सिल जाएगी।'</li>
          </ul>
        </article>

        <article class="card">
          <h3>💡 8. संस्कृति (भदंत आनंद कौसल्यायन)</h3>
          <p class="formula">संस्कृति बनाम सभ्यता · मानव कल्याण की उदात्त भावना</p>
          <ul class="clean-list">
            <li><strong>संस्कृति (Culture) की परिभाषा:</strong> मानव बुद्धि या योग्यता जिसके बल पर वह किसी नए तथ्य या वस्तु का पहली बार आविष्कार करता है (जैसे आग की खोज या सुई-धागे की खोज करने वाला मूल आविष्कारक 'संस्कृत' व्यक्ति है)।</li>
