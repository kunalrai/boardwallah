<style>
  .resource-header {
    padding-block: 1.5rem 2rem;
  }

  .section-title-wrap {
    margin-bottom: 1.25rem;
  }

  .section-title-wrap h2 {
    font-size: 1.6rem;
    margin-bottom: 0.25rem;
  }

  .chapters-grid {
    gap: 1.5rem;
  }

  .chapter-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.75rem;
  }

  .chapter-card h2 {
    margin-top: 0.6rem;
    font-size: 1.45rem;
    color: var(--brand);
  }

  .topic-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1rem 0;
  }

  .topic-tag {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: var(--paper);
    color: var(--muted);
    border: 1px solid var(--line);
  }

  /* ── CTA banner ── */
  .cta-banner {
    padding: 2rem;
    background: var(--brand);
    border-radius: var(--radius);
    color: #fff;
    text-align: center;
  }

  .cta-banner h2 {
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .cta-banner p {
    color: rgb(255 255 255 / 85%);
    max-width: 54ch;
    margin-inline: auto;
    margin-bottom: 1.25rem;
  }

  .cta-banner .button {
    background: #fff;
    color: var(--brand);
    border-color: #fff;
  }

  .cta-banner .button:hover {
    background: #e8f0f1;
    color: var(--brand-dark);
  }
</style>
