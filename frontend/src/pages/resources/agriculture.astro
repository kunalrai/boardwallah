</Layout>

<script is:inline>
  const questions = [
    {
      q: "1. What is 'Slash and Burn' agriculture called in the north-eastern states of Assam, Meghalaya, Mizoram, and Nagaland?",
      options: [
        "Bewar",
        "Jhumming",
        "Podu",
        "Penda"
      ],
      correct: 1,
      explanation: "Slash and burn shifting cultivation is commonly known as 'Jhumming' or 'Jhum' in north-eastern India."
    },
    {
      q: "2. Why is 'Intensive Subsistence Farming' practiced in densely populated countries like India?",
      options: [
        "Because the right of inheritance has led to division of landholdings among successive generations, making plot sizes uneconomical and requiring high manual input for maximum output",
        "Because farmers are legally banned from using tractors",
        "Because intensive farming produces diamond crystals",
        "Because monsoon rains fall all 365 days of the year"
      ],
      correct: 0,
      explanation: "Subdivision of agricultural landholdings through generational inheritance makes plots very small, forcing farmers to apply intensive labor and fertilizer to survive."
    },
    {
      q: "3. What is a key characteristic of 'Plantation Agriculture'?",
      options: [
        "A single crop is grown over a vast estate using capital-intensive inputs and migrant laborers",
        "Farmers grow 50 different crops on a half-acre field",
        "No fertilizers or irrigation are allowed",
        "Crops are harvested only by university professors"
      ],
      correct: 0,
      explanation: "Plantations are large commercial single-crop agricultural enterprises (like tea, coffee, rubber) with an interface of agriculture and industry."
    },
    {
      q: "4. Which of the following is a classic example of a plantation crop grown extensively in Assam and North Bengal?",
      options: [
        "Tea",
        "Wheat",
        "Bajra",
        "Mustard"
      ],
      correct: 0,
      explanation: "Tea is an important beverage plantation crop introduced initially by the British, grown extensively in Assam and Darjeeling/Jalpaiguri."
    },
    {
      q: "5. When are 'Rabi' crops sown and harvested in India?",
      options: [
        "Sown in winter from October to December and harvested in summer from April to June",
        "Sown in June and harvested in September",
        "Sown in March and harvested in May",
        "Sown every week throughout the year"
      ],
      correct: 0,
      explanation: "Rabi crops are winter crops sown in October–December and harvested in April–June (e.g. wheat, mustard, gram)."
    },
    {
      q: "6. Which weather phenomenon during winter months brings precipitation that is vital for the success of Rabi wheat in Punjab and Haryana?",
      options: [
        "South-West Summer Monsoons",
        "Western temperate cyclonic depressions originating in the Mediterranean region",
        "North-East Retreating Monsoons",
        "Tropical Cyclones from the Bay of Bengal"
      ],
      correct: 1,
      explanation: "Western disturbances originating over the Mediterranean bring crucial winter rain across North-West India, benefiting rabi crops."
    },
    {
      q: "7. Which of the following is a 'Kharif' crop sown with the arrival of monsoon rains?",
      options: [
        "Paddy (Rice)",
        "Wheat",
        "Mustard",
        "Gram"
      ],
      correct: 0,
      explanation: "Paddy (rice), maize, cotton, and jute are major Kharif crops sown with the onset of the monsoon in June–July."
    },
    {
      q: "8. In Assam, West Bengal, and Odisha, three crops of paddy are grown in a year. What are these three crops named?",
      options: [
        "Aus, Aman, and Boro",
        "Rabi, Kharif, and Zaid",
        "Samba, Kuruvai, and Thaladi",
        "Jhum, Bewar, and Podu"
      ],
      correct: 0,
      explanation: "In eastern river deltas, rice is grown thrice annually as Aus, Aman, and Boro due to abundant water availability."
    },
    {
      q: "9. What is the short cropping season between the Rabi and Kharif seasons during summer months called?",
      options: [
        "Zaid season",
        "Winter season",
        "Autumn season",
        "Monsoon season"
      ],
      correct: 0,
      explanation: "The short summer cropping season between March and June is called the Zaid season (growing watermelons, cucumbers, fodder)."
    },
    {
      q: "10. What are the ideal climatic conditions required for the cultivation of Rice?",
      options: [
        "High temperature (above 25°C), high humidity, and annual rainfall above 100 cm",
        "Freezing temperatures below 0°C with desert winds",
        "Low temperature (10°C) and less than 20 cm rainfall",
        "Dry climate with zero humidity throughout the year"
      ],
      correct: 0,
      explanation: "Rice requires warm tropical temperatures above 25°C, high humidity, and plenty of water (over 100 cm annual rainfall)."
    },
    {
      q: "11. Why are coarse grains like Jowar, Bajra, and Ragi collectively referred to as 'Millets' highly valued?",
      options: [
        "They have very high nutritional value, being extremely rich in iron, calcium, other micro-nutrients, and roughage",
        "They can be converted directly into gasoline",
        "They grow only under sea water",
        "They are used exclusively to make paper money"
      ],
      correct: 0,
      explanation: "Millets are nutritionally superior grains rich in iron, calcium, minerals, and fiber, and thrive in dry, rain-fed conditions."
    },
    {
      q: "12. Why do leguminous crops like pulses (except arhar/tur) play a critical role in sustainable agriculture?",
      options: [
        "They fix atmospheric nitrogen in their root nodules, thereby restoring and maintaining natural soil fertility",
        "They require 500 cm of rainfall per month",
        "They poison all insects in nearby fields",
        "They prevent farmers from needing any seeds next year"
      ],
      correct: 0,
      explanation: "Leguminous pulses have symbiotic Rhizobium bacteria in their root nodules that fix nitrogen from the air into the soil, restoring fertility."
    },
    {
      q: "13. Which variety of Coffee was initially brought to India from Yemen and is renowned globally for its superior quality?",
      options: [
        "Arabica",
        "Robusta",
        "Liberica",
        "Excelsa"
      ],
      correct: 0,
      explanation: "The world-famous Arabica variety was brought from Yemen to India and first cultivated on the Baba Budan Hills in Karnataka."
    },
    {
      q: "14. What are the specific geographical requirements for growing Cotton?",
      options: [
        "Black soil of Deccan plateau, high temperature, light rainfall/irrigation, and 210 frost-free days with bright sunshine",
        "Heavy snowfall for 6 months on granite rocks",
        "Marshy swamp land with continuous flooding",
        "Extreme sub-zero cold with zero sunshine"
      ],
      correct: 0,
      explanation: "Cotton thrives on Deccan black soil, requiring high temperatures, light rain, 210 frost-free days, and bright sunshine during ripening."
    },
    {
      q: "15. Why is Jute known as the 'Golden Fiber' and where is it predominantly grown?",
      options: [
        "Due to its golden color and commercial value; grown on well-drained fertile soils in the floodplains of West Bengal, Bihar, and Assam",
        "Because it is spun out of real gold wire in Gujarat",
        "Because it grows in gold mines of Karnataka",
        "Because it is exported exclusively to Switzerland"
      ],
      correct: 0,
      explanation: "Jute is called the golden fiber for its shiny golden brown color and versatility; it is grown in the Ganga-Brahmaputra delta (West Bengal leads)."
    },
    {
      q: "16. Why is Jute losing its global market to synthetic substitutes like nylon?",
      options: [
        "Synthetic packing materials are far cheaper to manufacture than natural jute",
        "Jute is banned by the United Nations",
        "Jute causes skin allergies in all humans",
        "Jute cannot be dyed in colors"
      ],
      correct: 0,
      explanation: "Because of high production costs, natural jute faces fierce market competition from synthetic fibers and packing materials like nylon and polypropylene."
    },
    {
      q: "17. What institutional reform was prioritized in India's First Five Year Plan to address fragmented agricultural landholdings?",
      options: [
        "Consolidation of holdings (Chakbandi) and abolition of the Zamindari system",
        "Forced privatization of all village wells",
        "Banning the sale of agricultural crops in cities",
        "Exporting all grain to Europe"
      ],
      correct: 0,
      explanation: "Land reforms, including consolidation of fragmented holdings (Chakbandi) and abolishing exploitative Zamindari intermediaries, were primary objectives."
    },
    {
      q: "18. What scheme was introduced by the Government of India to provide cheap institutional credit and insurance to farmers?",
      options: [
        "Kissan Credit Card (KCC) and Personal Accident Insurance Scheme (PAIS)",
        "Universal Free Smartphone Scheme",
        "Foreign Vacation Allowance for Landlords",
        "Gold Coin Distribution Scheme"
      ],
      correct: 0,
      explanation: "The Kissan Credit Card (KCC) and PAIS were introduced to protect farmers against financial shocks and informal moneylenders."
    },
    {
      q: "19. Who initiated the 'Bhoodan - Gramdan' movement, also known as the 'Blood-less Revolution'?",
      options: [
        "Vinoba Bhave",
        "Mahatma Gandhi",
        "Jawaharlal Nehru",
        "Jayaprakash Narayan"
      ],
      correct: 0,
      explanation: "Acharya Vinoba Bhave pioneered the Bhoodan-Gramdan movement, persuading wealthy landowners to voluntarily donate land to landless poor peasants."
    },
    {
      q: "20. At which historic village in Andhra Pradesh (now Telangana) did the Bhoodan movement begin when Ram Chandra Reddy donated 80 acres of land?",
      options: [
        "Pochampalli",
        "Champaran",
        "Bardoli",
        "Sevagram"
      ],
      correct: 0,
      explanation: "The Bhoodan movement started at Pochampalli in 1951, when Sri Ram Chandra Reddy donated 80 acres of land to 80 landless Dalit villagers."
    }
  ];

  function renderQuiz() {
    const container = document.getElementById('quizContainer');
    if (!container) return;
    container.innerHTML = '';

    questions.forEach((item, idx) => {
      const qCard = document.createElement('div');
      qCard.className = 'quiz-card';
      qCard.id = `qCard_${idx}`;

      const title = document.createElement('h3');
      title.className = 'quiz-question';
      title.textContent = item.q;
      qCard.appendChild(title);

      const optList = document.createElement('div');
      optList.className = 'quiz-options';

      item.options.forEach((optText, optIdx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'quiz-opt-btn';
        btn.textContent = optText;
        btn.addEventListener('click', () => handleSelectOption(idx, optIdx));
        optList.appendChild(btn);
      });
      qCard.appendChild(optList);

      const feedback = document.createElement('div');
      feedback.className = 'quiz-feedback';
      feedback.id = `feedback_${idx}`;
      qCard.appendChild(feedback);

      container.appendChild(qCard);
    });
  }

  let userAnswers = {};

  function handleSelectOption(qIdx, optIdx) {
    if (userAnswers[qIdx] !== undefined) return;
    userAnswers[qIdx] = optIdx;

    const q = questions[qIdx];
    const isCorrect = (optIdx === q.correct);
    const card = document.getElementById(`qCard_${qIdx}`);
    const btns = card.querySelectorAll('.quiz-opt-btn');
    const fb = document.getElementById(`feedback_${qIdx}`);

    btns.forEach((btn, i) => {
      btn.disabled = true;
      if (i === q.correct) {
        btn.classList.add('opt-correct');
      } else if (i === optIdx) {
        btn.classList.add('opt-wrong');
      }
    });

    if (isCorrect) {
      fb.className = 'quiz-feedback feedback-correct';
      fb.innerHTML = `<strong>Correct!</strong> ${q.explanation}`;
    } else {
      fb.className = 'quiz-feedback feedback-wrong';
      fb.innerHTML = `<strong>Incorrect.</strong> ${q.explanation}`;
    }

    updateScoreSummary();
  }

  function updateScoreSummary() {
    let score = 0;
    const answeredCount = Object.keys(userAnswers).length;
    for (let qIdx in userAnswers) {
      if (userAnswers[qIdx] === questions[qIdx].correct) {
        score++;
      }
    }
    const badge = document.getElementById('quizScoreBadge');
    if (badge) badge.textContent = `Score: ${score} / ${questions.length}`;

    const prog = document.getElementById('quizProgressText');
    if (prog) prog.textContent = `${answeredCount} of ${questions.length} answered`;
  }

  function resetQuiz() {
    userAnswers = {};
    renderQuiz();
    updateScoreSummary();
  }

  document.addEventListener('DOMContentLoaded', () => {
    renderQuiz();
    const resetBtn = document.getElementById('resetQuizBtn');
    if (resetBtn) resetBtn.addEventListener('click', resetQuiz);
  });
</script>

