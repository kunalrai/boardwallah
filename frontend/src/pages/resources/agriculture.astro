    </section>

    <!-- Board Exam Quiz Section (20 Questions) -->
    <section class="section">
      <div class="quiz-header">
        <div>
          <h2>CBSE Board Examination Quiz</h2>
          <p class="lead" style="margin-bottom:0;">Test your understanding of Farming Types, Cropping Seasons, Major Crops, and Reforms.</p>
        </div>
