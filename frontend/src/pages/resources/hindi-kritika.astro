---
import Layout from "../../layouts/Layout.astro";
import { loadContent } from "../../lib/content";
import { calBookingUrl } from "../../lib/site";

const { provider } = loadContent();
---

<Layout
  title={`कृतिका भाग-2 | CBSE Class 10 Hindi Course 'A' | ${provider.name}`}
  description="CBSE कक्षा 10 हिंदी (कोर्स 'अ') पूरक पाठ्यपुस्तक कृतिका भाग-2 सम्पूर्ण अध्ययन नोट्स। माता का अँचल, जॉर्ज पंचम की नाक, साना-साना हाथ जोड़ि..., मैं क्यों लिखता हूँ? के विस्तृत सारांश, मूल संवेदना, आरेख एवं 20 महत्वपूर्ण बोर्ड परीक्षा प्रश्न।"
>
  <div class="wrap">
    <nav class="small" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/subjects/">Subjects</a> / <a href="/resources/">Resources</a> / कृतिका भाग-2
    </nav>

    <div class="resource-header">
      <span class="eyebrow">CBSE Class 10 · Hindi Course 'A' · पूरक पाठ्यपुस्तक कृतिका भाग-2</span>
      <h1>कृतिका भाग-2: सम्पूर्ण पाठ विश्लेषण व प्रश्नोत्तरी</h1>
      <p class="lead">
        सीबीएसई कक्षा 10वीं हिंदी की पूरक पाठ्यपुस्तक कृतिका भाग-2 के सभी महत्वपूर्ण पाठों का सर्वांगीण विवेचन: ग्रामीण बाल मनोविज्ञान, औपनिवेशिक मानसिकता पर तीखा व्यंग्य, हिमालय का यात्रा सौंदर्य और रचनात्मक लेखन की आंतरिक प्रेरणा।
      </p>
    </div>

    <!-- Core Concepts Section -->
    <section class="section">
      <h2>कृतिका भाग-2 के सभी पाँच प्रमुख पाठ एवं मूल संवेदना</h2>

      <div class="grid two concept-grid">
        <article class="card">
          <h3>🏡 1. माता का अँचल (शिवपूजन सहाय)</h3>
          <p class="formula">देहाती दुनिया · पिता का सान्निध्य और माँ की ममता का सुरक्षा-कवच</p>
          <ul class="clean-list">
            <li><strong>भोलानाथ (तारकेश्वरनाथ) का बाल-संसार:</strong> लेखक का बचपन पिता के साथ अधिक बीतता था। भोर में पिता के साथ उठना, नहलाना, पूजा में बैठना और माथे पर भभूत का त्रिपुंड लगाना। गंगा तट पर राम-नाम लिखी 500 कागज़ की गोलियों में लिपटे आटे की गोलियाँ मछलियों को खिलाना।</li>
            <li><strong>सामूहिक बाल-क्रीड़ाएँ:</strong> मिठाई की दुकान लगाना, बारात का जुलूस निकालना, खेती करना, चूल्हे की दावत सजाना—सब कुछ प्रकृति की गोद में धूल-मिट्टी के सहज खिलौनों से होता था।</li>
            <li><strong>चरम मोड़ (माँ के आँचल की शरण):</strong> टीले पर चूहों के बिल में पानी डालते समय अचानक भयानक काला साँप निकल आया। बच्चे रोते-चीखते बदहवास भागे। भोलानाथ काँपता हुआ सीधे घर में घुसा और पिता के पुकारने पर भी उनके पास न जाकर रोते हुए <strong>माँ के आँचल</strong> में छिप गया।</li>
            <li><strong>संदेश:</strong> पिता बच्चे के पालन-पोषण और क्रीड़ा के संगी हो सकते हैं, किंतु संकट के समय जो असीम सुरक्षा, शांति और वात्सल्य माँ की गोद और उसके आँचल में मिलता है, वह अन्यत्र दुर्लभ है।</li>
          </ul>
        </article>

        <article class="card">
          <h3>👃 2. जॉर्ज पंचम की नाक (कमलेश्वर)</h3>
          <p class="formula">औपनिवेशिक दासता की चाटुकारिता पर तीखा व्यंग्य</p>
          <ul class="clean-list">
            <li><strong>पृष्ठभूमि:</strong> इंग्लैंड की महारानी एलिजाबेथ द्वितीय का पति सहित भारत दौरा होना था। समूची भारतीय प्रशासनिक मशीनरी और दिल्ली की सड़कें, इमारतें सजने लगीं।</li>
            <li><strong>समस्या:</strong> अचानक पता चला कि इंडिया गेट के सामने लगी जॉर्ज पंचम की लाट (मूर्ति) की 'नाक' गायब है! भारतीय हुक्मरानों में हड़कंप मच गया कि 'यदि जॉर्ज पंचम की नाक नहीं होगी, तो हमारी नाक (प्रतिष्ठा) भी कट जाएगी।'</li>
            <li><strong>मूर्तिकार के हास्यास्पद प्रयास:</strong>
              <br/>• हिंदुस्तान के सभी पहाड़ों पर जाकर उस विशेष पत्थर की खोज की गई—पत्थर नहीं मिला।
              <br/>• देश के सभी महापुरुषों (गांधी, नेहरू, पटेल, सुभाष, तिलक) और यहाँ तक कि बिहार सेक्रेटेरिएट के बाहर 1942 के शहीद बच्चों की मूर्तियों की नाक नापी गई—किंतु सबकी नाक जॉर्ज पंचम की लाट से बड़ी निकली! (अर्थात भारतीय शहीदों का सम्मान औपनिवेशिक शासकों से कहीं ऊँचा था)।
            </li>
            <li><strong>शर्मनाक अंत:</strong> अंततः मूर्तिकार की सलाह पर किसी ज़िंदा इंसान की नाक काटकर जॉर्ज पंचम की लाट पर लगा दी गई। उस दिन देश के किसी अखबार में कोई उद्घाटन, अभिनंदन या स्वागत समारोह की खबर नहीं छपी—सभी अखबार मौन रहकर इस राष्ट्रीय लज्जा पर मातम मना रहे थे।</li>
          </ul>
        </article>

        <article class="card">
          <h3>🏔️ 3. साना-साना हाथ जोड़ि... (मधु कांकरिया)</h3>
          <p class="formula">सिक्किम हिमालय का विराट सौंदर्य एवं कठोर मानवीय श्रम</p>
          <ul class="clean-list">
            <li><strong>गंगटोक (मेहनतकश बादशाहों का शहर):</strong> रात के समय सितारों भरे आकाश में रहस्यमयी रोशनी का सौंदर्य। नेपाली प्रार्थना: <em>'साना-साना हाथ जोड़ि कहुं प्रार्थना, हम्रो जीवन तिम्रो कोसैली'</em> (छोटे-छोटे हाथ जोड़कर प्रार्थना करती हूँ कि मेरा सारा जीवन अच्छाइयों को समर्पित हो)।</li>
            <li><strong>श्वेत व रंगीन पताकाएँ:</strong> बौद्ध मान्यता के अनुसार किसी बुद्धिस्ट की मृत्यु पर शांति के लिए शहर से दूर 108 श्वेत पताकाएँ फहराई जाती हैं, जिन्हें उतारा नहीं जाता। नए कार्य के आरंभ में रंगीन पताकाएँ लगाई जाती हैं।</li>
            <li><strong>पहाड़ी महिलाओं का अदम्य श्रम:</strong> अनुपम प्राकृतिक सौंदर्य के बीच लेखिका ने देखा कि पीठ पर बँधी डोको (टोकरी) में अपने बच्चों को बाँधे हुए पहाड़ी स्त्रियाँ हथौड़े से पत्थर तोड़कर रास्ते चौड़े कर रही थीं। मातृत्व और श्रम-साधना का यह अद्भुत रूप लेखिका को झकझोर देता है।</li>
            <li><strong>कटाओ (भारत का स्विट्ज़रलैंड):</strong> प्रदूषण और व्यावसायीकरण से मुक्त बर्फ का स्वर्ग। लायुंग, युमथांग और कटाओ का नैसर्गिक सौंदर्य। नदी, झरने, पहाड़ और बर्फ को लेखिका प्रकृति का जल-संचय तंत्र मानती हैं।</li>
          </ul>
        </article>

        <article class="card">
          <h3>🌺 4. एही ठैयाँ झुलनी हेरानी हो रामा! (शिवप्रसाद मिश्र 'रुद्र')</h3>
          <p class="formula">बनारसी लोकसंस्कृति · स्वाधीनता संग्राम · दुलारी और टुन्नू का अमर देशप्रेम</p>
          <ul class="clean-list">
            <li><strong>दुलारी (गौनहारी) और टुन्नू:</strong> दुलारी बनारस की ख्यातिप्राप्त कजली गायिका थी। टुन्नू एक सोलह-सत्रह वर्ष का देशभक्त ब्राह्मण युवक था जो दुलारी से निश्छल, आत्मिक प्रेम करता था। दुलारी ने बाहर से उसे डाँटकर भगा दिया, किंतु उसके द्वारा उपहार में दी गई खद्दर की धोती को सहेज कर अपने सीने से लगा लिया।</li>
            <li><strong>विदेशी वस्त्र बहिष्कार आंदोलन:</strong> 1942 के भारत छोड़ो आंदोलन के समय टाउनहाल के मैदान में विदेशी वस्त्रों की होली जलाई जा रही थी। दुलारी ने अपने कीमती विदेशी कपड़ों का बंडल जलती चिता में फेंक दिया।</li>
            <li><strong>टुन्नू की शहादत:</strong> उसी जुलूस में देशभक्ति के नारे लगाते टुन्नू को अत्याचारी अंग्रेज पुलिस अधिकारी (जमादार अली सगीर) ने बूटों से रौंदकर और लाठियों से पीटकर शहीद कर दिया।</li>
            <li><strong>अंतिम कजली और विद्रोह:</strong> टुन्नू के बलिदान के बाद दुलारी ने उसी मंच पर उसकी दी हुई खद्दर की धोती पहनकर 'एही ठैयाँ झुलनी हेरानी हो रामा' कजली गाई। आंसुओं भरी आँखों में देशप्रेम और अंग्रेजी हुकूमत के प्रति विद्रोह की ज्वाला धधक रही थी। फेकू सरदार द्वारा अपमान किए जाने पर उसने उसे भरे मंच पर जूते से मारकर बदला लिया।</li>
            <li><strong>संदेश:</strong> स्वाधीनता की वेदी पर आम कलाकारों और उपेक्षित समाज के बलिदान की मार्मिक गाथा।</li>
          </ul>
        </article>

        <article class="card">
          <h3>✍️ 5. मैं क्यों लिखता हूँ? (अज्ञेय)</h3>
          <p class="formula">आंतरिक विवशता · प्रत्यक्ष अनुभव बनाम आत्मिक अनुभूति</p>
          <ul class="clean-list">
            <li><strong>लेखन का वास्तविक कारण:</strong> लेखक बाहरी यश, धन या संपादक के आग्रह पर नहीं, बल्कि अपने <strong>भीतर की विवशता (आंतरिक तड़प)</strong> को पहचानने और उससे मुक्त होने के लिए लिखता है।</li>
            <li><strong>अनुभव (Experience) और अनुभूति (Intuition) में अंतर:</strong>
              <br/>• अनुभव बाहर घटित घटना है जिसे व्यक्ति इंद्रियों से देखता या सुनता है।
              <br/>• अनुभूति उस घटना के साथ आंतरिक तादात्म्य और संवेदना का गहरा जुड़ाव है। बिना अनुभूति के सच्चा साहित्य नहीं रचा जा सकता।
            </li>
            <li><strong>हिरोशिमा का साक्षात्कार:</strong> लेखक ने पहले हिरोशिमा के परमाणु बम विस्फोट के बारे में केवल पढ़ा था (वह अनुभव था)। किंतु जब जापान जाकर उन्होंने जले हुए पत्थर पर एक आदमी की काली छाया देखी, जो परमाणु विकिरण की भीषण गर्मी से भाप बनकर उड़ गया था, तब लेखक के भीतर वह विस्फोट जीवंत हो उठा।</li>
            <li><strong>सच्ची रचनाशीलता:</strong> उसी अनुभूति के दबाव में उन्होंने भारत लौटकर रेलगाड़ी में बैठे-बैठे 'हिरोशिमा' पर प्रसिद्ध कविता लिखी।</li>
          </ul>
        </article>
      </div>
    </section>

    <!-- Visual Diagrams Section -->
    <section class="section">
      <h2>दृश्य संकल्पना: 'जॉर्ज पंचम की नाक' का व्यंग्य-प्रवाह एवं 'अनुभूति' का चक्र</h2>

      <div class="grid two">
        <div class="card visual-card">
          <div class="visual-badge">आरेख 1 · 'जॉर्ज पंचम की नाक': प्रशासनिक चाटुकारिता का पतन</div>
          <div class="svg-container">
            <svg viewBox="0 0 460 250" xmlns="http://www.w3.org/2000/svg" aria-label="जॉर्ज पंचम की नाक व्यंग्य चक्र">
              <rect width="460" height="250" fill="#f8fafc" rx="8"/>
              
              <!-- Step 1 -->
              <rect x="25" y="30" width="125" height="70" fill="#eff6ff" stroke="#3b82f6" stroke-width="1.5" rx="6"/>
              <text x="87" y="55" fill="#1d4ed8" font-size="10.5" font-weight="bold" text-anchor="middle">1. लाट की नाक गायब</text>
              <text x="87" y="75" fill="#475569" font-size="8.5" text-anchor="middle">रानी के आगमन से भय</text>

              <!-- Arrow 1 -->
              <path d="M 150 65 L 180 65" stroke="#64748b" stroke-width="2"/>

              <!-- Step 2 -->
              <rect x="180" y="30" width="130" height="70" fill="#fef3c7" stroke="#d97706" stroke-width="1.5" rx="6"/>
              <text x="245" y="55" fill="#b45309" font-size="10" font-weight="bold" text-anchor="middle">2. भारतीय महापुरुष</text>
              <text x="245" y="75" fill="#475569" font-size="8.5" text-anchor="middle">सबकी नाक लाट से बड़ी</text>

              <!-- Arrow 2 -->
              <path d="M 310 65 L 340 65" stroke="#64748b" stroke-width="2"/>

              <!-- Step 3 -->
              <rect x="340" y="30" width="105" height="70" fill="#fed7aa" stroke="#ea580c" stroke-width="1.5" rx="6"/>
              <text x="392" y="55" fill="#c2410c" font-size="10" font-weight="bold" text-anchor="middle">3. शहीद बालक</text>
              <text x="392" y="75" fill="#475569" font-size="8.5" text-anchor="middle">उनका सम्मान भी बड़ा</text>

              <!-- Arrow down to 4 -->
              <path d="M 392 100 L 392 140 L 350 140" stroke="#ef4444" stroke-width="2"/>

              <!-- Step 4: शर्मनाक निर्णय -->
              <rect x="40" y="140" width="310" height="80" fill="#fee2e2" stroke="#dc2626" stroke-width="2" rx="8"/>
              <text x="195" y="168" fill="#991b1b" font-size="12" font-weight="bold" text-anchor="middle">4. ज़िंदा इंसान की नाक का प्रत्यारोपण</text>
              <text x="195" y="190" fill="#334155" font-size="9.5" text-anchor="middle">• आत्मसम्मान की पूर्ण बलि · सभी अखबार मौन रहे</text>
              <text x="195" y="206" fill="#991b1b" font-size="9" font-weight="bold" text-anchor="middle">औपनिवेशिक मानसिक दासता का चरम रूप</text>
            </svg>
          </div>
          <p class="caption">कमलेश्वर का व्यंग्य उजागर करता है कि किस प्रकार स्वतंत्र भारत के शासक आज भी विदेशी सत्ता के आगे नतमस्तक थे।</p>
        </div>

        <div class="card visual-card">
          <div class="visual-badge">आरेख 2 · 'मैं क्यों लिखता हूँ?': अनुभव से अनुभूति तक का सफर</div>
          <div class="svg-container">
            <svg viewBox="0 0 460 250" xmlns="http://www.w3.org/2000/svg" aria-label="अनुभव से अनुभूति का चक्र">
