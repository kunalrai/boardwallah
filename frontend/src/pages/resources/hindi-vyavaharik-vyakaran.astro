---
import Layout from "../../layouts/Layout.astro";
import { loadContent } from "../../lib/content";
import { calBookingUrl } from "../../lib/site";

const { provider } = loadContent();
---

<Layout
  title={`हिंदी व्याकरण (व्यावहारिक व्याकरण) | CBSE Class 10 Hindi | ${provider.name}`}
  description="CBSE कक्षा 10 हिंदी (कोर्स 'अ') व्यावहारिक व्याकरण सम्पूर्ण नोट्स। रचना के आधार पर वाक्य भेद, वाच्य एवं वाच्य परिवर्तन, पद परिचय और अलंकार (श्लेष, उत्प्रेक्षा, अतिशयोक्ति, मानवीकरण) के नियम, आरेख और 20 महत्वपूर्ण बोर्ड परीक्षा प्रश्न।"
>
  <div class="wrap">
    <nav class="small" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/subjects/">Subjects</a> / <a href="/resources/">Resources</a> / हिंदी व्यावहारिक व्याकरण
    </nav>

    <div class="resource-header">
      <span class="eyebrow">CBSE Class 10 · Hindi Course 'A' · व्याकरण (16 अंक)</span>
      <h1>व्यावहारिक व्याकरण: सम्पूर्ण नियम व अभ्यास</h1>
      <p class="lead">
        सीबीएसई कक्षा 10वीं बोर्ड परीक्षा के व्यावहारिक व्याकरण के चारों प्रमुख खंडों (वाक्य रूपांतरण, वाच्य, पद परिचय और अलंकार) के सटीक नियम, पहचान तालिकाएँ, दृश्य आरेख और 20 बोर्ड परीक्षा प्रश्नों का संकलन।
      </p>
    </div>

    <!-- Core Concepts Section -->
    <section class="section">
      <h2>व्याकरण के चार मुख्य स्तंभ (Core Grammar Pillars)</h2>

      <div class="grid two concept-grid">
        <article class="card">
          <h3>🌿 1. रचना के आधार पर वाक्य भेद (4 अंक)</h3>
          <p class="formula">सरल वाक्य · संयुक्त वाक्य · मिश्र वाक्य</p>
          <ul class="clean-list">
            <li><strong>सरल वाक्य (Simple Sentence):</strong> जिस वाक्य में एक ही उद्देश्य (कर्ता) और एक ही विधेय (मुख्य क्रिया) हो। जैसे: <em>'परिश्रमी बालक परीक्षा में सफल होते हैं।'</em></li>
            <li><strong>संयुक्त वाक्य (Compound Sentence):</strong> दो या दो से अधिक स्वतंत्र उपवाक्य समानाधिकरण समुच्चयबोधक योजकों (और, तथा, एवं, या, अथवा, किंतु, परंतु, लेकिन, इसलिए, अतः) से जुड़े हों। जैसे: <em>'सूर्योदय हुआ और पक्षी चहचहाने लगे।'</em></li>
            <li><strong>मिश्र वाक्य (Complex Sentence):</strong> एक मुख्य (प्रधान) उपवाक्य और एक या अधिक आश्रित उपवाक्य व्यधिकरण योजकों (कि, जो, जिसे, यदि-तो, जब-तब, क्योंकि, यद्यपि-तथापि) से जुड़े हों।</li>
            <li><strong>आश्रित उपवाक्य के तीन भेद:</strong>
              <br/>• <em>संज्ञा उपवाक्य:</em> जो प्रधान उपवाक्य की संज्ञा के स्थान पर प्रयुक्त हो (प्रायः 'कि' से शुरू)।
              <br/>• <em>विशेषण उपवाक्य:</em> जो प्रधान उपवाक्य की संज्ञा/सर्वनाम की विशेषता बताए (जो, जिसने, जिसका)।
              <br/>• <em>क्रियाविशेषण उपवाक्य:</em> जो प्रधान उपवाक्य की क्रिया की विशेषता बताए (स्थान, काल, रीति, परिमाण, कार्य-कारण)।
            </li>
          </ul>
        </article>

        <article class="card">
          <h3>🎭 2. वाच्य एवं वाच्य परिवर्तन (4 अंक)</h3>
          <p class="formula">कर्तृवाच्य · कर्मवाच्य · भाववाच्य</p>
          <ul class="clean-list">
            <li><strong>वाच्य की परिभाषा:</strong> क्रिया के जिस रूप से यह ज्ञात हो कि वाक्य में क्रिया का मुख्य केंद्र कर्ता, कर्म या भाव है।</li>
            <li><strong>कर्तृवाच्य (Active Voice):</strong> क्रिया का लिंग व वचन कर्ता के अनुसार होता है। सकर्मक व अकर्मक दोनों क्रियाएँ संभव। जैसे: <em>'मोहन पत्र लिखता है।' / 'बच्चा सोता है।'</em></li>
            <li><strong>कर्मवाच्य (Passive Voice):</strong> क्रिया का लिंग व वचन कर्म के अनुसार होता है। केवल सकर्मक क्रिया। कर्ता के साथ 'से / के द्वारा / द्वारा' परसर्ग जुड़ता है और क्रिया में 'जा' धातु का रूप जुड़ता है। जैसे: <em>'मोहन के द्वारा पत्र लिखा जाता है।'</em></li>
            <li><strong>भाववाच्य (Impersonal Voice):</strong> कर्ता या कर्म की प्रधानता न होकर भाव की प्रधानता होती है। केवल अकर्मक क्रिया। क्रिया सदैव पुल्लिंग, एकवचन और अन्य पुरुष में होती है। प्रायः असमर्थता प्रकट करने हेतु। जैसे: <em>'मुझसे रात भर सोया नहीं जाता।'</em></li>
          </ul>
        </article>

        <article class="card">
          <h3>🔍 3. पद परिचय (Pad Parichay - 4 अंक)</h3>
          <p class="formula">वाक्य में प्रयुक्त पद का व्याकरणिक परिचय</p>
          <ul class="clean-list">
            <li><strong>पद की संकल्पना:</strong> जब कोई शब्द व्याकरणिक नियमों में बँधकर वाक्य में प्रयुक्त होता है, तो वह 'पद' बन जाता है।</li>
            <li><strong>संज्ञा पद परिचय:</strong> भेद (व्यक्तिवाचक, जातिवाचक, भाववाचक), लिंग, वचन, कारक तथा क्रिया के साथ संबंध।</li>
            <li><strong>सर्वनाम पद परिचय:</strong> भेद (पुरुषवाचक, निजवाचक, निश्चयवाचक, अनिश्चयवाचक, संबंधवाचक, प्रश्नवाचक), लिंग, वचन, कारक।</li>
            <li><strong>विशेषण पद परिचय:</strong> भेद (गुणवाचक, संख्यावाचक, परिमाणवाचक, सार्वनामिक), लिंग, वचन तथा विशेष्य।</li>
            <li><strong>क्रिया पद परिचय:</strong> भेद (सकर्मक/अकर्मक), धातु, काल, वाच्य, लिंग, वचन तथा कर्ता/कर्म का उल्लेख।</li>
            <li><strong>अव्यय पद परिचय:</strong> क्रियाविशेषण (रीति, काल, स्थान, परिमाण), संबंधबोधक, समुच्चयबोधक (योजक), विस्मयादिबोधक, निपात (ही, भी, तो, तक, मात्र)।</li>
          </ul>
        </article>

        <article class="card">
          <h3>✨ 4. अलंकार (Figures of Speech - 4 अंक)</h3>
          <p class="formula">श्लेष · उत्प्रेक्षा · अतिशयोक्ति · मानवीकरण</p>
          <ul class="clean-list">
            <li><strong>श्लेष अलंकार (शब्दालंकार):</strong> जहाँ एक ही शब्द एक बार प्रयुक्त हो, किंतु भिन्न-भिन्न प्रसंगों में उसके कई अर्थ निकलते हों (श्लिष्ट अर्थ)।
              <br/>• उदाहरण: <em>'रहिमन पानी राखिये, बिन पानी सब सून। पानी गये न ऊबरै, मोती, मानुष, चून।'</em> (पानी = चमक, सम्मान, जल)।
            </li>
            <li><strong>उत्प्रेक्षा अलंकार (अर्थालंकार):</strong> उपमेय में उपमान की संभावना या कल्पना की जाए। पहचान वाचक शब्द: <strong>मानो, मनु, मनहु, जानो, जनु, जनहु, ज्यों</strong>।
              <br/>• उदाहरण: <em>'उस काल मारे क्रोध के तन काँपने उनका लगा। मानो हवा के ज़ोर से सोता हुआ सागर जगा।'</em>
            </li>
            <li><strong>अतिशयोक्ति अलंकार:</strong> जहाँ किसी वस्तु, व्यक्ति या स्थिति का वर्णन बहुत बढ़ा-चढ़ाकर लोक-सीमा से परे किया जाए।
              <br/>• उदाहरण: <em>'हनुमान की पूँछ में लगन न पाई आग, लंका सिगरी जल गई गए निशाचर भाग।'</em>
            </li>
            <li><strong>मानवीकरण अलंकार:</strong> जहाँ जड़ प्रकृति (निर्जीव वस्तुओं या अमूर्त भावों) पर मानवीय चेष्टाओं, अनुभूतियों और क्रियाकलापों का आरोप किया जाए।
              <br/>• उदाहरण: <em>'मेघ आए बड़े बन-ठन के सँवर के।' / 'फूल हँसे कलियाँ मुसकाईं।'</em>
            </li>
          </ul>
        </article>
      </div>
    </section>

    <!-- Visual Diagrams Section -->
    <section class="section">
      <h2>दृश्य संकल्पना: वाक्य रूपांतरण संरचना एवं अलंकार पहचान प्रवाह</h2>

      <div class="grid two">
        <div class="card visual-card">
          <div class="visual-badge">आरेख 1 · रचना के आधार पर वाक्य संरचना एवं योजक</div>
          <div class="svg-container">
            <svg viewBox="0 0 460 250" xmlns="http://www.w3.org/2000/svg" aria-label="वाक्य भेद संरचना">
              <rect width="460" height="250" fill="#f8fafc" rx="8"/>
              
              <!-- Root: वाक्य -->
              <rect x="170" y="20" width="120" height="36" fill="#0f766e" rx="6"/>
              <text x="230" y="43" fill="#ffffff" font-size="13" font-weight="bold" text-anchor="middle">वाक्य के 3 भेद</text>

              <!-- Lines to 3 branches -->
              <path d="M 230 56 L 80 90" stroke="#0d9488" stroke-width="2" fill="none"/>
              <path d="M 230 56 L 230 90" stroke="#0d9488" stroke-width="2" fill="none"/>
              <path d="M 230 56 L 380 90" stroke="#0d9488" stroke-width="2" fill="none"/>

              <!-- Node 1: सरल वाक्य -->
              <rect x="20" y="90" width="120" height="135" fill="#eff6ff" stroke="#3b82f6" stroke-width="1.5" rx="6"/>
              <text x="80" y="115" fill="#1d4ed8" font-size="11" font-weight="bold" text-anchor="middle">1. सरल वाक्य</text>
              <line x1="30" y1="125" x2="130" y2="125" stroke="#93c5fd" stroke-width="1"/>
              <text x="80" y="145" fill="#334155" font-size="9" text-anchor="middle">1 उद्देश्य + 1 विधेय</text>
              <text x="80" y="165" fill="#334155" font-size="9" text-anchor="middle">कोई योजक नहीं</text>
              <text x="80" y="190" fill="#166534" font-size="8.5" font-weight="bold" text-anchor="middle">उदा: वह हँसकर बोला।</text>

              <!-- Node 2: संयुक्त वाक्य -->
              <rect x="170" y="90" width="120" height="135" fill="#fef3c7" stroke="#d97706" stroke-width="1.5" rx="6"/>
              <text x="230" y="115" fill="#b45309" font-size="11" font-weight="bold" text-anchor="middle">2. संयुक्त वाक्य</text>
              <line x1="180" y1="125" x2="280" y2="125" stroke="#fcd34d" stroke-width="1"/>
              <text x="230" y="145" fill="#334155" font-size="9" text-anchor="middle">स्वतंत्र उपवाक्य</text>
              <text x="230" y="165" fill="#b45309" font-size="8.5" font-weight="bold" text-anchor="middle">और, किंतु, परंतु, या</text>
              <text x="230" y="190" fill="#166534" font-size="8.5" font-weight="bold" text-anchor="middle">उदा: रात हुई और सो गए।</text>

              <!-- Node 3: मिश्र वाक्य -->
              <rect x="320" y="90" width="120" height="135" fill="#f0fdf4" stroke="#16a34a" stroke-width="1.5" rx="6"/>
              <text x="380" y="115" fill="#15803d" font-size="11" font-weight="bold" text-anchor="middle">3. मिश्र वाक्य</text>
              <line x1="330" y1="125" x2="430" y2="125" stroke="#86efac" stroke-width="1"/>
              <text x="380" y="145" fill="#334155" font-size="9" text-anchor="middle">प्रधान + आश्रित</text>
              <text x="380" y="165" fill="#15803d" font-size="8.5" font-weight="bold" text-anchor="middle">कि, जो, जैसे ही..वैसे</text>
              <text x="380" y="190" fill="#166534" font-size="8.5" font-weight="bold" text-anchor="middle">उदा: जब वह आया, तब..</text>
            </svg>
          </div>
          <p class="caption">रचना के आधार पर वाक्य पहचान की योजक तालिका और उपवाक्य संबंध।</p>
        </div>

        <div class="card visual-card">
          <div class="visual-badge">आरेख 2 · कक्षा 10 अलंकार पहचान कुंजी (Identification Keys)</div>
          <div class="svg-container">
            <svg viewBox="0 0 460 250" xmlns="http://www.w3.org/2000/svg" aria-label="अलंकार पहचान कुंजी">
              <rect width="460" height="250" fill="#f8fafc" rx="8"/>
              
              <!-- 4 Quadrants -->
              <!-- श्लेष -->
              <rect x="25" y="30" width="195" height="90" fill="#eff6ff" stroke="#3b82f6" stroke-width="1.5" rx="6"/>
              <text x="122" y="55" fill="#1d4ed8" font-size="12" font-weight="bold" text-anchor="middle">श्लेष (चिपका हुआ)</text>
              <text x="122" y="75" fill="#334155" font-size="9" text-anchor="middle">एक शब्द → एकाधिक संदर्भगत अर्थ</text>
              <text x="122" y="95" fill="#166534" font-size="9" font-weight="bold" text-anchor="middle">कुंजी: 'पानी गये न ऊबरै'</text>

              <!-- उत्प्रेक्षा -->
              <rect x="240" y="30" width="195" height="90" fill="#fef3c7" stroke="#d97706" stroke-width="1.5" rx="6"/>
              <text x="337" y="55" fill="#b45309" font-size="12" font-weight="bold" text-anchor="middle">उत्प्रेक्षा (संभावना)</text>
              <text x="337" y="75" fill="#334155" font-size="9" text-anchor="middle">उपमेय में उपमान की कल्पना</text>
              <text x="337" y="95" fill="#b45309" font-size="9" font-weight="bold" text-anchor="middle">कुंजी: मानो, जनु, जानो, मनहु</text>

              <!-- अतिशयोक्ति -->
              <rect x="25" y="135" width="195" height="90" fill="#fdf4ff" stroke="#a855f7" stroke-width="1.5" rx="6"/>
              <text x="122" y="160" fill="#7e22ce" font-size="12" font-weight="bold" text-anchor="middle">अतिशयोक्ति (अत्यधिक बढ़ाना)</text>
              <text x="122" y="180" fill="#334155" font-size="9" text-anchor="middle">लोक सीमा से परे अतिरंजित वर्णन</text>
              <text x="122" y="200" fill="#7e22ce" font-size="9" font-weight="bold" text-anchor="middle">कुंजी: 'आगे नदियां पड़ी अपार'</text>

              <!-- मानवीकरण -->
              <rect x="240" y="135" width="195" height="90" fill="#f0fdf4" stroke="#16a34a" stroke-width="1.5" rx="6"/>
              <text x="337" y="160" fill="#15803d" font-size="12" font-weight="bold" text-anchor="middle">मानवीकरण (प्रकृति में मानव)</text>
              <text x="337" y="180" fill="#334155" font-size="9" text-anchor="middle">निर्जीव/प्रकृति पर मानवीय क्रिया आरोप</text>
              <text x="337" y="200" fill="#15803d" font-size="9" font-weight="bold" text-anchor="middle">कुंजी: 'मेघ आए बन-ठन के'</text>
            </svg>
          </div>
          <p class="caption">सीबीएसई पाठ्यक्रम के चारों अलंकारों के मुख्य वाचक शब्द और विशिष्ट पहचान तकनीक।</p>
        </div>
      </div>
    </section>

    <!-- Board Exam Quiz Section (20 Questions) -->
    <section class="section">
      <div class="quiz-header">
        <div>
          <h2>सीबीएसई बोर्ड परीक्षा व्याकरण अभ्यास (20 बहुविकल्पी प्रश्न)</h2>
          <p class="lead" style="margin-bottom:0;">वाक्य भेद, वाच्य, पद परिचय और अलंकार पर आधारित वस्तुनिष्ठ प्रश्नोत्तर।</p>
        </div>
        <div class="quiz-score-badge" id="quizScoreBadge">Score: 0 / 20</div>
      </div>

      <div class="quiz-container" id="quizContainer">
        <!-- JS rendered -->
      </div>

      <div class="quiz-footer-actions">
        <button type="button" class="button" id="resetQuizBtn">पुनः अभ्यास करें (Reset)</button>
        <span class="small" id="quizProgressText">0 of 20 answered</span>
      </div>
    </section>

    <!-- Call to Action Banner -->
    <section class="cta-banner">
