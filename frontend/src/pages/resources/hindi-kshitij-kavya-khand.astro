---
import Layout from "../../layouts/Layout.astro";
import { loadContent } from "../../lib/content";
import { calBookingUrl } from "../../lib/site";

const { provider } = loadContent();
---

<Layout
  title={`क्षितिज भाग-2 (काव्य खंड) | CBSE Class 10 Hindi Course 'A' | ${provider.name}`}
  description="CBSE कक्षा 10 हिंदी (कोर्स 'अ') पाठ्यपुस्तक क्षितिज भाग-2 काव्य खंड सम्पूर्ण भावार्थ एवं शिल्प सौंदर्य। सूरदास के पद, राम-लक्ष्मण-परशुराम संवाद, आत्मकथ्य, उत्साह व अट नहीं रही है, यह दंतुरित मुस्कान व फसल, संगतकार, काव्य आरेख एवं 20 महत्वपूर्ण बोर्ड परीक्षा प्रश्न।"
>
  <div class="wrap">
    <nav class="small" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/subjects/">Subjects</a> / <a href="/resources/">Resources</a> / क्षितिज भाग-2 काव्य खंड
    </nav>

    <div class="resource-header">
      <span class="eyebrow">CBSE Class 10 · Hindi Course 'A' · पाठ्यपुस्तक क्षितिज भाग-2</span>
      <h1>क्षितिज भाग-2: काव्य खंड (सम्पूर्ण पद्य भावार्थ व प्रश्नोत्तरी)</h1>
      <p class="lead">
        सीबीएसई कक्षा 10वीं हिंदी पद्य खंड की सभी अमर कविताओं का गहन भावार्थ, रस-छंद-अलंकार, शिल्प सौंदर्य, दृश्य आरेख और 20 बोर्ड परीक्षा प्रश्नों का प्रामाणिक संकलन।
      </p>
    </div>

    <!-- Core Concepts Section -->
    <section class="section">
      <h2>काव्य खंड के प्रमुख अध्याय, भावार्थ एवं शिल्प सौंदर्य</h2>

      <div class="grid two concept-grid">
        <article class="card">
          <h3>🦚 1. सूरदास के पद (भ्रमरगीत सार)</h3>
          <p class="formula">ज्ञान-योग पर प्रेम-भक्ति की विजय · गोपियों का वाक्चातुर्य</p>
          <ul class="clean-list">
            <li><strong>प्रसंग:</strong> मथुरा जाकर श्रीकृष्ण ने गोपियों को सांत्वना देने के लिए अपने ज्ञानी सखा उद्धव को योग-संदेश लेकर भेजा। गोपियों ने निर्गुण ज्ञान को नकारकर सगुण प्रेम की प्रतिष्ठा की।</li>
            <li><strong>पद 1: 'ऊधौ, तुम हौ अति बड़भागी'</strong>—गोपियों का वक्रोक्तिपूर्ण व्यंग्य। उद्धव को कमल के पत्ते (पात) और तेल की गागर के समान निर्लिप्त बताया जो जल में रहकर भी भीगते नहीं। गोपियाँ स्वयं को गुड़ से लिपटी चींटियों (गुर चाँटी ज्यौं पागी) की तरह कृष्ण-प्रेम में लीन कहती हैं।</li>
            <li><strong>पद 2: 'मन की मन ही माँझ रही'</strong>—गोपियों की विरह व्यथा। जिससे प्रेम की गुहार लगाई थी, उसी ओर से योग की धार बह निकली। मर्यादा न रखने वाले कृष्ण पर कटाक्ष।</li>
            <li><strong>पद 3: 'हमारैं हरि हारिल की लकरी'</strong>—कृष्ण उनके लिए हारिल पक्षी की लकड़ी के समान हैं जिसे मन-कर्म-वचन से जकड़े हुए हैं। उद्धव का योग संदेश उन्हें 'कड़वी ककड़ी' जैसा लगता है।</li>
            <li><strong>पद 4: 'हरि हैं राजनीति पढ़ि आए'</strong>—कृष्ण अब कुशल राजनीतिज्ञ हो गए हैं। 'राजधर्म' की याद दिलाते हुए कहती हैं कि राजा का धर्म प्रजा को सताना नहीं, बल्कि उसकी रक्षा करना है।</li>
            <li><strong>शिल्प सौंदर्य:</strong> ब्रजभाषा की मधुरता, वियोग शृंगार रस, उपमा, रूपक और दृष्टांत अलंकार, गेय पद शैली।</li>
          </ul>
        </article>

        <article class="card">
          <h3>🏹 2. राम-लक्ष्मण-परशुराम संवाद (तुलसीदास)</h3>
          <p class="formula">रामचरितमानस (बालकांड) · वीर व रौद्र रस का अद्भुत समन्वय</p>
          <ul class="clean-list">
            <li><strong>प्रसंग:</strong> सीता स्वयंवर में शिव-धनुष (पिनाक) टूटने पर परशुराम जी अत्यंत क्रोधित होकर जनक सभा में उपस्थित होते हैं।</li>
            <li><strong>संवाद की प्रमुख विशेषताएँ:</strong>
              <br/>• <em>श्रीराम की विनयशीलता:</em> 'नाथ संभुधनु भंजनिहारा। होइहि केउ एक दास तुम्हारा।'—शांत रस का शांत प्रभाव।
              <br/>• <em>लक्ष्मण की व्यंग्योक्तियाँ:</em> शिव-धनुष को बचपन में तोड़े 'धनुहीं' जैसा बताना, 'भृगुबर' के फरसे को देखकर 'फूँक से पहाड़ उड़ाने' (चहत उड़ावन फूँकि पहारू) जैसा तीखा व्यंग्य।
              <br/>• <em>परशुराम का रौद्र रूप:</em> क्षत्रियों के संहार, सहस्रबाहु के वध और फरसे की भयानकता का बारंबार आत्म-प्रशंसात्मक बखान।
            </li>
            <li><strong>शिल्प सौंदर्य:</strong> अवधी भाषा, दोहा-चौपाई छंद, वीर, रौद्र और हास्य रस (लक्ष्मण के वचनों में), अनुप्रास, उपमा, उत्प्रेक्षा अलंकार।</li>
          </ul>
        </article>

        <article class="card">
          <h3>👑 3. सवैया और कवित्त (देव)</h3>
          <p class="formula">रीतिकालीन सौंदर्य चित्रण · कृष्ण का राजसी रूप एवं वसंत-बालक का मानवीकरण</p>
          <ul class="clean-list">
            <li><strong>सवैया ('पायनि नूपुर मंजु बजैं'):</strong> श्रीकृष्ण के राजसी, नटवर वेश का अलौकिक सौंदर्य। पैरों में मधुर ध्वनि करने वाले नूपुर (पायल), कमर में करधनी, पीला पीतांबर, गले में वनमाला, माथे पर मुकुट और बड़ी चंचल आँखें। उन्हें 'जग-मंदिर के दीपक' के रूप में चित्रित किया गया है।</li>
            <li><strong>कवित्त 1 (वसंत का मानवीकरण):</strong> कामदेव के नवजात बालक के रूप में वसंत ऋतु का रूपक। वृक्षों के नए पल्लवों का पालना, पुष्पों का झबला (वस्त्र), पवन द्वारा झुलाना, मोर और तोते द्वारा बातें करना, कोयल द्वारा ताली बजाना और गुलाब द्वारा चुटकी देकर जगाना।</li>
            <li><strong>कवित्त 2 (पूर्णिमा की चांदनी):</strong> शरद पूर्णिमा की रात का श्वेत, निष्कलंक सौंदर्य। आकाश ऐसा प्रतीत होता है मानो अमृत का महल हो, या दही का समुद्र उमड़ रहा हो, या दूध का झाग पूरे आंगन में फैला हो। राधिका के मुख-सौंदर्य की तुलना चंद्रमा से की गई है।</li>
            <li><strong>शिल्प सौंदर्य:</strong> ब्रजभाषा, सवैया व कवित्त छंद, अनुप्रास, रूपक, उपमा अलंकार, माधुर्य गुण।</li>
          </ul>
        </article>

        <article class="card">
          <h3>🦋 4. आत्मकथ्य (जयशंकर प्रसाद)</h3>
          <p class="formula">छायावादी आत्म-समीक्षा · जीवन का यथार्थ बनाम अभावों का मौन</p>
          <ul class="clean-list">
            <li><strong>रचना-पृष्ठभूमि:</strong> 'हंस' पत्रिका के आत्मकथा विशेषांक के लिए मित्रों द्वारा आत्मकथा लिखने के अनुरोध पर कवि द्वारा यह कविता लिखी गई, जिसमें वे अपनी साधारणता व्यक्त करते हैं।</li>
            <li><strong>मूल भाव:</strong>
              <br/>• जीवन की नश्वरता: 'मधुप गुनगुना कर कह जाता कौन कहानी यह अपनी'। जीवन-उपवन की पत्तियाँ मुरझाकर गिर रही हैं।
              <br/>• खाली गागर: कवि कहते हैं कि उनके जीवन में कोई ऐसी महान उपलब्धि नहीं है जिसे सुनकर लोग आनंद लें; उनका जीवन अभावों और दुखों से भरी 'रीती गागर' है।
              <br/>• निजी पलों की शुचिता: प्रियतमा के साथ बिताए गए सुखद क्षण अब केवल 'पाथेय' (मार्ग का सहारा) हैं, जिनकी 'कंथारी' (गुदड़ी) को उधेड़कर वे दुनिया को नहीं दिखाना चाहते।
            </li>
            <li><strong>शिल्प सौंदर्य:</strong> तत्सम प्रधान परिष्कृत खड़ी बोली, छायावादी प्रतीकात्मक शैली, मानवीकरण एवं रूपक अलंकार, करुण व शांत रस।</li>
          </ul>
        </article>

        <article class="card">
          <h3>⚡ 5. उत्साह (सूर्यकांत त्रिपाठी 'निराला')</h3>
          <p class="formula">आह्वान गीत · क्रांति-चेतना एवं शोषित जनता में नवजीवन का संचार</p>
          <ul class="clean-list">
            <li><strong>बादल का आह्वान:</strong> 'बादल, गरजो! घेर घेर घोर गगन, धरधराधर ओ!'—बादल को क्रांति, नवसृजन और सामाजिक परिवर्तन के अग्रदूत के रूप में पुकारा गया है।</li>
            <li><strong>द्वि-आयामी स्वरूप:</strong>
              <br/>• कोमल पक्ष: 'ललित ललित, काले घुँघराले, बाल कल्पना के-से पाले'—बाल-सुलभ कोमलता।
              <br/>• कठोर विप्लवी पक्ष: 'उर में विद्युत-छवि, करवि नवजीवन वाले! वज्र छिपा, नूतन कविता फिर भर दो!'—कवि के हृदय में बिजली की चमक और अन्याय को नष्ट करने का वज्र।
            </li>
            <li><strong>तप्त धरा को शीतलता:</strong> विश्व के सभी लोग ग्रीष्म की प्रचंड तपन से व्याकुल और अनमने थे। बादल आकर अनंत आकाश से बरसकर इस तप्त धरती को जल से शीतल और पुनर्जीवित कर देते हैं।</li>
            <li><strong>शिल्प सौंदर्य:</strong> ओज गुण, वीर रस, तत्सम शब्दावली युक्त खड़ी बोली, मुक्त छंद, मानवीकरण व अनुप्रास अलंकार।</li>
          </ul>
        </article>

        <article class="card">
          <h3>🌸 6. अट नहीं रही है (सूर्यकांत त्रिपाठी 'निराला')</h3>
          <p class="formula">फागुन का अप्रतिम सौंदर्य · प्रकृति और अंतर्मन का एकाकार उल्लास</p>
          <ul class="clean-list">
            <li><strong>फागुन की मादकता:</strong> 'अट नहीं रही है, आभा फागुन की तन सट नहीं रही है।'—फागुन मास (वसंत) के प्राकृतिक सौंदर्य का उल्लास इतना अधिक है कि वह प्रकृति में समा नहीं पा रहा है।</li>
            <li><strong>प्रकृति का सजीव रूप:</strong>
              <br/>• 'कहीं साँस लेते हो, घर-घर भर देते हो'—फागुन की हवा जब साँस लेती है, तो हर घर फूलों की सुगंध से भर जाता है।
              <br/>• 'उड़ने को नभ में तुम पर-पर कर देते हो'—यह सौंदर्य मन को कल्पना के पंख लगाकर आकाश में उड़ने को विवश कर देता है।
              <br/>• 'आँख हटाता हूँ तो हट नहीं रही है'—डालियाँ कहीं हरी, कहीं लाल कोपलों से लदी हैं, और गले में मंद सुगंधित पुष्पमाला पड़ी है।
            </li>
            <li><strong>शिल्प सौंदर्य:</strong> गीत-शैली, माधुर्य गुण, शृंगार रस, बिंब-विधान, संगीतात्मकता, मानवीकरण अलंकार।</li>
          </ul>
        </article>

        <article class="card">
          <h3>👶 7. यह दंतुरित मुस्कान (नागार्जुन)</h3>
          <p class="formula">वात्सल्य रस की पराकाष्ठा · शिशु की मुस्कान का जादू एवं माँ की भूमिका</p>
          <ul class="clean-list">
            <li><strong>शिशु की मुस्कान का प्रभाव:</strong> नवजात शिशु के नए निकले दूध के दाँतों की मधुर मुस्कान इतनी जीवंत है कि वह पाषाण-हृदय या 'मृतक में भी जान डाल दे'।</li>
            <li><strong>प्रतीकात्मक बिंब:</strong>
              <br/>• 'धूलि-धूसर तुम्हारे ये गात, छोड़कर तालाब मेरी झोपड़ी में खिल रहे जलजात'—धूल से सने शिशु का शरीर ऐसा लगता है मानो कमल तालाब छोड़कर झोपड़ी में खिल गया हो।
              <br/>• शिशु के स्पर्श मात्र से कठोर बाँस और बबूल से भी शेफालिका के सुकोमल फूल झरने लगते हैं।
            </li>
            <li><strong>माँ का योगदान:</strong> कवि निरंतर प्रवास में रहने के कारण स्वयं को शिशु के लिए 'अतिथि' मानते हैं। शिशु और कवि के बीच परिचय का सूत्र उसकी माँ है, जो उसे 'मधुपर्क' कराती रही है। जब बच्चा तिरछी नजर से देखकर मुस्कुराता है, तो कवि धन्य हो उठता है।</li>
            <li><strong>शिल्प सौंदर्य:</strong> सहज व्यावहारिक खड़ी बोली, वात्सल्य रस, उत्प्रेक्षा, रूपक एवं विरोधाभास अलंकार।</li>
          </ul>
        </article>

        <article class="card">
          <h3>🌾 8. फसल (नागार्जुन)</h3>
          <p class="formula">कृषि संस्कृति · मानवीय श्रम, प्रकृति और सामूहिकता का समन्वित फल</p>
          <ul class="clean-list">
            <li><strong>फसल की बहु-घटकीय परिभाषा:</strong> फसल केवल बीज या मिट्टी का एकाकी परिणाम नहीं है, बल्कि कई तत्वों के सह-अस्तित्व का उत्सव है:
              <br/>• 'एक के नहीं, दो के नहीं, ढेर सारी नदियों के पानी का जादू' (गंगा, यमुना, सतलुज आदि का सिंचन)।
              <br/>• 'लाख-लाख कोटि-कोटि हाथों के स्पर्श की गरिमा' (अनगिनत किसानों और मजदूरों का कठोर पसीना व श्रम)।
              <br/>• 'भूली-काली-संदली मिट्टी का गुण-धर्म' (धरती की पोषक क्षमता)।
