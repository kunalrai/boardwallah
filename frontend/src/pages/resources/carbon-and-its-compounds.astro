        <button class="button rules-tab-btn active" id="tab-btn-micelle" type="button" role="tab" aria-selected="true" aria-controls="panel-micelle">
          🧼 Soap Micelle Formation
        </button>
        <button class="button secondary rules-tab-btn" id="tab-btn-methane" type="button" role="tab" aria-selected="false" aria-controls="panel-methane">
          ⚛️ Methane (CH₄) Electron Sharing
        </button>
      </div>

      <!-- Panel 1: Micelle -->
