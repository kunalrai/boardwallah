---
import Layout from "../../layouts/Layout.astro";
import { loadContent } from "../../lib/content";
import { calBookingUrl } from "../../lib/site";

const { provider } = loadContent();
---

<Layout
  title={`Areas Related to Circles | CBSE Class 10 Maths | ${provider.name}`}
  description="CBSE Class 10 Maths Chapter 11 study notes on Areas Related to Circles. Perimeter and area of circles, arc length, area of sectors (minor/major), segment areas, clock hands, wheel revolutions, and an interactive 20-question board quiz."
>
  <div class="wrap">
    <nav class="small" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/subjects/">Subjects</a> / <a href="/resources/">Resources</a> / Areas Related to Circles
    </nav>

    <div class="resource-header">
      <span class="eyebrow">CBSE Class 10 · Mathematics · Chapter 11</span>
      <h1>Areas Related to Circles</h1>
      <p class="lead">
        Master sectors, segments, arc lengths, circular rings, clock hand movements, and wheel revolutions for the CBSE Class 10 Board Exam.
      </p>
    </div>

    <!-- Core Concepts -->
    <section class="section">
      <h2>Key Concepts &amp; Formulas</h2>

      <div class="grid two concept-grid">
        <article class="card">
          <h3>⭕ Circle Basics &amp; Circular Ring</h3>
          <p class="formula">Circumference = 2πr &nbsp;|&nbsp; Area = πr²</p>
          <ul class="clean-list">
            <li><strong>Perimeter (Circumference):</strong> <code>C = 2πr = πd</code> (where d = 2r).</li>
            <li><strong>Semi-circle:</strong> Area = <code>1/2 πr²</code>. Perimeter = <code>πr + 2r = r(π + 2)</code>.</li>
            <li><strong>Circular Ring (Track):</strong> Area between two concentric circles of radii R and r (R &gt; r):
              <br/><code>Area = π(R² - r²) = π(R - r)(R + r)</code>.
            </li>
            <li><strong>Wheel Revolutions:</strong> <code>Number of revolutions = Total Distance / Circumference (2πr)</code>.</li>
          </ul>
        </article>

        <article class="card">
          <h3>🍰 Sector of a Circle</h3>
          <p class="formula">Area = (θ/360°) × πr² &nbsp;|&nbsp; Arc l = (θ/360°) × 2πr</p>
          <ul class="clean-list">
            <li><strong>Sector:</strong> Region bounded by two radii and the arc between them.</li>
            <li><strong>Length of Arc of Sector (angle θ):</strong> <code>l = (θ / 360°) × 2πr</code>.</li>
            <li><strong>Area of Sector:</strong> <code>A = (θ / 360°) × πr² = 1/2 · l · r</code>.</li>
            <li><strong>Perimeter of Sector:</strong> <code>l + 2r = (θ / 360°) × 2πr + 2r</code>.</li>
            <li><strong>Major Sector Area:</strong> <code>πr² - Area of minor sector = [(360° - θ)/360°] × πr²</code>.</li>
          </ul>
        </article>

        <article class="card">
          <h3>✂️ Segment of a Circle</h3>
          <p class="formula">Area of Segment = Area of Sector - Area of Triangle</p>
          <ul class="clean-list">
            <li><strong>Segment:</strong> Region bounded by a chord and the corresponding arc.</li>
            <li><strong>Area of Minor Segment:</strong> <code>Area(Sector OAB) - Area(ΔOAB)</code>.</li>
            <li><strong>Area of ΔOAB:</strong> <code>1/2 · r² · sin θ</code>:
              <br/>• For θ = 60°: <code>ar(Δ) = (√3 / 4) r²</code> (Equilateral triangle)
              <br/>• For θ = 90°: <code>ar(Δ) = 1/2 r²</code> (Right-angled triangle)
              <br/>• For θ = 120°: <code>ar(Δ) = (√3 / 4) r²</code>
            </li>
            <li><strong>Area of Major Segment:</strong> <code>Total Circle Area - Area of Minor Segment</code>.</li>
          </ul>
        </article>

        <article class="card">
          <h3>⏰ Clock Hands &amp; Angular Speed</h3>
          <p class="formula">Minute Hand: 6° per min &nbsp;|&nbsp; Hour Hand: 0.5° per min</p>
          <ul class="clean-list">
            <li><strong>Minute hand:</strong> Completes 360° in 60 minutes.
              <br/>⟹ Speed = <code>360° / 60 = 6° per minute</code>.
              <br/>In 5 minutes, angle swept = <code>5 × 6° = 30°</code>.
            </li>
            <li><strong>Hour hand:</strong> Completes 360° in 12 hours (720 minutes).
              <br/>⟹ Speed = <code>360° / 720 = 0.5° per minute</code>.
            </li>
          </ul>
        </article>
      </div>
    </section>

    <!-- Visual Diagrams Section -->
    <section class="section">
      <h2>Visual Concepts: Sector vs Segment &amp; Clock Area Swept</h2>

      <div class="grid two">
        <div class="card visual-card">
          <div class="visual-badge">Visual Diagram 1 · Sector and Segment Decomposition</div>
          <div class="svg-container">
            <svg viewBox="0 0 460 250" xmlns="http://www.w3.org/2000/svg" aria-label="Sector and segment of a circle">
              <rect width="460" height="250" fill="#f8fafc" rx="8"/>
              
              <!-- Circle Center O(230, 125) radius 85 -->
              <circle cx="230" cy="125" r="85" fill="#fff" stroke="#94a3b8" stroke-width="1.5"/>

              <!-- Minor Sector Path (e.g. angle 90 deg from 225 deg to 315 deg) -->
              <!-- Sector arc: from (170, 65) to (290, 65) -->
              <path d="M 230 125 L 160 80 A 85 85 0 0 1 300 80 Z" fill="#e0f2fe" stroke="#0284c7" stroke-width="2"/>

              <!-- Segment (shaded region between chord and arc) -->
              <path d="M 160 80 A 85 85 0 0 1 300 80 Z" fill="#fbcfe8" stroke="#db2777" stroke-width="2"/>

              <!-- Chord AB -->
              <line x1="160" y1="80" x2="300" y2="80" stroke="#db2777" stroke-width="2.5"/>

              <!-- Triangle OAB -->
              <line x1="230" y1="125" x2="160" y2="80" stroke="#0284c7" stroke-width="2"/>
              <line x1="230" y1="125" x2="300" y2="80" stroke="#0284c7" stroke-width="2"/>

              <!-- Center Point O -->
              <circle cx="230" cy="125" r="4" fill="#0f766e"/>
              <text x="230" y="145" font-size="12" font-weight="700" fill="#0f766e" text-anchor="middle">O</text>

              <!-- Points A and B -->
              <circle cx="160" cy="80" r="4" fill="#0284c7"/>
              <text x="145" y="78" font-size="12" font-weight="700" fill="#0284c7">A</text>
              <circle cx="300" cy="80" r="4" fill="#0284c7"/>
              <text x="312" y="78" font-size="12" font-weight="700" fill="#0284c7">B</text>

              <!-- Central angle arc -->
              <path d="M 215 110 A 20 20 0 0 1 245 110" fill="none" stroke="#ea580c" stroke-width="2"/>
              <text x="230" y="102" font-size="11" font-weight="700" fill="#ea580c" text-anchor="middle">θ</text>

              <!-- Radius labels -->
              <text x="185" y="115" font-size="10" font-weight="600" fill="#0284c7">r</text>
              <text x="275" y="115" font-size="10" font-weight="600" fill="#0284c7">r</text>

              <!-- Legend Boxes -->
              <rect x="25" y="195" width="180" height="40" rx="4" fill="#e0f2fe" stroke="#0284c7"/>
              <text x="115" y="212" font-size="10" font-weight="700" fill="#0369a1" text-anchor="middle">Sector OAB (Blue + Pink)</text>
              <text x="115" y="227" font-size="9" fill="#0284c7" text-anchor="middle">Area = (θ/360°) × πr²</text>

              <rect x="255" y="195" width="180" height="40" rx="4" fill="#fbcfe8" stroke="#db2777"/>
              <text x="345" y="212" font-size="10" font-weight="700" fill="#9d174d" text-anchor="middle">Segment (Pink Shaded)</text>
              <text x="345" y="227" font-size="9" fill="#db2777" text-anchor="middle">Sector OAB - ΔOAB</text>
            </svg>
          </div>
          <p class="visual-caption">A sector is bounded by two radii and an arc; a segment is bounded by a chord and an arc.</p>
        </div>

        <div class="card visual-card">
          <div class="visual-badge">Visual Diagram 2 · Clock Minute Hand Swept Sector</div>
          <div class="svg-container">
            <svg viewBox="0 0 460 250" xmlns="http://www.w3.org/2000/svg" aria-label="Clock minute hand swept area">
              <rect width="460" height="250" fill="#f8fafc" rx="8"/>
              
              <!-- Clock Dial: Center O(230, 125) radius 80 -->
              <circle cx="230" cy="125" r="80" fill="#f1f5f9" stroke="#334155" stroke-width="3"/>
              
              <!-- Hour marks 12, 3, 6, 9 -->
              <text x="230" y="60" text-anchor="middle" font-size="12" font-weight="700" fill="#1e293b">12</text>
              <text x="295" y="129" text-anchor="middle" font-size="12" font-weight="700" fill="#1e293b">3</text>
              <text x="230" y="198" text-anchor="middle" font-size="12" font-weight="700" fill="#1e293b">6</text>
              <text x="165" y="129" text-anchor="middle" font-size="12" font-weight="700" fill="#1e293b">9</text>

              <!-- Swept sector (from 12 to 2: 10 mins = 60 degrees) -->
              <path d="M 230 125 L 230 55 A 70 70 0 0 1 291 90 Z" fill="#ecfdf5" stroke="#10b981" stroke-width="2"/>

              <!-- Minute Hand 1 (at 12) -->
              <line x1="230" y1="125" x2="230" y2="55" stroke="#0f766e" stroke-width="3"/>
              <!-- Minute Hand 2 (at 2) -->
              <line x1="230" y1="125" x2="291" y2="90" stroke="#0f766e" stroke-width="3"/>

              <!-- Central Pivot -->
              <circle cx="230" cy="125" r="5" fill="#ef4444"/>

              <!-- Arc angle θ = 60° -->
              <path d="M 230 100 A 25 25 0 0 1 252 112" fill="none" stroke="#ef4444" stroke-width="2"/>
              <text x="246" y="98" font-size="10" font-weight="700" fill="#dc2626">θ = 60°</text>

              <!-- Formula callout -->
              <rect x="50" y="210" width="360" height="28" rx="4" fill="#0f766e"/>
              <text x="230" y="228" text-anchor="middle" font-size="11" font-weight="700" fill="#fff">Angle swept in t mins = t × 6° &nbsp;|&nbsp; Area = (θ/360°) × πr²</text>
            </svg>
          </div>
          <p class="visual-caption">The minute hand moves 6° per minute. In 10 minutes, θ = 60°, sweeping a sector of area (60°/360°) × πr².</p>
        </div>
      </div>
    </section>

    <!-- Solved Step-by-Step Problem -->
    <section class="section">
      <h2>Exemplar Board Problem: Minor &amp; Major Segment Areas Solved</h2>
      <div class="card" style="padding:1.75rem; background:var(--paper)">
        <h3 style="color:var(--brand);margin-top:0">Problem: A chord of a circle of radius 15 cm subtends an angle of 60° at the center. Find the areas of the corresponding minor and major segments of the circle. (Use π = 3.14 and √3 = 1.73)</h3>
        <div style="font-size:0.95rem; line-height:1.7; color:var(--text)">
          <p><strong>Step 1 (Given Data):</strong> Radius <code>r = 15 cm</code>, Central angle <code>θ = 60°</code>.</p>
          <p><strong>Step 2 (Area of Minor Sector OAB):</strong>
            <br/><code>Area = (θ / 360°) × πr²</code>
            <br/><code>Area = (60° / 360°) × 3.14 × 15 × 15 = (1 / 6) × 3.14 × 225 = 117.75 cm²</code>.
          </p>
          <p><strong>Step 3 (Area of Equilateral Triangle OAB):</strong>
            <br/>Since <code>OA = OB = 15 cm</code> and <code>∠AOB = 60°</code>, ΔOAB is an equilateral triangle.
            <br/><code>ar(ΔOAB) = (√3 / 4) × r² = (1.73 / 4) × 225 = 389.25 / 4 = 97.3125 cm²</code>.
          </p>
          <p><strong>Step 4 (Area of Minor Segment):</strong>
            <br/><code>Area of Minor Segment = Area of Sector OAB - ar(ΔOAB)</code>
            <br/><code>Area = 117.75 - 97.3125 = 20.4375 cm²</code>.
          </p>
          <p><strong>Step 5 (Area of Major Segment):</strong>
            <br/><code>Total Area of Circle = πr² = 3.14 × 15 × 15 = 706.5 cm²</code>.
            <br/><code>Area of Major Segment = Total Circle Area - Area of Minor Segment</code>
            <br/><code>Area = 706.5 - 20.4375 = 686.0625 cm²</code>.
            <br/><strong>Final Answer:</strong> Minor segment area = <strong>20.44 cm²</strong>, Major segment area = <strong>686.06 cm²</strong>.
          </p>
        </div>
      </div>
    </section>

    <!-- Interactive 20-Question Quiz -->
    <section class="section">
      <h2>Interactive CBSE Board Exam Quiz (20 Questions)</h2>
      <p class="muted">Test your command over circumference, sector formulas, segment subtraction, clock hands, and revolutions.</p>

      <div class="quiz-container card" id="quiz-box">
        <div class="quiz-header-bar">
          <span class="quiz-counter" id="quiz-counter">Question 1 of 20</span>
          <span class="quiz-score" id="quiz-score">Score: 0 / 20</span>
        </div>

        <div class="quiz-question-body">
          <p class="quiz-q-text" id="quiz-question">Loading question...</p>
          <div class="quiz-options-list" id="quiz-options"></div>
          <div class="quiz-feedback" id="quiz-feedback"></div>
        </div>

        <div class="quiz-footer-actions">
          <button class="button secondary" id="quiz-prev-btn" disabled>← Previous</button>
          <button class="button" id="quiz-next-btn" disabled>Next Question →</button>
        </div>
      </div>

      <div class="quiz-completed-banner card" id="quiz-result-box" style="display:none; text-align:center; padding:2.5rem;">
        <h3>Quiz Completed! 🎉</h3>
        <p class="quiz-final-score" id="quiz-final-score" style="font-size:1.4rem; font-weight:700; color:var(--brand); margin:1rem 0;"></p>
        <p id="quiz-final-msg" class="muted"></p>
        <button class="button" id="quiz-restart-btn" style="margin-top:1rem;">Retake Quiz</button>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-banner">
      <h2>Need personalized Maths guidance for Class 10?</h2>
      <p>Book a free {provider.trial.duration_minutes}-minute trial session with {provider.tutor_name} (online or at-home) to master Areas Related to Circles, mensuration formulas, and calculation shortcuts.</p>
      <a class="button" href={calBookingUrl} target="_blank" rel="noopener noreferrer">Book Free Trial</a>
    </section>
  </div>
</Layout>

<script is:inline>
(function() {
  const quizData = [
    {
      q: "If the perimeter and the area of a circle are numerically equal, then the radius of the circle is:",
      options: ["2 units", "π units", "4 units", "7 units"],
      answer: 0,
      explanation: "2πr = πr² ⟹ 2r = r² ⟹ r(r - 2) = 0. Since r > 0, r = 2 units."
    },
    {
      q: "Area of a sector of central angle p° of a circle with radius R is:",
      options: ["(p/180) × 2πR", "(p/180) × πR²", "(p/360) × 2πR", "(p/720) × 2πR²"],
      answer: 3,
      explanation: "Standard formula: (p / 360) × πR². Multiplying numerator and denominator by 2 gives (p / 720) × 2πR²."
    },
    {
      q: "The length of the minute hand of a clock is 14 cm. The area swept by the minute hand in 5 minutes is (take π = 22/7):",
      options: ["154/3 cm²", "154 cm²", "77/3 cm²", "308/3 cm²"],
      answer: 0,
      explanation: "Angle swept in 5 mins: θ = 5 × 6° = 30°. Area = (30/360) × (22/7) × 14 × 14 = (1/12) × 22 × 2 × 14 = (1/12) × 616 = 154/3 cm² ≈ 51.33 cm²."
    },
    {
      q: "If the circumference of a circle and the perimeter of a square are equal, then:",
      options: ["Area of circle = Area of square", "Area of circle > Area of square", "Area of circle < Area of square", "Cannot be determined"],
      answer: 1,
      explanation: "For a given perimeter, a circle encloses the maximum possible area among all geometric 2D shapes. Hence Area of circle > Area of square."
    },
    {
      q: "The diameter of a wheel is 84 cm. How many revolutions will it make to cover a distance of 792 m?",
      options: ["100", "200", "300", "400"],
      answer: 2,
      explanation: "Circumference = πd = (22/7) × 84 = 22 × 12 = 264 cm = 2.64 m. Number of revolutions = 792 / 2.64 = 300."
    },
    {
      q: "The area of the square that can be inscribed in a circle of radius 8 cm is:",
      options: ["64 cm²", "128 cm²", "256 cm²", "64√2 cm²"],
      answer: 1,
      explanation: "Diagonal of inscribed square = diameter of circle = 2 × 8 = 16 cm. Area of square = (diagonal)² / 2 = 16² / 2 = 256 / 2 = 128 cm²."
    },
    {
      q: "The perimeter of a circular sector of radius 5.2 cm is 16.4 cm. The area of the sector is:",
      options: ["15.6 cm²", "16.4 cm²", "31.2 cm²", "12.8 cm²"],
      answer: 0,
      explanation: "Perimeter = l + 2r ⟹ 16.4 = l + 2(5.2) ⟹ l = 16.4 - 10.4 = 6 cm. Area = 1/2 · l · r = 1/2 × 6 × 5.2 = 3 × 5.2 = 15.6 cm²."
    },
    {
      q: "If the difference between circumference and radius of a circle is 37 cm, then using π = 22/7, the circumference is:",
      options: ["44 cm", "14 cm", "7 cm", "88 cm"],
      answer: 0,
      explanation: "2πr - r = 37 ⟹ r(2 × 22/7 - 1) = 37 ⟹ r(44/7 - 1) = 37 ⟹ r(37/7) = 37 ⟹ r = 7 cm. Circumference = 2 × (22/7) × 7 = 44 cm."
    },
    {
      q: "A steel wire when bent in the form of a square encloses an area of 121 cm². If the same wire is bent into the form of a circle, the area of the circle is:",
      options: ["154 cm²", "176 cm²", "144 cm²", "121 cm²"],
      answer: 0,
      explanation: "Side of square = √121 = 11 cm. Wire length = 4 × 11 = 44 cm. For circle: 2πr = 44 ⟹ r = 7 cm. Area = (22/7) × 7² = 154 cm²."
    },
    {
      q: "The area of a circle that can be inscribed in a square of side 10 cm is:",
      options: ["25π cm²", "50π cm²", "100π cm²", "10π cm²"],
      answer: 0,
      explanation: "Diameter of inscribed circle = side of square = 10 cm ⟹ radius r = 5 cm. Area = πr² = π(5)² = 25π cm²."
    },
    {
      q: "In a circle of radius 21 cm, an arc subtends an angle of 60° at the center. The length of the arc is:",
      options: ["11 cm", "22 cm", "44 cm", "33 cm"],
      answer: 1,
      explanation: "Arc length = (θ / 360°) × 2πr = (60/360) × 2 × (22/7) × 21 = (1/6) × 2 × 22 × 3 = 22 cm."
    },
    {
      q: "A race track is in the form of a ring whose inner circumference is 352 m and outer circumference is 396 m. The width of the track is:",
      options: ["4 m", "7 m", "14 m", "3.5 m"],
      answer: 1,
      explanation: "Width = R - r. 2πR - 2πr = 396 - 352 = 44 m ⟹ 2π(R - r) = 44 ⟹ 2 × (22/7) × (R - r) = 44 ⟹ R - r = 7 m."
    },
    {
      q: "The ratio of the areas of the incircle and circumcircle of a square is:",
      options: ["1 : 2", "1 : √2", "2 : 1", "1 : 4"],
      answer: 0,
      explanation: "Let side of square = 2a. Inradius r = a. Circumradius R = diagonal / 2 = 2a√2 / 2 = a√2. Ratio of areas = πr² / πR² = a² / (2a²) = 1/2 = 1 : 2."
    },
    {
      q: "Area of the largest triangle that can be inscribed in a semi-circle of radius r is:",
      options: ["r²", "2r²", "1/2 r²", "√2 r²"],
      answer: 0,
      explanation: "Base of largest triangle is the diameter = 2r. Maximum height is the radius = r. Area = 1/2 × base × height = 1/2 × (2r) × r = r²."
    },
    {
      q: "If the radius of a circle is doubled, its area becomes:",
      options: ["Doubled", "Tripled", "4 times", "8 times"],
      answer: 2,
      explanation: "Area A₁ = πr². With radius 2r: A₂ = π(2r)² = 4πr² = 4 A₁. The area becomes 4 times."
    },
    {
      q: "A pendulum swings through an angle of 30° and describes an arc 8.8 cm in length. The length of the pendulum is:",
      options: ["16.8 cm", "14 cm", "21 cm", "28 cm"],
      answer: 0,
      explanation: "Arc l = (θ / 360) × 2πr ⟹ 8.8 = (30/360) × 2 × (22/7) × r ⟹ 8.8 = (1/12) × (44/7) × r ⟹ r = (8.8 × 84) / 44 = 0.2 × 84 = 16.8 cm."
    },
    {
      q: "In a circle of radius 14 cm, a chord subtends a right angle at the center. The area of the minor segment is (use π = 22/7):",
      options: ["56 cm²", "98 cm²", "154 cm²", "112 cm²"],
      answer: 0,
      explanation: "Area of sector = (90/360) × π(14)² = 1/4 × (22/7) × 196 = 154 cm². Area of Δ = 1/2 × 14 × 14 = 98 cm². Area of minor segment = 154 - 98 = 56 cm²."
    },
    {
      q: "A cow is tied with a rope of length 14 m at the corner of a rectangular field of dimensions 20 m × 16 m. The area of the field in which the cow can graze is:",
      options: ["154 cm²", "154 m²", "308 m²", "77 m²"],
      answer: 1,
      explanation: "The cow grazes a sector with central angle 90° (corner of rectangle). Area = (90/360) × πr² = 1/4 × (22/7) × 14 × 14 = 154 m²."
    },
    {
      q: "The short and long hands of a clock are 4 cm and 6 cm long respectively. Sum of distances traveled by their tips in 2 days (48 hours) is approximately:",
      options: ["1910 cm", "1850 cm", "1960 cm", "2010 cm"],
      answer: 0,
      explanation: "Hour hand makes 4 revolutions in 2 days: 4 × 2π(4) = 32π. Minute hand makes 48 revolutions: 48 × 2π(6) = 576π. Total distance = 608π ≈ 608 × 3.1416 ≈ 1910 cm."
    },
    {
      q: "If the radius of a circle is increased by 50%, then its area increases by:",
      options: ["50%", "100%", "125%", "150%"],
      answer: 2,
      explanation: "New radius = 1.5r. New area = π(1.5r)² = 2.25 πr² = 2.25 A. Increase in area = 2.25A - A = 1.25A = 125%."
    }
  ];

  let currentIdx = 0;
  let userAnswers = new Array(quizData.length).fill(null);

  const qText = document.getElementById("quiz-question");
  const optionsBox = document.getElementById("quiz-options");
  const feedbackBox = document.getElementById("quiz-feedback");
  const counterBox = document.getElementById("quiz-counter");
  const scoreBox = document.getElementById("quiz-score");
  const prevBtn = document.getElementById("quiz-prev-btn");
  const nextBtn = document.getElementById("quiz-next-btn");
  const quizBox = document.getElementById("quiz-box");
  const resultBox = document.getElementById("quiz-result-box");
  const finalScore = document.getElementById("quiz-final-score");
  const finalMsg = document.getElementById("quiz-final-msg");
  const restartBtn = document.getElementById("quiz-restart-btn");

  function renderQuestion(idx) {
    const item = quizData[idx];
    counterBox.textContent = `Question ${idx + 1} of ${quizData.length}`;
    qText.textContent = item.q;
    optionsBox.innerHTML = "";
    feedbackBox.textContent = "";
    feedbackBox.className = "quiz-feedback";

    const selected = userAnswers[idx];

    item.options.forEach((optText, oIdx) => {
      const btn = document.createElement("button");
      btn.className = "quiz-opt-btn";
      btn.textContent = `${String.fromCharCode(65 + oIdx)}. ${optText}`;

      if (selected !== null) {
        btn.disabled = true;
        if (oIdx === item.answer) {
          btn.classList.add("opt-correct");
        } else if (oIdx === selected) {
          btn.classList.add("opt-wrong");
        }
      } else {
        btn.onclick = () => selectOption(oIdx);
      }

      optionsBox.appendChild(btn);
    });

    if (selected !== null) {
      if (selected === item.answer) {
        feedbackBox.textContent = `✓ Correct! ${item.explanation}`;
        feedbackBox.classList.add("feedback-correct");
      } else {
        feedbackBox.textContent = `✗ Incorrect. Correct answer is option ${String.fromCharCode(65 + item.answer)}. ${item.explanation}`;
        feedbackBox.classList.add("feedback-wrong");
      }
    }

    prevBtn.disabled = idx === 0;
    nextBtn.disabled = selected === null;
    nextBtn.textContent = idx === quizData.length - 1 ? "Finish Quiz →" : "Next Question →";
    updateScoreDisplay();
  }

  function selectOption(oIdx) {
    userAnswers[currentIdx] = oIdx;
    renderQuestion(currentIdx);
  }

  function updateScoreDisplay() {
    let score = 0;
    userAnswers.forEach((ans, i) => {
      if (ans === quizData[i].answer) score++;
    });
    scoreBox.textContent = `Score: ${score} / ${quizData.length}`;
  }

  prevBtn.onclick = () => {
    if (currentIdx > 0) {
      currentIdx--;
      renderQuestion(currentIdx);
    }
  };

  nextBtn.onclick = () => {
    if (currentIdx < quizData.length - 1) {
      currentIdx++;
      renderQuestion(currentIdx);
    } else {
      finishQuiz();
    }
  };

  function finishQuiz() {
    quizBox.style.display = "none";
    resultBox.style.display = "block";
    let score = 0;
    userAnswers.forEach((ans, i) => {
      if (ans === quizData[i].answer) score++;
    });
    finalScore.textContent = `Your Final Score: ${score} / ${quizData.length} (${Math.round((score / quizData.length) * 100)}%)`;
    if (score >= 18) {
      finalMsg.textContent = "Superb mastery! You have exceptional accuracy in sector/segment calculations and clock angle problems.";
    } else if (score >= 14) {
      finalMsg.textContent = "Good score! Review segment triangle subtractions and percentage change questions to achieve 100%.";
    } else {
      finalMsg.textContent = "Review the sector, segment, and clock formulas above, then re-attempt the quiz.";
    }
  }

  restartBtn.onclick = () => {
    userAnswers = new Array(quizData.length).fill(null);
    currentIdx = 0;
    resultBox.style.display = "none";
    quizBox.style.display = "block";
    renderQuestion(0);
  };

  renderQuestion(0);
})();
</script>

