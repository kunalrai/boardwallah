          <h3>Human Double Circulation Circuit</h3>
          <div class="svg-container">
            <svg viewBox="0 0 600 320" xmlns="http://www.w3.org/2000/svg">
              <rect width="600" height="320" fill="#f8fafc" />
              
              <!-- Pulmonary Capillaries (Lungs) -->
              <rect x="220" y="20" width="160" height="40" rx="8" fill="#e0f2fe" stroke="#0284c7" stroke-width="2" />
              <text x="300" y="45" text-anchor="middle" font-size="13" font-weight="700" fill="#0369a1">🫁 LUNG CAPILLARIES</text>

              <!-- Heart Center -->
              <rect x="180" y="90" width="240" height="140" rx="10" fill="#fff" stroke="#475569" stroke-width="2" />
              <line x1="300" y1="90" x2="300" y2="230" stroke="#cbd5e1" stroke-width="2" stroke-dasharray="4" />
              <line x1="180" y1="160" x2="420" y2="160" stroke="#cbd5e1" stroke-width="2" />
              
              <!-- Chambers -->
              <rect x="190" y="100" width="100" height="50" rx="4" fill="#fee2e2" />
              <text x="240" y="130" text-anchor="middle" font-size="11" font-weight="700" fill="#991b1b">Right Atrium</text>
              <rect x="310" y="100" width="100" height="50" rx="4" fill="#dbeafe" />
              <text x="360" y="130" text-anchor="middle" font-size="11" font-weight="700" fill="#1e40af">Left Atrium</text>

              <rect x="190" y="170" width="100" height="50" rx="4" fill="#fee2e2" />
              <text x="240" y="200" text-anchor="middle" font-size="11" font-weight="700" fill="#991b1b">Right Ventricle</text>
              <rect x="310" y="170" width="100" height="50" rx="4" fill="#dbeafe" />
              <text x="360" y="200" text-anchor="middle" font-size="11" font-weight="700" fill="#1e40af">Left Ventricle</text>

              <!-- Body Capillaries (Bottom) -->
              <rect x="220" y="260" width="160" height="40" rx="8" fill="#fef3c7" stroke="#d97706" stroke-width="2" />
              <text x="300" y="285" text-anchor="middle" font-size="13" font-weight="700" fill="#92400e">🧬 BODY TISSUES</text>

              <!-- Circulation Paths -->
              <!-- RV to Lungs (Pulmonary Artery - Blue) -->
              <path d="M 210 170 C 120 130, 120 40, 220 40" fill="none" stroke="#dc2626" stroke-width="2.5" />
              <text x="110" y="85" font-size="10" font-weight="700" fill="#dc2626">Pulmonary Artery</text>

              <!-- Lungs to LA (Pulmonary Vein - Red) -->
              <path d="M 380 40 C 480 40, 480 130, 390 120" fill="none" stroke="#2563eb" stroke-width="2.5" />
              <text x="490" y="85" font-size="10" font-weight="700" fill="#2563eb">Pulmonary Vein</text>

              <!-- LV to Body (Aorta - Red) -->
              <path d="M 390 200 C 480 220, 480 280, 380 280" fill="none" stroke="#2563eb" stroke-width="2.5" />
              <text x="495" y="250" font-size="10" font-weight="700" fill="#2563eb">Aorta (Systemic)</text>

              <!-- Body to RA (Vena Cava - Blue) -->
              <path d="M 220 280 C 120 280, 120 200, 210 130" fill="none" stroke="#dc2626" stroke-width="2.5" />
              <text x="110" y="250" font-size="10" font-weight="700" fill="#dc2626">Vena Cava</text>
            </svg>
          </div>
          <p class="caption">Figure 1: Complete double circulation ensuring oxygen-rich blood remains strictly segregated from deoxygenated blood.</p>
        </article>

        <article class="card visual-card">
          <span class="visual-badge">Renal Microscopic Anatomy</span>
          <h3>Structure of a Nephron &amp; Filtration</h3>
          <div class="svg-container">
            <svg viewBox="0 0 600 320" xmlns="http://www.w3.org/2000/svg">
              <rect width="600" height="320" fill="#f8fafc" />
              
              <!-- Glomerulus & Bowman's Capsule -->
              <circle cx="90" cy="100" r="40" fill="#fee2e2" stroke="#dc2626" stroke-width="2" />
              <circle cx="90" cy="100" r="24" fill="#f87171" />
              <text x="90" y="160" text-anchor="middle" font-size="11" font-weight="700" fill="#991b1b">Bowman's Capsule</text>
              <text x="90" y="175" text-anchor="middle" font-size="9" fill="#7f1d1d">(Glomerulus inside)</text>

              <!-- Proximal Tubule -->
              <path d="M 130 100 Q 180 40 220 100 T 260 160" fill="none" stroke="#0284c7" stroke-width="6" />
              <text x="190" y="60" text-anchor="middle" font-size="10" font-weight="700" fill="#0369a1">PCT (Reabsorption of Glucose/Amino Acids)</text>

              <!-- Loop of Henle -->
              <path d="M 260 160 L 260 260 Q 300 290 340 260 L 340 160" fill="none" stroke="#0284c7" stroke-width="5" />
              <text x="300" y="240" text-anchor="middle" font-size="11" font-weight="700" fill="#0284c7">Loop of Henle</text>
              <text x="300" y="255" text-anchor="middle" font-size="9" fill="#0369a1">(Water &amp; Salt conservation)</text>

              <!-- Distal Tubule & Collecting Duct -->
              <path d="M 340 160 Q 380 90 430 140" fill="none" stroke="#0284c7" stroke-width="6" />
              <text x="390" y="100" text-anchor="middle" font-size="10" font-weight="700" fill="#0369a1">DCT (Secretion)</text>

              <rect x="440" y="40" width="30" height="240" rx="6" fill="#fef3c7" stroke="#d97706" stroke-width="2" />
              <text x="495" y="150" font-size="11" font-weight="700" fill="#92400e">Collecting Duct</text>
              <text x="495" y="170" font-size="9" fill="#78350f">Urine &rarr; Ureter</text>

              <!-- Reabsorption arrows -->
              <path d="M 200 110 L 200 140" stroke="#16a34a" stroke-width="2" marker-end="url(#arrow)" />
              <text x="210" y="130" font-size="9" font-weight="700" fill="#166534">99% Water back to blood</text>
            </svg>
          </div>
          <p class="caption">Figure 2: Functional nephron units execute ultrafiltration, selective tubular reabsorption, and urine concentration.</p>
        </article>
      </div>
    </section>

    <!-- Quiz Section -->
    <section class="section">
      <div class="quiz-header">
        <div>
          <h2>CBSE Board Examination Practice: Life Processes</h2>
          <p class="muted">20 High-yield questions testing enzymatic actions, respiration equations, cardiac valves, and nephron reabsorption.</p>
        </div>
        <div class="quiz-score-badge" id="quizScoreBadge">Score: 0 / 20</div>
      </div>

      <div class="quiz-container" id="quizApp"></div>

      <div class="quiz-footer-actions">
        <span class="muted" id="quizProgressText">0 of 20 answered</span>
        <button class="button secondary" id="resetQuizBtn">Reset Quiz</button>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-banner">
      <h2>Excel in CBSE Class 10 Biology with Expert Mentorship</h2>
      <p>Master physiological pathways, labeled diagram practice, and NCERT exemplars with 1-on-1 tutoring.</p>
      <a class="button" href={calBookingUrl} target="_blank" rel="noopener noreferrer">Book Your Free Trial Class</a>
    </section>
  </div>
</Layout>

<script is:inline>
  const questions = [
    {
      q: "Which enzyme is present in human saliva, and what is its specific digestive action on food?",
      opts: [
        "Pepsin; it digests dietary proteins into peptones",
        "Salivary amylase (ptyalin); it breaks down starch into simpler maltose sugar",
        "Lipase; it emulsifies fats into fatty acids",
        "Trypsin; it converts complex polysaccharides into glucose"
      ],
      correct: 1,
      exp: "Salivary amylase secreted by salivary glands in the mouth initiates chemical digestion by converting starch into maltose."
    },
    {
      q: "Why is the inner wall of the small intestine lined with millions of tiny finger-like projections called villi?",
      opts: [
        "To secrete hydrochloric acid into the chyme",
        "To drastically increase the surface area for rapid absorption of digested nutrients into the bloodstream",
        "To prevent food from moving backward into the stomach",
        "To break down cellulose in herbivorous diets"
      ],
      correct: 1,
      exp: "Villi and microvilli enormously increase the absorptive surface area of the ileum, equipped with capillaries and lacteals for nutrient uptake."
    },
    {
      q: "What role does bile juice play in the human digestive system, considering it contains no enzymes?",
      opts: [
        "It digests carbohydrates into glucose",
        "It creates an acidic medium for pepsin activation",
        "It neutralizes the acidic chyme from the stomach and emulsifies large fat globules into tiny droplets for lipase action",
        "It absorbs water and forms solid feces"
      ],
      correct: 2,
      exp: "Bile salts provide an alkaline pH required by pancreatic enzymes and emulsify fat globules, multiplying the surface area for lipase to act."
    },
    {
      q: "During vigorous exercise, what causes sudden painful muscle cramps in athletes?",
      opts: [
        "Excessive production of carbon dioxide and water",
        "Accumulation of lactic acid due to anaerobic breakdown of pyruvate in muscle cells lacking sufficient oxygen",
        "Dehydration leading to protein breakdown in mitochondria",
        "Conversion of glucose into ethanol"
      ],
      correct: 1,
      exp: "When oxygen demand outpaces supply during intense exertion, muscle cells convert pyruvate into 3-carbon lactic acid, causing cramps."
    },
    {
      q: "What are the correct products formed during yeast fermentation (anaerobic respiration)?",
      opts: [
        "Lactic acid + Energy",
        "Ethanol + Carbon dioxide + Energy (2 ATP)",
        "Carbon dioxide + Water + 38 ATP",
        "Pyruvate + Oxygen"
      ],
      correct: 1,
      exp: "In the absence of oxygen, yeast cells break down pyruvate into 2-carbon ethanol, CO₂, and release a net yield of 2 ATP."
    },
    {
      q: "Where does the aerobic breakdown of pyruvate into carbon dioxide, water, and 36–38 ATP molecules take place inside a eukaryotic cell?",
      opts: [
        "Cytoplasm",
        "Ribosomes",
        "Mitochondria",
        "Endoplasmic reticulum"
      ],
      correct: 2,
      exp: "While initial glycolysis occurs in the cytoplasm, aerobic respiration (Krebs cycle and oxidative phosphorylation) occurs inside mitochondria."
    },
    {
      q: "Why do fishes exhibit a much faster breathing rate compared to terrestrial organisms like dogs and humans?",
      opts: [
        "Because fish swim continuously without rest",
        "Because the amount of dissolved oxygen in water is fairly low compared to the high oxygen concentration in atmospheric air",
        "Because fish lungs have smaller surface areas",
        "Because fish blood lacks hemoglobin"
      ],
      correct: 1,
      exp: "Water contains only ~0.7% dissolved oxygen by volume compared to ~21% in air, requiring aquatic animals to pass water rapidly over gills."
    },
    {
      q: "Which chamber of the human heart possesses the thickest, most muscular muscular wall, and why?",
      opts: [
        "Right Atrium, because it receives blood from the entire body",
        "Right Ventricle, because it pumps blood to the nearby lungs",
        "Left Ventricle, because it must pump oxygenated blood under high pressure through the aorta to the entire systemic body",
        "Left Atrium, because it receives oxygenated blood from the pulmonary vein"
      ],
      correct: 2,
      exp: "The left ventricle pumps blood across the entire systemic circulation to all distant body tissues against high arterial resistance, necessitating a thick muscular wall."
    },
    {
      q: "What prevents the backflow of deoxygenated blood in human veins where blood pressure is relatively low?",
      opts: [
        "Thick elastic muscular walls",
        "Internal pocket valves that allow blood to flow in only one direction toward the heart",
        "Continuous suction from the liver",
        "High capillary resistance"
      ],
      correct: 1,
      exp: "Veins feature one-way valves along their length that close automatically to prevent gravity-induced retrograde flow."
    },
    {
      q: "Which component of human blood is specifically responsible for initiating the clotting mechanism at sites of vessel injury?",
      opts: [
        "Erythrocytes (Red Blood Cells)",
        "Blood Platelets (Thrombocytes)",
        "Leukocytes (White Blood Cells)",
        "Blood Plasma proteins"
      ],
      correct: 1,
      exp: "Platelets aggregate at injury sites and release thromboplastin to convert prothrombin into thrombin, generating a fibrin clot."
    },
    {
      q: "What is the primary physical driving force responsible for the upward movement of water in tall trees during the daytime?",
      opts: [
        "Active ATP pumping by root cells",
        "Transpiration pull generated by the continuous evaporation of water molecules from leaf stomatal pores",
        "Osmotic suction from the phloem tissue",
        "Gravitational pull on the trunk"
      ],
      correct: 1,
      exp: "Transpiration creates a negative pressure tension (transpiration pull) in xylem vessels that lifts continuous columns of water to tall heights."
    },
    {
      q: "How does the translocation of sucrose in phloem tissue fundamentally differ from water transport in xylem?",
      opts: [
        "Xylem transport requires ATP, whereas phloem is completely passive",
        "Phloem translocation is an active process utilizing ATP energy to generate osmotic pressure, whereas xylem relies on physical capillary/transpiration forces",
        "Phloem only transports water downwards",
        "Xylem moves food during winter months"
      ],
      correct: 1,
      exp: "Translocation of food in phloem requires energy from ATP to build up osmotic pressure that moves sucrose bidirectionally to target tissues."
    },
    {
      q: "What is the initial volume of glomerular filtrate formed daily by healthy human kidneys, and how much actual urine is excreted?",
      opts: [
        "50 litres filtrate; 25 litres excreted",
        "180 litres filtrate; only about 1.5 to 2 litres excreted due to massive tubular reabsorption",
        "5 litres filtrate; 5 litres excreted",
        "180 litres filtrate; 180 litres excreted"
      ],
      correct: 1,
      exp: "Kidneys filter ~180 litres of fluid daily through glomeruli, but ~99% of water and essential solutes are reabsorbed along nephron tubules."
    },
    {
      q: "Which nitrogenous waste product is primarily eliminated by human kidneys from the deamination of excess proteins in the liver?",
      opts: [
        "Ammonia",
        "Uric acid crystals",
        "Urea",
        "Creatine"
      ],
      correct: 2,
      exp: "Humans are ureotelic; the liver converts toxic ammonia from amino acid deamination into less toxic urea, which kidneys excrete in urine."
    },
    {
      q: "Which substance present in the initial glomerular filtrate is normally 100% reabsorbed in the proximal convoluted tubule (PCT) of a healthy individual?",
      opts: [
        "Urea",
        "Glucose",
        "Excess sodium ions",
        "Uric acid"
      ],
      correct: 1,
      exp: "Under healthy conditions, all filtered glucose and amino acids are completely reabsorbed by active transport in the PCT (appearance of glucose in urine indicates diabetes mellitus)."
    },
    {
      q: "How does an artificial kidney machine (hemodialyzer) clean the blood of a patient with end-stage renal failure?",
      opts: [
        "It uses electricity to shock blood proteins",
        "Blood passes through semi-permeable cellophane tubes surrounded by dialyzing fluid that removes urea by diffusion, with zero reabsorption",
        "It transplants synthetic nephrons into the kidney",
        "It boils the blood to evaporate excess water"
      ],
      correct: 1,
      exp: "Hemodialysis allows nitrogenous wastes like urea to diffuse out into dialyzing solution across a semi-permeable membrane without tubular reabsorption."
    },
    {
      q: "What is the primary function of the cartilaginous C-shaped rings supporting the human trachea?",
      opts: [
        "To produce vocal sounds during speech",
        "To prevent the respiratory airway from collapsing when there is less air in it",
        "To filter large dust particles before reaching lungs",
        "To absorb oxygen directly into neck arteries"
      ],
      correct: 1,
      exp: "Incomplete C-shaped hyaline cartilage rings keep the trachea continuously patent and prevent airway collapse under negative thoracic pressure."
    },
    {
      q: "How do desert plants (xerophytes) manage photosynthesis without losing catastrophic amounts of water through open stomata during the day?",
      opts: [
        "They do not perform photosynthesis at all",
        "They absorb sunlight during the day and take in CO₂ only at night, synthesizing an intermediate malic acid compound",
        "They open stomata only during torrential rain",
        "They obtain all carbohydrates from soil roots"
      ],
      correct: 1,
      exp: "Desert plants perform CAM photosynthesis, opening stomata at night to fix CO₂ into an organic acid, and utilizing daytime sunlight to complete glucose synthesis."
    },
    {
      q: "Why is double circulation indispensable for birds and mammals, unlike amphibians and reptiles?",
      opts: [
        "Birds and mammals have single-chambered hearts",
        "Birds and mammals are warm-blooded (homeothermic) and require high, constant supplies of oxygen to maintain a constant body temperature",
        "Reptiles possess three ventricles",
        "Fish lack circulatory capillaries"
      ],
      correct: 1,
      exp: "Endotherms (warm-blooded animals) have tremendous metabolic energy demands to sustain body temperature, necessitating complete separation of oxygenated and deoxygenated blood."
    },
    {
      q: "How do plants discard their accumulated metabolic waste products without specialized renal organs?",
      opts: [
        "They excrete wastes as gas via flowers",
        "They store wastes in cellular vacuoles, shedding leaves that accumulate waste, and depositing gums and resins in old non-functional xylem",
        "They convert all wastes into cellulose",
        "They release all waste chemicals through pollen"
      ],
      correct: 1,
      exp: "Plants store wastes in dead heartwood cells as resins and gums, inside cell vacuoles, and periodically drop old leaves containing accumulated wastes."
    }
  ];

  let userAnswers = {};

  function renderQuiz() {
    const container = document.getElementById('quizApp');
    if (!container) return;
    container.innerHTML = '';

    questions.forEach((qItem, idx) => {
      const card = document.createElement('div');
      card.className = 'quiz-card';

      const qTitle = document.createElement('h3');
      qTitle.className = 'quiz-question';
      qTitle.textContent = `${idx + 1}. ${qItem.q}`;
      card.appendChild(qTitle);

      const optsDiv = document.createElement('div');
      optsDiv.className = 'quiz-options';

      qItem.opts.forEach((optText, optIdx) => {
        const btn = document.createElement('button');
        btn.className = 'quiz-opt-btn';
        btn.textContent = optText;

        if (userAnswers[idx] !== undefined) {
          btn.disabled = true;
          if (optIdx === qItem.correct) {
            btn.classList.add('opt-correct');
          } else if (userAnswers[idx] === optIdx) {
            btn.classList.add('opt-wrong');
          }
        } else {
          btn.addEventListener('click', () => {
            userAnswers[idx] = optIdx;
            renderQuiz();
            updateScoreSummary();
          });
        }
        optsDiv.appendChild(btn);
      });

      card.appendChild(optsDiv);

      if (userAnswers[idx] !== undefined) {
        const fb = document.createElement('div');
        fb.className = 'quiz-feedback ' + (userAnswers[idx] === qItem.correct ? 'feedback-correct' : 'feedback-wrong');
        fb.innerHTML = (userAnswers[idx] === qItem.correct ? '<strong>✓ Correct!</strong> ' : '<strong>✗ Incorrect.</strong> ') + qItem.exp;
        card.appendChild(fb);
      }

      container.appendChild(card);
    });
  }

  function updateScoreSummary() {
    let score = 0;
    const answeredCount = Object.keys(userAnswers).length;
    for (let qIdx in userAnswers) {
      if (userAnswers[qIdx] === questions[qIdx].correct) {
        score++;
      }
    }
    const badge = document.getElementById('quizScoreBadge');
    if (badge) badge.textContent = `Score: ${score} / ${questions.length}`;

    const prog = document.getElementById('quizProgressText');
    if (prog) prog.textContent = `${answeredCount} of ${questions.length} answered`;
  }

  function resetQuiz() {
    userAnswers = {};
    renderQuiz();
    updateScoreSummary();
  }

  document.addEventListener('DOMContentLoaded', () => {
    renderQuiz();
    const resetBtn = document.getElementById('resetQuizBtn');
    if (resetBtn) resetBtn.addEventListener('click', resetQuiz);
  });
</script>

