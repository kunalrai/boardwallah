let current = 0;
let score = 0;
let answered = false;

const qEl     = document.getElementById('quiz-question') as HTMLElement;
const optsEl  = document.getElementById('quiz-options') as HTMLElement;
const fbEl    = document.getElementById('quiz-feedback') as HTMLElement;
const nextBtn = document.getElementById('quiz-next') as HTMLButtonElement;
const counter = document.getElementById('quiz-counter') as HTMLElement;
const fill    = document.getElementById('quiz-progress-fill') as HTMLElement;
const bar     = document.getElementById('quiz-progress-bar') as HTMLElement;
const result  = document.getElementById('quiz-result') as HTMLElement;
const card    = document.getElementById('quiz-card') as HTMLElement;
const retryBtn = document.getElementById('quiz-retry') as HTMLElement;

function render() {
  answered = false;
  nextBtn.disabled = true;
  fbEl.textContent = '';
  fbEl.className = 'quiz-feedback';

  const q = questions[current];
  counter.textContent = `Question ${current + 1} of ${questions.length}`;
  bar.setAttribute('aria-valuenow', String(current));
  fill.style.width = `${(current / questions.length) * 100}%`;

  qEl.textContent = q.q;
  optsEl.innerHTML = '';
  q.opts.forEach((opt, i) => {
    const li  = document.createElement('li');
    const btn = document.createElement('button');
    btn.className = 'button secondary quiz-opt-btn';
    btn.textContent = opt;
    btn.dataset.idx = String(i);
    btn.addEventListener('click', () => choose(i));
    li.appendChild(btn);
    optsEl.appendChild(li);
  });
}

function choose(idx: number) {
  if (answered) return;
  answered = true;
  const q = questions[current];
  const btns = optsEl.querySelectorAll<HTMLButtonElement>('.quiz-opt-btn');
  btns.forEach((btn, i) => {
    btn.disabled = true;
    if (i === q.ans) btn.classList.add('opt-correct');
    else if (i === idx) btn.classList.add('opt-wrong');
  });
  if (idx === q.ans) {
    score++;
    fbEl.textContent = '✅ Correct! ' + q.exp;
    fbEl.className = 'quiz-feedback feedback-correct';
  } else {
    fbEl.textContent = '❌ ' + q.exp;
    fbEl.className = 'quiz-feedback feedback-wrong';
  }
  nextBtn.disabled = false;
}

nextBtn.addEventListener('click', () => {
  current++;
  if (current >= questions.length) showResult();
  else render();
});

function showResult() {
  card.hidden = true;
  counter.hidden = true;
  result.hidden = false;
  fill.style.width = '100%';
  bar.setAttribute('aria-valuenow', String(questions.length));

  const pct = Math.round((score / questions.length) * 100);
  const scoreHead = document.getElementById('quiz-score-heading') as HTMLElement;
  const scoreMsg  = document.getElementById('quiz-score-msg') as HTMLElement;
  scoreHead.textContent = `You scored ${score} / ${questions.length} (${pct}%)`;
  if      (pct === 100) scoreMsg.textContent = '🏆 Perfect score! Outstanding preparation on Electricity.';
  else if (pct >= 80)   scoreMsg.textContent = '🌟 Excellent! You have strong mastery over circuit formulas and numericals.';
  else if (pct >= 60)   scoreMsg.textContent = '👍 Good attempt. Review the formula sheet above and try again.';
  else if (pct >= 40)   scoreMsg.textContent = '📚 Keep revising — check resistor combinations and retry.';
  else                  scoreMsg.textContent = "💡 Don't worry! Review the concepts and give it another shot.";
}

retryBtn.addEventListener('click', () => {
  current = 0; score = 0;
  card.hidden = false;
  counter.hidden = false;
  result.hidden = true;
  render();
});

// Circuit tabs switching
const tabSeriesParallel = document.getElementById("tab-btn-series-parallel");
const tabOhmsLaw = document.getElementById("tab-btn-ohms-law");
const panelSeriesParallel = document.getElementById("panel-series-parallel");
const panelOhmsLaw = document.getElementById("panel-ohms-law");

if (tabSeriesParallel && tabOhmsLaw && panelSeriesParallel && panelOhmsLaw) {
  tabSeriesParallel.addEventListener("click", () => {
    tabSeriesParallel.classList.remove("secondary");
    tabSeriesParallel.classList.add("active");
    tabSeriesParallel.setAttribute("aria-selected", "true");
    tabOhmsLaw.classList.add("secondary");
    tabOhmsLaw.classList.remove("active");
    tabOhmsLaw.setAttribute("aria-selected", "false");
    panelSeriesParallel.hidden = false;
    panelOhmsLaw.hidden = true;
  });

  tabOhmsLaw.addEventListener("click", () => {
    tabOhmsLaw.classList.remove("secondary");
    tabOhmsLaw.classList.add("active");
    tabOhmsLaw.setAttribute("aria-selected", "true");
    tabSeriesParallel.classList.add("secondary");
    tabSeriesParallel.classList.remove("active");
    tabSeriesParallel.setAttribute("aria-selected", "false");
    panelOhmsLaw.hidden = false;
    panelSeriesParallel.hidden = true;
  });
}

render();
</script>

