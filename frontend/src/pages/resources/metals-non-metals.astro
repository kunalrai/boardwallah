---
import Layout from "../../layouts/Layout.astro";
import { loadContent } from "../../lib/content";
import { calBookingUrl } from "../../lib/site";

const { provider } = loadContent();
---

<Layout
  title={`Metals and Non-metals | CBSE Class 10 Science | ${provider.name}`}
  description="Complete CBSE Class 10 Chemistry chapter on Metals and Non-metals. Covers physical & chemical properties, reactivity series, ionic bonding, metallurgy, roasting, calcination, corrosion prevention, and 20-question quiz."
>
  <div class="wrap">
    <nav class="small" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/subjects/">Subjects</a> / <a href="/resources/">Resources</a> / Metals &amp; Non-metals
    </nav>

    <div class="resource-header">
      <span class="eyebrow">CBSE Class 10 · Science · Chemistry</span>
      <h1>Metals and Non-metals</h1>
      <p class="lead">
        Comprehensive revision notes on metal reactivity, ionic electron transfer, metallurgical extraction, alloys, and an interactive 20-question board quiz.
      </p>
    </div>

    <!-- Key concepts -->
    <section class="section">
      <h2>Key Concepts at a Glance</h2>

      <div class="grid two concept-grid">
        <article class="card">
          <h3>🔨 Physical Properties &amp; Exceptions</h3>
          <ul class="clean-list">
            <li><strong>Malleability</strong>: Ability to be beaten into thin sheets (Gold &amp; Silver are most malleable).</li>
            <li><strong>Ductility</strong>: Ability to be drawn into thin wires (1g gold can make a 2 km wire!).</li>
            <li><strong>Exceptions in Metals</strong>:
              <ul>
                <li><strong>Mercury (Hg)</strong>: Only metal that is liquid at room temperature.</li>
                <li><strong>Gallium &amp; Caesium</strong>: Melt in your palm (very low melting points).</li>
                <li><strong>Sodium &amp; Potassium</strong>: Soft alkali metals easily cut with a knife; stored in kerosene to prevent fire.</li>
              </ul>
            </li>
            <li><strong>Exceptions in Non-metals</strong>:
              <ul>
                <li><strong>Bromine (Br₂)</strong>: Only non-metal that is liquid at room temperature.</li>
                <li><strong>Iodine</strong>: Lustrous non-metal.</li>
                <li><strong>Graphite (Carbon allotrope)</strong>: Good conductor of electricity.</li>
                <li><strong>Diamond (Carbon allotrope)</strong>: Hardest natural substance with very high melting point.</li>
              </ul>
            </li>
          </ul>
        </article>

        <article class="card">
          <h3>🔥 Chemical Properties of Metals</h3>
          <ul class="clean-list">
            <li><strong>Reaction with Oxygen</strong>: Metal + O₂ ⟶ Metal Oxide (Basic).
              <br/>• <strong>Amphoteric Oxides</strong>: Show both acidic and basic properties (e.g., <strong>Al₂O₃</strong> and <strong>ZnO</strong> react with both acids and bases).
              <br/>Al₂O₃ + 6HCl ⟶ 2AlCl₃ + 3H₂O
              <br/>Al₂O₃ + 2NaOH ⟶ 2NaAlO₂ (Sodium aluminate) + H₂O</li>
            <li><strong>Reaction with Water</strong>:
              <br/>• Na &amp; K react violently with cold water (H₂ catches fire).
              <br/>• Ca reacts less violently with cold water (floats as H₂ bubbles stick to it).
              <br/>• Mg reacts only with hot water.
              <br/>• Al, Fe, Zn react only with steam: 3Fe + 4H₂O (g) ⟶ Fe₃O₄ + 4H₂↑.
              <br/>• Cu, Ag, Au, Pb do not react with water or steam at all.</li>
            <li><strong>Aqua Regia</strong>: Fresh mixture of conc. HCl and conc. HNO₃ in <strong>3:1 ratio</strong>; dissolves noble metals like gold and platinum.</li>
          </ul>
        </article>

        <article class="card">
          <h3>⚡ The Reactivity Series</h3>
          <p class="formula">K &gt; Na &gt; Ca &gt; Mg &gt; Al &gt; Zn &gt; Fe &gt; Pb &gt; [H] &gt; Cu &gt; Hg &gt; Ag &gt; Au</p>
          <ul class="clean-list">
            <li>Metals above Hydrogen in the activity series displace H₂ gas from dilute acids.</li>
            <li>A more reactive metal displaces a less reactive metal from its salt solution (e.g., Zn + CuSO₄ ⟶ ZnSO₄ + Cu).</li>
            <li><strong>Mnemonic Trick</strong>: <em>"Please Stop Calling Me A Zebra In The Lead House, Can Many Scientists Assist?"</em></li>
          </ul>
        </article>

        <article class="card">
          <h3>⚛️ Ionic Bonding &amp; Ionic Compounds</h3>
          <ul class="clean-list">
            <li>Formed by complete transfer of electrons from a metal (cation) to a non-metal (anion). Example: NaCl, MgCl₂.
              <br/>• Na (2,8,1) ⟶ Na⁺ (2,8) + e⁻
              <br/>• Cl (2,8,7) + e⁻ ⟶ Cl⁻ (2,8,8)
              <br/>• Strong electrostatic force of attraction between oppositely charged ions.</li>
            <li><strong>Properties of Ionic Compounds</strong>:
              <ol>
                <li>Solid and brittle crystalline nature.</li>
                <li><strong>High melting and boiling points</strong> due to strong inter-ionic electrostatic forces.</li>
                <li>Soluble in water, insoluble in organic solvents (kerosene, petrol).</li>
                <li><strong>Conduct electricity only in molten state or aqueous solution</strong> (ions are free to move), but do NOT conduct in solid state.</li>
              </ol>
            </li>
          </ul>
        </article>

        <article class="card">
          <h3>⛏️ Extraction of Metals (Metallurgy)</h3>
          <ul class="clean-list">
            <li><strong>Ores</strong>: Minerals from which metals can be extracted profitably.</li>
            <li><strong>Gangue</strong>: Sand, soil, and rocky impurities associated with mined ores.</li>
            <li><strong>Roasting</strong>: Heating sulphide ores in the <strong>presence of excess air</strong> (e.g., 2ZnS + 3O₂ ⟶ 2ZnO + 2SO₂↑).</li>
            <li><strong>Calcination</strong>: Heating carbonate ores in the <strong>absence or limited supply of air</strong> (e.g., ZnCO₃ ⟶ ZnO + CO₂↑).</li>
            <li><strong>Reduction</strong>: Metal oxides reduced to metals using Carbon (Coke) or reactive metals (Thermite process: Fe₂O₃ + 2Al ⟶ 2Fe + Al₂O₃ + Heat used to weld railway tracks).</li>
            <li><strong>Electrolytic Refining</strong>: Highly electropositive metals (Na, Mg, Al) extracted by electrolysis of their molten chlorides/oxides. In copper refining: Impure Cu is Anode (+), pure Cu strip is Cathode (−), and acidified CuSO₄ is electrolyte.</li>
          </ul>
        </article>

        <article class="card">
          <h3>🛡️ Corrosion Prevention &amp; Alloys</h3>
          <ul class="clean-list">
            <li><strong>Corrosion Prevention</strong>: Painting, oiling, greasing, <strong>Galvanization</strong> (coating iron with a protective thin layer of Zinc metal).</li>
            <li><strong>Alloy</strong>: Homogeneous mixture of two or more metals, or a metal and a non-metal. Enhances strength, corrosion resistance, and lowers electrical conductivity.
              <ul>
                <li><strong>Steel</strong>: Iron + small amount of Carbon (0.05%) (hard and strong).</li>
                <li><strong>Stainless Steel</strong>: Iron + Nickel + Chromium (does not rust).</li>
                <li><strong>Brass</strong>: Copper (Cu) + Zinc (Zn).</li>
                <li><strong>Bronze</strong>: Copper (Cu) + Tin (Sn).</li>
                <li><strong>Solder</strong>: Lead (Pb) + Tin (Sn) (low melting point; used for welding electrical wires).</li>
                <li><strong>Amalgam</strong>: Any alloy in which one of the metals is Mercury (Hg).</li>
              </ul>
            </li>
          </ul>
        </article>
      </div>
    </section>

    <!-- Visual Diagrams Section -->
    <section class="section" id="visual-metals">
      <div class="rules-header">
        <span class="eyebrow">Interactive Visual Schematics</span>
        <h2>Reactivity Order &amp; Electrolytic Refining</h2>
        <p class="lead">
          Visual guides for metal activity, ionic electron transfer, and copper purification:
        </p>
      </div>

      <!-- Tab Switcher -->
      <div class="rules-tabs" role="tablist" aria-label="Metals diagram categories">
        <button class="button rules-tab-btn active" id="tab-btn-reactivity" type="button" role="tab" aria-selected="true" aria-controls="panel-reactivity">
          ⚡ Reactivity Series Hierarchy
        </button>
        <button class="button secondary rules-tab-btn" id="tab-btn-refining" type="button" role="tab" aria-selected="false" aria-controls="panel-refining">
          🔬 Electrolytic Refining of Copper
        </button>
      </div>

      <!-- Panel 1: Reactivity Series -->
      <div class="rules-panel" id="panel-reactivity" role="tabpanel" aria-labelledby="tab-btn-reactivity">
        <article class="card rule-card" style="max-width:760px;margin-inline:auto">
          <div class="rule-badge">CBSE Metal Reactivity Series &amp; Extraction Method</div>
          <div class="rule-diagram">
            <svg viewBox="0 0 460 220" class="ray-svg" aria-label="Reactivity Series Diagram">
              <rect width="460" height="220" rx="8" fill="#f8fafc" />
              <!-- Top tier (Highly reactive) -->
              <rect x="30" y="20" width="400" height="50" rx="6" fill="#fef2f2" stroke="#ef4444" stroke-width="1.8" />
              <text x="50" y="45" font-size="13" font-weight="bold" fill="#dc2626">K &gt; Na &gt; Ca &gt; Mg &gt; Al</text>
              <text x="50" y="60" font-size="10" fill="#64748b">Highly Reactive · Extracted by Electrolysis of molten chlorides</text>
              <text x="410" y="48" text-anchor="end" font-size="10" font-weight="bold" fill="#dc2626">Electrolytic Reduction</text>
              <!-- Middle tier (Moderately reactive) -->
              <rect x="30" y="85" width="400" height="50" rx="6" fill="#fff7ed" stroke="#f97316" stroke-width="1.8" />
              <text x="50" y="110" font-size="13" font-weight="bold" fill="#ea580c">Zn &gt; Fe &gt; Pb &gt; [H] &gt; Cu</text>
              <text x="50" y="125" font-size="10" fill="#64748b">Moderately Reactive · Found as Sulphides/Carbonates · Reduced by Carbon</text>
              <text x="410" y="113" text-anchor="end" font-size="10" font-weight="bold" fill="#ea580c">Roasting / Calcination + C</text>
              <!-- Bottom tier (Least reactive) -->
              <rect x="30" y="150" width="400" height="50" rx="6" fill="#f0fdf4" stroke="#22c55e" stroke-width="1.8" />
              <text x="50" y="175" font-size="13" font-weight="bold" fill="#15803d">Ag &gt; Au &gt; Pt</text>
              <text x="50" y="190" font-size="10" fill="#64748b">Least Reactive · Found in Free/Native metallic state</text>
              <text x="410" y="178" text-anchor="end" font-size="10" font-weight="bold" fill="#15803d">Found Free in Nature</text>
            </svg>
          </div>
          <div class="rule-body">
            <h4>Reactivity Determines Extraction Technique:</h4>
            <p>1. <strong>Top metals</strong> have high affinity for oxygen and cannot be reduced by carbon; they require electrolytic reduction.<br/>2. <strong>Middle metals</strong> are converted to oxides via roasting/calcination and reduced with carbon coke.<br/>3. <strong>Bottom noble metals</strong> occur naturally uncombined.</p>
          </div>
        </article>
      </div>

      <!-- Panel 2: Electrolytic Refining -->
      <div class="rules-panel" id="panel-refining" role="tabpanel" aria-labelledby="tab-btn-refining" hidden>
        <article class="card rule-card" style="max-width:760px;margin-inline:auto">
          <div class="rule-badge">Purification of Copper by Electrolysis</div>
          <div class="rule-diagram">
            <svg viewBox="0 0 460 210" class="ray-svg" aria-label="Electrolytic Refining of Copper">
              <rect width="460" height="210" rx="8" fill="#f8fafc" />
              <!-- Tank -->
              <rect x="70" y="40" width="320" height="130" rx="6" fill="rgba(37, 99, 235, 0.15)" stroke="#1e3a8a" stroke-width="2" />
              <!-- Anode (+) Impure Copper block -->
              <rect x="130" y="55" width="28" height="95" fill="#a12b2b" rx="2" />
              <text x="144" y="45" text-anchor="middle" font-size="10" font-weight="bold" fill="#a12b2b">Anode (+)</text>
              <text x="144" y="105" text-anchor="middle" font-size="9" fill="#fff">Impure Cu</text>
              <!-- Cathode (-) Thin Pure Copper strip -->
              <rect x="290" y="55" width="12" height="95" fill="#15803d" rx="2" />
              <text x="296" y="45" text-anchor="middle" font-size="10" font-weight="bold" fill="#15803d">Cathode (−)</text>
              <text x="296" y="105" text-anchor="middle" font-size="9" fill="#fff" transform="rotate(-90, 296, 105)">Pure Cu</text>
              <!-- Electrolyte label -->
              <text x="220" y="100" text-anchor="middle" font-size="11" font-weight="bold" fill="#1e3a8a">Acidified CuSO₄ Solution</text>
              <text x="220" y="118" text-anchor="middle" font-size="10" fill="#0f4c5c">Cu²⁺ ⟶ Cathode</text>
              <!-- Anode mud -->
              <ellipse cx="144" cy="165" rx="22" ry="5" fill="#475569" />
              <text x="144" y="185" text-anchor="middle" font-size="10" font-weight="bold" fill="#475569">Anode Mud (Insoluble Ag, Au)</text>
              <!-- Wiring to Battery -->
              <line x1="144" y1="55" x2="144" y2="20" stroke="#334155" stroke-width="2" />
              <line x1="296" y1="55" x2="296" y2="20" stroke="#334155" stroke-width="2" />
              <path d="M 144 20 L 200 20" stroke="#334155" stroke-width="2" />
              <path d="M 296 20 L 240 20" stroke="#334155" stroke-width="2" />
              <!-- Battery symbol -->
              <line x1="200" y1="12" x2="200" y2="28" stroke="#0f4c5c" stroke-width="3" />
              <line x1="210" y1="16" x2="210" y2="24" stroke="#334155" stroke-width="2" />
              <line x1="220" y1="12" x2="220" y2="28" stroke="#0f4c5c" stroke-width="3" />
              <line x1="230" y1="16" x2="230" y2="24" stroke="#334155" stroke-width="2" />
            </svg>
          </div>
          <div class="rule-body">
            <h4>Anode Mud &amp; Pure Copper Deposition:</h4>
            <p>1. At the positive <strong>Anode</strong>, impure copper dissolves as Cu²⁺ ions.<br/>2. At the negative <strong>Cathode</strong>, pure copper ions deposit as pure copper metal.<br/>3. Insoluble impurities (gold, silver, platinum) settle below the anode as <strong>Anode Mud</strong>.</p>
          </div>
        </article>
      </div>
    </section>

    <!-- Quiz -->
    <section class="section quiz-root" id="quiz-root">
      <h2 class="quiz-heading">🧪 Metals &amp; Non-metals Chapter Quiz — 20 Board Questions</h2>
      <p class="muted" style="margin-bottom:1.5rem">Practice with high-yield questions on reactivity order, amphoteric oxides, ionic compounds, metallurgy, and alloys.</p>

      <div class="quiz-progress-bar" id="quiz-progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="20" aria-valuenow="0">
        <div class="quiz-progress-fill" id="quiz-progress-fill"></div>
      </div>
      <p class="quiz-counter" id="quiz-counter">Question 1 of 20</p>

      <div class="quiz-card card" id="quiz-card">
        <p class="quiz-question" id="quiz-question"></p>
        <ul class="quiz-options" id="quiz-options"></ul>
        <p class="quiz-feedback" id="quiz-feedback" aria-live="polite"></p>
        <div class="quiz-actions">
          <button class="button" id="quiz-next" disabled>Next →</button>
        </div>
      </div>

      <div class="quiz-result card" id="quiz-result" hidden>
        <h3 id="quiz-score-heading"></h3>
        <p id="quiz-score-msg"></p>
        <div class="actions" style="justify-content:center;margin-top:1rem">
          <button class="button secondary" id="quiz-retry">↺ Try Again</button>
          <a class="button" href={calBookingUrl} target="_blank" rel="noopener noreferrer">Book Free Trial</a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-banner">
      <h2>Need personalized help with Chemistry &amp; Metallurgy?</h2>
      <p>Book a free {provider.trial.duration_minutes}-minute trial session with {provider.tutor_name} (online or at home) for CBSE Class 10 board preparation.</p>
      <a class="button" href={calBookingUrl} target="_blank" rel="noopener noreferrer">Book Free Trial</a>
    </section>
  </div>
</Layout>

<script>
const questions = [
  {
    q: "Which metal is liquid at room temperature?",
    opts: ["Sodium", "Mercury (Hg)", "Bromine", "Gallium"],
    ans: 1,
    exp: "Mercury is the only metal that is liquid at room temperature. Bromine is a liquid non-metal."
  },
  {
    q: "Aluminium oxide (Al₂O₃) reacts with both hydrochloric acid and sodium hydroxide. Such metal oxides are called:",
    opts: ["Acidic oxides", "Basic oxides", "Amphoteric oxides", "Neutral oxides"],
    ans: 2,
    exp: "Oxides that react with both acids and bases to produce salt and water are called amphoteric oxides (e.g., Al₂O₃, ZnO)."
  },
  {
    q: "Which of the following metals does NOT react with cold water or hot water, but reacts with steam to produce hydrogen gas?",
    opts: ["Sodium", "Calcium", "Iron", "Copper"],
    ans: 2,
    exp: "Iron does not react with cold or hot water, but reacts with steam: 3Fe (s) + 4H₂O (g) ⟶ Fe₃O₄ (s) + 4H₂ (g)."
  },
  {
    q: "Aqua regia, capable of dissolving noble metals like gold and platinum, is a fresh mixture of:",
    opts: [
      "Conc. HCl and Conc. HNO₃ in 3:1 ratio",
      "Conc. HNO₃ and Conc. HCl in 3:1 ratio",
      "Conc. H₂SO₄ and Conc. HCl in 1:3 ratio",
      "Dilute HCl and Conc. HNO₃ in 1:1 ratio"
    ],
    ans: 0,
    exp: "Aqua regia is a 3:1 mixture of concentrated hydrochloric acid (HCl) and concentrated nitric acid (HNO₃)."
  },
  {
    q: "Which of the following elements displaces iron from iron sulphate solution?",
    opts: ["Copper", "Silver", "Zinc", "Lead"],
    ans: 2,
    exp: "Zinc is above iron in the reactivity series (Zn > Fe), so zinc displaces iron to form colourless ZnSO₄."
  },
  {
    q: "Why do ionic compounds have high melting and boiling points?",
    opts: [
      "They have weak intermolecular forces",
      "They have strong electrostatic forces of attraction between oppositely charged ions",
      "They are non-crystalline",
      "They contain shared pairs of electrons"
    ],
    ans: 1,
    exp: "A large amount of thermal energy is required to break the strong electrostatic ionic bonds between cations and anions."
  },
  {
    q: "Solid sodium chloride (NaCl) does NOT conduct electricity, but its aqueous solution does, because:",
    opts: [
      "In solid state, ions cannot move freely, whereas in water, ions are free to migrate",
      "Water provides free electrons",
      "NaCl decomposes into neutral atoms in water",
      "Solid NaCl contains no ions"
    ],
    ans: 0,
    exp: "Ionic solids have a rigid lattice holding ions fixed. In water or molten state, the ions dissociate and move freely to conduct current."
  },
  {
    q: "The process of heating sulphide ores strongly in the presence of excess air is known as:",
    opts: ["Calcination", "Roasting", "Reduction", "Refining"],
    ans: 1,
    exp: "Roasting converts sulphide ores into metal oxides in excess air (e.g. 2ZnS + 3O₂ ⟶ 2ZnO + 2SO₂)."
  },
  {
    q: "Calcination is used for which type of ore?",
    opts: ["Sulphide ores in excess air", "Carbonate ores in limited or no air", "Chloride ores in oxygen", "Oxide ores"],
    ans: 1,
    exp: "Calcination is the heating of carbonate ores in the absence/limited supply of air to expel CO₂ (e.g. ZnCO₃ ⟶ ZnO + CO₂)."
  },
  {
    q: "In the Thermite reaction used to join railway tracks, iron(III) oxide is reduced by:",
    opts: ["Carbon coke", "Aluminium powder", "Hydrogen gas", "Carbon monoxide"],
    ans: 1,
    exp: "Fe₂O₃ + 2Al ⟶ 2Fe (molten) + Al₂O₃ + Heat. Aluminium reduces iron oxide in a highly exothermic reaction."
  },
  {
    q: "During the electrolytic refining of copper, the anode is made of:",
    opts: ["Pure copper strip", "Impure copper block", "Graphite rod", "Platinum wire"],
    ans: 1,
    exp: "The impure copper block is made the anode (+), pure copper strip is the cathode (−), and acidified CuSO₄ is the electrolyte."
  },
  {
    q: "The insoluble impurities that settle down at the bottom of the anode during electrolytic refining are called:",
    opts: ["Slag", "Gangue", "Anode mud", "Flux"],
    ans: 2,
    exp: "Insoluble impurities like silver, gold, and platinum settle below the anode as anode mud."
  },
  {
    q: "Galvanization is a method of protecting steel and iron from rusting by coating them with a thin layer of:",
    opts: ["Tin", "Zinc", "Copper", "Silver"],
    ans: 1,
    exp: "Galvanization coats iron/steel with Zinc. Even if the zinc layer is scratched, zinc corrodes preferentially (sacrificial protection)."
  },
  {
    q: "An alloy of mercury with any other metal is termed an:",
    opts: ["Amalgam", "Solder", "Bronze", "Brass"],
    ans: 0,
    exp: "An alloy containing mercury as one of its constituent metals is called an amalgam (e.g., sodium amalgam, dental amalgam)."
  },
  {
    q: "Solder, an alloy used for welding electrical wires, is composed of:",
    opts: ["Copper and Tin", "Copper and Zinc", "Lead and Tin", "Iron and Carbon"],
    ans: 2,
    exp: "Solder is an alloy of Lead (Pb) and Tin (Sn) with a low melting point, ideal for electrical joints."
  },
  {
    q: "Brass is an alloy of:",
    opts: ["Copper and Tin", "Copper and Zinc", "Iron and Chromium", "Lead and Tin"],
    ans: 1,
    exp: "Brass = Copper (Cu) + Zinc (Zn). Bronze = Copper (Cu) + Tin (Sn)."
  },
  {
    q: "Stainless steel is prepared by adding which elements to iron?",
    opts: ["Nickel and Chromium", "Copper and Zinc", "Tin and Lead", "Magnesium and Aluminium"],
    ans: 0,
    exp: "Stainless steel contains iron, nickel, and chromium, giving it high tensile strength and complete resistance to rust."
  },
  {
    q: "Which non-metal is lustrous and shines like a metal?",
    opts: ["Sulphur", "Iodine", "Carbon", "Phosphorus"],
    ans: 1,
    exp: "Iodine is a non-metal that possesses a distinct metallic lustre."
  },
  {
    q: "Why are sodium and potassium stored under kerosene oil?",
    opts: [
      "To prevent them from evaporating",
      "They react violently with oxygen and moisture in air, catching fire immediately",
      "To keep them shiny",
      "Kerosene makes them hard"
    ],
    ans: 1,
    exp: "Sodium and potassium react vigorously with oxygen and moisture at room temperature to form hydroxides and catch fire."
  },
  {
    q: "When calcium metal reacts with water, it starts floating because:",
    opts: [
      "Calcium is lighter than water",
      "Bubbles of hydrogen gas produced stick to the calcium surface, making it buoyant",
      "Water boils instantly",
      "Calcium dissolves into air"
    ],
    ans: 1,
    exp: "The reaction Ca + 2H₂O ⟶ Ca(OH)₂ + H₂ is less violent; bubbles of H₂ gas stick to the metal, causing it to float."
  }
];

let current = 0;
let score = 0;
let answered = false;

const qEl     = document.getElementById('quiz-question') as HTMLElement;
const optsEl  = document.getElementById('quiz-options') as HTMLElement;
const fbEl    = document.getElementById('quiz-feedback') as HTMLElement;
const nextBtn = document.getElementById('quiz-next') as HTMLButtonElement;
const counter = document.getElementById('quiz-counter') as HTMLElement;
const fill    = document.getElementById('quiz-progress-fill') as HTMLElement;
const bar     = document.getElementById('quiz-progress-bar') as HTMLElement;
const result  = document.getElementById('quiz-result') as HTMLElement;
const card    = document.getElementById('quiz-card') as HTMLElement;
const retryBtn = document.getElementById('quiz-retry') as HTMLElement;

function render() {
  answered = false;
  nextBtn.disabled = true;
  fbEl.textContent = '';
  fbEl.className = 'quiz-feedback';

  const q = questions[current];
  counter.textContent = `Question ${current + 1} of ${questions.length}`;
  bar.setAttribute('aria-valuenow', String(current));
  fill.style.width = `${(current / questions.length) * 100}%`;

  qEl.textContent = q.q;
  optsEl.innerHTML = '';
  q.opts.forEach((opt, i) => {
    const li  = document.createElement('li');
    const btn = document.createElement('button');
    btn.className = 'button secondary quiz-opt-btn';
    btn.textContent = opt;
    btn.dataset.idx = String(i);
    btn.addEventListener('click', () => choose(i));
    li.appendChild(btn);
    optsEl.appendChild(li);
  });
}

function choose(idx: number) {
  if (answered) return;
  answered = true;
  const q = questions[current];
  const btns = optsEl.querySelectorAll<HTMLButtonElement>('.quiz-opt-btn');
  btns.forEach((btn, i) => {
    btn.disabled = true;
    if (i === q.ans) btn.classList.add('opt-correct');
    else if (i === idx) btn.classList.add('opt-wrong');
  });
  if (idx === q.ans) {
    score++;
    fbEl.textContent = '✅ Correct! ' + q.exp;
    fbEl.className = 'quiz-feedback feedback-correct';
  } else {
    fbEl.textContent = '❌ ' + q.exp;
    fbEl.className = 'quiz-feedback feedback-wrong';
  }
  nextBtn.disabled = false;
}

nextBtn.addEventListener('click', () => {
  current++;
  if (current >= questions.length) showResult();
  else render();
});

function showResult() {
  card.hidden = true;
  counter.hidden = true;
  result.hidden = false;
  fill.style.width = '100%';
  bar.setAttribute('aria-valuenow', String(questions.length));

  const pct = Math.round((score / questions.length) * 100);
  const scoreHead = document.getElementById('quiz-score-heading') as HTMLElement;
  const scoreMsg  = document.getElementById('quiz-score-msg') as HTMLElement;
  scoreHead.textContent = `You scored ${score} / ${questions.length} (${pct}%)`;
  if      (pct === 100) scoreMsg.textContent = '🏆 Perfect score! Masterful preparation on Metals & Metallurgy.';
  else if (pct >= 80)   scoreMsg.textContent = '🌟 Excellent! Strong command of reactivity, extraction, and alloys.';
  else if (pct >= 60)   scoreMsg.textContent = '👍 Good attempt. Review the extraction methods and retry.';
  else if (pct >= 40)   scoreMsg.textContent = '📚 Keep revising — check ionic properties and roasting/calcination and try again.';
  else                  scoreMsg.textContent = "💡 Don't worry! Review the key concepts and give it another shot.";
}

retryBtn.addEventListener('click', () => {
  current = 0; score = 0;
  card.hidden = false;
  counter.hidden = false;
  result.hidden = true;
  render();
});

// Tab switching
const tabReactivity = document.getElementById("tab-btn-reactivity");
const tabRefining = document.getElementById("tab-btn-refining");
const panelReactivity = document.getElementById("panel-reactivity");
const panelRefining = document.getElementById("panel-refining");

function activateTab(activeBtn: HTMLElement, activePanel: HTMLElement) {
  [tabReactivity, tabRefining].forEach((btn) => {
    if (btn) {
      btn.classList.add("secondary");
      btn.classList.remove("active");
      btn.setAttribute("aria-selected", "false");
    }
  });
  [panelReactivity, panelRefining].forEach((p) => {
    if (p) p.hidden = true;
  });
  activeBtn.classList.remove("secondary");
  activeBtn.classList.add("active");
  activeBtn.setAttribute("aria-selected", "true");
  activePanel.hidden = false;
}

if (tabReactivity && panelReactivity) tabReactivity.addEventListener("click", () => activateTab(tabReactivity, panelReactivity));
if (tabRefining && panelRefining) tabRefining.addEventListener("click", () => activateTab(tabRefining, panelRefining));

render();
</script>

