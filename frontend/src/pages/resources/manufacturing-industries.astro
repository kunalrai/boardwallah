        </div>

        <div class="card visual-card">
          <div class="visual-badge">Visual Diagram 2 · Three-Tier Industrial Effluent Treatment</div>
          <div class="svg-container">
            <svg viewBox="0 0 460 250" xmlns="http://www.w3.org/2000/svg" aria-label="Effluent treatment steps">
              <rect width="460" height="250" fill="#f8fafc" rx="8"/>
              
              <!-- Stage 1 -->
              <rect x="25" y="45" width="125" height="155" fill="#fee2e2" stroke="#ef4444" stroke-width="1.5" rx="6"/>
              <text x="87" y="72" fill="#991b1b" font-size="11" font-weight="bold" text-anchor="middle">1. PRIMARY</text>
              <line x1="40" y1="80" x2="135" y2="80" stroke="#fca5a5" stroke-width="1"/>
              <text x="87" y="105" fill="#1e293b" font-size="9.5" font-weight="bold" text-anchor="middle">Mechanical</text>
              <text x="87" y="125" fill="#475569" font-size="8.5" text-anchor="middle">• Screening</text>
              <text x="87" y="142" fill="#475569" font-size="8.5" text-anchor="middle">• Grinding</text>
              <text x="87" y="160" fill="#475569" font-size="8.5" text-anchor="middle">• Flocculation</text>
              <text x="87" y="180" fill="#475569" font-size="8.5" text-anchor="middle">• Sedimentation</text>

              <!-- Stage 2 -->
              <rect x="167" y="45" width="125" height="155" fill="#fef3c7" stroke="#d97706" stroke-width="1.5" rx="6"/>
              <text x="230" y="72" fill="#b45309" font-size="11" font-weight="bold" text-anchor="middle">2. SECONDARY</text>
              <line x1="182" y1="80" x2="277" y2="80" stroke="#fcd34d" stroke-width="1"/>
              <text x="230" y="105" fill="#1e293b" font-size="9.5" font-weight="bold" text-anchor="middle">Biological</text>
              <text x="230" y="125" fill="#475569" font-size="8.5" text-anchor="middle">• Aeration tanks</text>
              <text x="230" y="142" fill="#475569" font-size="8.5" text-anchor="middle">• Microorganisms</text>
              <text x="230" y="160" fill="#475569" font-size="8.5" text-anchor="middle">• Organic digest</text>
              <text x="230" y="180" fill="#475569" font-size="8.5" text-anchor="middle">• Sludge settling</text>

              <!-- Stage 3 -->
              <rect x="310" y="45" width="125" height="155" fill="#dcfce7" stroke="#16a34a" stroke-width="1.5" rx="6"/>
              <text x="372" y="72" fill="#15803d" font-size="11" font-weight="bold" text-anchor="middle">3. TERTIARY</text>
              <line x1="325" y1="80" x2="420" y2="80" stroke="#86efac" stroke-width="1"/>
              <text x="372" y="105" fill="#1e293b" font-size="9.5" font-weight="bold" text-anchor="middle">Recycling</text>
              <text x="372" y="125" fill="#475569" font-size="8.5" text-anchor="middle">• Chemical treatment</text>
              <text x="372" y="142" fill="#475569" font-size="8.5" text-anchor="middle">• Filtration</text>
              <text x="372" y="160" fill="#475569" font-size="8.5" text-anchor="middle">• Disinfection</text>
              <text x="372" y="180" fill="#166534" font-size="8.5" font-weight="bold" text-anchor="middle">Clean Recycled H2O</text>

              <rect x="25" y="210" width="410" height="24" fill="#0f766e" rx="3"/>
              <text x="230" y="226" fill="#ffffff" font-size="9" font-weight="bold" text-anchor="middle">Mandatory Effluent Treatment Prior to Riverine Discharge</text>
            </svg>
          </div>
          <p class="caption">Standard industrial wastewater engineering converting toxic effluents into harmless recycled process water.</p>
        </div>
      </div>
    </section>

    <!-- Board Exam Quiz Section (20 Questions) -->
    <section class="section">
      <div class="quiz-header">
        <div>
          <h2>CBSE Board Examination Quiz</h2>
          <p class="lead" style="margin-bottom:0;">Test your understanding of Industrial Locations, Textiles, Iron &amp; Steel, and Pollution Control.</p>
        </div>
        <div class="quiz-score-badge" id="quizScoreBadge">Score: 0 / 20</div>
      </div>

      <div class="quiz-container" id="quizContainer">
        <!-- Rendered by JS -->
      </div>

      <div class="quiz-footer-actions">
        <button type="button" class="button" id="resetQuizBtn">Reset Quiz</button>
        <span class="small" id="quizProgressText">0 of 20 answered</span>
      </div>
    </section>

    <!-- Call to Action Banner -->
    <section class="cta-banner">
      <h2>Excel in CBSE Class 10 Geography</h2>
      <p>Master industrial maps (cotton textile centers, iron &amp; steel plants, and software technology parks) with expert mentors.</p>
      <a href={calBookingUrl} class="button">Book a Doubt Clearing Session</a>
    </section>
  </div>
</Layout>

<script is:inline>
  const questions = [
    {
      q: "1. What is 'manufacturing' in economic geography?",
      options: [
        "Production of goods in large quantities after processing raw materials into more valuable products",
        "Growing organic wheat in a rural village",
        "Selling second-hand clothes at a flea market",
        "Depositing cheques into an automated teller machine"
      ],
      correct: 0,
      explanation: "Manufacturing is the transformation of raw materials into finished consumer goods on a large scale through mechanized processes."
    },
    {
      q: "2. Why is the economic strength of a nation measured by the development of its manufacturing industries?",
      options: [
        "Because manufacturing modernizes farming, creates secondary jobs, eliminates poverty, and earns vital foreign exchange through exports",
        "Because factories are built exclusively out of pure silver",
        "Because only factory owners are allowed to vote in presidential elections",
        "Because factory workers do not pay income tax"
      ],
      correct: 0,
      explanation: "Manufacturing fuels productivity, absorbs excess agrarian labor, generates industrial wealth, and drives export earnings."
    },
    {
      q: "3. What are 'Agglomeration Economies' in industrial geography?",
      options: [
        "When many industries cluster in or near urban centers to take collective advantage of banking, transport, labor, and consulting services",
        "When all factories in a country are owned by a single politician",
        "When an industry shuts down due to power blackouts",
        "When factories are built exclusively on desert sand dunes"
      ],
      correct: 0,
      explanation: "Agglomeration economies occur when businesses benefit from clustering together in cities to share infrastructure, skilled labor pools, and markets."
    },
    {
      q: "4. Where was the first successful modern cotton textile mill established in India in 1854?",
      options: [
        "Mumbai (Bombay)",
        "Kolkata",
        "Surat",
        "Chennai"
      ],
      correct: 0,
      explanation: "The first successful modern cotton textile mill was established in Mumbai in 1854."
    },
    {
      q: "5. Why were early cotton textile mills concentrated in Maharashtra and Gujarat?",
      options: [
        "Availability of raw cotton from the black soil belt, humid climate facilitating yarn spinning, access to Mumbai port, and abundant capital",
        "The British government made cotton mills illegal anywhere else",
        "Because cotton cannot be transported by train",
        "Because northern states banned the wearing of cotton garments"
      ],
      correct: 0,
      explanation: "Proximity to the Deccan cotton tract, natural humidity (preventing thread breakage), port infrastructure, and local financial capital led to this clustering."
    },
    {
      q: "6. Where was the first jute mill in India set up in 1859 near Kolkata?",
      options: [
        "Rishra",
        "Bhadravati",
        "Durgapur",
        "Bokaro"
      ],
      correct: 0,
      explanation: "The first jute mill was established at Rishra, near Kolkata, in 1859 along the banks of the Hugli River."
    },
    {
      q: "7. Why are most jute mills in India concentrated in a narrow belt along the Hugli River in West Bengal?",
      options: [
        "Proximity to raw jute producing fields, cheap water transport, abundant water for processing and retting, and inexpensive labor from neighboring states",
        "Because jute grows only under concrete buildings",
        "Because West Bengal has no electricity",
        "Because paper mills are prohibited by law in Bengal"
      ],
      correct: 0,
      explanation: "The Hugli basin provides raw jute, vast fresh water for processing, cheap river transport, and abundant migrant labor from Bihar, Odisha, and UP."
    },
    {
      q: "8. Why is the sugar industry increasingly shifting and concentrating in the southern and western states of India (especially Maharashtra)?",
      options: [
        "Cane produced has higher sucrose content, cooler maritime climate ensures longer crushing season, and cooperative sugar mills are well managed",
        "Because sugarcane cannot grow in Uttar Pradesh",
        "Because diesel is free in Maharashtra",
        "Because sugar is prohibited in North India"
      ],
      correct: 0,
      explanation: "Maharashtra's cane has higher sucrose content, the cooler coastal climate extends the crushing season, and cooperative mills are remarkably successful."
    },
    {
      q: "9. Why is the Iron and Steel industry called a 'Basic Industry'?",
      options: [
        "Because all other heavy, medium, and light industries depend on it for their machinery and structural equipment",
        "Because it is very simple to make steel in home kitchens",
        "Because steel is cheaper than mud",
        "Because steel dissolves in rainwater"
      ],
      correct: 0,
      explanation: "Iron and steel is the basic industry because it supplies the foundational capital goods, machinery, and tools for all other manufacturing sectors."
    },
    {
      q: "10. In what approximate ratio are iron ore, coking coal, and limestone required in a blast furnace to manufacture steel?",
      options: [
        "4 : 2 : 1",
        "10 : 10 : 10",
        "1 : 1 : 1",
        "1 : 2 : 4"
      ],
      correct: 0,
      explanation: "Iron ore, coking coal, and limestone are needed in an approximate weight proportion of 4 : 2 : 1, along with manganese to harden the steel."
    },
    {
      q: "11. Why is the Chotanagpur Plateau region home to the maximum concentration of iron and steel plants in India?",
      options: [
        "Low cost of iron ore, high-grade coking coal nearby, vast limestone quarries, and cheap local labor",
        "Because the Himalayas block all other industries",
        "Because the government banned steel production in coastal cities",
        "Because steel is exported exclusively by rocket to the moon"
      ],
      correct: 0,
      explanation: "The Chotanagpur region (Jharkhand, Odisha, WB, Chhattisgarh) holds abundant raw materials: high-grade iron ore, metallurgical coal, limestone, and cheap labor."
    },
    {
      q: "12. What is the second most important metallurgical industry in India after iron and steel?",
      options: [
        "Aluminium smelting",
        "Copper refining",
        "Lead processing",
        "Zinc smelting"
      ],
      correct: 0,
      explanation: "Aluminium smelting is India's second largest metallurgical industry, valued for its light weight, corrosion resistance, and electrical conductivity."
    },
    {
      q: "13. What are the two prime location factors required for an aluminium smelting plant?",
      options: [
        "Regular, uninterrupted cheap supply of electricity and assured raw material (bauxite) at low cost",
        "Sand dunes and salt water",
        "Glacial ice and sub-zero temperatures",
        "Proximity to cotton textile markets"
      ],
      correct: 0,
      explanation: "Smelting aluminium is extremely energy-intensive, requiring massive electricity supplies alongside cheap bauxite ore."
    },
    {
      q: "14. Which city is universally recognized as the 'Electronic Capital of India'?",
      options: [
        "Bengaluru",
        "Mumbai",
        "New Delhi",
        "Hyderabad"
      ],
      correct: 0,
      explanation: "Bengaluru has emerged as the premier electronics and IT hub of India, housing major global software campuses and hardware research parks."
    },
    {
      q: "15. What proportion of the workforce in the Indian Information Technology and BPO industry is comprised of women?",
      options: [
        "Over 30%",
        "Less than 1%",
        "Zero percent",
        "Exactly 99%"
      ],
      correct: 0,
      explanation: "A major socioeconomic impact of the IT-BPO boom has been gender empowerment, with women constituting over 30% of the formal IT workforce."
    },
    {
      q: "16. What is the harmful effect of 'Thermal Pollution' of water caused by industries?",
      options: [
        "Hot wastewater from thermal power plants discharged into rivers without cooling destroys aquatic life and disrupts oxygen solubility",
        "It turns river water into solid gold",
        "It freezes all fish into ice blocks",
        "It eliminates all bacteria from drinking water permanently"
      ],
      correct: 0,
      explanation: "Thermal pollution occurs when boiling effluent and hot cooling water are dumped directly into rivers, lowering dissolved oxygen and killing marine life."
    },
    {
      q: "17. What does 'Primary Treatment' of industrial effluents involve?",
      options: [
        "Mechanical means: screening, grinding, flocculation, and sedimentation",
        "Biological digestion using aerobic bacteria",
        "Chemical distillation using nuclear reactors",
        "Spraying perfumes over polluted lakes"
      ],
      correct: 0,
      explanation: "Primary treatment removes solid debris through physical and mechanical processes like screening, sedimentation tanks, and flocculation."
    },
    {
      q: "18. How can factories reduce particulate matter in the air?",
      options: [
        "By fitting smokestacks with electrostatic precipitators, fabric filters, scrubbers, and inertial separators",
        "By painting factory chimneys with blue paint",
        "By burning plastic bags inside boilers",
        "By operating factories only on foggy winter mornings"
      ],
      correct: 0,
      explanation: "Particulate smoke emissions can be filtered by installing electrostatic precipitators, scrubbers, and baghouse fabric filters in chimneys."
    },
    {
      q: "19. Which public sector enterprise in India has ISO 14001 certification for proactive Environmental Management Systems (EMS)?",
      options: [
        "NTPC (National Thermal Power Corporation)",
        "Air India",
        "State Bank of India",
        "Life Insurance Corporation"
      ],
      correct: 0,
      explanation: "NTPC is ISO 14001 certified for its environmental management, utilizing ash ponds, ash water recycling, and extensive green shelterbelts."
    },
    {
      q: "20. How does recycling of industrial water help water conservation?",
      options: [
        "Treating industrial wastewater through secondary and tertiary stages allows it to be reused for industrial cooling and processing, saving freshwater",
        "It converts river water into petroleum",
        "It eliminates the need for rainfall in agricultural states",
        "It allows factories to operate without any electricity"
      ],
      correct: 0,
      explanation: "Water recycling through closed-loop industrial effluent treatment plants drastically minimizes freshwater intake from stressed rivers and aquifers."
    }
  ];

  function renderQuiz() {
    const container = document.getElementById('quizContainer');
    if (!container) return;
    container.innerHTML = '';

    questions.forEach((item, idx) => {
      const qCard = document.createElement('div');
      qCard.className = 'quiz-card';
      qCard.id = `qCard_${idx}`;

      const title = document.createElement('h3');
      title.className = 'quiz-question';
      title.textContent = item.q;
      qCard.appendChild(title);

      const optList = document.createElement('div');
      optList.className = 'quiz-options';

      item.options.forEach((optText, optIdx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'quiz-opt-btn';
        btn.textContent = optText;
        btn.addEventListener('click', () => handleSelectOption(idx, optIdx));
        optList.appendChild(btn);
      });
      qCard.appendChild(optList);

      const feedback = document.createElement('div');
      feedback.className = 'quiz-feedback';
      feedback.id = `feedback_${idx}`;
      qCard.appendChild(feedback);

      container.appendChild(qCard);
    });
  }

  let userAnswers = {};

  function handleSelectOption(qIdx, optIdx) {
    if (userAnswers[qIdx] !== undefined) return;
    userAnswers[qIdx] = optIdx;

    const q = questions[qIdx];
    const isCorrect = (optIdx === q.correct);
    const card = document.getElementById(`qCard_${qIdx}`);
    const btns = card.querySelectorAll('.quiz-opt-btn');
    const fb = document.getElementById(`feedback_${qIdx}`);

    btns.forEach((btn, i) => {
      btn.disabled = true;
      if (i === q.correct) {
        btn.classList.add('opt-correct');
      } else if (i === optIdx) {
        btn.classList.add('opt-wrong');
      }
    });

    if (isCorrect) {
      fb.className = 'quiz-feedback feedback-correct';
      fb.innerHTML = `<strong>Correct!</strong> ${q.explanation}`;
    } else {
      fb.className = 'quiz-feedback feedback-wrong';
      fb.innerHTML = `<strong>Incorrect.</strong> ${q.explanation}`;
    }

    updateScoreSummary();
  }

  function updateScoreSummary() {
    let score = 0;
    const answeredCount = Object.keys(userAnswers).length;
    for (let qIdx in userAnswers) {
      if (userAnswers[qIdx] === questions[qIdx].correct) {
        score++;
      }
    }
    const badge = document.getElementById('quizScoreBadge');
    if (badge) badge.textContent = `Score: ${score} / ${questions.length}`;

    const prog = document.getElementById('quizProgressText');
    if (prog) prog.textContent = `${answeredCount} of ${questions.length} answered`;
  }

  function resetQuiz() {
    userAnswers = {};
    renderQuiz();
    updateScoreSummary();
  }

  document.addEventListener('DOMContentLoaded', () => {
    renderQuiz();
    const resetBtn = document.getElementById('resetQuizBtn');
    if (resetBtn) resetBtn.addEventListener('click', resetQuiz);
  });
</script>

