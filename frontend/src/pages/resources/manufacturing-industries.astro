              <text x="190" y="95" fill="#ffffff" font-size="10.5" font-weight="bold" text-anchor="middle">COAL</text>
              <text x="190" y="125" fill="#38bdf8" font-size="22" font-weight="bold" text-anchor="middle">2</text>
              <text x="190" y="150" fill="#cbd5e1" font-size="9" text-anchor="middle">Parts</text>

              <!-- Plus Sign -->
              <text x="245" y="125" fill="#64748b" font-size="20" font-weight="bold" text-anchor="middle">+</text>

              <!-- Input 3: Limestone (1 part) -->
              <rect x="260" y="90" width="75" height="90" fill="#94a3b8" rx="6"/>
              <text x="297" y="115" fill="#0f172a" font-size="9.5" font-weight="bold" text-anchor="middle">LIME</text>
              <text x="297" y="140" fill="#0f172a" font-size="20" font-weight="bold" text-anchor="middle">1</text>
              <text x="297" y="160" fill="#334155" font-size="8.5" text-anchor="middle">Part</text>

              <!-- Arrow -->
