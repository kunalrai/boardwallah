              <text x="75" y="115" fill="#38bdf8" font-size="24" font-weight="bold" text-anchor="middle">4</text>
              <text x="75" y="145" fill="#94a3b8" font-size="9" text-anchor="middle">Parts</text>

              <!-- Plus Sign -->
              <text x="135" y="125" fill="#64748b" font-size="20" font-weight="bold" text-anchor="middle">+</text>

              <!-- Input 2: Coking Coal (2 parts) -->
