  </div>
</Layout>

<script is:inline>
  const questions = [
    {
      q: "What does the hemlock tree symbolize in Robert Frost's 'Dust of Snow', and how does the poet subvert this symbol?",
      opts: [
        "It symbolizes wealth; he subverts it by making it shed gold",
        "It is traditionally a poisonous tree symbolizing death, but Frost uses it to trigger positive mental rejuvenation",
        "It symbolizes spring; he subverts it by showing it covered in ice",
        "It represents human civilization invading the forest"
      ],
      correct: 1,
      exp: "A hemlock tree is a poisonous plant associated with toxicity and death; however, the snow falling from it revives the poet's spirits, reversing its negative cultural connotation."
    },
    {
      q: "Which poetic device is demonstrated in the line 'Has given my heart / A change of mood' from 'Dust of Snow'?",
      opts: [
        "Alliteration and Synecdoche",
        "Onomatopoeia",
        "Oxymoron",
        "Hyperbole"
      ],
      correct: 0,
      exp: "'Has given my heart' uses Alliteration (repetition of 'h' sound) and Synecdoche (where 'heart' represents the whole person)."
    },
    {
      q: "In 'Fire and Ice', what human emotions and vices do 'Fire' and 'Ice' correspond to, respectively?",
      opts: [
        "Fire represents wisdom; Ice represents foolishness",
        "Fire represents desire, lust, and greed; Ice represents cold hatred, apathy, and indifference",
        "Fire represents military strength; Ice represents peaceful diplomacy",
        "Fire represents physical illness; Ice represents mental anxiety"
      ],
      correct: 1,
      exp: "Frost associates 'fire' with uncontrollable passions, greed, and lust, while 'ice' is equated with the coldness of hatred, cruelty, and unfeeling detachment."
    },
    {
      q: "What is the rhyme scheme of Robert Frost's nine-line poem 'Fire and Ice'?",
      opts: [
        "aabb ccdd e",
        "aba abc bcb",
        "abba cddc e",
        "abab cdcd e"
      ],
      correct: 1,
      exp: "The rhyme scheme is aba (fire/ice/desire) abc (fire/twice/ice) bcb (hate/great/suffice)."
    },
    {
      q: "What figure of speech is present in the phrase 'quiet rage' in 'A Tiger in the Zoo'?",
      opts: [
        "Hyperbole",
        "Oxymoron",
        "Simile",
        "Pun"
      ],
      correct: 1,
      exp: "An Oxymoron combines two contradictory terms together. 'Quiet' (calm/silent) and 'rage' (violent anger) are juxtaposed to show his suppressed ferocity."
    },
    {
      q: "Where does the poet imagine the tiger should be in his natural state in 'A Tiger in the Zoo'?",
      opts: [
        "Resting inside a cave near a village temple",
        "Lurking in shadows, sliding through long grass near the water hole where plump deer pass",
        "Swimming across broad rivers to escape hunter traps",
        "Performing in a circus ring"
      ],
      correct: 1,
      exp: "Norris asserts that in the wild, the tiger should be stalking prey near the water hole where deer congregate."
    },
    {
      q: "Why does Carolyn Wells use the spelling 'lep and lep again' in 'How to Tell Wild Animals'?",
      opts: [
        "It was a printing typographical mistake in the original edition",
        "Poetic Licence, intentionally breaking grammatical spelling to maintain rhythm and rhyme with 'leopard'",
        "Old English spelling from the 16th century",
        "To mimic children's baby talk"
      ],
      correct: 1,
      exp: "Poets have 'Poetic Licence' to distort spellings and rules to preserve meter and rhyme."
    },
    {
      q: "In 'The Ball Poem', what does the phrase 'epistemology of loss' refer to?",
      opts: [
