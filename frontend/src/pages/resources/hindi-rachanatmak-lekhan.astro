---
import Layout from "../../layouts/Layout.astro";
import { loadContent } from "../../lib/content";
import { calBookingUrl } from "../../lib/site";

const { provider } = loadContent();
---

<Layout
  title={`रचनात्मक लेखन (लेखन कौशल) | CBSE Class 10 Hindi | ${provider.name}`}
  description="CBSE कक्षा 10 हिंदी (कोर्स 'अ') रचनात्मक लेखन सम्पूर्ण गाइड (20 अंक)। अनुच्छेद लेखन, औपचारिक व अनौपचारिक पत्र लेखन, स्ववृत्त लेखन (Bio-data), ई-मेल लेखन, विज्ञापन लेखन एवं सन्देश लेखन के आधिकारिक सीबीएसई प्रारूप, आदर्श उदाहरण, आरेख एवं 20 महत्वपूर्ण बोर्ड परीक्षा प्रश्न।"
>
  <div class="wrap">
    <nav class="small" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/subjects/">Subjects</a> / <a href="/resources/">Resources</a> / रचनात्मक लेखन
    </nav>

    <div class="resource-header">
      <span class="eyebrow">CBSE Class 10 · Hindi Course 'A' · लेखन कौशल (20 अंक)</span>
      <h1>रचनात्मक लेखन: आधिकारिक प्रारूप, अंक-योजना व अभ्यास</h1>
      <p class="lead">
        सीबीएसई 10वीं बोर्ड परीक्षा में लेखन कौशल के पूरे 20 अंक प्राप्त करने की अचूक रणनीति: अनुच्छेद लेखन, औपचारिक-अनौपचारिक पत्र, स्ववृत्त, ई-मेल, विज्ञापन और सन्देश लेखन के मानक प्रारूप, दृश्य आरेख एवं 20 बोर्ड परीक्षा प्रश्न।
      </p>
    </div>

    <!-- Core Concepts Section -->
    <section class="section">
      <h2>रचनात्मक लेखन के पाँच प्रमुख आयाम (Official CBSE Rubrics)</h2>

      <div class="grid two concept-grid">
        <article class="card">
          <h3>📝 1. अनुच्छेद लेखन (5 अंक)</h3>
          <p class="formula">लगभग 120 शब्द · संकेत-बिंदुओं पर आधारित सुगठित विचार</p>
          <ul class="clean-list">
            <li><strong>अंक विभाजन:</strong> भूमिका एवं विषय-वस्तु (3 अंक), भाषा की शुद्धता व प्रवाह (1 अंक), प्रस्तुति (1 अंक)।</li>
            <li><strong>मुख्य नियम:</strong>
              <br/>• दिए गए 3-4 संकेत-बिंदुओं (प्रस्तावना, कारण/प्रभाव, निवारण, उपसंहार) को केंद्र में रखकर लिखें।
              <br/>• भूमिका में किसी प्रासंगिक सूक्ति, कविता की पंक्ति या दोहे से शुरुआत करने पर प्रभावकारी अंक मिलते हैं।
              <br/>• भाषा सरल, स्पष्ट और व्यावहारिक होनी चाहिए; व्यर्थ की पुनरावृत्ति से बचें।
              <br/>• अनुच्छेद में केवल एक या दो पैराग्राफ होने चाहिए, निबंध की तरह लंबे उपशीर्षक नहीं देने होते।
            </li>
          </ul>
        </article>

        <article class="card">
          <h3>✉️ 2. पत्र लेखन: औपचारिक व अनौपचारिक (5 अंक)</h3>
          <p class="formula">लगभग 100 शब्द · मानक प्रारूप एवं शिष्टाचार</p>
          <ul class="clean-list">
            <li><strong>औपचारिक पत्र (Formal Letter - प्रार्थना, शिकायती, संपादकीय पत्र):</strong>
              <br/>1. प्रेषक का पता (परीक्षा भवन, नई दिल्ली) एवं दिनांक
              <br/>2. सेवा में, पदनाम एवं कार्यालय का पता (जैसे: संपादक महोदय / प्रधानाचार्य)
              <br/>3. <strong>विषय (Subject):</strong> संक्षिप्त एवं स्पष्ट (एक पंक्ति में)
              <br/>4. महोदय / मान्यवर (संबोधन)
              <br/>5. मुख्य विषय-वस्तु (प्रस्तावना, समस्या का विस्तृत विवरण, समाधान की अपेक्षा)
              <br/>6. सधन्यवाद, भवदीय / प्रार्थी, क.ख.ग.
            </li>
            <li><strong>अनौपचारिक पत्र (Informal Letter - मित्र, सगे-संबंधी):</strong>
              <br/>पता, दिनांक, प्रिय/आदरणीय (संबोधन), सप्रेम नमस्ते/सादर प्रणाम, कुशल-क्षेम, मुख्य समाचार, आपका स्नेही/अनुज।
            </li>
          </ul>
        </article>

        <article class="card">
          <h3>💼 3. स्ववृत्त (बायोडाटा) एवं ई-मेल लेखन (5 अंक)</h3>
          <p class="formula">आधुनिक कार्यालयी संचार विधाएँ (लगभग 80–100 शब्द)</p>
          <ul class="clean-list">
            <li><strong>स्ववृत्त लेखन (Bio-data / Curriculum Vitae):</strong>
              <br/>• <em>व्यक्तिगत विवरण:</em> नाम, पिता का नाम, जन्मतिथि, वर्तमान पता, मोबाइल, ई-मेल।
              <br/>• <em>शैक्षणिक योग्यता तालिका:</em> क्रम, परीक्षा (10वीं, 12वीं, स्नातक), बोर्ड/विश्वविद्यालय, वर्ष, प्रतिशत।
              <br/>• <em>अन्य योग्यताएँ व अनुभव:</em> कंप्यूटर ज्ञान, भाषाएँ, पूर्व कार्य अनुभव।
              <br/>• <em>उद्घोषणा व हस्ताक्षर:</em> 'मैं प्रमाणित करता हूँ कि...', दिनांक, स्थान, हस्ताक्षर।
            </li>
            <li><strong>ई-मेल लेखन (E-mail):</strong>
              <br/>• <strong>To:</strong> प्राप्तकर्ता का मान्य ई-मेल पता (उदा: abc@email.com)
              <br/>• <strong>CC / BCC:</strong> आवश्यकतानुसार
              <br/>• <strong>Subject:</strong> स्पष्ट उद्देश्य
              <br/>• <strong>Salutation &amp; Body:</strong> महोदय, मुख्य संदेश, सादर, नाम।
            </li>
          </ul>
        </article>

        <article class="card">
          <h3>📢 4. विज्ञापन एवं सन्देश लेखन (5 अंक)</h3>
          <p class="formula">लगभग 40–50 शब्द · बॉक्स अनिवार्य · दृश्य संप्रेषणीयता</p>
          <ul class="clean-list">
            <li><strong>विज्ञापन लेखन (Advertisement Writing):</strong>
              <br/>• चारों ओर आकर्षक <strong>बॉक्स (Box)</strong> बनाएँ।
              <br/>• बोल्ड अक्षरों में मुख्य शीर्षक / उत्पाद का नाम।
              <br/>• आकर्षक तुकबंदी/स्लोगन (जैसे: 'धमाका सेल!', 'गुणवत्ता में सबसे आगे')।
              <br/>• उत्पाद की 4-5 मुख्य विशेषताएँ (बुलेट पॉइंट्स में)।
              <br/>• छूट, ऑफर या रियायत का स्पष्ट उल्लेख ('20% की विशेष छूट', 'एक पर एक मुफ्त')।
              <br/>• नीचे बाईं ओर संपर्क सूत्र (पता, दूरभाष, वेबसाइट)।
            </li>
            <li><strong>सन्देश लेखन (Message Writing):</strong>
              <br/>• बॉक्स में ऊपर मध्य में 'शुभकामना सन्देश / शोक सन्देश' शीर्षक।
              <br/>• बाईं ओर दिनांक और समय।
              <br/>• संबोधन, संक्षिप्त मंगलकामना या संवेदना, प्रेषक का नाम।
            </li>
          </ul>
        </article>
      </div>
    </section>

    <!-- Visual Diagrams Section -->
    <section class="section">
      <h2>दृश्य संकल्पना: औपचारिक पत्र एवं आधुनिक ई-मेल लेखन का मानक ढाँचा</h2>

      <div class="grid two">
        <div class="card visual-card">
          <div class="visual-badge">आरेख 1 · सीबीएसई मानक औपचारिक पत्र का सटीक प्रारूप (Format)</div>
          <div class="svg-container">
            <svg viewBox="0 0 460 250" xmlns="http://www.w3.org/2000/svg" aria-label="औपचारिक पत्र प्रारूप">
              <rect width="460" height="250" fill="#f8fafc" rx="8"/>
              
              <!-- Outer Letter Box -->
              <rect x="30" y="15" width="400" height="220" fill="#ffffff" stroke="#0f766e" stroke-width="2" rx="4"/>
              
              <!-- 1. प्रेषक पता -->
              <text x="50" y="38" fill="#1e293b" font-size="9" font-weight="bold">परीक्षा भवन, नई दिल्ली</text>
              <text x="50" y="52" fill="#64748b" font-size="8.5">दिनांक: 15 मार्च 2026</text>

              <!-- 2. सेवा में -->
              <text x="50" y="74" fill="#1e293b" font-size="9" font-weight="bold">सेवा में, मुख्य संपादक महोदय, 'दैनिक जागरण', दिल्ली</text>

              <!-- 3. विषय -->
              <rect x="45" y="85" width="370" height="18" fill="#f1f5f9" rx="2"/>
              <text x="50" y="98" fill="#0f766e" font-size="9" font-weight="bold">विषय: क्षेत्र में पेयजल की अनियमित आपूर्ति के संबंध में</text>

              <!-- 4. संबोधन -->
              <text x="50" y="120" fill="#1e293b" font-size="9" font-weight="bold">महोदय,</text>

              <!-- 5. मुख्य कलेवर (3 अनुच्छेद) -->
              <text x="65" y="136" fill="#334155" font-size="8">आपके सम्मानित समाचार-पत्र के माध्यम से मैं जल बोर्ड अधिकारियों का ध्यान...</text>
              <text x="65" y="150" fill="#334155" font-size="8">हमारे क्षेत्र में पिछले एक माह से गंदा और अल्प मात्रा में पानी आ रहा है...</text>
              <text x="65" y="164" fill="#334155" font-size="8">अतः आपसे विनम्र प्रार्थना है कि इस समस्या को प्राथमिकता से प्रकाशित करें।</text>

              <!-- 6. स्वनिर्देश -->
              <text x="50" y="188" fill="#1e293b" font-size="8.5">सधन्यवाद,</text>
              <text x="50" y="202" fill="#0f766e" font-size="9" font-weight="bold">भवदीय,</text>
              <text x="50" y="216" fill="#1e293b" font-size="8.5">क. ख. ग.</text>

              <rect x="290" y="185" width="125" height="36" fill="#ecfdf5" stroke="#10b981" stroke-width="1" rx="4"/>
              <text x="352" y="200" fill="#065f46" font-size="8.5" font-weight="bold" text-anchor="middle">पूर्ण अंक रणनीति:</text>
              <text x="352" y="214" fill="#065f46" font-size="7.5" text-anchor="middle">बायाँ संरेखण (Left Align)</text>
            </svg>
          </div>
          <p class="caption">सीबीएसई की आधुनिक लेखन शैली के अनुसार संपूर्ण पत्र बाईं ओर (Left Alignment) से ही प्रारंभ होता है।</p>
        </div>

        <div class="card visual-card">
          <div class="visual-badge">आरेख 2 · मानक ई-मेल लेखन एवं विज्ञापन बॉक्स संरचना</div>
          <div class="svg-container">
            <svg viewBox="0 0 460 250" xmlns="http://www.w3.org/2000/svg" aria-label="ई-मेल और विज्ञापन बॉक्स प्रारूप">
              <rect width="460" height="250" fill="#f8fafc" rx="8"/>
              
              <!-- Left: E-mail Box -->
              <rect x="25" y="25" width="195" height="200" fill="#ffffff" stroke="#2563eb" stroke-width="1.5" rx="4"/>
              <rect x="25" y="25" width="195" height="24" fill="#eff6ff" rx="4 4 0 0"/>
              <text x="122" y="41" fill="#1d4ed8" font-size="10" font-weight="bold" text-anchor="middle">ई-मेल लेखन प्रारूप (E-mail)</text>
              <text x="35" y="65" fill="#1e293b" font-size="8.5"><strong>To:</strong> principal@school.edu.in</text>
              <line x1="30" y1="72" x2="215" y2="72" stroke="#e2e8f0" stroke-width="1"/>
              <text x="35" y="86" fill="#1e293b" font-size="8.5"><strong>CC/BCC:</strong> (रिक्त छोड़ें)</text>
              <line x1="30" y1="93" x2="215" y2="93" stroke="#e2e8f0" stroke-width="1"/>
              <text x="35" y="108" fill="#0f766e" font-size="8.5"><strong>विषय:</strong> शुल्क मुक्ति हेतु आवेदन</text>
              <line x1="30" y1="115" x2="215" y2="115" stroke="#e2e8f0" stroke-width="1"/>
              <text x="35" y="132" fill="#334155" font-size="8">आदरणीय महोदय, सविनय निवेदन है...</text>
              <text x="35" y="152" fill="#334155" font-size="8">कृपा कर छात्रवृत्ति प्रदान करें...</text>
              <text x="35" y="180" fill="#1e293b" font-size="8">आपका आज्ञाकारी शिष्य, क.ख.ग.</text>

              <!-- Right: Advertisement Box -->
              <rect x="240" y="25" width="195" height="200" fill="#ffffff" stroke="#d97706" stroke-width="1.5" rx="4"/>
              <rect x="240" y="25" width="195" height="24" fill="#fef3c7" rx="4 4 0 0"/>
              <text x="337" y="41" fill="#b45309" font-size="10" font-weight="bold" text-anchor="middle">विज्ञापन लेखन (Advertisement)</text>
              <text x="337" y="68" fill="#ea580c" font-size="11" font-weight="bold" text-anchor="middle">★ नटराज पेंसिल ★</text>
              <text x="337" y="85" fill="#166534" font-size="8" font-weight="bold" text-anchor="middle">"लिखे ऐसा कि जादू छा जाए!"</text>
              <text x="250" y="108" fill="#334155" font-size="8">• सबसे सुंदर लिखावट</text>
              <text x="250" y="124" fill="#334155" font-size="8">• मजबूत लेड, बार-बार न टूटे</text>
              <text x="250" y="140" fill="#334155" font-size="8">• रबर और शार्पनर बिल्कुल मुफ्त</text>
              <rect x="250" y="155" width="175" height="20" fill="#fee2e2" rx="3"/>
              <text x="337" y="169" fill="#991b1b" font-size="8.5" font-weight="bold" text-anchor="middle">धमाका: 2 पैकेट पर 1 मुफ्त!</text>
              <text x="250" y="195" fill="#475569" font-size="7.5">संपर्क: सभी प्रमुख बुक स्टोर्स पर उपलब्ध</text>
            </svg>
          </div>
          <p class="caption">ई-मेल और विज्ञापन लेखन में स्पष्ट बॉक्स, आकर्षक लेआउट और बिंदुवार विवरण 100% अंक दिलाते हैं।</p>
        </div>
      </div>
    </section>

    <!-- Board Exam Quiz Section (20 Questions) -->
    <section class="section">
      <div class="quiz-header">
        <div>
          <h2>सीबीएसई बोर्ड परीक्षा रचनात्मक लेखन अभ्यास (20 बहुविकल्पी प्रश्न)</h2>
          <p class="lead" style="margin-bottom:0;">प्रारूप, अंक योजना, शब्द सीमा और शुद्ध लेखन शैली पर आधारित प्रश्नोत्तरी।</p>
        </div>
        <div class="quiz-score-badge" id="quizScoreBadge">Score: 0 / 20</div>
      </div>

      <div class="quiz-container" id="quizContainer">
        <!-- JS rendered -->
      </div>

      <div class="quiz-footer-actions">
        <button type="button" class="button" id="resetQuizBtn">पुनः अभ्यास करें (Reset)</button>
        <span class="small" id="quizProgressText">0 of 20 answered</span>
      </div>
    </section>

    <!-- Call to Action Banner -->
    <section class="cta-banner">
      <h2>हिंदी रचनात्मक लेखन में 20/20 अंक सुनिश्चित करें</h2>
      <p>सीबीएसई की सटीक मार्किंग स्कीम, मॉडल फॉर्मेट्स और निबंध-पत्र लेखन की व्यक्तिगत समीक्षा प्राप्त करें।</p>
      <a href={calBookingUrl} class="button">संदेह निवारण सत्र बुक करें (Book Trial)</a>
    </section>
  </div>
</Layout>

<script is:inline>
  const questions = [
    {
      q: "1. सीबीएसई बोर्ड परीक्षा में 'अनुच्छेद लेखन' के लिए अनुशंसित आदर्श शब्द सीमा कितनी होती है?",
      options: [
        "लगभग 50 शब्द",
        "लगभग 100 से 120 शब्द",
        "कम से कम 500 शब्द",
        "1000 शब्द"
      ],
      correct: 1,
      explanation: "सीबीएसई कक्षा 10वीं हिंदी में अनुच्छेद लेखन के लिए निर्धारित शब्द सीमा लगभग 100 से 120 शब्द है।"
    },
    {
      q: "2. औपचारिक पत्र में 'विषय' (Subject) कहाँ लिखा जाना चाहिए?",
      options: [
        "पत्र के सबसे अंत में हस्ताक्षर के नीचे",
        "प्रेषक का पता, दिनांक और सेवा में (प्राप्तकर्ता के पदनाम) के ठीक बाद संबोधन से पूर्व",
        "लिफाफे के पीछे",
        "अनौपचारिक पत्र में ही विषय लिखा जाता है"
