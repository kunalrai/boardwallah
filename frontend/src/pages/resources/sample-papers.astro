<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Subject Tab Switching
    const tabs = document.querySelectorAll('.subject-tab');
    const containers = document.querySelectorAll('.paper-content-container');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        containers.forEach(c => c.classList.remove('active'));

        tab.classList.add('active');
        const subj = tab.dataset.subject;
        const targetContainer = document.getElementById(`paper-${subj}`);
        if (targetContainer) targetContainer.classList.add('active');
      });
    });

    // Display Mode Toggling (Both / Exam / Marking)
    const modePills = document.querySelectorAll('.toggle-pill');
    modePills.forEach(pill => {
      pill.addEventListener('click', () => {
        modePills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        const mode = pill.dataset.mode;

        const allQuestions = document.querySelectorAll('.q-text');
        const allSolutions = document.querySelectorAll('.solution-box');

        if (mode === 'exam') {
          allQuestions.forEach(q => q.style.display = 'block');
          allSolutions.forEach(s => s.style.display = 'none');
        } else if (mode === 'marking') {
          allQuestions.forEach(q => q.style.display = 'none');
          allSolutions.forEach(s => s.style.display = 'block');
        } else {
          allQuestions.forEach(q => q.style.display = 'block');
          allSolutions.forEach(s => s.style.display = 'block');
        }
      });
    });

    // 3-Hour Practice Exam Timer
    let totalSeconds = 3 * 3600; // 3 hours = 10800 seconds
    let timerInterval = null;
    let isRunning = false;
    const timerDisplay = document.getElementById('exam-timer');
    const toggleBtn = document.getElementById('timer-toggle-btn');
    const resetBtn = document.getElementById('timer-reset-btn');

    function updateTimerDisplay() {
      const hrs = Math.floor(totalSeconds / 3600);
      const mins = Math.floor((totalSeconds % 3600) / 60);
      const secs = totalSeconds % 60;
      timerDisplay.textContent = 
        `${String(hrs).padStart(2, '0')}:${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }

    toggleBtn.addEventListener('click', () => {
      if (!isRunning) {
        isRunning = true;
        toggleBtn.textContent = 'Pause Timer';
        toggleBtn.classList.add('running');
        timerInterval = setInterval(() => {
          if (totalSeconds > 0) {
            totalSeconds--;
            updateTimerDisplay();
          } else {
            clearInterval(timerInterval);
            isRunning = false;
            toggleBtn.textContent = 'Time Up!';
            alert('Time is up! 3 hours have completed.');
          }
        }, 1000);
      } else {
        clearInterval(timerInterval);
        isRunning = false;
        toggleBtn.textContent = 'Resume Timer';
        toggleBtn.classList.remove('running');
      }
    });

    resetBtn.addEventListener('click', () => {
      clearInterval(timerInterval);
      isRunning = false;
      totalSeconds = 3 * 3600;
      updateTimerDisplay();
      toggleBtn.textContent = 'Start Timer';
      toggleBtn.classList.remove('running');
    });
  });
</script>

