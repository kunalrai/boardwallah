---
import Layout from "../../layouts/Layout.astro";
import { loadContent } from "../../lib/content";
import { calBookingUrl } from "../../lib/site";
import TutorTrialCallout from "../../components/TutorTrialCallout.astro";

const { provider } = loadContent();
---

<Layout
  title={`CBSE Class 10 Board Exam 2026 Sample Papers & Step-by-Step Marking Schemes | ${provider.name}`}
  description="Free full-length 80-mark CBSE Class 10 Sample Papers for 2026 Board Exams in Mathematics, Science, Social Science, and English with official step-by-step marking schemes, blueprint weightage, and interactive exam mode."
>
  <div class="wrap">
    <nav class="small" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/subjects/">Subjects</a> / <a href="/resources/">Resources</a> / Sample Papers
    </nav>

    <div class="resource-header">
      <span class="eyebrow">CBSE Class 10 · Official Blueprint (Code 2025–26)</span>
      <h1>CBSE Class 10 Board Exam 2026 Sample Papers &amp; Marking Schemes</h1>
      <p class="lead">
        Full 80-mark model question papers strictly structured on the official CBSE 2025–2026 curriculum blueprint. Includes 50% competency-focused questions, case-based units, and step-by-step marking schemes for Mathematics, Science, Social Science, and English.
      </p>
    </div>

    <!-- Exam Blueprint Overview & Timer Bar -->
    <div class="card exam-control-panel">
      <div class="panel-left">
        <span class="badge exam-badge">⏱️ Exam Simulator Mode</span>
        <div class="timer-display">
          <span class="timer-label">Practice Countdown:</span>
          <span id="exam-timer" class="timer-clock">03:00:00</span>
        </div>
        <div class="timer-buttons">
          <button id="timer-toggle-btn" class="button small">Start Timer</button>
          <button id="timer-reset-btn" class="button secondary small">Reset</button>
        </div>
      </div>

      <div class="panel-right">
        <div class="view-toggle-wrap">
          <span class="toggle-label">Paper Display Mode:</span>
          <div class="toggle-pills" role="radiogroup" aria-label="Paper Display Mode">
            <button id="btn-mode-both" class="toggle-pill active" data-mode="both">Questions + Solutions</button>
            <button id="btn-mode-exam" class="toggle-pill" data-mode="exam">Exam Mode (Questions Only)</button>
            <button id="btn-mode-marking" class="toggle-pill" data-mode="marking">Marking Scheme Only</button>
          </div>
        </div>
        <div class="print-action">
          <button onclick="window.print()" class="button secondary small">🖨️ Print / Save as PDF</button>
        </div>
      </div>
    </div>

    <!-- Inline 1-on-1 Mock Paper Evaluation Callout -->
    <TutorTrialCallout 
      topic="80-Mark Sample Paper Evaluation & Step-by-Step Marking Rubrics" 
      subject="CBSE Class 10" 
      title="Want your Mock Paper evaluated with CBSE Step-by-Step Marking Rubrics?"
      subtitle={`Submit your handwritten mock exam answers and get detailed feedback on lost marks, formula presentation, and time-management from ${provider.tutor_name} (20 yrs exp, B.Tech, ex-Samsung/HCL).`}
    />

    <!-- Subject Selector Tabs -->
    <nav class="subject-tabs-nav" aria-label="Subject Sample Papers">
      <button class="subject-tab active" data-subject="maths">
        <span class="tab-icon">📐</span>
        <span class="tab-title">Mathematics (Standard)</span>
        <span class="tab-meta">Code 041 · 80 Marks · 38 Qs</span>
      </button>
      <button class="subject-tab" data-subject="science">
        <span class="tab-icon">🔬</span>
        <span class="tab-title">Science</span>
        <span class="tab-meta">Code 086 · 80 Marks · 39 Qs</span>
      </button>
      <button class="subject-tab" data-subject="sst">
        <span class="tab-icon">🌍</span>
        <span class="tab-title">Social Science</span>
        <span class="tab-meta">Code 087 · 80 Marks · 37 Qs</span>
      </button>
      <button class="subject-tab" data-subject="english">
        <span class="tab-icon">📖</span>
        <span class="tab-title">English (Lang &amp; Lit)</span>
        <span class="tab-meta">Code 184 · 80 Marks · 3 Sections</span>
      </button>
    </nav>

    <!-- ========================================================================= -->
    <!-- MATHEMATICS SAMPLE PAPER -->
    <!-- ========================================================================= -->
    <div id="paper-maths" class="paper-content-container active">
      <div class="paper-header card">
        <div class="paper-header-meta">
          <span class="series">CBSE CLASS 10 BOARD EXAMINATION 2026</span>
          <h2>MATHEMATICS – STANDARD (SUBJECT CODE: 041)</h2>
          <div class="spec-row">
            <span><strong>Time Allowed:</strong> 3 Hours</span>
            <span><strong>Maximum Marks:</strong> 80</span>
            <span><strong>Total Questions:</strong> 38</span>
          </div>
        </div>
        <div class="general-instructions">
          <h4>General Instructions:</h4>
          <ol>
            <li>This question paper contains <strong>38 questions</strong> divided into <strong>5 Sections</strong>: A, B, C, D, and E.</li>
            <li><strong>Section A</strong> comprises 20 Multiple Choice Questions (MCQs) of 1 mark each (Q1 to Q20). Q19 and Q20 are Assertion-Reason questions.</li>
            <li><strong>Section B</strong> comprises 5 Short Answer Type-I (SA-I) questions of 2 marks each (Q21 to Q25).</li>
            <li><strong>Section C</strong> comprises 6 Short Answer Type-II (SA-II) questions of 3 marks each (Q26 to Q31).</li>
            <li><strong>Section D</strong> comprises 4 Long Answer (LA) questions of 5 marks each (Q32 to Q35).</li>
            <li><strong>Section E</strong> comprises 3 Case-Based integrated units of assessment (Q36 to Q38) of 4 marks each with sub-parts of 1, 1, and 2 marks respectively.</li>
            <li>All Questions are compulsory. Internal choice is provided in 2 questions of Section B, 2 questions of Section C, 2 questions of Section D, and in the 2-mark sub-question of Section E.</li>
            <li>Use of calculators is strictly prohibited. Take &pi; = 22/7 unless stated otherwise.</li>
          </ol>
        </div>
      </div>

      <!-- Section A: Maths -->
      <section class="section paper-section">
        <div class="section-badge-header">
          <h3>SECTION A — 20 Marks</h3>
          <p class="muted">Questions 1 to 20 carry 1 mark each. Select the correct option.</p>
        </div>

        <div class="questions-list">
          <!-- Q1 -->
          <article class="card question-card">
            <div class="q-header">
              <span class="q-num">Q1</span>
              <span class="q-marks">1 Mark</span>
            </div>
            <div class="q-text">
              <p>If two positive integers <em>a</em> and <em>b</em> are written as <em>a = x³ y²</em> and <em>b = x y³</em>, where <em>x</em> and <em>y</em> are prime numbers, then HCF(a, b) is:</p>
              <div class="mcq-options">
                <span class="opt">(a) x y</span>
                <span class="opt">(b) x y²</span>
                <span class="opt">(c) x³ y³</span>
                <span class="opt">(d) x² y²</span>
              </div>
            </div>
            <div class="solution-box">
              <span class="sol-tag">Marking Scheme &amp; Solution:</span>
              <p><strong>Correct Option: (b) x y²</strong></p>
              <div class="steps">
                • HCF is the product of the smallest powers of each common prime factor involved.<br/>
                • Common factors: x (power 1) and y (power 2).<br/>
                • Therefore, HCF(a, b) = x¹ · y² = x y². <span class="step-marks">[1 Mark]</span>
              </div>
            </div>
          </article>

          <!-- Q2 -->
          <article class="card question-card">
            <div class="q-header">
              <span class="q-num">Q2</span>
              <span class="q-marks">1 Mark</span>
            </div>
            <div class="q-text">
              <p>If α and β are the zeroes of the quadratic polynomial p(x) = 2x² - 5x + 7, then the value of α⁻¹ + β⁻¹ is:</p>
              <div class="mcq-options">
                <span class="opt">(a) 5/7</span>
                <span class="opt">(b) -5/7</span>
                <span class="opt">(c) 7/5</span>
                <span class="opt">(d) -7/5</span>
              </div>
            </div>
            <div class="solution-box">
              <span class="sol-tag">Marking Scheme &amp; Solution:</span>
              <p><strong>Correct Option: (a) 5/7</strong></p>
              <div class="steps">
                • For p(x) = 2x² - 5x + 7: α + β = -(-5)/2 = 5/2, and α·β = 7/2.<br/>
                • α⁻¹ + β⁻¹ = (1/α) + (1/β) = (α + β) / (α·β) = (5/2) / (7/2) = 5/7. <span class="step-marks">[1 Mark]</span>
              </div>
            </div>
          </article>

          <!-- Q3 -->
          <article class="card question-card">
            <div class="q-header">
              <span class="q-num">Q3</span>
              <span class="q-marks">1 Mark</span>
            </div>
            <div class="q-text">
              <p>The pair of linear equations kx + 3y - (k - 3) = 0 and 12x + ky - k = 0 has infinitely many solutions. The value of k is:</p>
              <div class="mcq-options">
                <span class="opt">(a) 6</span>
                <span class="opt">(b) -6</span>
                <span class="opt">(c) 0</span>
                <span class="opt">(d) ±6</span>
              </div>
            </div>
            <div class="solution-box">
              <span class="sol-tag">Marking Scheme &amp; Solution:</span>
              <p><strong>Correct Option: (a) 6</strong></p>
              <div class="steps">
                • For infinitely many solutions: (a₁/a₂) = (b₁/b₂) = (c₁/c₂) &rarr; (k/12) = (3/k) = (k - 3)/k.<br/>
                • From (k/12) = (3/k) &rarr; k² = 36 &rarr; k = ±6.<br/>
                • From (3/k) = (k - 3)/k &rarr; 3 = k - 3 &rarr; k = 6.<br/>
                • The value satisfying both conditions simultaneously is k = 6. <span class="step-marks">[1 Mark]</span>
              </div>
            </div>
          </article>

          <!-- Q4 -->
          <article class="card question-card">
            <div class="q-header">
              <span class="q-num">Q4</span>
              <span class="q-marks">1 Mark</span>
            </div>
            <div class="q-text">
              <p>If the distance between the points A(x, 2) and B(9, 8) is 10 units, then the value(s) of x is/are:</p>
              <div class="mcq-options">
                <span class="opt">(a) 1 or 17</span>
                <span class="opt">(b) -1 or 17</span>
                <span class="opt">(c) 1 or -17</span>
                <span class="opt">(d) 3 or 15</span>
              </div>
            </div>
            <div class="solution-box">
              <span class="sol-tag">Marking Scheme &amp; Solution:</span>
              <p><strong>Correct Option: (a) 1 or 17</strong></p>
              <div class="steps">
                • By Distance Formula: AB² = (9 - x)² + (8 - 2)² = 10² &rarr; (9 - x)² + 36 = 100.<br/>
                • (9 - x)² = 64 &rarr; 9 - x = ±8.<br/>
                • 9 - x = 8 &rarr; x = 1; and 9 - x = -8 &rarr; x = 17. <span class="step-marks">[1 Mark]</span>
              </div>
            </div>
          </article>

          <!-- Q19 (Assertion-Reason) -->
          <article class="card question-card">
            <div class="q-header">
              <span class="q-num">Q19 (Assertion-Reason)</span>
              <span class="q-marks">1 Mark</span>
            </div>
            <div class="q-text">
              <p><strong>Statement A (Assertion):</strong> The HCF of two numbers is 5 and their product is 150, then their LCM is 30.<br/>
              <strong>Statement R (Reason):</strong> For any two positive integers a and b, HCF(a, b) × LCM(a, b) = a × b.</p>
              <div class="mcq-options">
                <span class="opt">(a) Both (A) and (R) are true and (R) is the correct explanation of (A).</span>
                <span class="opt">(b) Both (A) and (R) are true but (R) is not the correct explanation of (A).</span>
                <span class="opt">(c) (A) is true but (R) is false.</span>
                <span class="opt">(d) (A) is false but (R) is true.</span>
              </div>
            </div>
            <div class="solution-box">
              <span class="sol-tag">Marking Scheme &amp; Solution:</span>
              <p><strong>Correct Option: (a)</strong></p>
              <div class="steps">
                • LCM = (a × b) / HCF = 150 / 5 = 30. Both statements are true and Reason accurately explains Assertion. <span class="step-marks">[1 Mark]</span>
              </div>
            </div>
          </article>
        </div>
      </section>

      <!-- Section B: Maths (2 Marks) -->
      <section class="section paper-section">
        <div class="section-badge-header">
          <h3>SECTION B — 10 Marks</h3>
          <p class="muted">Questions 21 to 25 carry 2 marks each.</p>
        </div>

        <div class="questions-list">
          <!-- Q21 -->
          <article class="card question-card">
            <div class="q-header">
              <span class="q-num">Q21</span>
              <span class="q-marks">2 Marks</span>
            </div>
            <div class="q-text">
              <p>Prove that √5 is an irrational number by contradiction.</p>
            </div>
            <div class="solution-box">
              <span class="sol-tag">Marking Scheme &amp; Solution:</span>
              <div class="steps">
                1. Assume on contrary that √5 = a/b where a, b are integers, b &ne; 0 and HCF(a, b) = 1 (coprime).<br/>
                2. Squaring both sides: 5b² = a² &rarr; 5 divides a² &rarr; 5 divides a. <span class="step-marks">[1/2 Mark]</span><br/>
                3. Let a = 5c. Then 5b² = (5c)² = 25c² &rarr; b² = 5c² &rarr; 5 divides b² &rarr; 5 divides b. <span class="step-marks">[1/2 Mark]</span><br/>
                4. Thus 5 is a common factor of both a and b, which contradicts our assumption that a and b are coprime. <span class="step-marks">[1/2 Mark]</span><br/>
                5. Hence, our assumption is false, and √5 is irrational. <span class="step-marks">[1/2 Mark]</span>
              </div>
            </div>
          </article>

          <!-- Q22 -->
          <article class="card question-card">
            <div class="q-header">
              <span class="q-num">Q22</span>
              <span class="q-marks">2 Marks</span>
            </div>
            <div class="q-text">
              <p>In &Delta;ABC, DE &parallel; BC intersecting AB at D and AC at E. If AD = x, DB = x - 2, AE = x + 2, and EC = x - 1, find the value of x.</p>
            </div>
            <div class="solution-box">
              <span class="sol-tag">Marking Scheme &amp; Solution:</span>
              <div class="steps">
                1. By Basic Proportionality Theorem (Thales' Theorem): AD / DB = AE / EC. <span class="step-marks">[1/2 Mark]</span><br/>
                2. x / (x - 2) = (x + 2) / (x - 1). <span class="step-marks">[1/2 Mark]</span><br/>
                3. Cross-multiplying: x(x - 1) = (x - 2)(x + 2) &rarr; x² - x = x² - 4. <span class="step-marks">[1/2 Mark]</span><br/>
                4. -x = -4 &rarr; x = 4. <span class="step-marks">[1/2 Mark]</span>
              </div>
            </div>
          </article>
        </div>
      </section>

      <!-- Section C: Maths (3 Marks) -->
      <section class="section paper-section">
        <div class="section-badge-header">
          <h3>SECTION C — 18 Marks</h3>
          <p class="muted">Questions 26 to 31 carry 3 marks each.</p>
        </div>

        <div class="questions-list">
          <!-- Q26 -->
          <article class="card question-card">
            <div class="q-header">
              <span class="q-num">Q26</span>
              <span class="q-marks">3 Marks</span>
            </div>
            <div class="q-text">
              <p>Prove the trigonometric identity: (sin &theta; - 2sin³ &theta;) / (2cos³ &theta; - cos &theta;) = tan &theta;.</p>
            </div>
            <div class="solution-box">
              <span class="sol-tag">Marking Scheme &amp; Solution:</span>
              <div class="steps">
                1. LHS = [sin &theta; (1 - 2sin² &theta;)] / [cos &theta; (2cos² &theta; - 1)]. <span class="step-marks">[1 Mark]</span><br/>
                2. Substitute sin² &theta; = 1 - cos² &theta; in numerator:<br/>
                &nbsp;&nbsp;&nbsp;1 - 2(1 - cos² &theta;) = 1 - 2 + 2cos² &theta; = 2cos² &theta; - 1. <span class="step-marks">[1 Mark]</span><br/>
                3. LHS = [sin &theta; (2cos² &theta; - 1)] / [cos &theta; (2cos² &theta; - 1)] = sin &theta; / cos &theta; = tan &theta; = RHS. Hence Proved. <span class="step-marks">[1 Mark]</span>
              </div>
            </div>
          </article>

          <!-- Q27 -->
          <article class="card question-card">
            <div class="q-header">
              <span class="q-num">Q27</span>
              <span class="q-marks">3 Marks</span>
            </div>
            <div class="q-text">
              <p>Prove that the tangents drawn from an external point to a circle are equal in length (Theorem 10.2).</p>
            </div>
            <div class="solution-box">
              <span class="sol-tag">Marking Scheme &amp; Solution:</span>
              <div class="steps">
                1. <em>Given:</em> A circle with centre O, external point P, tangents PQ and PR. To prove: PQ = PR.<br/>
                2. <em>Construction:</em> Join OP, OQ, and OR. <span class="step-marks">[1/2 Mark]</span><br/>
                3. In &Delta;OQP and &Delta;ORP:<br/>
                &nbsp;&nbsp;&nbsp;• &ang;OQP = &ang;ORP = 90° (Radius is perpendicular to tangent at point of contact).<br/>
                &nbsp;&nbsp;&nbsp;• OP = OP (Common hypotenuse).<br/>
                &nbsp;&nbsp;&nbsp;• OQ = OR (Radii of the same circle). <span class="step-marks">[1.5 Marks]</span><br/>
                4. &Delta;OQP &cong; &Delta;ORP by RHS Congruence Criterion.<br/>
                5. Therefore, PQ = PR by CPCT. Hence Proved. <span class="step-marks">[1 Mark]</span>
              </div>
            </div>
          </article>
        </div>
      </section>

      <!-- Section D: Maths (5 Marks) -->
      <section class="section paper-section">
        <div class="section-badge-header">
          <h3>SECTION D — 20 Marks</h3>
          <p class="muted">Questions 32 to 35 carry 5 marks each.</p>
        </div>

        <div class="questions-list">
          <!-- Q32 -->
          <article class="card question-card">
            <div class="q-header">
              <span class="q-num">Q32</span>
              <span class="q-marks">5 Marks</span>
            </div>
            <div class="q-text">
              <p>A motor boat whose speed is 18 km/h in still water takes 1 hour more to go 24 km upstream than to return downstream to the same spot. Find the speed of the stream.</p>
            </div>
            <div class="solution-box">
              <span class="sol-tag">Marking Scheme &amp; Solution:</span>
              <div class="steps">
                1. Let the speed of the stream be x km/h. Speed upstream = (18 - x) km/h, speed downstream = (18 + x) km/h. <span class="step-marks">[1 Mark]</span><br/>
                2. Time upstream T₁ = 24 / (18 - x), Time downstream T₂ = 24 / (18 + x). <span class="step-marks">[1 Mark]</span><br/>
                3. Given condition: [24 / (18 - x)] - [24 / (18 + x)] = 1.<br/>
                4. 24 [(18 + x - 18 + x) / (324 - x²)] = 1 &rarr; 24(2x) = 324 - x² &rarr; x² + 48x - 324 = 0. <span class="step-marks">[1.5 Marks]</span><br/>
                5. Factoring: (x + 54)(x - 6) = 0. Since speed cannot be negative, x = 6 km/h.<br/>
                • <em>Answer:</em> Speed of the stream is 6 km/h. <span class="step-marks">[1.5 Marks]</span>
              </div>
            </div>
          </article>
        </div>
      </section>

      <!-- Section E: Case Study -->
      <section class="section paper-section">
        <div class="section-badge-header">
          <h3>SECTION E — 12 Marks</h3>
          <p class="muted">Questions 36 to 38 are Case-Based questions of 4 marks each.</p>
        </div>

        <div class="questions-list">
          <article class="card question-card">
            <div class="q-header">
              <span class="q-num">Q36 (Case Study 1 · Applications of Trigonometry)</span>
              <span class="q-marks">4 Marks</span>
            </div>
            <div class="q-text">
              <p><strong>Context:</strong> A traffic monitoring drone is hovering at a fixed vertical altitude above a straight road. From two observation points A and B on the road 100 m apart on the same side of the drone's vertical projection, the angles of elevation of the stationary drone P are 30° and 60° respectively.</p>
              <div class="case-sub-questions">
                <p><strong>(i)</strong> Draw a neat representative line diagram labeling all distances and angles. <span class="badge-mini">1 Mark</span></p>
                <p><strong>(ii)</strong> If the drone is at vertical height h, express the distance from the closer observation point B to the foot of the perpendicular Q in terms of h. <span class="badge-mini">1 Mark</span></p>
                <p><strong>(iii)</strong> Calculate the exact height h of the drone above the ground (take √3 = 1.732). <span class="badge-mini">2 Marks</span></p>
              </div>
            </div>
            <div class="solution-box">
              <span class="sol-tag">Marking Scheme &amp; Solution:</span>
              <div class="steps">
                • <strong>(i) Diagram:</strong> Vertical line PQ = h with Q on road. Points B and A collinear with Q. &ang;PBQ = 60°, &ang;PAQ = 30°, AB = 100 m. <span class="step-marks">[1 Mark]</span><br/>
                • <strong>(ii):</strong> In right &Delta;PQB: tan 60° = h / QB &rarr; √3 = h / QB &rarr; QB = h / √3. <span class="step-marks">[1 Mark]</span><br/>
                • <strong>(iii):</strong> In right &Delta;PQA: tan 30° = h / QA = h / (100 + QB) &rarr; 1 / √3 = h / (100 + h / √3).<br/>
                &nbsp;&nbsp;&nbsp;100 + h / √3 = h√3 &rarr; 100 = h (√3 - 1/√3) = h (2 / √3).<br/>
                &nbsp;&nbsp;&nbsp;h = 100√3 / 2 = 50√3 = 50 × 1.732 = 86.6 metres. <span class="step-marks">[2 Marks]</span>
              </div>
            </div>
          </article>
        </div>
      </section>
    </div>

    <!-- ========================================================================= -->
    <!-- SCIENCE SAMPLE PAPER -->
    <!-- ========================================================================= -->
    <div id="paper-science" class="paper-content-container">
      <div class="paper-header card">
        <div class="paper-header-meta">
          <span class="series">CBSE CLASS 10 BOARD EXAMINATION 2026</span>
          <h2>SCIENCE (SUBJECT CODE: 086)</h2>
          <div class="spec-row">
            <span><strong>Time Allowed:</strong> 3 Hours</span>
            <span><strong>Maximum Marks:</strong> 80</span>
            <span><strong>Total Questions:</strong> 39</span>
          </div>
        </div>
        <div class="general-instructions">
          <h4>General Instructions:</h4>
          <ol>
            <li>The question paper comprises <strong>39 questions</strong> in <strong>5 sections</strong>: A, B, C, D, and E.</li>
            <li><strong>Section A</strong>: Q1 to Q20 are objective type questions (1 mark each). Q17 to Q20 are Assertion-Reasoning.</li>
            <li><strong>Section B</strong>: Q21 to Q26 are Very Short Answer type questions (2 marks each).</li>
            <li><strong>Section C</strong>: Q27 to Q33 are Short Answer type questions (3 marks each).</li>
            <li><strong>Section D</strong>: Q34 to Q36 are Long Answer type questions (5 marks each).</li>
            <li><strong>Section E</strong>: Q37 to Q39 are Case-Based/Data-Based assessments (4 marks each) with internal choices.</li>
          </ol>
        </div>
      </div>

      <!-- Section A: Science -->
      <section class="section paper-section">
        <div class="section-badge-header">
          <h3>SECTION A — 20 Marks</h3>
          <p class="muted">Questions 1 to 20 carry 1 mark each.</p>
        </div>

        <div class="questions-list">
          <article class="card question-card">
            <div class="q-header">
              <span class="q-num">Q1</span>
              <span class="q-marks">1 Mark</span>
            </div>
            <div class="q-text">
              <p>When lead nitrate powder is heated strongly in a dry test tube, brown fumes of gas (X) are evolved along with a yellow solid residue of (Y). What are (X) and (Y)?</p>
              <div class="mcq-options">
                <span class="opt">(a) X = NO₂, Y = PbO</span>
                <span class="opt">(b) X = O₂, Y = PbO</span>
                <span class="opt">(c) X = N₂O, Y = Pb₃O₄</span>
