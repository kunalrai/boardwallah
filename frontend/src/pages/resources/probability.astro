              <!-- Face Cards Summary Box -->
              <rect x="30" y="180" width="400" height="55" rx="6" fill="#ecfdf5" stroke="#10b981"/>
              <text x="230" y="202" text-anchor="middle" font-size="11" font-weight="700" fill="#065f46">12 Face Cards (Jack, Queen, King × 4 suits) = 6 Red + 6 Black</text>
              <text x="230" y="222" text-anchor="middle" font-size="10" fill="#047857">4 Aces (2 Red + 2 Black) · Note: Ace is NOT a face card!</text>
            </svg>
          </div>
          <p class="visual-caption">Standard 52-card hierarchy: 2 colors, 4 suits (13 each), 12 face cards, and 4 aces.</p>
        </div>

        <div class="card visual-card">
          <div class="visual-badge">Visual Diagram 2 · Two-Dice 36 Outcomes Matrix &amp; Sum Diagonal</div>
          <div class="svg-container">
            <svg viewBox="0 0 460 250" xmlns="http://www.w3.org/2000/svg" aria-label="Two dice 36 outcomes sum matrix">
              <rect width="460" height="250" fill="#f8fafc" rx="8"/>
              
              <!-- Matrix Title -->
              <text x="230" y="22" text-anchor="middle" font-size="12" font-weight="700" fill="#0f766e">36 Possible Outcomes (Die 1 vs Die 2)</text>

              <!-- Table Headers -->
              <text x="70" y="50" font-size="10" font-weight="700" fill="#64748b">Die 1 \ 2</text>
              <text x="130" y="50" font-size="10" font-weight="700" fill="#0284c7">1</text>
              <text x="180" y="50" font-size="10" font-weight="700" fill="#0284c7">2</text>
              <text x="230" y="50" font-size="10" font-weight="700" fill="#0284c7">3</text>
              <text x="280" y="50" font-size="10" font-weight="700" fill="#0284c7">4</text>
              <text x="330" y="50" font-size="10" font-weight="700" fill="#0284c7">5</text>
              <text x="380" y="50" font-size="10" font-weight="700" fill="#0284c7">6</text>

              <!-- Rows sample -->
              <!-- Row 1: 1 -->
              <text x="70" y="80" font-size="10" font-weight="700" fill="#0284c7">1</text>
              <rect x="115" y="68" width="30" height="18" rx="3" fill="#ecfdf5" stroke="#10b981"/>
              <text x="130" y="81" font-size="9" text-anchor="middle" fill="#065f46" font-weight="700">1,1</text>
              <text x="180" y="81" font-size="9" text-anchor="middle" fill="#64748b">1,2</text>
              <text x="230" y="81" font-size="9" text-anchor="middle" fill="#64748b">1,3</text>
              <text x="280" y="81" font-size="9" text-anchor="middle" fill="#64748b">1,4</text>
              <text x="330" y="81" font-size="9" text-anchor="middle" fill="#64748b">1,5</text>
              <text x="380" y="81" font-size="9" text-anchor="middle" fill="#64748b">1,6</text>

              <!-- Row 2: 2 -->
              <text x="70" y="105" font-size="10" font-weight="700" fill="#0284c7">2</text>
              <text x="130" y="105" font-size="9" text-anchor="middle" fill="#64748b">2,1</text>
              <rect x="165" y="93" width="30" height="18" rx="3" fill="#ecfdf5" stroke="#10b981"/>
              <text x="180" y="105" font-size="9" text-anchor="middle" fill="#065f46" font-weight="700">2,2</text>
              <text x="230" y="105" font-size="9" text-anchor="middle" fill="#64748b">2,3</text>
              <text x="280" y="105" font-size="9" text-anchor="middle" fill="#64748b">2,4</text>
              <text x="330" y="105" font-size="9" text-anchor="middle" fill="#64748b">2,5</text>
              <text x="380" y="105" font-size="9" text-anchor="middle" fill="#64748b">2,6</text>

              <!-- Highlighted Doublets diagonal line -->
              <line x1="130" y1="80" x2="380" y2="180" stroke="#10b981" stroke-width="2" stroke-dasharray="4"/>
              
