              <text x="165" y="150" text-anchor="middle" font-size="11" font-weight="700" fill="#dc2626">13 Diamonds ♦</text>

              <!-- Black: Spades & Clubs -->
              <line x1="320" y1="103" x2="295" y2="130" stroke="#334155" stroke-width="1.5"/>
              <line x1="380" y1="103" x2="405" y2="130" stroke="#334155" stroke-width="1.5"/>
              <rect x="250" y="130" width="90" height="30" rx="4" fill="#fff" stroke="#334155"/>
