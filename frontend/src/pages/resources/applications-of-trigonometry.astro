---
import Layout from "../../layouts/Layout.astro";
import { loadContent } from "../../lib/content";
import { calBookingUrl } from "../../lib/site";

const { provider } = loadContent();
---

<Layout
  title={`Some Applications of Trigonometry | CBSE Class 10 Maths | ${provider.name}`}
  description="CBSE Class 10 Maths Chapter 9 study notes on Some Applications of Trigonometry (Heights and Distances). Line of sight, angle of elevation, angle of depression, 1-triangle & 2-triangle setups, and an interactive 20-question board exam quiz."
>
  <div class="wrap">
    <nav class="small" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/subjects/">Subjects</a> / <a href="/resources/">Resources</a> / Applications of Trigonometry
    </nav>

    <div class="resource-header">
      <span class="eyebrow">CBSE Class 10 · Mathematics · Chapter 9</span>
      <h1>Some Applications of Trigonometry</h1>
      <p class="lead">
        Master real-world heights and distances problems: understand line of sight, angle of elevation and depression, set up trigonometric equations, and solve board exam scenarios.
      </p>
    </div>

    <!-- Core Concepts -->
    <section class="section">
      <h2>Key Concepts &amp; Formulas</h2>

      <div class="grid two concept-grid">
        <article class="card">
          <h3>👁️ Line of Sight &amp; Angle of Elevation</h3>
          <p class="formula">Observer looking UPWARDS at an object</p>
          <ul class="clean-list">
            <li><strong>Line of Sight:</strong> The imaginary line drawn from the eye of an observer to the point in the object viewed by the observer.</li>
            <li><strong>Angle of Elevation:</strong> The angle formed by the line of sight with the horizontal line when the point being viewed is <strong>above</strong> the horizontal level.</li>
            <li><code>tan θ = Height / Distance = Opposite / Adjacent</code></li>
          </ul>
        </article>

        <article class="card">
          <h3>⬇️ Angle of Depression</h3>
          <p class="formula">Observer looking DOWNWARDS at an object</p>
          <ul class="clean-list">
            <li><strong>Angle of Depression:</strong> The angle formed by the line of sight with the horizontal line when the point being viewed is <strong>below</strong> the horizontal level.</li>
            <li><strong>Key Geometric Property:</strong> By alternate interior angles between horizontal parallel lines, <code>Angle of Depression = Angle of Elevation</code> from the object to the observer!</li>
          </ul>
        </article>

        <article class="card">
          <h3>⚡ Key Trigonometric Values for Word Problems</h3>
          <p class="formula">Most problems involve 30°, 45°, and 60°</p>
          <ul class="clean-list">
            <li><code>tan 30° = 1 / √3 ≈ 0.577</code> &nbsp;|&nbsp; <code>sin 30° = 1/2</code></li>
            <li><code>tan 45° = 1</code> &nbsp;(Height equals horizontal distance!)</li>
            <li><code>tan 60° = √3 ≈ 1.732</code> &nbsp;|&nbsp; <code>sin 60° = √3/2</code></li>
            <li>Use <code>√3 = 1.732</code> and <code>√2 = 1.414</code> when numeric calculations are required by the question.</li>
          </ul>
        </article>

        <article class="card">
          <h3>🏰 Standard 2-Triangle Problem Archetypes</h3>
          <p class="formula">Multi-stage trigonometric formulations</p>
          <ul class="clean-list">
            <li><strong>Two points on the ground:</strong> Watching a tower from two points on the same side or opposite sides: <code>h = d / (cot θ₁ ± cot θ₂)</code>.</li>
            <li><strong>Pedestal &amp; Statue:</strong> Statue of height <em>h</em> on a pedestal of height <em>p</em>.</li>
            <li><strong>Equal poles on opposite sides of road:</strong> Road width <em>w</em>, two equal poles of height <em>h</em> with angles of elevation 30° and 60°.</li>
            <li><strong>Cloud &amp; Reflection in Lake:</strong> Cloud at height <em>h</em> above water, reflection at depth <em>h</em> below water surface.</li>
          </ul>
        </article>
      </div>
    </section>

    <!-- Visual Diagrams Section -->
    <section class="section">
      <h2>Visual Concepts: Elevation vs Depression &amp; Dual Observation Setup</h2>

      <div class="grid two">
        <div class="card visual-card">
          <div class="visual-badge">Visual Diagram 1 · Elevation vs. Depression</div>
          <div class="svg-container">
            <svg viewBox="0 0 460 250" xmlns="http://www.w3.org/2000/svg" aria-label="Angle of elevation and depression">
              <rect width="460" height="250" fill="#f8fafc" rx="8"/>
              
              <!-- Observer Eye Level (Center Left) -->
              <circle cx="80" cy="125" r="6" fill="#0f766e"/>
              <text x="45" y="130" font-size="11" font-weight="700" fill="#0f766e">Eye</text>

              <!-- Horizontal Line -->
              <line x1="80" y1="125" x2="380" y2="125" stroke="#64748b" stroke-width="2" stroke-dasharray="4"/>
              <text x="390" y="129" font-size="11" fill="#64748b">Horizontal Level</text>

              <!-- Looking UP: Object A (Kite/Tower top) -->
              <line x1="80" y1="125" x2="340" y2="40" stroke="#0284c7" stroke-width="2.5"/>
              <circle cx="340" cy="40" r="5" fill="#0284c7"/>
              <text x="350" y="45" font-size="11" font-weight="700" fill="#0284c7">Object Above</text>
              <!-- Arc for elevation -->
              <path d="M 130 125 A 50 50 0 0 0 122 105" fill="none" stroke="#0284c7" stroke-width="2"/>
              <text x="145" y="110" font-size="11" font-weight="700" fill="#0284c7">θ₁ (Elevation)</text>

              <!-- Looking DOWN: Object B (Boat/Car) -->
              <line x1="80" y1="125" x2="340" y2="210" stroke="#ea580c" stroke-width="2.5"/>
              <circle cx="340" cy="210" r="5" fill="#ea580c"/>
              <text x="350" y="215" font-size="11" font-weight="700" fill="#ea580c">Object Below</text>
              <!-- Arc for depression -->
              <path d="M 130 125 A 50 50 0 0 1 122 145" fill="none" stroke="#ea580c" stroke-width="2"/>
              <text x="145" y="150" font-size="11" font-weight="700" fill="#ea580c">θ₂ (Depression)</text>
            </svg>
          </div>
          <p class="visual-caption">Angle of elevation is measured looking up from horizontal; angle of depression is measured looking down from horizontal.</p>
        </div>

        <div class="card visual-card">
          <div class="visual-badge">Visual Diagram 2 · Two Observation Points from Ground</div>
          <div class="svg-container">
            <svg viewBox="0 0 460 250" xmlns="http://www.w3.org/2000/svg" aria-label="Two observation points of a tower">
              <rect width="460" height="250" fill="#f8fafc" rx="8"/>
              
              <!-- Ground line -->
              <line x1="30" y1="210" x2="430" y2="210" stroke="#64748b" stroke-width="2"/>
              
              <!-- Tower AB -->
              <line x1="380" y1="50" x2="380" y2="210" stroke="#0f766e" stroke-width="5"/>
              <text x="390" y="130" font-size="12" font-weight="700" fill="#0f766e">h (Tower)</text>
              <text x="380" y="42" font-size="11" font-weight="700" fill="#0f766e" text-anchor="middle">A</text>
              <text x="380" y="225" font-size="11" font-weight="700" fill="#0f766e" text-anchor="middle">B (90°)</text>

              <!-- Observation point C (closer, 60°) -->
              <circle cx="280" cy="210" r="4" fill="#0284c7"/>
              <line x1="280" y1="210" x2="380" y2="50" stroke="#0284c7" stroke-width="2"/>
              <text x="280" y="225" font-size="11" font-weight="700" fill="#0284c7" text-anchor="middle">C</text>
              <path d="M 305 210 A 25 25 0 0 0 297 185" fill="none" stroke="#0284c7" stroke-width="1.5"/>
              <text x="315" y="195" font-size="10" font-weight="700" fill="#0284c7">60°</text>

              <!-- Observation point D (farther, 30°) -->
              <circle cx="100" cy="210" r="4" fill="#ea580c"/>
              <line x1="100" y1="210" x2="380" y2="50" stroke="#ea580c" stroke-width="2"/>
              <text x="100" y="225" font-size="11" font-weight="700" fill="#ea580c" text-anchor="middle">D</text>
              <path d="M 130 210 A 30 30 0 0 0 125 195" fill="none" stroke="#ea580c" stroke-width="1.5"/>
              <text x="140" y="198" font-size="10" font-weight="700" fill="#ea580c">30°</text>

              <!-- Distance CD = d -->
              <line x1="100" y1="235" x2="280" y2="235" stroke="#475569" stroke-width="1.5"/>
              <text x="190" y="247" text-anchor="middle" font-size="10" fill="#475569" font-weight="600">Distance CD = d</text>
            </svg>
          </div>
          <p class="visual-caption">Classic 2-triangle setup: As the observer approaches the tower from D to C, the angle of elevation increases from 30° to 60°.</p>
        </div>
      </div>
    </section>

    <!-- Solved Step-by-Step Problem -->
    <section class="section">
      <h2>Exemplar Board Problem: Heights &amp; Distances Solved</h2>
      <div class="card" style="padding:1.75rem; background:var(--paper)">
        <h3 style="color:var(--brand);margin-top:0">Problem: The shadow of a tower standing on a level ground is found to be 40 m longer when the Sun's altitude is 30° than when it is 60°. Find the height of the tower. (Take √3 = 1.732)</h3>
        <div style="font-size:0.95rem; line-height:1.7; color:var(--text)">
          <p><strong>Step 1 (Draw &amp; Label the Diagram):</strong>
            <br/>Let <em>AB</em> be the tower of height <em>h</em>.
            <br/>Let <em>BC = x</em> be the length of the shadow when the Sun's altitude is 60°.
            <br/>When the Sun's altitude decreases to 30°, the shadow becomes <em>BD = x + 40</em> m.
          </p>
          <p><strong>Step 2 (From right-angled ΔABC):</strong>
            <br/><code>tan 60° = AB / BC = h / x</code>
            <br/><code>√3 = h / x &nbsp;⟹&nbsp; x = h / √3 &nbsp;...(Equation 1)</code>
          </p>
          <p><strong>Step 3 (From right-angled ΔABD):</strong>
            <br/><code>tan 30° = AB / BD = h / (x + 40)</code>
            <br/><code>1 / √3 = h / (x + 40) &nbsp;⟹&nbsp; x + 40 = h√3 &nbsp;...(Equation 2)</code>
          </p>
          <p><strong>Step 4 (Substitute x from Eq 1 into Eq 2):</strong>
            <br/><code>h / √3 + 40 = h√3</code>
            <br/>Multiply the entire equation by √3:
            <br/><code>h + 40√3 = 3h</code>
            <br/><code>2h = 40√3 &nbsp;⟹&nbsp; h = 20√3 meters</code>.
          </p>
          <p><strong>Step 5 (Compute numerical value):</strong>
            <br/><code>h = 20 × 1.732 = 34.64 meters</code>.
            <br/><strong>Answer:</strong> The height of the tower is <strong>20√3 m (or 34.64 m)</strong>.
          </p>
        </div>
      </div>
    </section>

    <!-- Interactive 20-Question Quiz -->
    <section class="section">
      <h2>Interactive CBSE Board Exam Quiz (20 Questions)</h2>
      <p class="muted">Test your skills in elevation, depression, shadow ratios, and multi-triangle applications with board exam MCQs.</p>

      <div class="quiz-container card" id="quiz-box">
        <div class="quiz-header-bar">
          <span class="quiz-counter" id="quiz-counter">Question 1 of 20</span>
          <span class="quiz-score" id="quiz-score">Score: 0 / 20</span>
        </div>

        <div class="quiz-question-body">
          <p class="quiz-q-text" id="quiz-question">Loading question...</p>
          <div class="quiz-options-list" id="quiz-options"></div>
          <div class="quiz-feedback" id="quiz-feedback"></div>
        </div>

        <div class="quiz-footer-actions">
          <button class="button secondary" id="quiz-prev-btn" disabled>← Previous</button>
          <button class="button" id="quiz-next-btn" disabled>Next Question →</button>
        </div>
      </div>

      <div class="quiz-completed-banner card" id="quiz-result-box" style="display:none; text-align:center; padding:2.5rem;">
        <h3>Quiz Completed! 🎉</h3>
        <p class="quiz-final-score" id="quiz-final-score" style="font-size:1.4rem; font-weight:700; color:var(--brand); margin:1rem 0;"></p>
        <p id="quiz-final-msg" class="muted"></p>
        <button class="button" id="quiz-restart-btn" style="margin-top:1rem;">Retake Quiz</button>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-banner">
      <h2>Need personalized Maths guidance for Class 10?</h2>
      <p>Book a free {provider.trial.duration_minutes}-minute trial session with {provider.tutor_name} (online or at-home) to master Heights &amp; Distances and geometry application problems.</p>
      <a class="button" href={calBookingUrl} target="_blank" rel="noopener noreferrer">Book Free Trial</a>
    </section>
  </div>
</Layout>

<script is:inline>
(function() {
  const quizData = [
    {
      q: "If the length of the shadow of a tower is √3 times that of its height, then the angle of elevation of the Sun is:",
      options: ["30°", "45°", "60°", "90°"],
      answer: 0,
      explanation: "Let height = h. Shadow = h√3. tan θ = h / (h√3) = 1/√3. Hence θ = 30°."
    },
    {
      q: "A pole 6 m high casts a shadow 2√3 m long on the ground, then the Sun's elevation is:",
      options: ["60°", "45°", "30°", "90°"],
      answer: 0,
      explanation: "tan θ = 6 / (2√3) = 3 / √3 = √3. Hence θ = 60°."
    },
    {
      q: "A ladder 15 m long just reaches the top of a vertical wall. If the ladder makes an angle of 60° with the wall, find the height of the wall:",
      options: ["15√3/2 m", "15/2 m", "7.5√3 m", "15 m"],
      answer: 1,
      explanation: "The angle with the wall is 60°, so the wall is the adjacent side to this angle. cos 60° = Height / Hypotenuse ⟹ 1/2 = h / 15 ⟹ h = 15/2 = 7.5 m."
    },
    {
      q: "The angle of elevation of the top of a tower from a point on the ground 30 m away from the foot of the tower is 30°. The height of the tower is:",
      options: ["10√3 m", "20√3 m", "30√3 m", "10 m"],
      answer: 0,
      explanation: "tan 30° = h / 30 ⟹ 1/√3 = h / 30 ⟹ h = 30 / √3 = 10√3 m."
    },
    {
      q: "If the angle of depression of an object from a 75 m high tower is 30°, the distance of the object from the base of the tower is:",
      options: ["25√3 m", "50√3 m", "75√3 m", "150 m"],
      answer: 2,
      explanation: "By alternate interior angles, angle of elevation from object to tower top is 30°. tan 30° = 75 / d ⟹ 1/√3 = 75 / d ⟹ d = 75√3 m."
    },
    {
      q: "A kite is flying at a height of 60 m above the ground attached to an inclined string of inclination 60°. Length of the string is:",
      options: ["40√3 m", "30 m", "60√3 m", "120 m"],
      answer: 0,
      explanation: "sin 60° = Height / Length = 60 / L ⟹ √3/2 = 60 / L ⟹ L = 120 / √3 = 40√3 m."
    },
    {
      q: "When the angle of elevation of the sun increases from 30° to 60°, the length of shadow of a tower:",
      options: ["Increases", "Decreases", "Remains unchanged", "Doubles"],
      answer: 1,
      explanation: "As the sun rises higher (angle of elevation increases), the shadow cast by an object becomes shorter."
    },
    {
      q: "From a point on a bridge across a river, the angles of depression of the banks on opposite sides are 30° and 45°. If the bridge is at a height of 3 m, the width of the river is:",
      options: ["3(√3 + 1) m", "3(√3 - 1) m", "3√3 m", "6 m"],
      answer: 0,
      explanation: "Width = d₁ + d₂. tan 30° = 3 / d₁ ⟹ d₁ = 3√3. tan 45° = 3 / d₂ ⟹ d₂ = 3. Width = 3√3 + 3 = 3(√3 + 1) m."
    },
    {
      q: "A tree breaks due to storm and the broken part bends so that the top touches the ground making an angle 30° with it. The distance from the foot of tree to where it touches ground is 8 m. Height of tree is:",
      options: ["8√3 m", "16√3 m", "8 m", "16 m"],
      answer: 0,
      explanation: "Let unbroken part = h, broken hypotenuse = L. tan 30° = h / 8 ⟹ h = 8/√3. cos 30° = 8 / L ⟹ √3/2 = 8 / L ⟹ L = 16/√3. Total tree height = h + L = 8/√3 + 16/√3 = 24/√3 = 8√3 m."
    },
    {
      q: "An observer 1.5 m tall is 28.5 m away from a chimney. The angle of elevation of the top from her eyes is 45°. The height of the chimney is:",
      options: ["28.5 m", "30 m", "31.5 m", "27 m"],
      answer: 1,
      explanation: "tan 45° = (H - 1.5) / 28.5 ⟹ 1 = (H - 1.5) / 28.5 ⟹ H - 1.5 = 28.5 ⟹ H = 30 m."
    },
    {
      q: "If the ratio of the height of a tower and the length of its shadow is 1 : 1, the angle of elevation of the Sun is:",
      options: ["30°", "45°", "60°", "90°"],
      answer: 1,
      explanation: "tan θ = Height / Shadow = 1/1 = 1 ⟹ θ = 45°."
    },
    {
      q: "The tops of two poles of heights 20 m and 14 m are connected by a wire. If the wire makes an angle of 30° with the horizontal, the length of the wire is:",
      options: ["12 m", "10 m", "8 m", "6 m"],
      answer: 0,
      explanation: "Difference in height = 20 - 14 = 6 m. sin 30° = 6 / L ⟹ 1/2 = 6 / L ⟹ L = 12 m."
    },
    {
      q: "From the top of a 7 m high building, the angle of elevation of the top of a cable tower is 60° and the angle of depression of its foot is 45°. Height of the tower is:",
      options: ["7(√3 + 1) m", "7(√3 - 1) m", "14√3 m", "21 m"],
      answer: 0,
      explanation: "Distance to tower base d: tan 45° = 7 / d ⟹ d = 7 m. For the tower top above 7 m: tan 60° = h / d = h / 7 ⟹ h = 7√3 m. Total tower height = 7 + 7√3 = 7(√3 + 1) m."
    },
    {
      q: "Two poles of equal heights are standing opposite each other on either side of an 80 m wide road. From a point between them on the road, the angles of elevation are 60° and 30°. The height of the poles is:",
      options: ["20√3 m", "40√3 m", "20 m", "40 m"],
      answer: 0,
      explanation: "Let distances be x and 80 - x. h = x tan 60° = x√3. Also h = (80 - x) tan 30° = (80 - x)/√3. x√3 = (80 - x)/√3 ⟹ 3x = 80 - x ⟹ 4x = 80 ⟹ x = 20 m. h = 20√3 m."
    },
    {
      q: "A 1.2 m tall girl spots a balloon moving with the wind at a constant height of 88.2 m. The angle of elevation reduces from 60° to 30°. The distance traveled by the balloon is:",
      options: ["58√3 m", "29√3 m", "87√3 m", "58 m"],
      answer: 0,
      explanation: "Effective height = 88.2 - 1.2 = 87 m. x₁ = 87 / tan 60° = 87 / √3 = 29√3. x₂ = 87 / tan 30° = 87√3. Distance = x₂ - x₁ = 87√3 - 29√3 = 58√3 m."
    },
    {
      q: "The angle of elevation of a cloud from a point h meters above a lake is θ and the angle of depression of its reflection in the lake is φ. The height of the cloud is:",
      options: ["[h(tan φ + tan θ)] / (tan φ - tan θ)", "[h(tan φ - tan θ)] / (tan φ + tan θ)", "h tan θ", "h tan φ"],
      answer: 0,
      explanation: "Let height of cloud above lake be H. Distance x = (H - h)/tan θ = (H + h)/tan φ. (H - h) tan φ = (H + h) tan θ ⟹ H(tan φ - tan θ) = h(tan φ + tan θ) ⟹ H = h(tan φ + tan θ)/(tan φ - tan θ)."
    },
    {
      q: "If a 1.5 m tall boy stands at a distance of 3 m from a lamp post and casts a shadow of 4.5 m, the height of the lamp post is:",
      options: ["2.5 m", "3 m", "3.5 m", "4 m"],
      answer: 0,
      explanation: "By similar triangles: H / (3 + 4.5) = 1.5 / 4.5 ⟹ H / 7.5 = 1 / 3 ⟹ H = 7.5 / 3 = 2.5 m."
    },
    {
      q: "A straight highway leads to the foot of a tower. A man on the tower observes a car at 30° depression. 6 seconds later, depression becomes 60°. Time taken to reach the tower foot from this point is:",
      options: ["3 seconds", "6 seconds", "9 seconds", "12 seconds"],
      answer: 0,
      explanation: "x₂ = h / √3. x₁ = h√3. Distance CD = x₁ - x₂ = h(√3 - 1/√3) = 2h/√3 covered in 6 s. Remaining distance x₂ = h/√3 is exactly half of CD! Since speed is uniform, time taken = 6 / 2 = 3 seconds."
    },
    {
      q: "The line drawn from the eye of an observer to the point of an object viewed is called:",
      options: ["Horizontal line", "Line of sight", "Vertical line", "Transversal"],
      answer: 1,
      explanation: "By definition, the line connecting the observer's eye to the point viewed is the line of sight."
    },
    {
      q: "If angles of elevation of the top of a tower from two points at distances a and b from the base and in the same straight line are complementary, height of tower is:",
      options: ["√(a/b)", "√(ab)", "ab", "a + b"],
      answer: 1,
      explanation: "tan θ = h / a. Complementary angle: tan(90° - θ) = cot θ = h / b. Multiplying both: tan θ · cot θ = (h/a)(h/b) ⟹ 1 = h² / (ab) ⟹ h = √(ab)."
    }
  ];

  let currentIdx = 0;
  let userAnswers = new Array(quizData.length).fill(null);

  const qText = document.getElementById("quiz-question");
  const optionsBox = document.getElementById("quiz-options");
  const feedbackBox = document.getElementById("quiz-feedback");
  const counterBox = document.getElementById("quiz-counter");
  const scoreBox = document.getElementById("quiz-score");
  const prevBtn = document.getElementById("quiz-prev-btn");
  const nextBtn = document.getElementById("quiz-next-btn");
  const quizBox = document.getElementById("quiz-box");
  const resultBox = document.getElementById("quiz-result-box");
  const finalScore = document.getElementById("quiz-final-score");
  const finalMsg = document.getElementById("quiz-final-msg");
  const restartBtn = document.getElementById("quiz-restart-btn");

  function renderQuestion(idx) {
    const item = quizData[idx];
    counterBox.textContent = `Question ${idx + 1} of ${quizData.length}`;
    qText.textContent = item.q;
    optionsBox.innerHTML = "";
    feedbackBox.textContent = "";
    feedbackBox.className = "quiz-feedback";

    const selected = userAnswers[idx];

    item.options.forEach((optText, oIdx) => {
      const btn = document.createElement("button");
      btn.className = "quiz-opt-btn";
      btn.textContent = `${String.fromCharCode(65 + oIdx)}. ${optText}`;

      if (selected !== null) {
        btn.disabled = true;
        if (oIdx === item.answer) {
          btn.classList.add("opt-correct");
        } else if (oIdx === selected) {
          btn.classList.add("opt-wrong");
        }
      } else {
        btn.onclick = () => selectOption(oIdx);
      }

      optionsBox.appendChild(btn);
    });

    if (selected !== null) {
      if (selected === item.answer) {
        feedbackBox.textContent = `✓ Correct! ${item.explanation}`;
        feedbackBox.classList.add("feedback-correct");
      } else {
        feedbackBox.textContent = `✗ Incorrect. Correct answer is option ${String.fromCharCode(65 + item.answer)}. ${item.explanation}`;
        feedbackBox.classList.add("feedback-wrong");
      }
    }

    prevBtn.disabled = idx === 0;
    nextBtn.disabled = selected === null;
    nextBtn.textContent = idx === quizData.length - 1 ? "Finish Quiz →" : "Next Question →";
    updateScoreDisplay();
  }

  function selectOption(oIdx) {
    userAnswers[currentIdx] = oIdx;
    renderQuestion(currentIdx);
  }

  function updateScoreDisplay() {
    let score = 0;
    userAnswers.forEach((ans, i) => {
      if (ans === quizData[i].answer) score++;
    });
    scoreBox.textContent = `Score: ${score} / ${quizData.length}`;
  }

  prevBtn.onclick = () => {
    if (currentIdx > 0) {
      currentIdx--;
      renderQuestion(currentIdx);
    }
  };

  nextBtn.onclick = () => {
    if (currentIdx < quizData.length - 1) {
      currentIdx++;
      renderQuestion(currentIdx);
    } else {
      finishQuiz();
    }
  };

  function finishQuiz() {
    quizBox.style.display = "none";
    resultBox.style.display = "block";
    let score = 0;
    userAnswers.forEach((ans, i) => {
      if (ans === quizData[i].answer) score++;
    });
    finalScore.textContent = `Your Final Score: ${score} / ${quizData.length} (${Math.round((score / quizData.length) * 100)}%)`;
    if (score >= 18) {
      finalMsg.textContent = "Outstanding mastery! You have exceptional clarity on angles of elevation/depression and dual-triangle modeling.";
    } else if (score >= 14) {
      finalMsg.textContent = "Great job! Review complementary angle proofs and moving observer problems to get full marks.";
    } else {
      finalMsg.textContent = "Keep practicing! Review the exemplar diagram and tan trigonometric ratios above, then retry.";
    }
  }

  restartBtn.onclick = () => {
    userAnswers = new Array(quizData.length).fill(null);
    currentIdx = 0;
    resultBox.style.display = "none";
    quizBox.style.display = "block";
    renderQuestion(0);
  };

  renderQuestion(0);
})();
</script>

