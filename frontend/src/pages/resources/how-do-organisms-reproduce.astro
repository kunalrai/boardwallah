              <line x1="300" y1="52" x2="300" y2="150" stroke="#f59e0b" stroke-width="3" stroke-dasharray="2,2" />
              <text x="340" y="105" font-size="10" font-weight="700" fill="#166534">&larr; Pollen Tube</text>

              <!-- Ovary (Swollen Base) -->
              <ellipse cx="300" cy="190" rx="60" ry="45" fill="#f0fdf4" stroke="#16a34a" stroke-width="2" />
              <text x="300" y="250" text-anchor="middle" font-size="11" font-weight="700" fill="#166534">Ovary (&rarr; Fruit)</text>

              <!-- Ovule inside -->
              <ellipse cx="300" cy="190" rx="30" ry="24" fill="#fef3c7" stroke="#d97706" stroke-width="1.5" />
              <circle cx="300" cy="198" r="6" fill="#dc2626" />
              <text x="300" y="185" text-anchor="middle" font-size="9" font-weight="700" fill="#92400e">Ovule (&rarr; Seed)</text>
              <text x="300" y="215" text-anchor="middle" font-size="8" fill="#991b1b">Female Egg</text>

              <!-- Stamens (Left & Right) -->
              <rect x="190" y="90" width="16" height="12" rx="4" fill="#fef08a" stroke="#ca8a04" />
              <path d="M 198 102 Q 190 180 250 200" fill="none" stroke="#65a30d" stroke-width="2" />
              <text x="160" y="85" font-size="10" font-weight="700" fill="#854d0e">Anther (Stamen)</text>

              <rect x="394" y="90" width="16" height="12" rx="4" fill="#fef08a" stroke="#ca8a04" />
              <path d="M 402 102 Q 410 180 350 200" fill="none" stroke="#65a30d" stroke-width="2" />
              <text x="400" y="85" font-size="10" font-weight="700" fill="#854d0e">Filament</text>
            </svg>
          </div>
          <p class="caption">Figure 1: Chemotropic growth of the pollen tube through the style to deliver dual male gametes to the ovule.</p>
        </article>

        <article class="card visual-card">
          <span class="visual-badge">Human Embryology</span>
          <h3>Female Reproductive System &amp; Implantation</h3>
          <div class="svg-container">
            <svg viewBox="0 0 600 320" xmlns="http://www.w3.org/2000/svg">
              <rect width="600" height="320" fill="#f8fafc" />
              
              <!-- Uterus Womb -->
              <path d="M 230 110 Q 300 80 370 110 L 350 210 Q 300 230 250 210 Z" fill="#ffe4e6" stroke="#e11d48" stroke-width="2" />
              <text x="300" y="145" text-anchor="middle" font-size="12" font-weight="700" fill="#be123c">UTERUS (Womb)</text>
              <circle cx="300" cy="170" r="10" fill="#f43f5e" />
              <text x="300" y="195" text-anchor="middle" font-size="9" font-weight="700" fill="#881337">Placenta &amp; Embryo</text>

              <!-- Fallopian Tubes (Left & Right) -->
              <path d="M 230 110 C 160 80, 100 120, 110 160" fill="none" stroke="#f43f5e" stroke-width="3" />
              <text x="120" y="75" font-size="10" font-weight="700" fill="#be123c">Fallopian Tube (Site of Fertilization)</text>

              <path d="M 370 110 C 440 80, 500 120, 490 160" fill="none" stroke="#f43f5e" stroke-width="3" />
              <text x="420" y="75" font-size="10" font-weight="700" fill="#be123c">Oviduct</text>

              <!-- Ovaries -->
              <ellipse cx="110" cy="175" rx="20" ry="14" fill="#fbcfe8" stroke="#db2777" stroke-width="2" />
              <text x="110" y="205" text-anchor="middle" font-size="10" font-weight="700" fill="#9d174d">Ovary</text>

              <ellipse cx="490" cy="175" rx="20" ry="14" fill="#fbcfe8" stroke="#db2777" stroke-width="2" />
              <text x="490" y="205" text-anchor="middle" font-size="10" font-weight="700" fill="#9d174d">Ovary</text>

              <!-- Cervix & Vagina (Bottom) -->
              <rect x="280" y="215" width="40" height="35" fill="#fecdd3" stroke="#e11d48" />
              <text x="300" y="235" text-anchor="middle" font-size="10" font-weight="700" fill="#9f1239">Cervix</text>

              <rect x="280" y="250" width="40" height="40" fill="#fda4af" stroke="#e11d48" />
              <text x="300" y="275" text-anchor="middle" font-size="10" font-weight="700" fill="#881337">Vagina</text>
            </svg>
          </div>
          <p class="caption">Figure 2: Architectural layout of the female tract showing ovulation from ovary, fertilization in oviduct, and uterine implantation.</p>
        </article>
      </div>
    </section>

    <!-- Quiz Section -->
    <section class="section">
      <div class="quiz-header">
        <div>
          <h2>CBSE Board Examination Practice: How Do Organisms Reproduce?</h2>
          <p class="muted">20 High-yield questions testing asexual fission modes, double fertilization, placental function, and contraceptive methods.</p>
        </div>
        <div class="quiz-score-badge" id="quizScoreBadge">Score: 0 / 20</div>
      </div>

      <div class="quiz-container" id="quizApp"></div>

      <div class="quiz-footer-actions">
        <span class="muted" id="quizProgressText">0 of 20 answered</span>
        <button class="button secondary" id="resetQuizBtn">Reset Quiz</button>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-banner">
      <h2>Score 100% in CBSE Class 10 Science</h2>
      <p>Master complex biological diagrams, NCERT line-by-line concepts, and board answer writing with 1-on-1 tutoring.</p>
      <a class="button" href={calBookingUrl} target="_blank" rel="noopener noreferrer">Book Your Free Trial Class</a>
    </section>
  </div>
</Layout>

<script is:inline>
  const questions = [
    {
      q: "Why are the human male testes positioned outside the abdominal cavity within the pouch-like scrotum?",
      opts: [
        "To protect them from mechanical bone injuries",
        "Because spermatogenesis requires a temperature approximately 2 to 2.5°C lower than normal internal body temperature",
        "To allow faster diffusion of testosterone into the air",
        "To prevent urine from mixing with semen"
      ],
      correct: 1,
      exp: "Sperm development (spermatogenesis) requires a cooler thermal environment (34.5–35°C), which the extra-abdominal scrotum provides."
    },
    {
      q: "In which anatomical organ of the female reproductive tract does fertilization between the sperm and ovum typically occur?",
      opts: [
        "Uterus",
        "Ovary",
        "Fallopian Tube (Oviduct)",
        "Cervix"
      ],
      correct: 2,
      exp: "Fertilization occurs in the ampullary-isthmic junction of the Fallopian tube (oviduct); the fertilized zygote then travels to implant in the uterus."
    },
    {
      q: "What is the primary role of the secretions provided by the prostate gland and seminal vesicles in the male reproductive system?",
      opts: [
        "To generate sperm cells via meiosis",
        "To provide a fluid medium, alkaline neutralization of vaginal acidity, and nutritional fructose to facilitate sperm transport",
        "To store urine during copulation",
        "To produce testosterone exclusively"
      ],
      correct: 1,
      exp: "Seminal vesicle and prostate fluids nourish sperm with fructose, neutralize acidic tracts, and provide a liquid vehicle (semen) for motility."
    },
    {
      q: "What is the exact biological function of the placenta during human pregnancy?",
      opts: [
        "It generates amniotic bone tissue",
        "It acts as a vascular bridge containing villi that delivers glucose, oxygen, and nutrients from mother to embryo, while carrying away fetal metabolic wastes",
        "It triggers monthly menstruation during gestation",
        "It prevents all maternal hormones from entering the fetal bloodstream"
      ],
      correct: 1,
      exp: "The placenta provides an extensive surface area for oxygen and nutrient diffusion from maternal blood into the embryo, and transfers embryo wastes into maternal circulation."
    },
    {
      q: "What happens to the uterine lining in a human female if the released ovum is NOT fertilized by a sperm?",
      opts: [
        "It hardens into a protective fibrous cyst",
        "It degenerates and sheds along with blood and unfertilized ovum through the vagina as menstruation",
        "It is reabsorbed by the fallopian tube",
        "It transforms immediately into ovarian follicles"
      ],
      correct: 1,
      exp: "Without progesterone maintenance from fertilization, the thickened uterine lining sloughs off, resulting in 3 to 5 days of menstrual bleeding."
    },
    {
      q: "Which mode of asexual reproduction is exhibited by the malarial parasite Plasmodium inside its protective cyst?",
      opts: [
        "Binary fission",
        "Fragmentation",
        "Multiple fission",
        "Regeneration"
      ],
      correct: 2,
      exp: "Plasmodium reproduces via multiple fission, where the single nucleus divides repeatedly into dozens of daughter cells inside a cyst, releasing them simultaneously."
    },
    {
      q: "How does binary fission in Leishmania fundamentally differ from binary fission in Amoeba?",
      opts: [
        "Amoeba divides only at night",
        "Amoeba can divide in any anatomical plane, whereas Leishmania has a definite whip-like flagellum and divides in a fixed longitudinal plane",
        "Leishmania produces four daughter cells",
        "Amoeba requires two parent cells"
      ],
      correct: 1,
      exp: "Amoeba splits across any random plane, whereas Leishmania possesses a specialized flagellar structure and divides longitudinally along a definite orientation."
    },
    {
      q: "Why is vegetative propagation widely practiced by horticulturists for growing plants like sugarcane, roses, and bananas?",
      opts: [
        "Because it produces seeds with diverse unpredictable colours",
        "Because it allows plants that have lost the capacity to produce viable seeds to reproduce, and produces genetically identical crops with faster maturation",
        "Because it requires zero soil nutrients",
        "Because it eradicates all fungal spores"
      ],
      correct: 1,
      exp: "Vegetative propagation preserves desirable genetic traits, produces fruits/flowers faster than seeds, and enables seedless plants (bananas, seedless grapes) to multiply."
    },
    {
      q: "In angiosperm plants, what are the two distinct cellular fusions that constitute 'Double Fertilization'?",
      opts: [
        "Two sperms fertilizing two separate eggs",
        "Syngamy (1 male gamete + egg &rarr; 2n Zygote) and Triple Fusion (1 male gamete + 2 polar nuclei &rarr; 3n Primary Endosperm Nucleus)",
        "Pollination followed by wind dispersal",
        "Mitosis followed by meiotic spore release"
      ],
      correct: 1,
      exp: "Double fertilization involves Syngamy (forming the diploid zygote) and Triple Fusion (forming the triploid nutritive endosperm)."
    },
    {
      q: "Following successful pollination and fertilization in a flower, what do the ovary and ovule ultimately transform into?",
      opts: [
        "Ovary becomes Seed; Ovule becomes Fruit",
        "Ovary becomes Fruit; Ovule becomes Seed",
        "Both become petals",
        "Ovary degenerates; Ovule becomes flower bud"
      ],
      correct: 1,
      exp: "Post-fertilization, the ovule develops a tough seed coat becoming the Seed, while the surrounding ovary wall swells and ripens into the Fruit."
    },
    {
      q: "Which contraceptive method provides the dual advantage of preventing unwanted pregnancy AND protecting against sexually transmitted infections (STIs)?",
      opts: [
        "Oral contraceptive pills",
        "Copper-T (Intrauterine device)",
        "Condoms (Mechanical barrier)",
        "Tubectomy"
      ],
      correct: 2,
      exp: "Condoms prevent physical contact of bodily fluids, serving as the only contraceptive method that also protects against STDs like HIV and Syphilis."
    },
    {
      q: "What is the surgical sterilization procedure called in which the vas deferens in human males is cut and ligated?",
      opts: [
        "Tubectomy",
        "Vasectomy",
        "Dialysis",
        "Laparoscopy"
      ],
      correct: 1,
      exp: "Vasectomy involves cutting and sealing the vas deferens, preventing sperm from entering the ejaculatory duct."
    },
    {
      q: "How does an intrauterine contraceptive device like the Copper-T prevent pregnancy when inserted into a female's uterus?",
      opts: [
        "By killing the ovaries",
        "By releasing copper ions that suppress sperm motility and preventing the blastocyst from implanting in the uterine wall",
        "By blocking the vagina completely",
        "By stopping menstruation permanently"
      ],
      correct: 1,
      exp: "Copper-T releases copper ions that decrease sperm viability and motility, while generating a localized sterile reaction that prevents blastocyst implantation."
    },
    {
      q: "Which of the following sexually transmitted diseases is caused by a bacterial pathogen?",
      opts: [
        "HIV-AIDS",
        "Genital Warts",
        "Syphilis",
        "Hepatitis B"
      ],
      correct: 2,
      exp: "Syphilis (caused by Treponema pallidum) and Gonorrhoea are bacterial STDs, whereas HIV-AIDS and Genital Warts are viral."
    },
    {
      q: "Why is sexual reproduction evolutionary superior to asexual reproduction in driving the long-term survival of species?",
      opts: [
        "Because it requires less energy",
        "Because sexual reproduction combines genetic material from two distinct individuals, creating novel variations essential for adapting to changing environments",
        "Because it produces millions of identical clones",
        "Because it does not involve DNA replication"
      ],
      correct: 1,
      exp: "Sexual reproduction shuffles genes via meiosis and fertilization, generating phenotypic variation that fuels natural selection and adaptation."
    },
    {
      q: "In Bryophyllum, where do the vegetative reproductive buds develop to produce independent new plants?",
      opts: [
        "Along the deep root nodes underground",
        "Along the notches in the margins of mature leaves",
        "Inside the flower petals",
        "On the surface of the bark"
      ],
      correct: 1,
      exp: "Bryophyllum produces adventitious buds in the serrated notches of leaf margins; when detached and touching moist soil, they grow into new plantlets."
    },
    {
      q: "What is the primary role of the bloblike sporangia in the bread mould fungus Rhizopus?",
      opts: [
        "To absorb water from the air",
        "To manufacture carbohydrates via photosynthesis",
        "To produce and house hundreds of microscopic reproductive spores covered by thick protective walls",
        "To attach the fungus to the bread"
      ],
      correct: 2,
      exp: "Sporangia are reproductive structures containing resilient, thick-walled spores that disperse through the air to germinate on moist bread."
    },
    {
      q: "Why is the misuse of prenatal ultrasound scanning to determine fetal sex strictly banned under the PCPNDT Act in India?",
      opts: [
        "Because ultrasound rays damage fetal brain development",
        "To eradicate female foeticide and restore a balanced female-to-male sex ratio in society",
        "Because ultrasound tests are 100% inaccurate",
        "To prevent multiple pregnancies"
      ],
      correct: 1,
      exp: "The Pre-Conception and Pre-Natal Diagnostic Techniques (PCPNDT) Act strictly criminalizes prenatal sex determination to stop female foeticide."
    },
    {
      q: "What happens during regeneration if an organism like Planaria is cut into three horizontal segments?",
      opts: [
        "All three segments die within an hour",
        "Only the head segment survives",
        "Each of the three segments regenerates missing organs to form three complete, healthy Planaria individuals",
        "The pieces fuse back into one scarred worm"
      ],
      correct: 2,
      exp: "Planaria possesses specialized stem cells (neoblasts) that proliferate and differentiate to reconstruct complete organisms from cut body fragments."
    },
    {
      q: "How do hormonal contraceptive pills effectively prevent pregnancy in females?",
      opts: [
        "By physically trapping sperm in the cervix",
        "By altering systemic hormone levels to inhibit the release of mature ova (ovulation) from the ovaries",
        "By neutralizing gastric acid in the stomach",
        "By dissolving the sperm membrane chemically"
      ],
      correct: 1,
      exp: "Oral pills contain synthetic estrogen and progestin that inhibit pituitary gonadotropin release, preventing ovulation."
    }
  ];

  let userAnswers = {};

  function renderQuiz() {
    const container = document.getElementById('quizApp');
    if (!container) return;
    container.innerHTML = '';

    questions.forEach((qItem, idx) => {
      const card = document.createElement('div');
      card.className = 'quiz-card';

      const qTitle = document.createElement('h3');
      qTitle.className = 'quiz-question';
      qTitle.textContent = `${idx + 1}. ${qItem.q}`;
      card.appendChild(qTitle);

      const optsDiv = document.createElement('div');
      optsDiv.className = 'quiz-options';

      qItem.opts.forEach((optText, optIdx) => {
        const btn = document.createElement('button');
        btn.className = 'quiz-opt-btn';
        btn.textContent = optText;

        if (userAnswers[idx] !== undefined) {
          btn.disabled = true;
          if (optIdx === qItem.correct) {
            btn.classList.add('opt-correct');
          } else if (userAnswers[idx] === optIdx) {
            btn.classList.add('opt-wrong');
          }
        } else {
          btn.addEventListener('click', () => {
            userAnswers[idx] = optIdx;
            renderQuiz();
            updateScoreSummary();
          });
        }
        optsDiv.appendChild(btn);
      });

      card.appendChild(optsDiv);

      if (userAnswers[idx] !== undefined) {
        const fb = document.createElement('div');
        fb.className = 'quiz-feedback ' + (userAnswers[idx] === qItem.correct ? 'feedback-correct' : 'feedback-wrong');
        fb.innerHTML = (userAnswers[idx] === qItem.correct ? '<strong>✓ Correct!</strong> ' : '<strong>✗ Incorrect.</strong> ') + qItem.exp;
        card.appendChild(fb);
      }

      container.appendChild(card);
    });
  }

  function updateScoreSummary() {
    let score = 0;
    const answeredCount = Object.keys(userAnswers).length;
    for (let qIdx in userAnswers) {
      if (userAnswers[qIdx] === questions[qIdx].correct) {
        score++;
      }
    }
    const badge = document.getElementById('quizScoreBadge');
    if (badge) badge.textContent = `Score: ${score} / ${questions.length}`;

    const prog = document.getElementById('quizProgressText');
    if (prog) prog.textContent = `${answeredCount} of ${questions.length} answered`;
  }

  function resetQuiz() {
    userAnswers = {};
    renderQuiz();
    updateScoreSummary();
  }

  document.addEventListener('DOMContentLoaded', () => {
    renderQuiz();
    const resetBtn = document.getElementById('resetQuizBtn');
    if (resetBtn) resetBtn.addEventListener('click', resetQuiz);
  });
</script>

