              <rect width="600" height="320" fill="#f8fafc" />
              
              <!-- Petals (Pink backdrop) -->
              <path d="M 120 180 Q 200 60 260 140" fill="none" stroke="#f472b6" stroke-width="6" />
              <path d="M 480 180 Q 400 60 340 140" fill="none" stroke="#f472b6" stroke-width="6" />

              <!-- Pistil/Carpel (Center) -->
              <!-- Stigma -->
