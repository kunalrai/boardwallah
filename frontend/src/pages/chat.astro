          </button>
          <button class="notebook-item topic-preset-btn" data-thread="maths" type="button">
            <span class="item-icon">📄</span>
            <span class="item-label">Mathematics Standard</span>
          </button>
          <button class="notebook-item topic-preset-btn" data-thread="electricity" type="button">
            <span class="item-icon">📄</span>
            <span class="item-label">Electricity &amp; Physics</span>
          </button>
