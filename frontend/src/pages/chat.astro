        <div class="header-left-col">
          <button id="mobile-toggle-btn" class="mobile-toggle-btn" type="button" aria-label="Open sidebar">
            ☰
          </button>
          <span class="active-notebook-title" id="active-notebook-title"></span>
        </div>
        <div class="header-right-col">
          <div class="mode-pill-select" id="mode-pill-select" role="radiogroup" aria-label="AI Mode">
            <button class="mode-btn active" data-mode="hint" type="button" title="Socratic hints guiding you to find the answer yourself">💡 Hint</button>
            <button class="mode-btn" data-mode="step_by_step" type="button" title="Full CBSE model answer with marking scheme">📝 CBSE Answer</button>
            <button class="mode-btn" data-mode="find_mistake" type="button" title="Paste steps to spot mistakes">🔍 Step Check</button>
          </div>
