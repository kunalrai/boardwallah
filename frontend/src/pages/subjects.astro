---
import Layout from "../layouts/Layout.astro";
import { loadContent } from "../lib/content";
import { calBookingUrl } from "../lib/site";

const { provider, subjects } = loadContent();
---

<Layout
  title={`CBSE Class 10 subjects | ${provider.name}`}
  description={`Mathematics, Science, Social Science, English and Hindi for CBSE Class 10 with ${provider.tutor_name}.`}
>
  <div class="wrap">
    <nav class="small" aria-label="Breadcrumb"><a href="/">Home</a> / Subjects</nav>
    <h1>CBSE Class 10 subjects</h1>
    <p class="lead">
      All lessons follow the CBSE Class 10 syllabus, online or at your home. Tell us which subjects you need when you book.
    </p>

    <div class="grid two">
      {
        subjects.map((subject) => (
          <article class="card subject-card">
            <h2>{subject.name}</h2>
            <p class="muted">Board: {subject.board}. Class: {subject.class}.</p>
            <p>
              This subject is available as part of the monthly plan and the crash course. Mention it in the
              <a href="/enquiry/">enquiry form</a> if you want to discuss a specific topic first.
            </p>
            {subject.id === "science" && (
              <div class="subject-resources">
                <p><strong>Science chapter guides &amp; quizzes:</strong></p>
                <div style="margin-bottom: 0.5rem;">
                  <strong class="small" style="color:var(--brand)">Chemistry:</strong>
                  <ul style="margin-top:0.25rem; margin-bottom:0.5rem;">
                    <li><a href="/resources/chemical-reactions-equations/">⚗️ Chemical Reactions &amp; Equations</a></li>
                    <li><a href="/resources/acids-bases-salts/">🧪 Acids, Bases &amp; Salts</a></li>
                    <li><a href="/resources/metals-non-metals/">🔩 Metals &amp; Non-Metals</a></li>
                    <li><a href="/resources/carbon-and-its-compounds/">💎 Carbon &amp; Its Compounds</a></li>
                  </ul>
                </div>
                <div>
                  <strong class="small" style="color:var(--brand)">Physics:</strong>
                  <ul style="margin-top:0.25rem;">
                    <li><a href="/resources/light-reflection-refraction/">📖 Light – Reflection &amp; Refraction</a></li>
                    <li><a href="/resources/human-eye-colourful-world/">👁️ The Human Eye &amp; Colourful World</a></li>
                    <li><a href="/resources/electricity/">⚡ Electricity</a></li>
                    <li><a href="/resources/magnetic-effects-electric-current/">🧲 Magnetic Effects of Electric Current</a></li>
                  </ul>
                </div>
              </div>
            )}
            <a class="button secondary" href={calBookingUrl} target="_blank" rel="noopener noreferrer">Book a trial</a>
          </article>
        ))
      }
    </div>

    <section class="section">
      <div class="card">
        <h2>Trial lesson</h2>
        <p>
          The {provider.trial.duration_minutes}-minute trial is {provider.trial.fee_paise === 0 ? "free" : "paid"}.
          Join online from anywhere, or book a home visit in {provider.service_localities.join(" and ")}, on
          {provider.availability.days.join(", ")} between {provider.availability.window} IST.
        </p>
        <a class="button" href={calBookingUrl} target="_blank" rel="noopener noreferrer">Choose a trial slot</a>
      </div>
    </section>
  </div>
</Layout>
