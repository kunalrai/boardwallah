---
import Layout from "../layouts/Layout.astro";
import { loadContent } from "../lib/content";
import { calBookingUrl } from "../lib/site";

const { provider, subjects } = loadContent();
---

<Layout
  title={`CBSE Class 10 subjects | ${provider.name}`}
  description={`Mathematics, Science, Social Science, English and Hindi for CBSE Class 10 with ${provider.tutor_name}.`}
>
  <div class="wrap">
    <nav class="small" aria-label="Breadcrumb"><a href="/">Home</a> / Subjects</nav>
    <h1>CBSE Class 10 subjects</h1>
    <p class="lead">
      All lessons follow the CBSE Class 10 syllabus, online or at your home. Tell us which subjects you need when you book.
    </p>

    <div class="grid two">
      {
        subjects.map((subject) => (
          <article class="card subject-card">
            <h2>{subject.name}</h2>
            <p class="muted">Board: {subject.board}. Class: {subject.class}.</p>
            <p>
              This subject is available as part of the monthly plan and the crash course. Mention it in the
              <a href="/enquiry/">enquiry form</a> if you want to discuss a specific topic first.
            </p>
            {subject.id === "maths" && (
              <div class="subject-resources">
                <p><strong>Mathematics chapter guides &amp; quizzes (All 14 Chapters):</strong></p>
                <ul style="margin-top:0.25rem; margin-bottom:0.75rem; display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.35rem; font-size: 0.88rem;">
                  <li><a href="/resources/real-numbers/">🔢 Real Numbers</a></li>
                  <li><a href="/resources/polynomials/">📈 Polynomials</a></li>
                  <li><a href="/resources/linear-equations-in-two-variables/">📏 Linear Equations</a></li>
                  <li><a href="/resources/quadratic-equations/">📐 Quadratic Equations</a></li>
                  <li><a href="/resources/arithmetic-progressions/">🪜 Arithmetic Progressions</a></li>
                  <li><a href="/resources/triangles/">🔺 Triangles (BPT)</a></li>
                  <li><a href="/resources/coordinate-geometry/">📍 Coordinate Geometry</a></li>
                  <li><a href="/resources/introduction-to-trigonometry/">📐 Trigonometry</a></li>
                  <li><a href="/resources/applications-of-trigonometry/">🗼 Heights &amp; Distances</a></li>
                  <li><a href="/resources/circles/">⭕ Circles (Tangents)</a></li>
                  <li><a href="/resources/areas-related-to-circles/">🍰 Areas &amp; Circles</a></li>
                  <li><a href="/resources/surface-areas-and-volumes/">🧊 Surface Areas &amp; Volumes</a></li>
                  <li><a href="/resources/statistics/">📊 Statistics</a></li>
                  <li><a href="/resources/probability/">🎲 Probability</a></li>
                </ul>
              </div>
            )}
            {subject.id === "science" && (
              <div class="subject-resources">
                <p><strong>Science chapter guides &amp; quizzes:</strong></p>
                <div style="margin-bottom: 0.5rem;">
                  <strong class="small" style="color:var(--brand)">Chemistry:</strong>
                  <ul style="margin-top:0.25rem; margin-bottom:0.5rem;">
                    <li><a href="/resources/chemical-reactions-equations/">⚗️ Chemical Reactions &amp; Equations</a></li>
                    <li><a href="/resources/acids-bases-salts/">🧪 Acids, Bases &amp; Salts</a></li>
                    <li><a href="/resources/metals-non-metals/">🔩 Metals &amp; Non-Metals</a></li>
                    <li><a href="/resources/carbon-and-its-compounds/">💎 Carbon &amp; Its Compounds</a></li>
                  </ul>
                </div>
                <div>
                  <strong class="small" style="color:var(--brand)">Physics:</strong>
                  <ul style="margin-top:0.25rem;">
                    <li><a href="/resources/light-reflection-refraction/">📖 Light – Reflection &amp; Refraction</a></li>
                    <li><a href="/resources/human-eye-colourful-world/">👁️ The Human Eye &amp; Colourful World</a></li>
                    <li><a href="/resources/electricity/">⚡ Electricity</a></li>
                    <li><a href="/resources/magnetic-effects-electric-current/">🧲 Magnetic Effects of Electric Current</a></li>
                  </ul>
                </div>
              </div>
            )}
            {subject.id === "social_science" && (
              <div class="subject-resources">
                <p><strong>Social Science chapter guides &amp; quizzes (Complete Syllabus · 20 Chapters):</strong></p>
                <div style="margin-bottom: 0.5rem;">
                  <strong class="small" style="color:var(--brand)">History (India and the Contemporary World – II):</strong>
                  <ul style="margin-top:0.25rem; margin-bottom:0.5rem;">
                    <li><a href="/resources/the-rise-of-nationalism-in-europe/">🏰 The Rise of Nationalism in Europe</a></li>
                    <li><a href="/resources/nationalism-in-india/">🇮🇳 Nationalism in India</a></li>
                    <li><a href="/resources/the-making-of-a-global-world/">🌍 The Making of a Global World</a></li>
                    <li><a href="/resources/print-culture-and-the-modern-world/">📜 Print Culture and the Modern World</a></li>
                  </ul>
                </div>
                <div style="margin-bottom: 0.5rem;">
                  <strong class="small" style="color:var(--brand)">Civics (Democratic Politics – II):</strong>
                  <ul style="margin-top:0.25rem; margin-bottom:0.5rem;">
                    <li><a href="/resources/power-sharing/">⚖️ Power Sharing</a></li>
                    <li><a href="/resources/federalism/">🏛️ Federalism</a></li>
                    <li><a href="/resources/gender-religion-and-caste/">👩 Gender, Religion and Caste</a></li>
                    <li><a href="/resources/political-parties/">🗳️ Political Parties</a></li>
                    <li><a href="/resources/outcomes-of-democracy/">🌟 Outcomes of Democracy</a></li>
                  </ul>
                </div>
                <div style="margin-bottom: 0.5rem;">
                  <strong class="small" style="color:var(--brand)">Economics (Understanding Economic Development):</strong>
                  <ul style="margin-top:0.25rem; margin-bottom:0.5rem;">
                    <li><a href="/resources/development/">🎯 Development</a></li>
                    <li><a href="/resources/sectors-of-the-indian-economy/">🌾 Sectors of the Indian Economy</a></li>
                    <li><a href="/resources/money-and-credit/">💰 Money and Credit</a></li>
                    <li><a href="/resources/globalisation-and-the-indian-economy/">🌐 Globalisation and the Indian Economy</a></li>
                  </ul>
                </div>
                <div>
                  <strong class="small" style="color:var(--brand)">Geography (Contemporary India – II):</strong>
                  <ul style="margin-top:0.25rem;">
                    <li><a href="/resources/resources-and-development/">🌍 Resources and Development</a></li>
                    <li><a href="/resources/forest-and-wildlife-resources/">🌿 Forest and Wildlife Resources</a></li>
                    <li><a href="/resources/water-resources/">💧 Water Resources</a></li>
                    <li><a href="/resources/agriculture/">🚜 Agriculture</a></li>
                    <li><a href="/resources/minerals-and-energy-resources/">⛏️ Minerals and Energy Resources</a></li>
                    <li><a href="/resources/manufacturing-industries/">🏭 Manufacturing Industries</a></li>
                    <li><a href="/resources/lifelines-of-national-economy/">🛣️ Lifelines of National Economy</a></li>
                  </ul>
                </div>
              </div>
            )}
            <a class="button secondary" href={calBookingUrl} target="_blank" rel="noopener noreferrer">Book a trial</a>
          </article>
        ))
      }
    </div>

    <section class="section">
      <div class="card">
        <h2>Trial lesson</h2>
        <p>
          The {provider.trial.duration_minutes}-minute trial is {provider.trial.fee_paise === 0 ? "free" : "paid"}.
          Join online from anywhere, or book a home visit in {provider.service_localities.join(" and ")}, on
          {provider.availability.days.join(", ")} between {provider.availability.window} IST.
        </p>
        <a class="button" href={calBookingUrl} target="_blank" rel="noopener noreferrer">Choose a trial slot</a>
      </div>
    </section>
  </div>
</Layout>
