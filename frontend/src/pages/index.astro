        clearInterval(mockTimerInterval);
        mockTimerInterval = null;
      }
      if (timerStartBtn) timerStartBtn.textContent = 'Resume';
    });
  }

  if (timerResetBtn) {
    timerResetBtn.addEventListener('click', () => {
      if (mockTimerInterval) {
        clearInterval(mockTimerInterval);
        mockTimerInterval = null;
      }
