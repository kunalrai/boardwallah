    const STARTER_PACKS = {
      irrational: {
        subject: 'Mathematics',
        chapter: 'Ch 1: Real Numbers',
        marks: '3 MARKS',
        question: 'Prove that √5 is an irrational number.',
        hintBody: `**Socratic Hint (Ch 1: Real Numbers):**\nSuppose on the contrary that **\`√5\`** is rational. Then it can be written as \`√5 = a/b\` where \`a\` and \`b\` are integers with **\`b ≠ 0\`** and **\`HCF(a, b) = 1\`** (co-prime).\n\n- Square both sides and isolate \`a²\`.\n- Which fundamental theorem in NCERT tells you that if a prime \`p\` divides \`a²\`, then \`p\` divides \`a\`?`,
        solutionBody: `**CBSE Model Solution (3 Marks):**\n1. Assume \`√5\` is rational: \`√5 = a/b\`, where \`a, b\` are integers, \`b ≠ 0\`, and \`HCF(a, b) = 1\`.\n2. Squaring both sides gives \`5b² = a²\` → \`5\` divides \`a²\`, so by NCERT Theorem 1.2, **\`5\` divides \`a\`**.\n3. Let \`a = 5k\` for some integer \`k\`. Substituting gives \`5b² = 25k²\` → \`b² = 5k²\`, so **\`5\` divides \`b\`**.\n4. Thus \`5\` is a common factor of both \`a\` and \`b\`, contradicting \`HCF(a, b) = 1\`. Hence, **\`√5\` is irrational**.`,
        checkBody: `**Step Audit — Prove √5 Is Irrational:**\n- **Assumption & Co-primality:** Check that you explicitly state \`HCF(a, b) = 1\` and \`b ≠ 0\`.\n- **First Divisibility (\`5 | a² ⇒ 5 | a\`):** Earned if you link \`a² = 5b²\` to prime divisibility.\n- **Second Divisibility (\`a = 5k ⇒ 5 | b\`):** Often missed—must substitute back to show \`5\` divides \`b\` too before concluding contradiction.`,
        rubricSteps: [
          { mark: '1M', title: 'Assumption of Rationality & Co-primes', desc: 'Write √5 = a/b where a, b are co-prime integers (HCF = 1) and b ≠ 0.' },
          { mark: '1M', title: 'Squaring & Divisibility of a', desc: 'Obtain 5b² = a², deduce 5 divides a² and hence 5 divides a.' },
          { mark: '1M', title: 'Substitution & Contradiction Conclusion', desc: 'Substitute a = 5k to show 5 divides b, state contradiction to co-primality, and conclude √5 is irrational.' }
        ],
        examTip: 'Never skip writing "where a and b are co-prime integers (HCF = 1)"—CBSE marking schemes reserve explicit step credit for stating co-primality and contradiction.'
      },
      chemical: {
        subject: 'Science',
        chapter: 'Chem Ch 1: Chemical Reactions and Equations',
        marks: '3 MARKS',
        question: 'Balance the chemical equation: Fe(s) + H₂O(g) → Fe₃O₄(s) + H₂(g), and identify the type of reaction.',
        hintBody: `**Socratic Hint (Chem Ch 1):**\nStart by counting atoms of the element with the highest count on the product side (**Fe** and **O** in \`Fe₃O₄\`).\n\n- How many \`Fe\` atoms are on the RHS vs LHS?\n- How many \`O\` atoms are on the RHS vs LHS (in \`H₂O\`)?`,
        solutionBody: `**CBSE Model Solution (3 Marks):**\n1. **Balanced Equation:**\n   \`3Fe(s) + 4H₂O(g) → Fe₃O₄(s) + 4H₂(g)\`\n2. **Verification:** \`Fe\` = 3 on both sides; \`O\` = 4 on both sides; \`H\` = 8 on both sides.\n3. **Reaction Type:** **Displacement / Redox reaction** (iron displaces hydrogen from steam while getting oxidized to \`Fe₃O₄\`).`,
        checkBody: `**Step Audit — Balancing & State Symbols:**\n- Did you include physical state symbols **\`(s)\`**, **\`(g)\`**, **\`(aq)\`**?\n- Did you balance **\`H\`** after fixing **\`O\`** with coefficient \`4\` on \`H₂O\` (giving \`8 H\` atoms → \`4H₂\`)?`,
        rubricSteps: [
          { mark: '1.5M', title: 'Correct Stoichiometric Coefficients', desc: 'Balanced equation 3Fe + 4H₂O → Fe₃O₄ + 4H₂ with equal atom counts.' },
          { mark: '0.5M', title: 'Physical State Symbols', desc: 'Includes (s) and (g) steam state as specified in NCERT.' },
          { mark: '1M', title: 'Reaction Classification & Reasoning', desc: 'Correctly identifies displacement / redox behavior with clear justification.' }
        ],
        examTip: 'In CBSE Chemistry, forgetting state symbols or leaving fractional coefficients un-cleared can cost half-marks even when atom counts match.'
      },
      checksteps: {
        subject: 'Mathematics',
        chapter: 'Ch 4: Quadratic Equations',
        marks: '2 MARKS',
        question: 'Check my steps for finding the nature of roots of x² - 5x + 6 = 0.',
        hintBody: `**Socratic Hint (Discriminant D):**\nFor a quadratic equation \`ax² + bx + c = 0\`, recall the discriminant formula:\n\`D = b² - 4ac\`\n\n- Identify \`a\`, \`b\`, and \`c\` carefully (watch the negative sign of \`b\`).`,
        solutionBody: `**CBSE Model Solution (2 Marks):**\n1. Comparing \`x² - 5x + 6 = 0\` with \`ax² + bx + c = 0\`: \`a = 1, b = -5, c = 6\`.\n2. \`D = b² - 4ac = (-5)² - 4(1)(6) = 25 - 24 = 1 > 0\`.\n3. Since \`D > 0\`, the equation has **two distinct real roots** (\`x = 3\` and \`x = 2\`).`,
        checkBody: `**Step-by-Step Audit of Your Attempt:**\n- **Step 1 (\`a = 1, b = -5, c = 6\`):** ✔ Correct coefficients.\n- **Step 2 (\`D = (-5)² - 4(1)(6) = 1\`):** ✔ Correct discriminant calculation.\n- **Board Examiner Note:** In CBSE exams, always explicitly state **"D > 0 ⇒ Two distinct real roots"** even when asked to find the roots, as nature of roots carries distinct step credit.`,
        rubricSteps: [
          { mark: '0.5M', title: 'Standard Form & Coefficients', desc: 'Identifies a = 1, b = -5, c = 6 accurately.' },
          { mark: '1M', title: 'Discriminant Formula & Evaluation', desc: 'Writes D = b² - 4ac and computes D = 1.' },
          { mark: '0.5M', title: 'Nature of Roots Statement', desc: 'States D > 0 so two distinct real roots exist.' }
        ],
        examTip: 'Always write the formula D = b² - 4ac first before substituting numbers—formula writing alone can fetch step marks.'
      },
      mockdrill: {
        subject: 'Social Science',
        chapter: 'His Ch 1: The Rise of Nationalism in Europe',
        marks: '5 MARKS',
        question: 'Describe the process of unification of Germany (1866–1871).',
        hintBody: `**Socratic Hint (5-Mark History Answer):**\nStructure a 5-mark Social Science answer into **5 clear bulleted points** with key names, dates, and places:\n- Who led the architect role in Prussia?\n- Which **three wars over seven years** were fought, and what was the final **1871** ceremony?`,
        solutionBody: `**CBSE Model Solution (5 Marks):**\n1. **Leadership:** Otto von Bismarck (Chief Minister of Prussia) led unification using the Prussian army and bureaucracy.\n2. **Three Wars (7 Years):** Wars fought against **Denmark**, **France**, and **Austria**, ending in Prussian victory.\n3. **Proclamation (Jan 1871):** Prussian King **Kaiser William I** was proclaimed German Emperor at the **Hall of Mirrors, Palace of Versailles**.\n4. **State Modernization:** Emphasis on currency, banking, legal, and judicial systems in united Germany.`,
        checkBody: `**Step Audit — 5-Mark SST Rubric:**\n- A 5-mark SST question expects **5 distinct, well-explained points** (roughly 1 mark per valid point/keyword).\n- Key terms to include: **Otto von Bismarck**, **three wars in seven years**, **Kaiser William I (1871)**, **Palace of Versailles**.`,
        rubricSteps: [
          { mark: '1M', title: 'Bismarck & Prussian Leadership', desc: 'Mentions Otto von Bismarck and Prussian state/military leadership.' },
          { mark: '2M', title: 'Three Wars Over Seven Years', desc: 'Notes conflicts with Denmark, France, and Austria leading to victory.' },
          { mark: '2M', title: '1871 Proclamation & Reforms', desc: 'Mentions Kaiser William I at Versailles (Jan 1871) and modernization.' }
        ],
        examTip: 'For 3M and 5M Social Science answers, use crisp sub-points with underlined proper nouns, dates, and acts/treaties so examiners can award marks quickly.'
      }
    };

    const FLASHCARDS = [
      {
        subject: 'SCIENCE • PHYSICS',
        front: 'State Ohm’s Law and write its mathematical relation.',
        back: 'At constant temperature, electric current (I) flowing through a metallic conductor is directly proportional to the potential difference (V) across its ends. Relation: <strong>V = IR</strong> (where R is constant resistance in Ohms, Ω).'
      },
      {
        subject: 'MATHEMATICS • TRIGONOMETRY',
        front: 'What is the value of sin²θ + cos²θ for any acute angle θ?',
        back: '<strong>sin²θ + cos²θ = 1</strong> for all 0° ≤ θ ≤ 90°. Derived directly from Pythagoras theorem in a right-angled triangle (P² + B² = H²).'
      },
      {
