    const thinkingStages = [
      { main: "Thinking...", sub: "Consulting official CBSE Class 10 concepts & marking rubrics..." },
      { main: "Analyzing doubt...", sub: "Checking NCERT formulas, theorem conditions & step distribution..." },
      { main: "Formulating answer...", sub: "Structuring Socratic guidance and CBSE step-wise marks..." },
      { main: "Finalizing response...", sub: "Verifying standard SI units and key terms..." }
    ];
    let stageIdx = 0;
    if (thinkingInterval) clearInterval(thinkingInterval);
    thinkingInterval = setInterval(() => {
      stageIdx = (stageIdx + 1) % thinkingStages.length;
