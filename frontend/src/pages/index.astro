    color: #c4c7c5;
    cursor: pointer;
    padding: 0.3rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .dark-icon-btn:hover {
    color: #ffffff;
    background: #2d2f31;
  }

  .dark-card-pre {
    margin: 0;
    padding: 1.15rem 1.25rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #ffffff;
    overflow-x: auto;
  }

  /* ── Math & Scientific Diagram Card ── */
  .math-diagram-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    margin: 1.25rem 0;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
  }
  .math-diagram-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1rem;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
  }
  .math-diagram-badge {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: #1e293b;
  }
  .math-diagram-badge svg {
    color: #2563eb;
  }
  .math-diagram-actions {
    display: flex;
    gap: 0.4rem;
  }
  .diagram-action-btn,
  .diagram-download-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: #475569;
    font-size: 0.76rem;
    font-weight: 500;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .diagram-action-btn:hover,
  .diagram-download-btn:hover {
    background: #f1f5f9;
    color: #0f172a;
    border-color: #94a3b8;
  }
  .diagram-replay-btn {
    color: #1d4ed8;
    background: #eff6ff;
    border-color: #bfdbfe;
  }
  .diagram-replay-btn:hover {
    background: #dbeafe;
    color: #1e40af;
    border-color: #93c5fd;
  }

  .math-diagram-canvas {
    padding: 1rem;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #ffffff;
    overflow-x: auto;
  }
  .math-diagram-canvas svg {
    display: block;
    max-width: 100%;
    height: auto;
  }

  /* ── 3Blue1Brown-Style Mathematical Construction Keyframe Animations ── */
  @keyframes cbsePathDraw {
    from {
      stroke-dashoffset: 1200;
      opacity: 0.15;
    }
    to {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  @keyframes cbseElementFade {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes cbsePointPulse {
    0% {
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
    100% {
      opacity: 1;
    }
  }

  /* When canvas has .animated-diagram (active on load and replay) */
  .math-diagram-canvas.animated-diagram svg line,
  .math-diagram-canvas.animated-diagram svg path[stroke] {
    stroke-dasharray: 1200;
    stroke-dashoffset: 1200;
    animation: cbsePathDraw 1.5s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }

  /* Staggered construction delays */
  .math-diagram-canvas.animated-diagram svg line:nth-of-type(1) {
    animation-delay: 0.1s;
  }
  .math-diagram-canvas.animated-diagram svg line:nth-of-type(2),
  .math-diagram-canvas.animated-diagram svg line:nth-of-type(3) {
    animation-delay: 0.45s;
  }
  .math-diagram-canvas.animated-diagram svg line:nth-of-type(n+4),
  .math-diagram-canvas.animated-diagram svg path[stroke] {
    animation-delay: 0.9s;
  }

  /* Circles & point markers */
  .math-diagram-canvas.animated-diagram svg circle:not([r="70"]):not([r="60"]):not([r="80"]):not([r="50"]) {
    animation: cbsePointPulse 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: 1.25s;
    opacity: 0;
  }

  /* Geometry circle perimeter */
  .math-diagram-canvas.animated-diagram svg circle[r="70"],
  .math-diagram-canvas.animated-diagram svg circle[r="60"],
  .math-diagram-canvas.animated-diagram svg circle[r="80"],
  .math-diagram-canvas.animated-diagram svg circle[r="50"] {
    stroke-dasharray: 600;
    stroke-dashoffset: 600;
    animation: cbsePathDraw 1.6s cubic-bezier(0.25, 1, 0.5, 1) forwards;
    animation-delay: 0.2s;
  }

  /* Labels fade in smoothly after geometric lines complete */
  .math-diagram-canvas.animated-diagram svg text {
    opacity: 0;
    animation: cbseElementFade 0.6s ease forwards;
    animation-delay: 1.5s;
  }

  /* Lists */
  .gemini-ul,
  .gemini-ol {
    margin: 0 0 1rem 1.25rem;
    padding: 0;
  }
  .gemini-li {
    margin-bottom: 0.45rem;
  }

  /* Key Terms Pills */
  .gemini-keyterms-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid #eef2f6;
  }
  .keyterms-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: #64748b;
  }
  .keyterm-pill {
    background: #fef3c7;
    color: #92400e;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
  }

  /* Response Actions Bar (Copy, Thumbs) */
  .bot-actions-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.85rem;
  }
  .gemini-action-btn {
    background: transparent;
    border: none;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    color: #5f6368;
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .gemini-action-btn:hover {
    background: #f0f4f9;
    color: #1f1f1f;
  }
  .gemini-action-btn.star-action-btn.starred {
    color: #ea580c;
    background: #fff7ed;
    border: 1px solid #ffedd5;
  }
  .gemini-action-btn.star-action-btn.starred:hover {
    background: #ffedd5;
  }

  /* ── Thinking / Processing Indicator ── */
  .thinking-bubble {
    background: #f8fafd;
    border: 1px solid #d3e3fd;
    border-radius: 18px;
    padding: 0.85rem 1.15rem;
    display: inline-flex;
    flex-direction: column;
    gap: 0.35rem;
    box-shadow: 0 2px 10px rgba(66, 133, 244, 0.08);
    max-width: 480px;
    animation: fadeInThinking 0.25s ease-out;
  }
  @keyframes fadeInThinking {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .thinking-header-row {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .thinking-sparkle-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .thinking-star-icon {
    width: 20px;
    height: 20px;
    animation: thinkingSpin 3s linear infinite;
  }
  @keyframes thinkingSpin {
    0% { transform: rotate(0deg) scale(1); }
    50% { transform: rotate(180deg) scale(1.15); }
    100% { transform: rotate(360deg) scale(1); }
  }
  .thinking-label {
    font-size: 0.94rem;
    font-weight: 600;
    color: #1a73e8;
    letter-spacing: -0.01em;
  }
  .thinking-hint-line {
    font-size: 0.8rem;
    color: #5f6368;
    line-height: 1.4;
    transition: opacity 0.2s ease;
  }
  .gemini-typing-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0 0.15rem;
  }
  .gemini-typing-indicator span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #1a73e8;
    animation: typingPulse 1.4s infinite ease-in-out both;
  }
  .gemini-typing-indicator span:nth-child(1) { animation-delay: -0.32s; }
  .gemini-typing-indicator span:nth-child(2) { animation-delay: -0.16s; }
  @keyframes typingPulse {
    0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
    40% { transform: scale(1); opacity: 1; }
  }

  /* Thinking Spinner on Send Button */
  .thinking-spinner {
    animation: spinnerRotate 0.9s linear infinite;
  }
  @keyframes spinnerRotate {
    100% { transform: rotate(360deg); }
  }

  /* ── The Gemini Floating Capsule Dock ── */
  .capsule-dock-wrap {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.75rem 1.5rem 1.15rem;
    background: linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.92) 25%, #ffffff 100%);
    display: flex;
    justify-content: center;
    z-index: 50;
  }

  .gemini-capsule-form {
    max-width: 820px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  /* Image Attachment Preview Bar */
  .image-preview-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.4rem 0.85rem;
    background: #ffffff;
    border: 1px solid #d3e3fd;
    border-radius: 14px;
    box-shadow: 0 2px 10px rgba(26, 115, 232, 0.08);
    animation: fadeIn 0.2s ease-out;
  }
  .preview-thumb-box {
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid #dde3ea;
  }
  .preview-thumb-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .remove-preview-btn {
    position: absolute;
    top: 2px;
    right: 2px;
    background: rgba(31, 31, 31, 0.75);
    color: #fff;
    border: none;
    border-radius: 50%;
    width: 16px;
    height: 16px;
    font-size: 10px;
    line-height: 16px;
    text-align: center;
    cursor: pointer;
    padding: 0;
  }
  .remove-preview-btn:hover {
    background: #d93025;
  }
  .preview-info-text {
    font-size: 0.8rem;
    color: #1a73e8;
    font-weight: 500;
  }
  .user-pill-image img {
    max-width: 240px;
    max-height: 180px;
    border-radius: 12px;
    object-fit: cover;
    display: block;
    box-shadow: 0 2px 8px rgba(0,0,0,0.12);
  }

  .capsule-container {
    display: flex;
    align-items: center;
    background: #f0f4f9;
    border-radius: 999px;
    padding: 0.45rem 0.75rem 0.45rem 0.65rem;
    box-shadow: 0 2px 12px rgb(0 0 0 / 6%);
    border: 1px solid transparent;
    transition: background 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .capsule-container:focus-within {
    background: #ffffff;
    border-color: #e2e8f0;
    box-shadow: 0 4px 20px rgb(0 0 0 / 10%);
  }

  .capsule-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: #5f6368;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .capsule-btn:hover {
    background: #e2e8f0;
    color: #1f1f1f;
  }
  .plus-icon {
    font-size: 1.3rem;
    font-weight: 400;
  }

  .capsule-textarea {
    flex: 1;
    border: none;
    background: transparent;
    outline: none;
    resize: none;
    font-family: inherit;
    font-size: 0.98rem;
    line-height: 1.45;
    padding: 0.45rem 0.75rem;
    max-height: 150px;
    color: #1f1f1f;
  }

  .capsule-controls-right {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  /* Model/Mode Selector Dropdown Inside Capsule */
  .model-select-wrapper {
    position: relative;
  }
  .model-dropdown-btn {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: #1f1f1f;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    transition: all 0.15s ease;
  }
  .model-dropdown-btn:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
  }
  .chevron-down {
    font-size: 0.75rem;
    color: #5f6368;
  }

  .model-dropdown-menu {
    position: absolute;
    bottom: calc(100% + 8px);
    right: 0;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    box-shadow: 0 10px 28px rgb(0 0 0 / 14%);
    padding: 0.35rem;
    width: 230px;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    z-index: 100;
  }
  .dropdown-item {
    display: flex;
    flex-direction: column;
    text-align: left;
    padding: 0.5rem 0.65rem;
    border-radius: 8px;
    border: none;
    background: transparent;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .dropdown-item:hover {
    background: #f1f5f9;
  }
  .dropdown-item.active {
    background: #e9eef6;
  }
  .dropdown-item strong {
    font-size: 0.82rem;
    color: #0f172a;
  }
  .dropdown-item small {
    font-size: 0.72rem;
    color: #64748b;
  }

  /* Mic Button recording indicator */
  .mic-btn.recording {
    background: #fee2e2;
    color: #ef4444;
    animation: micPulse 1s infinite alternate;
  }
  @keyframes micPulse {
    from { transform: scale(1); }
    to { transform: scale(1.1); }
  }

  .send-btn {
    background: #1f1f1f;
    color: #ffffff;
  }
  .send-btn:hover {
    background: #000000;
    color: #ffffff;
  }

  .capsule-disclaimer {
    text-align: center;
    font-size: 0.72rem;
    color: #70757a;
    padding-top: 0.15rem;
  }

  /* ── 1-on-1 Mentor Dialog & In-Page Modals ── */
  .mentor-dialog {
    border: none;
    border-radius: 18px;
    padding: 0;
    max-width: 480px;
    width: 90%;
    box-shadow: 0 20px 40px rgb(0 0 0 / 25%);
    background: #ffffff;
    color: #1f1f1f;
  }
  .mentor-dialog::backdrop {
    background: rgba(15, 23, 42, 0.45);
    backdrop-filter: blur(2px);
  }
  .mentor-dialog-content {
    padding: 1.75rem;
    margin: 0;
    background: #ffffff;
    color: #1f1f1f;
  }
  .mentor-dialog-content.card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    color: #1f1f1f;
  }
  .dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }
  .dialog-header h3 {
    margin: 0;
    color: #1f1f1f;
    font-size: 1.25rem;
    font-weight: 600;
  }
  .close-dialog-btn {
    background: transparent;
    border: none;
    font-size: 1.2rem;
    cursor: pointer;
    color: #5f6368;
    padding: 0.25rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .close-dialog-btn:hover {
    background: #f1f5f9;
    color: #1f1f1f;
  }
  .dialog-desc {
    font-size: 0.94rem;
    color: #334155;
    line-height: 1.5;
    margin-bottom: 1rem;
  }
  .dialog-perks {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.88rem;
    color: #1f1f1f;
    font-weight: 500;
  }
  .dialog-actions {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .dialog-actions .button,
  .mentor-dialog-content .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.55rem 1.25rem;
    border-radius: 999px;
    background: #1a73e8;
    color: #ffffff !important;
    font-weight: 600;
    font-size: 0.9rem;
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .dialog-actions .button:hover,
  .mentor-dialog-content .button:hover {
    background: #0b57d0;
    color: #ffffff !important;
  }
  .dialog-actions .button.secondary,
  .mentor-dialog-content .button.secondary {
    background: #f0f4f9;
    color: #1f1f1f !important;
    border: 1px solid #dde3ea;
  }
  .dialog-actions .button.secondary:hover,
  .mentor-dialog-content .button.secondary:hover {
    background: #e2e8f0;
    color: #1f1f1f !important;
  }

  /* ── Responsive Styling: Mobile Drawer Rules (max-width: 900px) ── */
  @media (max-width: 900px) {
    .gemini-sidebar,
    .gemini-sidebar.collapsed {
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      bottom: 0 !important;
      width: 285px !important;
      max-width: 85vw !important;
      height: 100vh !important;
      height: 100dvh !important;
      z-index: 9999 !important;
      background: #ffffff !important;
      box-shadow: 4px 0 28px rgba(0, 0, 0, 0.25) !important;
      transform: translateX(-100%) !important;
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1) !important;
      padding: 0.85rem 0.75rem !important;
    }
    .gemini-sidebar.mobile-open,
    .gemini-sidebar.collapsed.mobile-open {
      transform: translateX(0) !important;
    }
    .gemini-sidebar #sidebar-collapse-btn,
    .gemini-sidebar.collapsed #sidebar-collapse-btn {
      display: none !important;
    }
    .gemini-sidebar .mobile-only-close,
    .gemini-sidebar.collapsed .mobile-only-close {
      display: flex !important;
    }
    .gemini-sidebar.collapsed .brand-link {
      display: flex !important;
    }
    .gemini-sidebar.collapsed .brand-text,
    .gemini-sidebar.collapsed .brand-tag,
    .gemini-sidebar.collapsed .nav-item-label,
    .gemini-sidebar.collapsed .section-title,
    .gemini-sidebar.collapsed .item-label,
    .gemini-sidebar.collapsed :global(.recent-text),
    .gemini-sidebar.collapsed :global(.pin-icon),
    .gemini-sidebar.collapsed .profile-info {
      display: inline !important;
    }
  }

