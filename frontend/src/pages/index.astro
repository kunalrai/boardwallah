  function filterLibraryChapters() {
    if (!libraryGrid) return;
    const q = (libSearchInput ? libSearchInput.value : '').toLowerCase().trim();
    const cards = libraryGrid.querySelectorAll('.chapter-card');
    let visibleCount = 0;

    cards.forEach(c => {
      const subj = (c.getAttribute('data-subject') || '').toLowerCase();
      const matchesSubject = (activeLibrarySubject === 'all' || subj === activeLibrarySubject.toLowerCase());
      const text = c.textContent.toLowerCase();
      const matchesSearch = !q || text.includes(q);

      if (matchesSubject && matchesSearch) {
        c.style.display = 'flex';
        visibleCount++;
      } else {
        c.style.display = 'none';
      }
    });

    let emptyNotice = libraryGrid.querySelector('.lib-empty-notice');
    if (visibleCount === 0) {
      if (!emptyNotice) {
        emptyNotice = document.createElement('div');
        emptyNotice.className = 'lib-empty-notice';
        emptyNotice.style.cssText = 'grid-column: 1 / -1; text-align: center; padding: 2rem 1rem; color: #64748b; font-size: 0.88rem;';
        emptyNotice.innerHTML = '<p>No chapters match this subject filter or search keyword.</p>';
        libraryGrid.appendChild(emptyNotice);
      }
      emptyNotice.style.display = 'block';
    } else if (emptyNotice) {
      emptyNotice.style.display = 'none';
    }
  }

