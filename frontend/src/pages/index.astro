  function printRevisionVault() {
    const starred = JSON.parse(localStorage.getItem('boardwallah_starred_doubts') || '[]');
    const user = getStoredUser();

    const itemsToPrint = starred.length > 0 ? starred : [
      {
        question: "Theorem 1.3 & √5 Irrationality Proof (Real Numbers)",
        answer: "Assume √5 is rational = a/b (co-prime integers, b ≠ 0). 5b² = a² ⇒ 5 divides a². By Theorem 1.3, 5 divides a. Let a = 5c ⇒ 5b² = 25c² ⇒ b² = 5c² ⇒ 5 divides b. Hence 5 divides both a and b, contradicting the co-prime assumption. Therefore √5 is irrational.",
        keyTerms: ["Contradiction Method", "Co-prime Integers", "Theorem 1.3 Divisibility"]
      },
      {
        question: "Basic Proportionality Theorem (Thales Theorem - Ch 6 Triangles)",
        answer: "Statement: If a line is drawn parallel to one side of a triangle intersecting other two sides, it divides the two sides in the same ratio: AD/DB = AE/EC. Proof uses ratio of area of triangles with common altitude.",
        keyTerms: ["Area of Triangles", "Parallel Construction", "AD/DB = AE/EC"]
      },
      {
        question: "Ohm's Law & Circuit Formulas (Electricity - Ch 12)",
        answer: "V = I × R. Series: Rs = R1 + R2 + R3 (Current is constant, voltages add). Parallel: 1/Rp = 1/R1 + 1/R2 (Voltage is constant, currents add). Joule's Heating: H = I²Rt. Power: P = VI = I²R = V²/R.",
        keyTerms: ["V = IR", "Series Rs = ΣR", "Parallel 1/Rp = Σ1/R", "Joule Heating H = I²Rt"]
      },
      {
        question: "Light Optics Sign Conventions & Formulas (Ch 10)",
        answer: "Mirror Formula: 1/f = 1/v + 1/u. Magnification m = -v/u = h'/h. Lens Formula: 1/f = 1/v - 1/u. Magnification m = v/u = h'/h. Power P = 1/f (in meters, Dioptres D). Object distance u is ALWAYS negative.",
        keyTerms: ["Mirror 1/f = 1/v + 1/u", "Lens 1/f = 1/v - 1/u", "Power P = 1/f (D)", "u is always negative"]
      }
    ];

    const printWin = window.open('', '_blank', 'width=800,height=900');
    if (!printWin) {
      showToast('Please allow popups to open the Printable Revision Vault');
      return;
    }

    let cardsHtml = '';
    for (let i = 0; i < itemsToPrint.length; i++) {
      const it = itemsToPrint[i];
      let tagsHtml = '';
      if (it.keyTerms && it.keyTerms.length) {
        tagsHtml = '<div class="keyterms"><span style="font-size:11px;color:#666;font-weight:600;">Key Terms: </span>' +
          it.keyTerms.map(t => '<span class="tag">' + escapeHtml(t) + '</span>').join('') +
          '</div>';
      }
      cardsHtml += '<div class="card">' +
        '<h3>#' + (i + 1) + '. ' + escapeHtml(it.question || 'CBSE Board Problem') + '</h3>' +
        '<p>' + escapeHtml(it.answer || '') + '</p>' +
        tagsHtml +
        '</div>';
    }

    const studentName = user ? escapeHtml(user.name) : 'Board Aspirant';
    const dateStr = new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });

    const htmlContent = '<!DOCTYPE html><html><head><meta charset="utf-8">' +
      '<title>CBSE Class 10 Board Revision Vault — Boardwallah</title>' +
      '<style>' +
      'body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; line-height: 1.5; color: #111; padding: 24px; max-width: 800px; margin: 0 auto; }' +
      '.header { border-bottom: 2px solid #1a73e8; padding-bottom: 12px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: flex-end; }' +
      '.logo { font-size: 20px; font-weight: 800; color: #1a73e8; letter-spacing: -0.02em; }' +
      '.meta { font-size: 12px; color: #555; text-align: right; }' +
      '.badge { display: inline-block; background: #e8f0fe; color: #1a73e8; padding: 2px 8px; border-radius: 4px; font-weight: 600; font-size: 11px; margin-top: 4px; }' +
      '.card { border: 1px solid #dde3ea; border-radius: 8px; padding: 14px; margin-bottom: 14px; page-break-inside: avoid; background: #fafbfc; }' +
      '.card h3 { margin: 0 0 6px; font-size: 15px; color: #0d47a1; }' +
      '.card p { margin: 0 0 8px; font-size: 13px; white-space: pre-line; }' +
      '.keyterms { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 6px; }' +
      '.tag { background: #fff3e0; color: #e65100; font-size: 11px; padding: 2px 6px; border-radius: 4px; font-weight: 600; }' +
      '.footer { margin-top: 30px; border-top: 1px solid #ddd; padding-top: 10px; font-size: 11px; color: #777; text-align: center; }' +
      '@media print { body { padding: 0; } .no-print { display: none !important; } .card { border: 1px solid #ccc; background: #fff; } }' +
      '</style></head><body>' +
      '<div class="header">' +
      '<div><div class="logo">BOARDWALLAH ★ REVISION VAULT</div><div style="font-size: 13px; color: #444; margin-top: 2px;">CBSE Class 10 High-Yield Derivations, Proofs &amp; Formulas</div></div>' +
      '<div class="meta"><div><strong>Student:</strong> ' + studentName + '</div><div><strong>Generated:</strong> ' + dateStr + '</div><div class="badge">Target: 95%+ Board Exam</div></div>' +
      '</div>' +
      '<div class="no-print" style="margin-bottom: 16px; display: flex; gap: 8px;">' +
      '<button onclick="window.print()" style="padding: 9px 18px; background: #1a73e8; color: #fff; border: none; border-radius: 6px; font-weight: 600; cursor: pointer;">🖨️ Print / Save as PDF</button>' +
      '<button onclick="window.close()" style="padding: 9px 18px; background: #f1f3f4; color: #333; border: 1px solid #ccc; border-radius: 6px; cursor: pointer;">Close</button>' +
      '</div>' +
      cardsHtml +
      '<div class="footer">Official CBSE Class 10 Board Exam Timetable 2026: Maths (17 Feb), Science (25 Feb), SST (07 Mar) | www.boardwallah.space</div>' +
      '</body></html>';

    printWin.document.open();
    printWin.document.write(htmlContent);
    printWin.document.close();
    showToast('Revision Vault print sheet ready! Click Print / Save as PDF.');
  }

  // ── Global Single-Page Link & Navigation Interceptor ──
  // Ensures clicking ANY link anywhere NEVER leaves the root single page layout
  document.addEventListener('click', (e) => {
    const anchor = e.target.closest('a');
    if (anchor) {
      e.preventDefault();
      e.stopPropagation();
      const href = (anchor.getAttribute('href') || '').toLowerCase();
      if (href.includes('cal.com') || href.includes('booking') || href.includes('mentor')) {
        if (mentorModal) mentorModal.showModal();
      } else if (href.includes('flashcard') || href.includes('diagram') || href.includes('image')) {
        if (imagesModal) imagesModal.showModal();
      } else if (href.includes('mock') || href.includes('practice') || href.includes('arena')) {
        if (practiceModal) practiceModal.showModal();
      } else if (href.includes('resource') || href.includes('chapter') || href.includes('library')) {
        if (libraryModal) libraryModal.showModal();
      } else if (href.includes('login') || href.includes('account') || href.includes('auth')) {
        const currentUser = getStoredUser();
        if (currentUser) openAccountModal(currentUser);
        else openSignInModal();
      } else {
        startNewChat();
      }
    }
  }, true);

  // ── PWA Installation Logic ──
  let deferredPwaPrompt = null;
  const pwaHeaderBtn = document.getElementById('pwa-install-header-btn');
  const pwaSidebarBtn = document.getElementById('pwa-install-sidebar-btn');

  function updatePwaInstallVisibility(show) {
    const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
    if (isStandalone) {
      if (pwaHeaderBtn) pwaHeaderBtn.style.display = 'none';
      if (pwaSidebarBtn) pwaSidebarBtn.style.display = 'none';
      return;
    }
    if (pwaHeaderBtn) pwaHeaderBtn.style.display = show ? 'inline-flex' : 'none';
    if (pwaSidebarBtn) pwaSidebarBtn.style.display = show ? 'flex' : 'none';
  }

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPwaPrompt = e;
    updatePwaInstallVisibility(true);
  });

  async function triggerPwaInstall() {
    if (!deferredPwaPrompt) {
      alert('To install Boardwallah on your device:\n\n• On Chrome / Android: tap ⋮ > "Install app" or "Add to Home screen"\n• On Safari / iOS: tap Share ⎋ > "Add to Home Screen"');
      return;
    }
    try {
      deferredPwaPrompt.prompt();
      const choiceResult = await deferredPwaPrompt.userChoice;
      if (choiceResult && choiceResult.outcome === 'accepted') {
        console.log('[PWA] User accepted the install prompt');
      } else {
        console.log('[PWA] User dismissed the install prompt');
      }
      deferredPwaPrompt = null;
      updatePwaInstallVisibility(false);
    } catch (err) {
      console.warn('[PWA] Prompt error:', err);
    }
  }

  if (pwaHeaderBtn) {
    pwaHeaderBtn.addEventListener('click', triggerPwaInstall);
  }
  if (pwaSidebarBtn) {
    pwaSidebarBtn.addEventListener('click', triggerPwaInstall);
  }

  window.addEventListener('appinstalled', () => {
    console.log('[PWA] App successfully installed');
    deferredPwaPrompt = null;
    updatePwaInstallVisibility(false);
  });

  // Initialize Firebase Client sync on startup
  initFirebaseClient();
})();
</script>

