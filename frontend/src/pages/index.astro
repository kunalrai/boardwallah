---
import { getImage, Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { loadContent, teachingModeLabel, whatsappLink } from "../lib/content";
import { calBookingUrl, siteOrigin } from "../lib/site";
import adImage from "../assets/ad.png";

const { provider, subjects } = loadContent();
const posterAlt =
  "BoardWallah CBSE Class 10 maths banner: complete maths preparation for board exams, covering NCERT, RD Sharma, previous year questions and revision, with chapter-wise concepts, important questions and practice tests.";
const socialImage = await getImage({ src: adImage, width: 1200, format: "webp" });

const waHeroLink = whatsappLink(
  provider.contact.whatsapp,
  `Hello ${provider.tutor_name}, I am looking for CBSE Class 10 tuition (online/home visit). Could you please share more details?`
);

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "EducationalOrganization",
      "@id": `${siteOrigin}/#organization`,
      "name": provider.name,
      "url": siteOrigin,
      "logo": `${siteOrigin}/favicon.svg`,
      "description": `Comprehensive 1-on-1 CBSE Class 10 tutoring and board exam preparation in Gaur City 2, VVIP Homes, Noida Extension and online by ${provider.tutor_name} (20 yrs exp, B.Tech, ex-Samsung/HCL).`,
      "founder": {
        "@type": "Person",
        "name": provider.tutor_name,
        "jobTitle": "Lead Educator & Founder",
        "knowsAbout": ["CBSE Class 10 Mathematics", "Science", "Social Science", "English", "Hindi"]
      },
      "areaServed": provider.service_localities.map((locality) => ({
        "@type": "Place",
        "name": locality
      })),
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "Student Support",
        "email": provider.contact.email,
        "telephone": provider.contact.whatsapp,
        "availableLanguage": provider.languages
      }
    },
    {
      "@type": "Person",
      "@id": `${siteOrigin}/#tutor`,
      "name": provider.tutor_name,
      "jobTitle": "CBSE Class 10 Educator & Tutor",
      "description": `${provider.experience_years} years of teaching experience specializing in CBSE Class 10 board exam preparation, concept clarification, and scoring 95%+ in boards.`,
      "hasCredential": provider.qualifications.map((q) => ({
        "@type": "EducationalOccupationalCredential",
        "credentialCategory": "degree",
        "name": q
      })),
      "knowsAbout": subjects.map((s) => s.name)
    },
    {
      "@type": "Course",
      "@id": `${siteOrigin}/#course-cbse-10`,
      "name": "CBSE Class 10 Complete Board Exam Preparation",
      "description": "Comprehensive one-on-one and small group CBSE Class 10 tutoring covering Mathematics, Science, Social Science, English, and Hindi with NCERT solutions, chapter guides, 1,120+ MCQs, 80-mark sample papers, and active-recall flashcards.",
      "provider": {
        "@id": `${siteOrigin}/#organization`
      },
      "educationalLevel": "Secondary Education (CBSE Class 10)",
      "offers": [
        {
          "@type": "Offer",
          "name": `Free ${provider.trial.duration_minutes}-Minute Trial Session`,
          "price": "0",
          "priceCurrency": "INR",
          "category": "TrialSession",
          "url": calBookingUrl,
          "availability": "https://schema.org/InStock"
        }
      ]
    }
  ]
};
---

<Layout 
  title="BoardWallah | CBSE Class 10 Tutor in Gaur City, Noida & Online – Kunal Rai" 
  description="Expert 1-on-1 CBSE Class 10 Maths & Science tuition in Gaur City 2, Noida Extension & online by Kunal Rai (20 yrs exp, B.Tech, ex-Samsung/HCL). Book a free 60-min trial."
  image={socialImage.src}
  imageAlt={posterAlt}
  schema={homeSchema}
>
  <!-- Full-page Ambient Mathematical Pattern Background Layer -->
  <div class="math-ambient-bg" aria-hidden="true"></div>

  <div class="wrap">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-text">
        <a href="/resources/" class="hero-announcement-pill" aria-label="Explore CBSE Class 10 Board 2026 Study Toolkit">
          <span class="pill-badge">CBSE 2026 Toolkit</span>
          <span class="pill-text">80-Mark Sample Papers · 80 Flashcards · Unlimited Practice Arena · 56 Chapter Guides &rarr;</span>
        </a>

        <h1>CBSE Class 10 Tutor in Gaur City &amp; Noida – Kunal Rai</h1>
        <p class="lead">Personalized 1-on-1 Maths &amp; Science tuition at your home in Gaur City 2, VVIP Homes &amp; Noida Extension, or live online. Build conceptual clarity from first principles and target 95%+ in boards.</p>
        <div class="actions">
          <a class="button" href={calBookingUrl} target="_blank" rel="noopener noreferrer">Book Free Trial</a>
          <a class="button whatsapp-btn" href={waHeroLink} target="_blank" rel="noopener noreferrer">
            <span class="wa-icon" aria-hidden="true">💬</span> Chat on WhatsApp
          </a>
          <a href="/resources/" class="button resource-cta-btn">📚 Free Study Resources</a>
        </div>
        <div class="hero-trust-chips">
          <span class="trust-chip">📍 Gaur City 2 &amp; VVIP Homes (In-Person)</span>
          <span class="trust-chip">💻 Live 1-on-1 Online (Pan-India)</span>
          <span class="trust-chip">⭐ 20 Yrs Exp · ex-Samsung/HCL</span>
          <span class="trust-chip">🏆 95%+ Board Exam Track Record</span>
        </div>
      </div>
      <figure class="hero-media">
        <Image
          src={adImage}
          alt={posterAlt}
          widths={[640, 960, 1280]}
          sizes="(max-width: 820px) 92vw, 1080px"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </section>

    <!-- CBSE 2026 Board Exam Dates Section -->
    <section class="exam-dates-section" id="exam-dates">
      <div class="section-head">
        <span class="eyebrow dates-eyebrow">Official CBSE 2026 Date Sheet</span>
        <h2>Class 10 Board Exam Timetable (2026)</h2>
        <p class="subtitle">
          Official morning shift: <strong>10:30 AM – 1:30 PM IST</strong> (15-min reading from 10:15 AM). Prepare with subject-specific resources below.
        </p>
      </div>

      <div class="exam-dates-grid">
        <!-- 17 Feb 2026: Maths -->
        <article class="date-card date-card-maths">
          <div class="date-badge-col">
            <span class="exam-month">FEB</span>
            <span class="exam-day">17</span>
            <span class="exam-weekday">Tuesday</span>
          </div>
          <div class="date-info-col">
            <div class="date-tag-row">
              <span class="subject-tag tag-maths">Code 041 / 241</span>
              <span class="exam-time">10:30 AM – 1:30 PM</span>
            </div>
            <h3>Mathematics (Standard &amp; Basic)</h3>
            <p class="date-desc">Real Numbers, Polynomials, Triangles, Trigonometry, Statistics &amp; Probability.</p>
            <div class="date-action-row">
              <a href="/resources/sample-papers/" class="date-link">80-Mark Mock Paper &rarr;</a>
              <a href="/resources/triangles/" class="date-link-sub">BPT Proof</a>
            </div>
          </div>
        </article>

        <!-- 21 Feb 2026: English -->
        <article class="date-card date-card-english">
          <div class="date-badge-col">
            <span class="exam-month">FEB</span>
            <span class="exam-day">21</span>
            <span class="exam-weekday">Saturday</span>
          </div>
          <div class="date-info-col">
            <div class="date-tag-row">
              <span class="subject-tag tag-english">Code 184 / 101</span>
              <span class="exam-time">10:30 AM – 1:30 PM</span>
            </div>
            <h3>English (Language &amp; Literature)</h3>
            <p class="date-desc">Reading Comprehension, Analytical Paragraph, Formal Letter, First Flight &amp; Footprints.</p>
            <div class="date-action-row">
              <a href="/resources/english-first-flight-prose/" class="date-link">First Flight Guide &rarr;</a>
              <a href="/resources/english-grammar-and-writing/" class="date-link-sub">Writing Skills</a>
            </div>
          </div>
        </article>

        <!-- 25 Feb 2026: Science -->
        <article class="date-card date-card-science">
          <div class="date-badge-col">
            <span class="exam-month">FEB</span>
            <span class="exam-day">25</span>
            <span class="exam-weekday">Wednesday</span>
          </div>
          <div class="date-info-col">
            <div class="date-tag-row">
              <span class="subject-tag tag-science">Code 086</span>
              <span class="exam-time">10:30 AM – 1:30 PM</span>
            </div>
            <h3>Science (Physics, Chem, Biology)</h3>
            <p class="date-desc">Chemical Reactions, Acids/Bases, Life Processes, Heredity, Light &amp; Electricity.</p>
            <div class="date-action-row">
              <a href="/resources/light-reflection-refraction/" class="date-link">Ray Diagrams &rarr;</a>
              <a href="/resources/life-processes/" class="date-link-sub">Life Processes</a>
            </div>
          </div>
        </article>

        <!-- 27 Feb 2026: Information Technology -->
        <article class="date-card date-card-it">
          <div class="date-badge-col">
            <span class="exam-month">FEB</span>
            <span class="exam-day">27</span>
            <span class="exam-weekday">Friday</span>
          </div>
          <div class="date-info-col">
            <div class="date-tag-row">
              <span class="subject-tag tag-it">Code 402 / 417</span>
              <span class="exam-time">10:30 AM – 12:30 PM</span>
            </div>
            <h3>Information Tech &amp; AI</h3>
            <p class="date-desc">Employability Skills, Digital Documentation, Electronic Spreadsheet &amp; DBMS.</p>
            <div class="date-action-row">
              <a href="/resources/flashcards/" class="date-link">Revision Flashcards &rarr;</a>
            </div>
          </div>
        </article>

        <!-- 02 Mar 2026: Hindi -->
        <article class="date-card date-card-hindi">
          <div class="date-badge-col">
            <span class="exam-month">MAR</span>
            <span class="exam-day">02</span>
            <span class="exam-weekday">Monday</span>
          </div>
          <div class="date-info-col">
            <div class="date-tag-row">
              <span class="subject-tag tag-hindi">Code 002 / 085</span>
              <span class="exam-time">10:30 AM – 1:30 PM</span>
            </div>
            <h3>Hindi (Course A &amp; Course B)</h3>
            <p class="date-desc">Kshitij, Kritika, Sparsh, Sanchayan, Vyakaran (Vakya, Vachya, Pad Parichay) &amp; Lekhan.</p>
            <div class="date-action-row">
              <a href="/resources/hindi-kshitij-gadhya-khand/" class="date-link">Kshitij Revision &rarr;</a>
              <a href="/resources/hindi-vyavaharik-vyakaran/" class="date-link-sub">Vyakaran Rules</a>
            </div>
          </div>
        </article>

        <!-- 07 Mar 2026: Social Science -->
        <article class="date-card date-card-sst">
          <div class="date-badge-col">
            <span class="exam-month">MAR</span>
            <span class="exam-day">07</span>
            <span class="exam-weekday">Saturday</span>
          </div>
          <div class="date-info-col">
            <div class="date-tag-row">
              <span class="subject-tag tag-sst">Code 087</span>
              <span class="exam-time">10:30 AM – 1:30 PM</span>
            </div>
            <h3>Social Science (Hist, Civics, Geo, Eco)</h3>
            <p class="date-desc">Nationalism in Europe &amp; India, Federalism, Resources, Agriculture, Money &amp; Credit.</p>
            <div class="date-action-row">
              <a href="/resources/the-rise-of-nationalism-in-europe/" class="date-link">Nationalism Guide &rarr;</a>
              <a href="/resources/sample-papers/" class="date-link-sub">80-Mark Mock</a>
            </div>
          </div>
        </article>
      </div>

      <!-- Date Sheet Advisory Callout -->
      <div class="exam-rules-banner">
        <div class="rule-item">
          <span class="rule-icon">⏰</span>
          <div>
            <strong>10:15 AM Entry &amp; Reading Time</strong>
            <p>15 minutes strictly reserved to read the question paper and plan section order.</p>
          </div>
        </div>
        <div class="rule-item">
          <span class="rule-icon">📋</span>
          <div>
            <strong>80 Theory + 20 Internal Assessment</strong>
            <p>Pass criteria: Minimum 33% combined marks in theory + practical/internal.</p>
          </div>
        </div>
        <div class="rule-item">
          <span class="rule-icon">🎯</span>
          <div>
            <strong>Step-by-Step Marking</strong>
            <p>Full marks awarded for correct formula, intermediate steps, and boxed final answers.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CBSE 2026 Board Prep Toolkit Section -->
    <section class="toolkit-showcase-section">
      <div class="section-head">
        <span class="eyebrow">Target 95%+ in CBSE 2026 Boards</span>
        <h2>High-Yield Board Exam Study Toolkit</h2>
        <p class="subtitle">Equip yourself with the three essential tools every Class 10 topper uses to prepare, test, and master the board syllabus.</p>
      </div>

      <div class="toolkit-cards-grid">
        <!-- Card 1: Sample Papers -->
        <article class="toolkit-card toolkit-card-papers">
          <div class="toolkit-badge-row">
            <span class="toolkit-icon">📝</span>
            <span class="toolkit-badge badge-papers">Full 80 Marks</span>
          </div>
          <h3>CBSE 2026 Blueprint Mock Papers</h3>
          <p class="muted">
            Simulate authentic exam hall conditions for Maths, Science, Social Science &amp; English with a built-in 3-hour timer, question-wise marks, and marking schemes.
          </p>
          <ul class="toolkit-highlights">
            <li>⏱️ 3-Hour Practice Countdown Timer</li>
            <li>📋 Official Section Breakdown (A to E)</li>
            <li>🔍 Step-by-Step Marking Rubrics</li>
          </ul>
          <a href="/resources/sample-papers/" class="button small toolkit-action-btn">Simulate 80-Mark Exam &rarr;</a>
        </article>

        <!-- Card 2: Interactive Flashcards -->
        <article class="toolkit-card toolkit-card-flashcards">
          <div class="toolkit-badge-row">
            <span class="toolkit-icon">⚡</span>
            <span class="toolkit-badge badge-flashcards">Active Recall Engine</span>
          </div>
          <h3>80 Interactive Revision Flashcards</h3>
          <p class="muted">
            Test key formulas, chemical reaction colours, ray diagram conventions, historical dates, and Hindi/English grammar with 3D flip cards and self-testing.
          </p>
          <ul class="toolkit-highlights">
            <li>🔄 3D Flip Cards with Keyboard Navigation</li>
            <li>⭐ Key CBSE Marking Scheme Keywords</li>
            <li>🎯 Targeted Weak Cards Practice Filter</li>
          </ul>
          <a href="/resources/flashcards/" class="button small toolkit-action-btn">Practice 80 Flashcards &rarr;</a>
        </article>

        <!-- Card 3: Quiz Mastery Tracker -->
        <article class="toolkit-card toolkit-card-tracker">
          <div class="toolkit-badge-row">
            <span class="toolkit-icon">📊</span>
            <span class="toolkit-badge badge-tracker">Progress Tracker</span>
          </div>
          <h3>Syllabus Mastery &amp; Quiz Tracker</h3>
          <p class="muted">
            Take 20-question chapter quizzes across all 56 Class 10 chapters. Automatically saves high scores in your browser, monitors syllabus completion, and highlights weak topics.
          </p>
          <ul class="toolkit-highlights">
            <li>📈 Live Syllabus Completion Percentage</li>
            <li>🏆 Previous Best Score Tracking</li>
            <li>✅ Completed vs Needs Practice Filters</li>
          </ul>
          <a href="/resources/" class="button small toolkit-action-btn">Track 56 Chapters &rarr;</a>
        </article>

        <!-- Card 4: Endless Practice Arena -->
        <article class="toolkit-card toolkit-card-arena">
          <div class="toolkit-badge-row">
            <span class="toolkit-icon">🎯</span>
            <span class="toolkit-badge badge-arena">Infinite Generator</span>
          </div>
          <h3>Unlimited Practice Arena</h3>
          <p class="muted">
            Algorithmically generate unlimited fresh numericals and conceptual questions for Maths &amp; Science with randomized parameters and step-by-step marking rubrics.
          </p>
          <ul class="toolkit-highlights">
            <li>🔢 Infinite Parametric Problem Variations</li>
            <li>🔥 Live Answer Streaks &amp; Accuracy Stats</li>
            <li>📝 Step-by-Step Marking Rubrics &amp; Solutions</li>
          </ul>
          <a href="/resources/practice-arena/" class="button small toolkit-action-btn">Enter Practice Arena &rarr;</a>
        </article>
      </div>
    </section>

    <!-- Free CBSE Class 10 Resources Showcase Section -->
    <section class="home-resources-section">
      <div class="section-head">
        <span class="eyebrow">Free CBSE Class 10 Academic Hub</span>
        <h2>Explore Chapter Guides, Visual Diagrams &amp; Board Quizzes</h2>
        <p class="subtitle">Comprehensive revision notes, interactive SVG diagrams, formula sheets, and 20-question practice quizzes covering 100% of the syllabus.</p>
      </div>

      <div class="resource-hub-grid">
        <article class="hub-card hub-maths">
          <div class="hub-header">
            <span class="hub-icon">📐</span>
            <span class="hub-tag">14 Chapters · 100% Complete</span>
          </div>
          <h3>Mathematics</h3>
          <p>Real Numbers to Probability, step-by-step proofs, circle theorems, trigonometry ratios &amp; 20-question quizzes.</p>
          <ul class="hub-features">
            <li>✓ All NCERT &amp; RD Sharma core theorems</li>
            <li>✓ Interactive circle &amp; triangle proofs</li>
            <li>✓ 280+ board practice MCQs</li>
          </ul>
          <a href="/resources/#maths" class="hub-link">Explore Maths Guides &rarr;</a>
        </article>

        <article class="hub-card hub-science">
          <div class="hub-header">
            <span class="hub-icon">🔬</span>
            <span class="hub-tag">13 Chapters · Complete Science (Phy, Chem, Bio)</span>
          </div>
          <h3>Science</h3>
          <p>Life processes, nervous system, reproduction, genetics, optics ray diagrams, electric circuits, chemical reactions &amp; carbon compounds.</p>
          <ul class="hub-features">
            <li>✓ Custom SVG optical ray diagrams &amp; biological systems</li>
            <li>✓ Chemical reactions, equations &amp; carbon allotropes</li>
            <li>✓ 260+ interactive science board MCQs</li>
          </ul>
          <a href="/resources/#science" class="hub-link">Explore Science Guides &rarr;</a>
        </article>

        <article class="hub-card hub-sst">
          <div class="hub-header">
            <span class="hub-icon">🌍</span>
            <span class="hub-tag">20 Chapters · All 4 Disciplines</span>
          </div>
          <h3>Social Science</h3>
          <p>History revolutions &amp; nationalism, Civics power-sharing, Geography resources &amp; Economics development.</p>
          <ul class="hub-features">
            <li>✓ History timelines &amp; visual maps</li>
            <li>✓ Civics federalism &amp; democracy flowcharts</li>
            <li>✓ 400+ board exam practice questions</li>
          </ul>
          <a href="/resources/#social-science" class="hub-link">Explore Social Science &rarr;</a>
        </article>

        <article class="hub-card hub-hindi">
          <div class="hub-header">
            <span class="hub-icon">✍️</span>
            <span class="hub-tag">Course 'A' · सम्पूर्ण पाठ्यक्रम</span>
          </div>
          <h3>Hindi Course 'A'</h3>
          <p>क्षितिज भाग-2 (सभी 8 गद्य व 11 पद्य), कृतिका भाग-2 (सभी 5 पाठ), व्यावहारिक व्याकरण एवं रचनात्मक लेखन।</p>
          <ul class="hub-features">
            <li>✓ सभी गद्य पाठ व काव्य भावार्थ</li>
            <li>✓ व्याकरण स्तम्भ (16 अंक) व लेखन प्रारूप (20 अंक)</li>
            <li>✓ 100+ सीबीएसई बोर्ड अभ्यास प्रश्न</li>
          </ul>
          <a href="/resources/#hindi" class="hub-link">Explore Hindi Guides &rarr;</a>
        </article>

        <article class="hub-card hub-english">
          <div class="hub-header">
            <span class="hub-icon">📖</span>
            <span class="hub-tag">Code 184 · Complete Syllabus</span>
          </div>
          <h3>English Language &amp; Literature</h3>
          <p>First Flight (Prose &amp; Poetry), Footprints Without Feet, Grammar (Tenses, Modals, Concord) &amp; Writing (Letters &amp; Paragraphs).</p>
          <ul class="hub-features">
            <li>✓ All 9 prose chapters &amp; 10 poems</li>
            <li>✓ All 9 supplementary reader chapters</li>
            <li>✓ 80+ board practice MCQs &amp; RTC extracts</li>
          </ul>
          <a href="/resources/#english" class="hub-link">Explore English Guides &rarr;</a>
        </article>
      </div>

      <div class="hub-footer-cta">
        <div class="hub-banner">
          <div class="hub-banner-text">
            <strong>Need instant chapter revision or self-assessment?</strong>
            <p>Browse our complete library of 56+ chapter notes, formula sheets, and 1,120+ questions with step-by-step solutions.</p>
          </div>
          <a href="/resources/" class="button">Open Complete Resources Hub &rarr;</a>
        </div>
      </div>
    </section>

    <!-- About the Tutor Profile -->
    <section class="card provider-profile">
      <div class="profile-text">
        <h2>About the Tutor</h2>
        <p>With {provider.experience_years} years of experience, I focus on simplifying complex concepts and building student confidence for the CBSE board exams.</p>
        <ul class="qualifications">
          {provider.qualifications.map(q => <li>{q}</li>)}
        </ul>
      </div>
      <div class="profile-details">
        <div class="detail-item">
          <span class="label">Teaching Mode:</span>
          <span class="value">{provider.teaching_mode.map(teachingModeLabel).join(" or ")}</span>
        </div>
        <div class="detail-item">
          <span class="label">Languages:</span>
          <span class="value">{provider.languages.join(", ")}</span>
        </div>
        <div class="detail-item">
          <span class="label">Service Localities:</span>
          <span class="value">{provider.service_localities.join(", ")}</span>
        </div>
      </div>
    </section>

    <!-- Why Learn with BoardWallah (4 Pillars of Academic Success) -->
    <section class="why-boardwallah-section">
      <div class="section-head">
        <span class="eyebrow">The BoardWallah Advantage</span>
        <h2>Why Students &amp; Parents Trust Our Mentorship</h2>
        <p class="subtitle">Personalized 1-on-1 pedagogy designed to eliminate rote memorization and secure 95%+ marks in CBSE Class 10 board exams.</p>
      </div>

      <div class="pillars-grid">
        <article class="pillar-card">
          <div class="pillar-icon-wrap">
            <span class="pillar-icon">🎯</span>
          </div>
          <h3>100% CBSE Blueprint &amp; Marking Scheme Mastery</h3>
          <p class="muted">
            Board examiners look for specific steps, theorem names, units, and keywords. We train students to write answers matching the official CBSE marking rubrics to prevent needless mark deductions.
          </p>
        </article>

        <article class="pillar-card">
          <div class="pillar-icon-wrap">
            <span class="pillar-icon">💡</span>
          </div>
          <h3>First-Principles Concept Clarity, Not Rote Learning</h3>
          <p class="muted">
            From geometric proofs in Circles &amp; Triangles to chemical reaction mechanisms and ray diagram Cartesian conventions, every concept is broken down from first principles with visual intuition.
          </p>
        </article>

        <article class="pillar-card">
          <div class="pillar-icon-wrap">
            <span class="pillar-icon">📚</span>
          </div>
          <h3>NCERT + RD Sharma + Past 10 Years PYQs</h3>
          <p class="muted">
            We cover every single NCERT in-text &amp; exemplar problem, supplemented with high-difficulty RD Sharma problems and chapter-wise previous years' questions (PYQs) so no board question feels unfamiliar.
          </p>
        </article>

        <article class="pillar-card">
          <div class="pillar-icon-wrap">
            <span class="pillar-icon">🏡</span>
          </div>
          <h3>Flexible Modes: 1-on-1 Home Tuition &amp; Live Online</h3>
