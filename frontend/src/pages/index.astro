  async function submitQuery(question) {
    if (!question || isWaiting) return;

    appendUserPill(question);
    textarea.value = '';
    adjustInputHeight();

    if (activeNotebookTitle) {
      activeNotebookTitle.textContent = question.slice(0, 36) + (question.length > 36 ? '...' : '');
    }

    isWaiting = true;
    sendBtn.disabled = true;
    showTypingAnimation();

    try {
      const resp = await fetch(`${apiBase}/api/v1/ai/doubt-tutor`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          question: question,
          mode: currentMode,
        }),
      });

      if (resp.ok) {
        const data = await resp.json();
        removeTypingAnimation();
        appendBotResponse(data.answer, data.keyTerms);
      } else {
        throw new Error('Local fallback');
      }
    } catch (err) {
      removeTypingAnimation();
      const resolved = resolveChatDoubt(question);
      appendBotResponse(resolved.answer, resolved.keyTerms);
    } finally {
      isWaiting = false;
      sendBtn.disabled = false;
      textarea.focus();
    }
  }

