---
import { getImage, Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { loadContent, teachingModeLabel } from "../lib/content";
import { calBookingUrl, siteOrigin } from "../lib/site";
import adImage from "../assets/ad.png";

const { provider, subjects } = loadContent();
const posterAlt =
  "BoardWallah CBSE Class 10 maths banner: complete maths preparation for board exams, covering NCERT, RD Sharma, previous year questions and revision, with chapter-wise concepts, important questions and practice tests.";
const socialImage = await getImage({ src: adImage, width: 1200, format: "webp" });

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "EducationalOrganization",
      "@id": `${siteOrigin}/#organization`,
      "name": provider.name,
      "url": siteOrigin,
      "logo": `${siteOrigin}/favicon.svg`,
      "description": `Comprehensive CBSE Class 10 tutoring and board exam preparation in ${provider.service_localities.join(", ")} by ${provider.tutor_name}.`,
      "founder": {
        "@type": "Person",
        "name": provider.tutor_name,
        "jobTitle": "Lead Educator & Founder",
        "knowsAbout": ["CBSE Class 10 Mathematics", "Science", "Social Science", "English", "Hindi"]
      },
      "areaServed": provider.service_localities.map((locality) => ({
        "@type": "Place",
        "name": locality
      })),
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "Student Support",
        "email": provider.contact.email,
        "telephone": provider.contact.whatsapp,
        "availableLanguage": provider.languages
      }
    },
    {
      "@type": "Person",
      "@id": `${siteOrigin}/#tutor`,
      "name": provider.tutor_name,
      "jobTitle": "CBSE Class 10 Educator & Tutor",
      "description": `${provider.experience_years} years of teaching experience specializing in CBSE Class 10 board exam preparation, concept clarification, and scoring 95%+ in boards.`,
      "hasCredential": provider.qualifications.map((q) => ({
        "@type": "EducationalOccupationalCredential",
        "credentialCategory": "degree",
        "name": q
      })),
      "knowsAbout": subjects.map((s) => s.name)
    },
    {
      "@type": "Course",
      "@id": `${siteOrigin}/#course-cbse-10`,
      "name": "CBSE Class 10 Complete Board Exam Preparation",
      "description": "Comprehensive one-on-one and small group CBSE Class 10 tutoring covering Mathematics, Science, Social Science, English, and Hindi with NCERT solutions, chapter guides, 1,120+ MCQs, 80-mark sample papers, and active-recall flashcards.",
      "provider": {
        "@id": `${siteOrigin}/#organization`
      },
      "educationalLevel": "Secondary Education (CBSE Class 10)",
      "offers": [
        {
          "@type": "Offer",
          "name": `Free ${provider.trial.duration_minutes}-Minute Trial Session`,
          "price": "0",
          "priceCurrency": "INR",
          "category": "TrialSession",
          "url": calBookingUrl,
          "availability": "https://schema.org/InStock"
        }
      ]
    }
  ]
};
---

<Layout 
  title={`${provider.name} | CBSE Class 10 Tuition, Online or At Home`} 
  description={`One-to-one CBSE Class 10 tuition online or at home with ${provider.tutor_name}. Book a free trial slot.`}
  image={socialImage.src}
  imageAlt={posterAlt}
  schema={homeSchema}
>
  <!-- Full-page Ambient Mathematical Pattern Background Layer -->
  <div class="math-ambient-bg" aria-hidden="true"></div>

  <div class="wrap">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-text">
        <a href="/resources/" class="hero-announcement-pill" aria-label="Explore CBSE Class 10 Board 2026 Study Toolkit">
          <span class="pill-badge">CBSE 2026 Toolkit</span>
          <span class="pill-text">80-Mark Sample Papers · 80 Flashcards · 56 Chapter Guides &rarr;</span>
        </a>

        <h1>Master CBSE Class 10 with {provider.tutor_name}</h1>
        <p class="lead">Expert tuition online or at your home, tailored to your learning pace. Pick a slot and choose the mode when you book.</p>
        <div class="actions">
          <a class="button" href={calBookingUrl} target="_blank" rel="noopener noreferrer">Book Free Trial</a>
          <a href="/resources/" class="button resource-cta-btn">📚 Free Study Resources</a>
          <a href="/plans/" class="button secondary">View Plans</a>
        </div>
      </div>
      <figure class="hero-media">
        <Image
          src={adImage}
          alt={posterAlt}
          widths={[640, 960, 1280]}
          sizes="(max-width: 820px) 92vw, 1080px"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </section>

    <!-- CBSE 2026 Board Prep Toolkit Section -->
    <section class="toolkit-showcase-section">
      <div class="section-head">
        <span class="eyebrow">Target 95%+ in CBSE 2026 Boards</span>
        <h2>High-Yield Board Exam Study Toolkit</h2>
        <p class="subtitle">Equip yourself with the three essential tools every Class 10 topper uses to prepare, test, and master the board syllabus.</p>
      </div>

      <div class="toolkit-cards-grid">
        <!-- Card 1: Sample Papers -->
        <article class="toolkit-card toolkit-card-papers">
          <div class="toolkit-badge-row">
            <span class="toolkit-icon">📝</span>
            <span class="toolkit-badge badge-papers">Full 80 Marks</span>
          </div>
          <h3>CBSE 2026 Blueprint Mock Papers</h3>
          <p class="muted">
            Simulate authentic exam hall conditions for Maths, Science, Social Science &amp; English with a built-in 3-hour timer, question-wise marks, and marking schemes.
          </p>
          <ul class="toolkit-highlights">
            <li>⏱️ 3-Hour Practice Countdown Timer</li>
            <li>📋 Official Section Breakdown (A to E)</li>
            <li>🔍 Step-by-Step Marking Rubrics</li>
          </ul>
          <a href="/resources/sample-papers/" class="button small toolkit-action-btn">Simulate 80-Mark Exam &rarr;</a>
        </article>

        <!-- Card 2: Interactive Flashcards -->
        <article class="toolkit-card toolkit-card-flashcards">
          <div class="toolkit-badge-row">
            <span class="toolkit-icon">⚡</span>
            <span class="toolkit-badge badge-flashcards">Active Recall Engine</span>
          </div>
          <h3>80 Interactive Revision Flashcards</h3>
          <p class="muted">
            Test key formulas, chemical reaction colours, ray diagram conventions, historical dates, and Hindi/English grammar with 3D flip cards and self-testing.
          </p>
          <ul class="toolkit-highlights">
            <li>🔄 3D Flip Cards with Keyboard Navigation</li>
            <li>⭐ Key CBSE Marking Scheme Keywords</li>
            <li>🎯 Targeted Weak Cards Practice Filter</li>
          </ul>
          <a href="/resources/flashcards/" class="button small toolkit-action-btn">Practice 80 Flashcards &rarr;</a>
        </article>

        <!-- Card 3: Quiz Mastery Tracker -->
        <article class="toolkit-card toolkit-card-tracker">
          <div class="toolkit-badge-row">
            <span class="toolkit-icon">📊</span>
            <span class="toolkit-badge badge-tracker">Progress Tracker</span>
          </div>
          <h3>Syllabus Mastery &amp; Quiz Tracker</h3>
          <p class="muted">
            Take 20-question chapter quizzes across all 56 Class 10 chapters. Automatically saves high scores in your browser, monitors syllabus completion, and highlights weak topics.
          </p>
          <ul class="toolkit-highlights">
            <li>📈 Live Syllabus Completion Percentage</li>
            <li>🏆 Previous Best Score Tracking</li>
            <li>✅ Completed vs Needs Practice Filters</li>
          </ul>
          <a href="/resources/" class="button small toolkit-action-btn">Track 56 Chapters &rarr;</a>
        </article>
      </div>
    </section>

    <!-- Free CBSE Class 10 Resources Showcase Section -->
    <section class="home-resources-section">
      <div class="section-head">
        <span class="eyebrow">Free CBSE Class 10 Academic Hub</span>
        <h2>Explore Chapter Guides, Visual Diagrams &amp; Board Quizzes</h2>
        <p class="subtitle">Comprehensive revision notes, interactive SVG diagrams, formula sheets, and 20-question practice quizzes covering 100% of the syllabus.</p>
      </div>

      <div class="resource-hub-grid">
        <article class="hub-card hub-maths">
          <div class="hub-header">
            <span class="hub-icon">📐</span>
            <span class="hub-tag">14 Chapters · 100% Complete</span>
          </div>
          <h3>Mathematics</h3>
          <p>Real Numbers to Probability, step-by-step proofs, circle theorems, trigonometry ratios &amp; 20-question quizzes.</p>
          <ul class="hub-features">
            <li>✓ All NCERT &amp; RD Sharma core theorems</li>
            <li>✓ Interactive circle &amp; triangle proofs</li>
            <li>✓ 280+ board practice MCQs</li>
          </ul>
          <a href="/resources/#maths" class="hub-link">Explore Maths Guides &rarr;</a>
        </article>

        <article class="hub-card hub-science">
          <div class="hub-header">
            <span class="hub-icon">🔬</span>
            <span class="hub-tag">13 Chapters · Complete Science (Phy, Chem, Bio)</span>
          </div>
          <h3>Science</h3>
          <p>Life processes, nervous system, reproduction, genetics, optics ray diagrams, electric circuits, chemical reactions &amp; carbon compounds.</p>
          <ul class="hub-features">
            <li>✓ Custom SVG optical ray diagrams &amp; biological systems</li>
            <li>✓ Chemical reactions, equations &amp; carbon allotropes</li>
            <li>✓ 260+ interactive science board MCQs</li>
          </ul>
          <a href="/resources/#science" class="hub-link">Explore Science Guides &rarr;</a>
        </article>

        <article class="hub-card hub-sst">
          <div class="hub-header">
            <span class="hub-icon">🌍</span>
            <span class="hub-tag">20 Chapters · All 4 Disciplines</span>
          </div>
          <h3>Social Science</h3>
          <p>History revolutions &amp; nationalism, Civics power-sharing, Geography resources &amp; Economics development.</p>
          <ul class="hub-features">
            <li>✓ History timelines &amp; visual maps</li>
            <li>✓ Civics federalism &amp; democracy flowcharts</li>
            <li>✓ 400+ board exam practice questions</li>
          </ul>
          <a href="/resources/#social-science" class="hub-link">Explore Social Science &rarr;</a>
        </article>

        <article class="hub-card hub-hindi">
          <div class="hub-header">
            <span class="hub-icon">✍️</span>
            <span class="hub-tag">Course 'A' · सम्पूर्ण पाठ्यक्रम</span>
          </div>
          <h3>Hindi Course 'A'</h3>
          <p>क्षितिज भाग-2 (सभी 8 गद्य व 11 पद्य), कृतिका भाग-2 (सभी 5 पाठ), व्यावहारिक व्याकरण एवं रचनात्मक लेखन।</p>
          <ul class="hub-features">
            <li>✓ सभी गद्य पाठ व काव्य भावार्थ</li>
            <li>✓ व्याकरण स्तम्भ (16 अंक) व लेखन प्रारूप (20 अंक)</li>
            <li>✓ 100+ सीबीएसई बोर्ड अभ्यास प्रश्न</li>
          </ul>
          <a href="/resources/#hindi" class="hub-link">Explore Hindi Guides &rarr;</a>
        </article>

        <article class="hub-card hub-english">
          <div class="hub-header">
            <span class="hub-icon">📖</span>
            <span class="hub-tag">Code 184 · Complete Syllabus</span>
          </div>
          <h3>English Language &amp; Literature</h3>
          <p>First Flight (Prose &amp; Poetry), Footprints Without Feet, Grammar (Tenses, Modals, Concord) &amp; Writing (Letters &amp; Paragraphs).</p>
          <ul class="hub-features">
            <li>✓ All 9 prose chapters &amp; 10 poems</li>
            <li>✓ All 9 supplementary reader chapters</li>
            <li>✓ 80+ board practice MCQs &amp; RTC extracts</li>
          </ul>
          <a href="/resources/#english" class="hub-link">Explore English Guides &rarr;</a>
        </article>
      </div>

      <div class="hub-footer-cta">
        <div class="hub-banner">
          <div class="hub-banner-text">
            <strong>Need instant chapter revision or self-assessment?</strong>
            <p>Browse our complete library of 56+ chapter notes, formula sheets, and 1,120+ questions with step-by-step solutions.</p>
          </div>
          <a href="/resources/" class="button">Open Complete Resources Hub &rarr;</a>
        </div>
      </div>
    </section>

    <!-- About the Tutor Profile -->
    <section class="card provider-profile">
      <div class="profile-text">
        <h2>About the Tutor</h2>
        <p>With {provider.experience_years} years of experience, I focus on simplifying complex concepts and building student confidence for the CBSE board exams.</p>
        <ul class="qualifications">
          {provider.qualifications.map(q => <li>{q}</li>)}
        </ul>
      </div>
      <div class="profile-details">
        <div class="detail-item">
          <span class="label">Teaching Mode:</span>
          <span class="value">{provider.teaching_mode.map(teachingModeLabel).join(" or ")}</span>
        </div>
        <div class="detail-item">
          <span class="label">Languages:</span>
          <span class="value">{provider.languages.join(", ")}</span>
        </div>
        <div class="detail-item">
          <span class="label">Service Localities:</span>
          <span class="value">{provider.service_localities.join(", ")}</span>
        </div>
      </div>
    </section>

    <!-- Subjects Offered Section with Direct Resource Links -->
    <section class="subjects-section">
      <h2>Subjects Offered</h2>
      <p class="subtitle">Comprehensive coverage of the CBSE Class 10 curriculum with dedicated chapter notes &amp; quizzes.</p>
      <div class="subjects-grid">
        <a href="/resources/#maths" class="subject-card interactive-subject-card">
          <span class="subj-icon">📐</span>
          <span class="subj-title">Mathematics</span>
          <span class="subj-badge">14 Chapter Guides &amp; Quizzes &rarr;</span>
        </a>
        <a href="/resources/#science" class="subject-card interactive-subject-card">
          <span class="subj-icon">🔬</span>
          <span class="subj-title">Science</span>
          <span class="subj-badge">13 Physics, Chem &amp; Bio Guides &rarr;</span>
        </a>
        <a href="/resources/#social-science" class="subject-card interactive-subject-card">
          <span class="subj-icon">🌍</span>
          <span class="subj-title">Social Science</span>
          <span class="subj-badge">20 History, Civics, Geo &amp; Eco Guides &rarr;</span>
        </a>
        <a href="/resources/#hindi" class="subject-card interactive-subject-card">
          <span class="subj-icon">✍️</span>
          <span class="subj-title">Hindi Course 'A'</span>
          <span class="subj-badge">Complete Syllabus &amp; Quizzes &rarr;</span>
        </a>
        <a href="/resources/#english" class="subject-card interactive-subject-card">
          <span class="subj-icon">📖</span>
          <span class="subj-title">English</span>
          <span class="subj-badge">All Chapters &amp; Grammar &rarr;</span>
        </a>
      </div>
    </section>

    <!-- Bottom CTA Banner -->
    <section class="cta-banner">
      <h2>Ready to start learning?</h2>
      <p>Book your free trial session today. Pick online or a home visit when you choose a slot.</p>
      <a class="button" href={calBookingUrl} target="_blank" rel="noopener noreferrer">Reserve Your Free Trial</a>
    </section>
  </div>
</Layout>

<style>
  /* Full-page Ambient Mathematical Pattern Background Layer */
  :global(body:has(.math-ambient-bg)) {
    background-color: var(--paper);
    background-image: url("/math-pattern.svg");
    background-repeat: repeat;
    background-size: 580px 580px;
    background-attachment: fixed;
  }

  .math-ambient-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    background-image: url("/math-pattern.svg");
    background-repeat: repeat;
    background-size: 580px 580px;
  }

  .wrap {
    position: relative;
    z-index: 1;
  }

  /* Hero Announcement Pill */
  .hero-announcement-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0.85rem;
    margin-bottom: 1.25rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: 0 2px 8px rgb(21 37 43 / 6%);
    text-decoration: none;
    font-size: 0.86rem;
    color: var(--ink);
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .hero-announcement-pill:hover {
    transform: translateY(-1px);
    border-color: var(--brand);
    box-shadow: 0 4px 12px rgb(15 76 92 / 12%);
  }
  .pill-badge {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: #7c3a12;
    font-weight: 700;
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .pill-text {
    font-weight: 600;
    color: var(--brand);
  }

  /* Resource CTA Button in Hero */
  .resource-cta-btn {
    background: #e8f4f6;
    color: var(--brand);
    border: 1px solid #b5d8de;
  }
  .resource-cta-btn:hover {
    background: #d6ecf0;
    color: var(--brand-dark);
  }

  /* ── CBSE 2026 Board Prep Toolkit Section ── */
  .toolkit-showcase-section {
    margin-block: 2.25rem 3.5rem;
  }

  .toolkit-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .toolkit-card {
    background: var(--surface);
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 16px rgb(21 37 43 / 4%);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .toolkit-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgb(15 76 92 / 12%);
  }

  .toolkit-card-papers {
    border-color: #99f6e4;
    background: linear-gradient(145deg, #ffffff 0%, #f0fdfa 100%);
  }
  .toolkit-card-papers:hover {
    border-color: #0d9488;
  }

  .toolkit-card-flashcards {
    border-color: #c4b5fd;
    background: linear-gradient(145deg, #ffffff 0%, #f5f3ff 100%);
  }
  .toolkit-card-flashcards:hover {
    border-color: #7c3aed;
  }

  .toolkit-card-tracker {
    border-color: #bbf7d0;
    background: linear-gradient(145deg, #ffffff 0%, #f0fdf4 100%);
  }
  .toolkit-card-tracker:hover {
    border-color: #16a34a;
  }

  .toolkit-badge-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .toolkit-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .toolkit-badge {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
  }

  .badge-papers {
    background: #ccfbf1;
    color: #0f766e;
  }

  .badge-flashcards {
    background: #ede9fe;
    color: #5b21b6;
  }

  .badge-tracker {
    background: #dcfce7;
    color: #15803d;
  }

  .toolkit-card h3 {
    font-size: 1.28rem;
    margin-bottom: 0.45rem;
    color: var(--ink);
  }

  .toolkit-card p {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }

  .toolkit-highlights {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
    font-size: 0.86rem;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .toolkit-action-btn {
    margin-top: auto;
    width: 100%;
    text-align: center;
    justify-content: center;
  }

  /* Home Resources Showcase Section */
  .home-resources-section {
    margin-block: 2.5rem 3.5rem;
  }
  .section-head {
    text-align: center;
    max-width: 72ch;
    margin-inline: auto;
    margin-bottom: 2rem;
  }
  .section-head h2 {
    font-size: clamp(1.5rem, 3.2vw, 2.2rem);
    margin-bottom: 0.5rem;
  }
  .subtitle {
    color: var(--muted);
    font-size: 1.05rem;
    margin: 0;
  }

  .resource-hub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .hub-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .hub-card:hover {
    transform: translateY(-4px);
    border-color: var(--brand);
    box-shadow: 0 16px 36px rgb(15 76 92 / 12%);
  }

  .hub-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }
  .hub-icon {
    font-size: 1.8rem;
    line-height: 1;
  }
  .hub-tag {
    font-size: 0.74rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: #eef2f1;
    color: var(--muted);
    letter-spacing: 0.02em;
  }
  .hub-maths .hub-tag { background: #e0f2fe; color: #0369a1; }
  .hub-science .hub-tag { background: #fef3c7; color: #92400e; }
  .hub-sst .hub-tag { background: #dcfce7; color: #15803d; }
  .hub-hindi .hub-tag { background: #fae8ff; color: #86198f; }
  .hub-english .hub-tag { background: #ede9fe; color: #6d28d9; }

  .hub-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.4rem;
    color: var(--ink);
  }
  .hub-card p {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .hub-features {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem 0;
    font-size: 0.85rem;
    color: var(--ink);
  }
  .hub-features li {
    padding: 0.22rem 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .hub-link {
    margin-top: auto;
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--brand);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: gap 0.15s ease, color 0.15s ease;
  }
  .hub-link:hover {
    gap: 0.5rem;
    color: var(--accent);
  }

  /* Hub Footer Banner */
  .hub-footer-cta {
    margin-top: 1.5rem;
  }
  .hub-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
