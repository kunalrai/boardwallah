  const accountSignoutBtn = document.getElementById('account-signout-btn');

  function decodeJwt(token) {
    try {
      const base64Url = token.split('.')[1];
      const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
      const jsonPayload = decodeURIComponent(
        atob(base64)
          .split('')
          .map(c => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2))
          .join('')
      );
      return JSON.parse(jsonPayload);
    } catch (e) {
      return null;
    }
  }

  function getStoredUser() {
    try {
      const raw = localStorage.getItem(USER_STORAGE_KEY);
      return raw ? JSON.parse(raw) : null;
    } catch (e) {
      return null;
    }
  }

  function updateSidebarProfile(user) {
    const sidebarUserName = document.getElementById('sidebar-user-name');
    const sidebarUserStatus = document.getElementById('sidebar-user-status');
    const sidebarAvatar = document.getElementById('sidebar-avatar');

    if (!user) {
      if (sidebarUserName) sidebarUserName.textContent = "Sign in";
      if (sidebarUserStatus) sidebarUserStatus.textContent = "Student Account";
      if (sidebarAvatar) {
        sidebarAvatar.className = "profile-avatar signin-avatar";
        sidebarAvatar.innerHTML = `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`;
      }
      if (profileCard) profileCard.setAttribute('title', 'Sign in with Google');
      return;
    }

    if (sidebarUserName) sidebarUserName.textContent = user.name || "Student";
    if (sidebarUserStatus) sidebarUserStatus.textContent = user.email || "Active Account";
    if (profileCard) profileCard.setAttribute('title', `Signed in as ${user.name || user.email} (Click to manage)`);

    if (sidebarAvatar) {
      sidebarAvatar.className = "profile-avatar";
      if (user.picture) {
        sidebarAvatar.innerHTML = `<img src="${user.picture}" alt="${user.name || 'Student'}" style="width:100%;height:100%;border-radius:50%;object-fit:cover;" referrerpolicy="no-referrer" />`;
      } else {
        const initials = (user.name || "S").split(' ').map((p) => p[0]).join('').substring(0, 2).toUpperCase();
        sidebarAvatar.textContent = initials;
      }
    }
  }

  function handleSuccessfulSignIn(profile, token) {
    const user = {
      name: profile.name || "Student",
      email: profile.email || "",
      picture: profile.picture || "",
      sub: profile.sub || ""
    };
    try {
      localStorage.setItem(USER_STORAGE_KEY, JSON.stringify(user));
      if (token) localStorage.setItem(SESSION_KEY, token);
    } catch (e) {}

    updateSidebarProfile(user);

    if (signinModal && typeof signinModal.close === 'function') {
      try { signinModal.close(); } catch(e) {}
    }

    showToast(`Signed in as ${user.name || user.email}`);
  }

  function openSignInModal() {
    if (signinModal) signinModal.showModal();
  }

  function openAccountModal(user) {
    if (!accountModal) return;
    const avatarEl = document.getElementById('account-modal-avatar');
    const nameEl = document.getElementById('account-modal-name');
    const emailEl = document.getElementById('account-modal-email');
    if (nameEl) nameEl.textContent = user.name || "Student";
    if (emailEl) emailEl.textContent = user.email || "";
    if (avatarEl) {
      if (user.picture) {
        avatarEl.innerHTML = `<img src="${user.picture}" alt="${user.name}" style="width:100%;height:100%;border-radius:50%;object-fit:cover;" referrerpolicy="no-referrer" />`;
      } else {
        avatarEl.textContent = (user.name || "S").substring(0, 2).toUpperCase();
      }
    }
    accountModal.showModal();
  }

  function initGooglePopup() {
    if (typeof window.google === 'undefined' || !window.google.accounts) {
      setTimeout(initGooglePopup, 200);
      return;
    }

    // 1. Initialize OAuth2 Token Client (Opens native Google sign-in popup directly on click)
    try {
      if (window.google.accounts.oauth2 && typeof window.google.accounts.oauth2.initTokenClient === 'function') {
        googleTokenClient = window.google.accounts.oauth2.initTokenClient({
          client_id: GOOGLE_CLIENT_ID,
          scope: 'email profile openid',
          callback: async (tokenResponse) => {
            if (tokenResponse && tokenResponse.access_token) {
              try {
                const res = await fetch('https://www.googleapis.com/oauth2/v3/userinfo', {
                  headers: { Authorization: `Bearer ${tokenResponse.access_token}` }
                });
                if (res.ok) {
                  const profile = await res.json();
                  handleSuccessfulSignIn(profile, tokenResponse.access_token);
                }
              } catch (err) {
                console.error('Failed to fetch Google profile:', err);
              }
            }
          },
          error_callback: (err) => {
            console.warn('Google popup error:', err);
            if (err && err.type === 'popup_failed_to_open') {
              openSignInModal();
            }
          }
        });
      }
    } catch (e) {
      console.warn('oauth2 init error:', e);
    }

    // 2. Also initialize Google ID services for One Tap & fallback rendered button
    try {
      if (window.google.accounts.id && typeof window.google.accounts.id.initialize === 'function') {
        window.google.accounts.id.initialize({
          client_id: GOOGLE_CLIENT_ID,
          callback: (response) => {
            if (response && response.credential) {
              const decoded = decodeJwt(response.credential);
              if (decoded) {
                handleSuccessfulSignIn(decoded, response.credential);
              }
            }
          },
          auto_select: false,
          cancel_on_tap_outside: true,
        });

        const modalBtnContainer = document.getElementById('modal-gsi-btn-container');
        if (modalBtnContainer) {
          window.google.accounts.id.renderButton(modalBtnContainer, {
            type: 'standard',
            theme: 'outline',
            size: 'large',
            text: 'signin_with',
            shape: 'pill',
            width: 250,
            logo_alignment: 'left',
          });
        }
      }
    } catch (e) {
      console.warn('gsi id init error:', e);
    }
  }

  // Handle Profile / Sign in click
  if (profileCard) {
    profileCard.addEventListener('click', (e) => {
      e.preventDefault();
      const currentUser = getStoredUser();
      if (currentUser) {
        openAccountModal(currentUser);
        return;
      }

      // Trigger Google Popup directly
      if (googleTokenClient && typeof googleTokenClient.requestAccessToken === 'function') {
        googleTokenClient.requestAccessToken({ prompt: 'select_account' });
      } else if (window.google && window.google.accounts && window.google.accounts.id) {
        window.google.accounts.id.prompt((notification) => {
          if (notification.isNotDisplayed() || notification.isSkippedMoment()) {
