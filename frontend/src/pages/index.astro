---
import Layout from "../layouts/Layout.astro";
import { loadContent, whatsappLink } from "../lib/content";
import { calBookingUrl, siteOrigin } from "../lib/site";

const { provider } = loadContent();
const posterAlt =
  "10Boardwallah: CBSE Class 10 Board Exam Mentor with Kunal Rai. Socratic AI Doubt Solver, Marking Rubrics, 80 Concept Flashcards & 80-Mark Mock Exam Timer.";

const waHeroLink = whatsappLink(
  provider.contact.whatsapp,
  `Hello ${provider.tutor_name}, I am preparing for CBSE Class 10 Board Exams on boardwallah.space and would like to ask about 1-on-1 tuition.`
);

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "EducationalOrganization",
      "@id": `${siteOrigin}/#organization`,
      "name": provider.name,
      "url": siteOrigin,
      "logo": `${siteOrigin}/favicon.svg`,
      "description": `Comprehensive 1-on-1 CBSE Class 10 tutoring and board exam preparation by ${provider.tutor_name} (20 yrs exp, B.Tech, ex-Samsung/HCL).`,
      "founder": {
        "@type": "Person",
        "name": provider.tutor_name,
        "jobTitle": "Lead Educator & Founder",
        "knowsAbout": ["CBSE Class 10 Mathematics", "Science", "Social Science", "English", "Hindi"]
      },
      "areaServed": provider.service_localities.map((locality) => ({
        "@type": "Place",
        "name": locality
      })),
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "Student Support",
        "email": provider.contact.email,
        "telephone": provider.contact.whatsapp,
        "availableLanguage": provider.languages
      }
    },
    {
      "@type": "Person",
      "@id": `${siteOrigin}/#tutor`,
      "name": provider.tutor_name,
      "jobTitle": "CBSE Class 10 Educator & Tutor",
      "description": `${provider.experience_years} years of teaching experience specializing in CBSE Class 10 board exam preparation, concept clarification, and scoring 95%+ in boards.`,
      "hasCredential": provider.qualifications.map((q) => ({
        "@type": "EducationalOccupationalCredential",
        "credentialCategory": "degree",
        "name": q
      })),
      "knowsAbout": ["CBSE Class 10 Mathematics", "Science", "Social Science", "English", "Hindi"]
    },
    {
      "@type": "Course",
      "@id": `${siteOrigin}/#course-cbse-10`,
      "name": "CBSE Class 10 Complete Board Exam Preparation",
      "description": "Comprehensive CBSE Class 10 board preparation covering Mathematics, Science, Social Science, English, and Hindi with Socratic AI doubt mentor, CBSE step marking rubrics, 80-mark mock papers, and active-recall flashcards.",
      "provider": {
        "@id": `${siteOrigin}/#organization`
      },
      "educationalLevel": "Secondary Education (CBSE Class 10)",
      "offers": [
        {
          "@type": "Offer",
          "name": `Free ${provider.trial.duration_minutes}-Minute Trial Session`,
          "price": "0",
          "priceCurrency": "INR",
          "category": "TrialSession",
          "url": calBookingUrl,
          "availability": "https://schema.org/InStock"
        }
      ]
    }
  ]
};
---

<Layout
  title="10Boardwallah — CBSE Class 10 Board Exam Mentor | boardwallah.space"
  description="Master CBSE Class 10 with Kunal Rai. Socratic AI Doubt Tutor, CBSE step-wise marking rubrics, 80 concept flashcards, and 3-hour 80-mark mock papers."
  imageAlt={posterAlt}
  schema={homeSchema}
  isAppLayout={true}
  htmlClass="dark"
>
  <!-- Tailwind CSS & Lucide Icons -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />
  <script is:inline src="https://unpkg.com/lucide@latest"></script>

  <script is:inline>
    // Ensure dark class is present by default
    document.documentElement.classList.add('dark');
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'Inter', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            bw: {
              darkBg: '#0D1117',
              darkSurface: '#161B22',
              darkHover: '#21262D',
              darkBorder: '#30363D',
              lightBg: '#F8FAFC',
              lightSurface: '#FFFFFF',
              lightHover: '#F1F5F9',
              lightBorder: '#E2E8F0',
              saffron: '#F97316',
              saffronDeep: '#EA580C',
              cyan: '#38BDF8',
              cyanDeep: '#0284C7',
            }
          }
        }
      }
    };
  </script>

  <div class="h-screen w-screen overflow-hidden flex selection:bg-orange-500/30 selection:text-orange-200 bg-[#F8FAFC] dark:bg-[#0D1117] text-slate-900 dark:text-[#F0F6FC] font-sans antialiased">
    <!-- Mobile Sidebar Backdrop -->
    <div id="mobileBackdrop" onclick="toggleMobileSidebar(false)" class="fixed inset-0 bg-black/60 backdrop-blur-xs z-30 hidden md:hidden"></div>

    <!-- =====================================================================
         ZONE 1: COLLAPSIBLE LEFT SYLLABUS & SESSION RAIL (260px / 64px)
    ====================================================================== -->
    <aside id="sidebar" class="fixed md:static inset-y-0 left-0 z-40 flex flex-col justify-between bg-[#FFFFFF] dark:bg-[#161B22] border-r border-[#E2E8F0] dark:border-[#30363D] transition-all duration-200 ease-out w-[260px] -translate-x-full md:translate-x-0 shrink-0">
      
      <!-- Top Section: Brand + New Doubt Session + Subject & Chapter Syllabus -->
      <div class="p-3 flex flex-col gap-3 overflow-y-auto">
        <div class="flex items-center justify-between h-10 px-1.5">
          <a href="#" onclick="if(state.sidebarCollapsed){toggleSidebarCollapse();}else{resetToNewSession(event);}" class="flex items-center gap-2.5 overflow-hidden group">
            <!-- Custom Geometric "10BW" Boardwallah Chalkboard Emblem -->
            <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-orange-500 to-sky-400 p-[1.5px] shrink-0 shadow-sm">
              <div class="w-full h-full rounded-[10.5px] bg-[#FFFFFF] dark:bg-[#0D1117] flex items-center justify-center font-mono font-bold text-[11px] tracking-tighter text-slate-900 dark:text-white">
                <span class="text-orange-500">10</span><span>B</span><span class="text-sky-400">W</span>
              </div>
            </div>
            <div class="sidebar-label flex flex-col leading-none transition-opacity duration-150">
              <span class="font-mono font-bold text-[16px] tracking-tight text-slate-900 dark:text-white">10Boardwallah</span>
              <span class="text-[10px] font-medium text-slate-500 dark:text-slate-400 tracking-wide mt-0.5">CBSE CLASS 10 BOARDS</span>
            </div>
          </a>

          <button id="sidebarCollapseBtn" onclick="toggleSidebarCollapse()" title="Toggle Syllabus Rail" class="p-1.5 rounded-lg text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-[#21262D] transition-colors">
            <i data-lucide="panel-left" class="w-4 h-4"></i>
          </button>
        </div>

        <!-- + New Doubt Session Pill -->
        <button onclick="resetToNewSession()" class="flex items-center justify-between gap-2 w-full px-3 py-2.5 rounded-full bg-orange-500/10 hover:bg-orange-500/20 dark:bg-[#21262D] dark:hover:bg-[#2b323b] border border-orange-500/30 dark:border-[#30363D] text-orange-600 dark:text-orange-400 font-medium text-xs transition-all group">
          <span class="flex items-center gap-2.5">
            <i data-lucide="plus" class="w-4 h-4 shrink-0 text-orange-500"></i>
            <span class="sidebar-label whitespace-nowrap font-semibold text-slate-800 dark:text-slate-100">New Board Doubt</span>
          </span>
          <kbd class="sidebar-label hidden sm:inline-block px-1.5 py-0.5 text-[10px] font-mono rounded bg-white/80 dark:bg-[#0D1117] text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-[#30363D]">⌘K</kbd>
        </button>

        <!-- CBSE Class 10 Subjects Switcher -->
        <div class="sidebar-label pt-1">
          <div class="px-2 pb-1.5 text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">CBSE Class 10 Prep &amp; Subjects</div>
          <div class="flex flex-col gap-1" id="subjectList">
            <button onclick="selectSubject('CBSE Board 2026', this)" data-subject="CBSE Board 2026" class="subject-btn active flex items-center justify-between px-2.5 py-2 rounded-xl text-xs font-medium bg-orange-500/10 text-orange-600 dark:text-orange-400 border border-orange-500/20 transition-all">
              <span class="flex items-center gap-2 truncate"><i data-lucide="calendar-days" class="w-3.5 h-3.5 shrink-0"></i><span>CBSE Board 2026</span></span>
              <span class="text-[10px] font-mono opacity-80">Dates &amp; Plan</span>
            </button>
            <button onclick="selectSubject('Mathematics', this)" data-subject="Mathematics" class="subject-btn flex items-center justify-between px-2.5 py-2 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-[#21262D] border border-transparent transition-all">
              <span class="flex items-center gap-2 truncate"><i data-lucide="sigma" class="w-3.5 h-3.5 shrink-0"></i><span>Mathematics</span></span>
              <span class="text-[10px] font-mono opacity-80">14 Ch</span>
            </button>
            <button onclick="selectSubject('Science', this)" data-subject="Science" class="subject-btn flex items-center justify-between px-2.5 py-2 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-[#21262D] border border-transparent transition-all">
              <span class="flex items-center gap-2 truncate"><i data-lucide="flask-conical" class="w-3.5 h-3.5 shrink-0"></i><span>Science</span></span>
              <span class="text-[10px] font-mono opacity-80">P/C/B</span>
            </button>
            <button onclick="selectSubject('Social Science', this)" data-subject="Social Science" class="subject-btn flex items-center justify-between px-2.5 py-2 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-[#21262D] border border-transparent transition-all">
              <span class="flex items-center gap-2 truncate"><i data-lucide="globe-2" class="w-3.5 h-3.5 shrink-0"></i><span>Social Science</span></span>
              <span class="text-[10px] font-mono opacity-80">20 Ch</span>
            </button>
            <button onclick="selectSubject('English', this)" data-subject="English" class="subject-btn flex items-center justify-between px-2.5 py-2 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-[#21262D] border border-transparent transition-all">
              <span class="flex items-center gap-2 truncate"><i data-lucide="book-open-text" class="w-3.5 h-3.5 shrink-0"></i><span>English (Lang &amp; Lit)</span></span>
              <span class="text-[10px] font-mono opacity-80">NCERT</span>
            </button>
            <button onclick="selectSubject('Hindi Course A', this)" data-subject="Hindi Course A" class="subject-btn flex items-center justify-between px-2.5 py-2 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-[#21262D] border border-transparent transition-all">
              <span class="flex items-center gap-2 truncate"><i data-lucide="languages" class="w-3.5 h-3.5 shrink-0"></i><span>Hindi Course 'A'</span></span>
              <span class="text-[10px] font-mono opacity-80">क्षितिज</span>
            </button>
          </div>
        </div>

        <!-- Chapter Selector for Active Subject -->
        <div class="sidebar-label pt-1">
          <div class="flex items-center justify-between px-2 pb-1">
            <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">Chapter</span>
            <span id="chapterCountBadge" class="text-[10px] font-mono text-orange-500">14 Chapters</span>
          </div>
          <select id="chapterSelect" onchange="handleChapterChange(this.value)" class="w-full px-2.5 py-2 rounded-xl text-xs font-medium bg-slate-50 dark:bg-[#0D1117] text-slate-800 dark:text-slate-100 border border-slate-200 dark:border-[#30363D] focus:outline-none focus:border-orange-500">
            <!-- Populated dynamically per subject -->
          </select>
        </div>

        <!-- Quick Study Tools (80-Mark Mock, 80 Flashcards, Trial Info) -->
        <div class="sidebar-label pt-1 border-t border-slate-100 dark:border-[#30363D]/60">
          <div class="px-2 pt-2 pb-1.5 text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">Board Toolkit</div>
          <div class="flex flex-col gap-1">
            <button onclick="openStudyDrawerTab('mock')" class="w-full text-left px-2.5 py-2 rounded-xl hover:bg-slate-100 dark:hover:bg-[#21262D] flex items-center justify-between text-xs font-medium text-slate-700 dark:text-slate-200 transition-colors">
              <span class="flex items-center gap-2"><i data-lucide="timer" class="w-3.5 h-3.5 text-orange-500"></i><span>80-Mark Mock (3h)</span></span>
              <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-orange-500/10 text-orange-500">80M</span>
            </button>
            <button onclick="openStudyDrawerTab('flashcards')" class="w-full text-left px-2.5 py-2 rounded-xl hover:bg-slate-100 dark:hover:bg-[#21262D] flex items-center justify-between text-xs font-medium text-slate-700 dark:text-slate-200 transition-colors">
              <span class="flex items-center gap-2"><i data-lucide="layers" class="w-3.5 h-3.5 text-sky-400"></i><span>80 Concept Flashcards</span></span>
              <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-sky-500/10 text-sky-400">DECK</span>
            </button>
            <a href={calBookingUrl} target="_blank" rel="noopener noreferrer" class="w-full text-left px-2.5 py-2 rounded-xl hover:bg-slate-100 dark:hover:bg-[#21262D] flex items-center justify-between text-xs font-medium text-slate-700 dark:text-slate-200 transition-colors">
              <span class="flex items-center gap-2"><i data-lucide="calendar" class="w-3.5 h-3.5 text-emerald-400"></i><span>Free 60-Min Trial</span></span>
              <span class="text-[10px] font-mono text-emerald-400">16–20h ↗</span>
            </a>
            <a href="/resources/" class="w-full text-left px-2.5 py-2 rounded-xl hover:bg-slate-100 dark:hover:bg-[#21262D] flex items-center justify-between text-xs font-medium text-slate-700 dark:text-slate-200 transition-colors">
              <span class="flex items-center gap-2"><i data-lucide="library" class="w-3.5 h-3.5 text-indigo-400"></i><span>Study Resources</span></span>
              <span class="text-[10px] font-mono text-slate-400">56 Ch &rarr;</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Bottom Section: Theme Toggle + Tutor & Trial Info Badge -->
      <div class="p-3 border-t border-[#E2E8F0] dark:border-[#30363D] flex flex-col gap-2 shrink-0">
        <button onclick="toggleTheme()" class="flex items-center justify-between w-full px-2.5 py-2 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-[#21262D] transition-colors">
          <span class="flex items-center gap-2.5">
            <i id="themeIcon" data-lucide="sun" class="w-4 h-4 text-orange-500 shrink-0"></i>
            <span id="themeLabel" class="sidebar-label whitespace-nowrap">Chalk Light Mode</span>
          </span>
          <span class="sidebar-label text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-100 dark:bg-[#0D1117] text-slate-500 border border-slate-200 dark:border-[#30363D]">THEME</span>
        </button>

        <!-- Kunal Rai & Batch Info Pill -->
        <div class="flex flex-col gap-1.5 px-2.5 py-2 rounded-xl bg-slate-50 dark:bg-[#0D1117]/80 border border-slate-200/80 dark:border-[#30363D] hover:border-orange-500/40 transition-colors">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2 overflow-hidden">
              <div class="w-7 h-7 rounded-full bg-gradient-to-tr from-orange-500 to-sky-400 flex items-center justify-center text-white font-bold text-xs shrink-0">
                KR
              </div>
              <div class="sidebar-label flex flex-col leading-tight truncate">
                <span class="text-xs font-semibold text-slate-800 dark:text-slate-100 truncate">Kunal Rai • Mentor</span>
                <span class="text-[10px] text-slate-500 dark:text-slate-400 truncate">boardwallah.space</span>
              </div>
            </div>
            <span class="sidebar-label px-1.5 py-0.5 text-[9px] font-bold rounded-md bg-orange-500/15 text-orange-600 dark:text-orange-400 border border-orange-500/30">CBSE 10</span>
          </div>
          <div class="sidebar-label text-[10px] text-slate-500 dark:text-slate-400 pt-1 border-t border-slate-200/60 dark:border-slate-800 leading-snug flex items-center justify-between">
            <span>Online or Gaur City 2 • <span class="font-mono text-orange-500">16–20h</span></span>
            <a href={waHeroLink} target="_blank" rel="noopener noreferrer" class="text-emerald-500 hover:underline font-medium text-[10px]">Chat 💬</a>
          </div>
        </div>
      </div>
    </aside>

    <!-- =====================================================================
         ZONE 2: CENTER SOCRATIC DOUBT & STUDY STREAM
    ====================================================================== -->
    <div class="flex-1 flex flex-col h-full min-w-0 relative bg-[#F8FAFC] dark:bg-[#0D1117]" role="region" aria-label="CBSE Socratic Study Stream">
      
      <!-- Top Utility Bar: Active Subject/Chapter Badge + 3 Response Mode Pills + Study Drawer Toggle -->
      <header class="min-h-14 px-3 sm:px-6 py-2 flex flex-wrap items-center justify-between gap-2 border-b border-[#E2E8F0]/70 dark:border-[#30363D]/70 bg-[#F8FAFC]/85 dark:bg-[#0D1117]/85 backdrop-blur-md z-20 shrink-0">
        <div class="flex items-center gap-2 min-w-0">
          <!-- Mobile Menu Button -->
          <button onclick="toggleMobileSidebar(true)" class="md:hidden p-2 -ml-1 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-200/60 dark:hover:bg-[#21262D]">
            <i data-lucide="menu" class="w-5 h-5"></i>
          </button>

          <!-- Desktop Sidebar Expand Toggle (visible when sidebar is collapsed) -->
          <button id="desktopSidebarExpandBtn" onclick="toggleSidebarCollapse()" title="Expand Syllabus Rail" class="hidden md:inline-flex hidden p-2 -ml-1 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-200/60 dark:hover:bg-[#21262D]">
            <i data-lucide="panel-left-open" class="w-4 h-4"></i>
          </button>

          <!-- Active Subject & Chapter Pill -->
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white dark:bg-[#161B22] border border-slate-200 dark:border-[#30363D] truncate shadow-xs">
            <span class="w-2 h-2 rounded-full bg-orange-500 shrink-0"></span>
            <span id="activeSubjectLabel" class="font-semibold text-xs sm:text-sm text-slate-900 dark:text-white truncate">CBSE Board 2026</span>
            <span class="text-slate-300 dark:text-slate-600">•</span>
            <span id="activeChapterLabel" class="text-xs text-slate-600 dark:text-slate-300 truncate max-w-[140px] sm:max-w-[260px]">Official Date Sheet &amp; Timetable</span>
          </div>
        </div>

        <!-- 3 Response Mode Pills + Study Drawer Toggle -->
        <div class="flex items-center gap-1.5 flex-wrap">
          <div class="flex items-center p-0.5 rounded-xl bg-slate-200/70 dark:bg-[#161B22] border border-slate-300/60 dark:border-[#30363D]" role="group" aria-label="Response Mode">
            <button onclick="setResponseMode('hint', this)" id="mode-hint" class="resp-mode-btn active px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-orange-500 text-white shadow-xs transition-all">
              💡 Socratic Hint
            </button>
            <button onclick="setResponseMode('solution', this)" id="mode-solution" class="resp-mode-btn px-2.5 py-1 rounded-lg text-[11px] font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all">
              📝 CBSE Model Solution
            </button>
            <button onclick="setResponseMode('check', this)" id="mode-check" class="resp-mode-btn px-2.5 py-1 rounded-lg text-[11px] font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all">
              🔍 Check My Steps
            </button>
          </div>

          <button onclick="toggleStudyDrawer()" id="studyDrawerToggleBtn" title="Toggle Board Study Drawer" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-[#161B22] hover:bg-slate-100 dark:hover:bg-[#21262D] text-slate-800 dark:text-slate-100 border border-slate-200 dark:border-[#30363D] transition-all shadow-xs">
            <i data-lucide="clipboard-check" class="w-3.5 h-3.5 text-orange-500"></i>
            <span class="hidden sm:inline">Study Drawer</span>
          </button>
        </div>
      </header>

      <!-- Scrollable Doubt & Lesson Viewport -->
      <div id="chatScrollArea" class="flex-1 overflow-y-auto px-4 sm:px-6 py-6 scroll-smooth">
        <div class="max-w-[820px] mx-auto w-full flex flex-col">
          
          <!-- ZERO-STATE GREETING (Gemini-style clean hero + 4 CBSE Class 10 starter cards) -->
          <div id="zeroState" class="py-5 sm:py-10 flex flex-col justify-center">
            <div class="mb-7">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bw-spark-ring text-xs font-medium text-orange-600 dark:text-orange-300 mb-3.5">
                <i data-lucide="graduation-cap" class="w-3.5 h-3.5 text-orange-500"></i>
                <span>10Boardwallah • NCERT &amp; CBSE Marking Scheme Aligned</span>
              </div>
              <h1 class="text-2xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-white leading-tight">
                Namaste, Board Aspirant.<br />
                <span class="bw-gradient-text">Master Class 10 concepts step by step.</span>
              </h1>
              <p class="text-sm text-slate-500 dark:text-slate-400 mt-2.5 max-w-2xl leading-relaxed">
                Ask a NCERT or PYQ doubt with Kunal Rai's CBSE marking-scheme rubrics, get Socratic hints before peeking at the solution, or paste your steps to spot marks leaks.
              </p>
            </div>

            <!-- 4 CBSE Class 10 Starter Cards (2x2 Grid) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <button onclick="triggerStarterCard('datesheet')" class="group text-left p-4 rounded-2xl bg-white dark:bg-[#161B22] hover:bg-slate-50 dark:hover:bg-[#21262D] border border-slate-200 dark:border-[#30363D] hover:border-orange-500/50 transition-all shadow-xs flex flex-col justify-between min-h-[118px]">
                <div class="flex items-center justify-between w-full mb-2">
                  <span class="text-xs font-semibold text-slate-800 dark:text-slate-100 group-hover:text-orange-500 transition-colors">CBSE 2026 Board Exam Dates</span>
                  <div class="w-7 h-7 rounded-lg bg-orange-500/10 text-orange-500 flex items-center justify-center">
                    <i data-lucide="calendar-days" class="w-4 h-4"></i>
                  </div>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                  Official timetable (10:30 AM – 1:30 PM): Maths 17 Feb, English 21 Feb, Science 25 Feb, IT 27 Feb, Hindi 02 Mar, SST 07 Mar.
                </p>
              </button>

