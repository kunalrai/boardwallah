        keyTerms: ['Free 60-Min Trial', 'Gaur City 2 Hub', 'Online 1-on-1', '20 Yrs Experience']
      };
    }

    // 5. Maths proofs (√5, BPT, etc.)
    if (lower.includes('√') || lower.includes('irrational') || lower.includes('root 5') || lower.includes('root 3')) {
      return {
        answer: THREADS.irrational.botResponse,
        keyTerms: ['Proof by Contradiction', 'Co-prime Integers', 'Theorem 1.3 Divisibility']
      };
    }

    if (lower.includes('bpt') || lower.includes('thales') || lower.includes('triangle') || lower.includes('circle') || lower.includes('tangent')) {
      return {
        answer: THREADS.maths.botResponse,
        keyTerms: ['Basic Proportionality Theorem', 'Tangents from External Point', 'Theorem 10.2']
      };
    }

    // 6. Science
    if (lower.includes('ohm') || lower.includes('resistor') || lower.includes('current') || lower.includes('electric') || lower.includes('resistance')) {
      return {
        answer: THREADS.electricity.botResponse,
        keyTerms: ['Ohm’s Law V = IR', 'Series Rs = R1+R2+R3', 'Parallel 1/Rp = 1/R1+1/R2']
      };
