          });
        }
      });
    });

    // Wire dark card download snippet buttons
    row.querySelectorAll('.dark-download-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const card = e.target.closest('.gemini-dark-card');
        const code = card ? card.querySelector('code') : null;
        if (code) {
          const blob = new Blob([code.innerText], { type: 'text/plain;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `cbse-formula-step-${Date.now()}.txt`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
          showToast('Formula snippet downloaded!');
        }
      });
    });

    // Wire mathematical diagram replay animation buttons
    row.querySelectorAll('.diagram-replay-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const card = e.target.closest('.math-diagram-card');
        const canvas = card ? card.querySelector('.math-diagram-canvas') : null;
        if (canvas) {
          canvas.classList.remove('animated-diagram');
          void canvas.offsetWidth; // force browser reflow to re-trigger keyframe animations
          canvas.classList.add('animated-diagram');
          showToast('Replaying math construction animation 📐');
        }
      });
    });

    // Wire mathematical SVG diagram download buttons
    row.querySelectorAll('.diagram-download-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const card = e.target.closest('.math-diagram-card');
        const svgEl = card ? card.querySelector('.math-diagram-canvas svg') : null;
        if (svgEl) {
          const svgContent = svgEl.outerHTML;
          const blob = new Blob([svgContent], { type: 'image/svg+xml;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `cbse-math-diagram-${Date.now()}.svg`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
          showToast('Downloaded CBSE Math Diagram SVG!');
        }
      });
    });

    activeMessagesFeed.appendChild(row);
    scrollToBottom();
  }

