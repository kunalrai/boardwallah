    let state = {
      sidebarCollapsed: false,
      currentSubject: 'Mathematics',
      currentChapter: CBSE_SYLLABUS['Mathematics'][0],
      responseMode: 'hint', // 'hint' | 'solution' | 'check'
      isStreaming: false,
      streamTimer: null,
      flashcardIndex: 0,
      flashcardFlipped: false,
      mockSecondsRemaining: 3 * 3600, // 03:00:00
      mockInterval: null,
      activeRubric: STARTER_PACKS.irrational
    };

    function initIcons() {
      if (window.lucide && typeof window.lucide.createIcons === 'function') {
        window.lucide.createIcons();
      }
    }

    window.addEventListener('DOMContentLoaded', () => {
      populateChaptersForSubject(state.currentSubject);
      renderRubric(STARTER_PACKS.irrational);
      renderFlashcard();
      updateMockTimerDisplay();
      initIcons();

      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          resetToNewSession();
        }
        if (e.key === 'Escape') {
          const slashMenu = document.getElementById('slashMenu');
          if (slashMenu) slashMenu.classList.add('hidden');
        }
      });
    });

    // =====================================================================
    // SUBJECT, CHAPTER & RESPONSE MODE CONTROLS
    // =====================================================================
    function selectSubject(subjectName, btnEl) {
      state.currentSubject = subjectName;
      document.querySelectorAll('.subject-btn').forEach((b) => {
        b.className = 'subject-btn flex items-center justify-between px-2.5 py-2 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-[#21262D] border border-transparent transition-all';
      });
      if (btnEl) {
        btnEl.className = 'subject-btn active flex items-center justify-between px-2.5 py-2 rounded-xl text-xs font-medium bg-orange-500/10 text-orange-600 dark:text-orange-400 border border-orange-500/20 transition-all';
      }
      populateChaptersForSubject(subjectName);
      toggleMobileSidebar(false);
    }

    function populateChaptersForSubject(subjectName) {
      const chapters = CBSE_SYLLABUS[subjectName] || [];
      const select = document.getElementById('chapterSelect');
      const countBadge = document.getElementById('chapterCountBadge');
      if (countBadge) countBadge.textContent = `${chapters.length} Chapters`;

      if (select) {
        select.innerHTML = chapters
          .map((ch) => `<option value="${escapeHtml(ch)}">${escapeHtml(ch)}</option>`)
          .join('');
      }

      state.currentChapter = chapters[0] || '';
      updateActiveContextBadge();
    }

    function handleChapterChange(chapterVal) {
      state.currentChapter = chapterVal;
      updateActiveContextBadge();
      showToast(`Selected: ${chapterVal}`);
    }

    function updateActiveContextBadge() {
      const subjEl = document.getElementById('activeSubjectLabel');
      const chapEl = document.getElementById('activeChapterLabel');
      if (subjEl) subjEl.textContent = state.currentSubject;
      if (chapEl) chapEl.textContent = state.currentChapter;
    }

    function setResponseMode(mode, btnEl) {
      state.responseMode = mode;
      document.querySelectorAll('.resp-mode-btn').forEach((b) => {
        b.className = 'resp-mode-btn px-2.5 py-1 rounded-lg text-[11px] font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all';
      });
      if (btnEl) {
        btnEl.className = 'resp-mode-btn active px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-orange-500 text-white shadow-xs transition-all';
      }
      if (mode === 'check') {
        toggleStudentAttemptBox(true);
      }
    }

    function toggleStudentAttemptBox(forceOpen) {
      const box = document.getElementById('studentAttemptBox');
      if (!box) return;
      const open = typeof forceOpen === 'boolean' ? forceOpen : box.classList.contains('hidden');
      box.classList.toggle('hidden', !open);
      if (open) {
        const inp = document.getElementById('studentAttemptInput');
        if (inp) inp.focus();
      }
    }

    // =====================================================================
    // STARTER CARDS, SAMPLE CHIPS & CONVERSATION STREAM
    // =====================================================================
    function triggerStarterCard(packKey) {
      const pack = STARTER_PACKS[packKey];
      if (!pack) return;
      state.currentSubject = pack.subject;
      state.currentChapter = pack.chapter;
      updateActiveContextBadge();
      renderRubric(pack);

      if (packKey === 'mockdrill') {
        openStudyDrawerTab('mock');
      }

      if (packKey === 'checksteps') {
        setResponseMode('check', document.getElementById('mode-check'));
        toggleStudentAttemptBox(true);
        const attemptInput = document.getElementById('studentAttemptInput');
        if (attemptInput) {
          attemptInput.value = 'Let √5 = p/q (co-prime). 5q² = p² ⇒ 5 divides p. Put p = 5m ⇒ 25m² = 5q² ⇒ 5 divides q.';
        }
      }

      submitDoubt(pack.question, pack);
    }

    function useSampleChip(sampleText) {
      const input = document.getElementById('promptInput');
      if (!input) return;
      input.value = sampleText;
      handlePromptInput(input);
      input.focus();
    }

    function insertSampleHindiDoubt() {
      selectSubject('Hindi Course A', document.querySelector('[data-subject="Hindi Course A"]'));
      const input = document.getElementById('promptInput');
      if (!input) return;
      input.value = '‘नेताजी का चश्मा’ पाठ में कैप्टन की देशभक्ति को स्पष्ट कीजिए (3 अंक)।';
      handlePromptInput(input);
    }

    function handlePromptInput(textarea) {
      textarea.style.height = 'auto';
      textarea.style.height = Math.min(textarea.scrollHeight, 176) + 'px';
      updateSendButtonState();

      const val = textarea.value;
      if (val === '/' || (val.endsWith(' /') && val.length < 30)) {
        toggleSlashMenu(true);
      } else if (!val.startsWith('/')) {
        toggleSlashMenu(false);
      }
    }

    function handlePromptKeydown(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        const sendBtn = document.getElementById('sendBtn');
        if (sendBtn && !sendBtn.disabled) {
          handleSendOrStop();
        }
      }
    }

    function updateSendButtonState() {
      const input = document.getElementById('promptInput');
      const btn = document.getElementById('sendBtn');
      if (btn && input) {
        btn.disabled = !state.isStreaming && input.value.trim().length === 0;
      }
    }

    function toggleSlashMenu(forceOpen) {
      const menu = document.getElementById('slashMenu');
      if (!menu) return;
      const open = typeof forceOpen === 'boolean' ? forceOpen : menu.classList.contains('hidden');
      menu.classList.toggle('hidden', !open);
    }

    function insertSlashCommand(cmd) {
      const input = document.getElementById('promptInput');
      if (!input) return;
      input.value = cmd + input.value.replace(/^\/\w+\s*/, '');
      input.focus();
      toggleSlashMenu(false);
      updateSendButtonState();

      if (cmd.startsWith('/hint')) setResponseMode('hint', document.getElementById('mode-hint'));
      else if (cmd.startsWith('/solution')) setResponseMode('solution', document.getElementById('mode-solution'));
      else if (cmd.startsWith('/check')) {
        setResponseMode('check', document.getElementById('mode-check'));
        toggleStudentAttemptBox(true);
      }
    }

    async function handleSendOrStop() {
      if (state.isStreaming) {
        stopStreaming();
        return;
      }
      const input = document.getElementById('promptInput');
      if (!input) return;
      let raw = input.value.trim();
      if (!raw) return;

      if (raw.startsWith('/hint ')) {
        setResponseMode('hint', document.getElementById('mode-hint'));
        raw = raw.slice(6).trim();
      } else if (raw.startsWith('/solution ')) {
        setResponseMode('solution', document.getElementById('mode-solution'));
        raw = raw.slice(10).trim();
      } else if (raw.startsWith('/check ')) {
        setResponseMode('check', document.getElementById('mode-check'));
        raw = raw.slice(7).trim();
      } else if (raw.startsWith('/pyq ')) {
        raw = `CBSE PYQ Practice: ${raw.slice(5).trim()}`;
      }

      const attemptInput = document.getElementById('studentAttemptInput');
      const attemptText = attemptInput ? attemptInput.value.trim() : '';
      input.value = '';
      input.style.height = 'auto';
      toggleSlashMenu(false);

      // Select matching starter pack or dynamic subject pack
      let pack = STARTER_PACKS.irrational;
      const lower = raw.toLowerCase();
      if (lower.includes('hcl') || lower.includes('litmus') || lower.includes('chemical') || lower.includes('science') || state.currentSubject === 'Science') {
        pack = { ...STARTER_PACKS.chemical, subject: state.currentSubject, chapter: state.currentChapter, question: raw };
      } else if (lower.includes('germany') || lower.includes('social') || state.currentSubject === 'Social Science') {
        pack = { ...STARTER_PACKS.mockdrill, subject: state.currentSubject, chapter: state.currentChapter, question: raw };
      } else if (lower.includes('quadratic') || lower.includes('attempt') || attemptText) {
        pack = { ...STARTER_PACKS.checksteps, subject: state.currentSubject, chapter: state.currentChapter, question: raw };
      } else {
        pack = { ...STARTER_PACKS.irrational, subject: state.currentSubject, chapter: state.currentChapter, question: raw };
      }

      submitDoubt(raw, pack, attemptText);
    }

    async function submitDoubt(questionText, pack, attemptText = '') {
      const zeroState = document.getElementById('zeroState');
      if (zeroState) zeroState.classList.add('hidden');
      const thread = document.getElementById('messageThread');
      if (thread) {
        thread.classList.remove('hidden');
        thread.classList.add('flex');
      }

      appendStudentMessage(questionText, attemptText);
      startStreamingState();

      // Attempt live API if available, else render high-yield CBSE model response
      let liveResponseRendered = false;
      try {
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 3500);
        const resp = await fetch('/api/v1/ai/doubt-tutor', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            question: questionText + (attemptText ? `\n\nStudent Working: ${attemptText}` : ''),
            mode: state.responseMode,
            subject: state.currentSubject,
            chapter: state.currentChapter
          }),
          signal: controller.signal
        });
        clearTimeout(timeout);
        if (resp.ok) {
          const data = await resp.json();
          if (data && data.answer) {
            appendTutorResponse({
              ...pack,
              hintBody: data.answer,
              solutionBody: data.answer,
              checkBody: data.answer
            }, attemptText);
            renderRubric(pack);
            stopStreaming();
            liveResponseRendered = true;
          }
        }
      } catch (err) {
        // Fall back to immediate CBSE starter pack
      }

      if (!liveResponseRendered) {
        state.streamTimer = setTimeout(() => {
          appendTutorResponse(pack, attemptText);
          renderRubric(pack);
          stopStreaming();
        }, 700);
      }
    }

    function startStreamingState() {
      state.isStreaming = true;
      const btn = document.getElementById('sendBtn');
      const icon = document.getElementById('sendBtnIcon');
      if (btn) {
        btn.disabled = false;
        btn.classList.replace('bg-orange-500', 'bg-rose-500');
      }
      if (icon) {
        icon.setAttribute('data-lucide', 'square');
      }
      initIcons();

      const thread = document.getElementById('messageThread');
      if (thread) {
        const loader = document.createElement('div');
        loader.id = 'streamingLoader';
        loader.className = 'flex items-center gap-3 text-xs text-slate-500 dark:text-slate-400 py-2';
        loader.innerHTML = `
          <div class="w-7 h-7 rounded-xl bw-spark-ring flex items-center justify-center animate-spark shrink-0">
            <span class="font-mono font-bold text-[10px] text-orange-500">10B</span>
          </div>
          <span class="font-mono">10Boardwallah is checking CBSE marking scheme...</span>
        `;
        thread.appendChild(loader);
        scrollChatToBottom();
      }
    }

    function stopStreaming() {
      state.isStreaming = false;
      clearTimeout(state.streamTimer);
      const loader = document.getElementById('streamingLoader');
      if (loader) loader.remove();

      const btn = document.getElementById('sendBtn');
      const icon = document.getElementById('sendBtnIcon');
      if (btn) {
        btn.classList.replace('bg-rose-500', 'bg-orange-500');
      }
      if (icon) {
        icon.setAttribute('data-lucide', 'arrow-up');
      }
      updateSendButtonState();
      initIcons();
    }

    function appendStudentMessage(questionText, attemptText) {
      const thread = document.getElementById('messageThread');
      if (!thread) return;
      const el = document.createElement('div');
      el.className = 'flex justify-end';
      const attemptHtml = attemptText
        ? `<div class="mt-2 pt-2 border-t border-slate-200 dark:border-slate-700 text-xs font-mono text-sky-600 dark:text-sky-400 whitespace-pre-wrap">My Steps: ${escapeHtml(attemptText)}</div>`
        : '';
      el.innerHTML = `
        <div class="max-w-[85%] sm:max-w-[75%] rounded-2xl rounded-tr-sm px-4 py-3 bg-white dark:bg-[#161B22] border border-slate-200 dark:border-[#30363D] text-sm text-slate-800 dark:text-slate-100 shadow-xs leading-relaxed">
          <div class="text-[10px] font-mono text-orange-500 mb-1">${escapeHtml(state.currentSubject)} • ${escapeHtml(state.currentChapter)}</div>
          <div>${escapeHtml(questionText)}</div>
          ${attemptHtml}
        </div>
      `;
      thread.appendChild(el);
      scrollChatToBottom();
    }

    function appendTutorResponse(pack, attemptText) {
      const thread = document.getElementById('messageThread');
      if (!thread) return;
      const el = document.createElement('div');
      el.className = 'flex items-start gap-3.5';

      let bodyMarkdown = pack.hintBody;
      let modeBadge = '💡 SOCRATIC HINT';
      if (state.responseMode === 'solution') {
        bodyMarkdown = pack.solutionBody;
        modeBadge = '📝 CBSE MODEL SOLUTION';
      } else if (state.responseMode === 'check') {
        bodyMarkdown = pack.checkBody + (attemptText ? `\n\n**Audited Student Attempt:** \`${attemptText}\`` : '');
        modeBadge = '🔍 STEP AUDIT';
      }

      const rubricChipsHtml = (pack.rubricSteps || [])
        .map((r) => `<span class="px-2 py-1 rounded-lg bg-slate-100 dark:bg-[#0D1117] border border-slate-200 dark:border-[#30363D] text-[11px] font-mono"><strong class="text-orange-500">${escapeHtml(r.mark)}</strong> ${escapeHtml(r.title)}</span>`)
        .join('');

      el.innerHTML = `
        <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-orange-500 to-sky-400 p-[1.5px] shrink-0 mt-0.5 shadow-xs">
          <div class="w-full h-full rounded-[10px] bg-white dark:bg-[#0D1117] flex items-center justify-center font-mono font-bold text-[10px]">
            <span class="text-orange-500">10</span><span class="text-slate-900 dark:text-white">B</span>
          </div>
        </div>

        <div class="flex-1 min-w-0 space-y-3">
          <div class="rounded-2xl border border-slate-200 dark:border-[#30363D] bg-white dark:bg-[#161B22] p-4 shadow-xs space-y-3">
            <div class="flex items-center justify-between gap-2 pb-2 border-b border-slate-100 dark:border-slate-800">
              <span class="px-2 py-0.5 text-[10px] font-mono font-bold rounded bg-orange-500/15 text-orange-600 dark:text-orange-400">${modeBadge}</span>
              <span class="text-[11px] font-mono text-slate-400">${escapeHtml(pack.marks || '3 MARKS')} • CBSE Class 10</span>
            </div>

            <div class="text-sm text-slate-700 dark:text-slate-200 leading-relaxed space-y-2">
              ${formatBoardMarkdown(bodyMarkdown)}
            </div>

            <!-- Step-Wise Marks Summary Strip -->
            <div class="pt-2 border-t border-slate-100 dark:border-slate-800">
              <div class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Step-Wise Marking Allocation</div>
              <div class="flex flex-wrap gap-1.5">${rubricChipsHtml}</div>
            </div>

            <div class="pt-2 flex flex-wrap items-center gap-2">
              <button onclick="openStudyDrawerTab('rubric')" class="px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-orange-500/10 text-orange-600 dark:text-orange-400 hover:bg-orange-500/20 transition-colors">
                Open Full Marking Rubric →
              </button>
              <button onclick="openStudyDrawerTab('flashcards')" class="px-2.5 py-1 rounded-lg text-[11px] font-medium bg-slate-100 dark:bg-[#21262D] text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-[#2b323b] transition-colors">
                Practice Flashcards
              </button>
            </div>
          </div>
        </div>
      `;

      thread.appendChild(el);
      initIcons();
      scrollChatToBottom();
    }

    function resetToNewSession(e) {
      if (e) e.preventDefault();
      stopStreaming();
      const zero = document.getElementById('zeroState');
      if (zero) zero.classList.remove('hidden');
      const thread = document.getElementById('messageThread');
      if (thread) {
        thread.classList.add('hidden');
        thread.innerHTML = '';
      }
      const pInput = document.getElementById('promptInput');
      if (pInput) pInput.value = '';
      const sInput = document.getElementById('studentAttemptInput');
      if (sInput) sInput.value = '';
      updateSendButtonState();
      toggleMobileSidebar(false);
    }

    // =====================================================================
    // RIGHT STUDY DRAWER: RUBRIC, 80 FLASHCARDS & 80-MARK MOCK TIMER
    // =====================================================================
    function toggleStudyDrawer(forceOpen) {
      const drawer = document.getElementById('studyDrawer');
      if (!drawer) return;
      const shouldOpen = typeof forceOpen === 'boolean' ? forceOpen : drawer.classList.contains('hidden');
      drawer.classList.toggle('hidden', !shouldOpen);
      drawer.classList.toggle('flex', shouldOpen);
    }

    function openStudyDrawerTab(tabName) {
      toggleStudyDrawer(true);
      switchStudyTab(tabName);
      toggleMobileSidebar(false);
    }

    function switchStudyTab(tabName) {
      ['rubric', 'flashcards', 'mock'].forEach((t) => {
        const btn = document.getElementById(`tab-${t}`);
        const panel = document.getElementById(`panel-${t}`);
        if (!btn || !panel) return;
        if (t === tabName) {
          btn.className = 'study-tab px-3 py-2 text-xs font-semibold border-b-2 border-orange-500 text-orange-600 dark:text-orange-400 whitespace-nowrap transition-colors';
          panel.classList.remove('hidden');
        } else {
          btn.className = 'study-tab px-3 py-2 text-xs font-medium border-b-2 border-transparent text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200 whitespace-nowrap transition-colors';
          panel.classList.add('hidden');
        }
      });
    }

    function renderRubric(pack) {
      state.activeRubric = pack;
      const subPill = document.getElementById('rubricSubjectPill');
      const chapPill = document.getElementById('rubricChapterPill');
      const qTitle = document.getElementById('rubricQuestionTitle');
      const tip = document.getElementById('rubricExamTip');
      if (subPill) subPill.textContent = `${(pack.subject || '').toUpperCase()} • ${pack.marks || '3 MARKS'}`;
      if (chapPill) chapPill.textContent = pack.chapter || '';
      if (qTitle) qTitle.textContent = pack.question || '';
      if (tip) tip.textContent = pack.examTip || '';

      const list = document.getElementById('rubricStepsList');
      if (list && pack.rubricSteps) {
        list.innerHTML = pack.rubricSteps
          .map((step) => `
            <div class="p-3.5 rounded-xl bg-white dark:bg-[#161B22] border border-slate-200 dark:border-[#30363D] flex items-start gap-3">
              <span class="px-2 py-1 rounded-lg font-mono text-xs font-bold bg-orange-500/15 text-orange-600 dark:text-orange-400 shrink-0">${escapeHtml(step.mark)}</span>
              <div>
                <div class="text-xs font-bold text-slate-900 dark:text-white">${escapeHtml(step.title)}</div>
                <p class="text-xs text-slate-600 dark:text-slate-400 mt-0.5 leading-relaxed">${escapeHtml(step.desc)}</p>
              </div>
            </div>
          `)
          .join('');
      }
    }

    // Flashcards Logic
    function renderFlashcard() {
      const card = FLASHCARDS[state.flashcardIndex];
      if (!card) return;
      const sBadge = document.getElementById('fcSubjectBadge');
      const fText = document.getElementById('fcFrontText');
      const bText = document.getElementById('fcBackText');
      const counter = document.getElementById('flashcardCounter');
      if (sBadge) sBadge.textContent = card.subject;
      if (fText) fText.textContent = card.front;
      if (bText) bText.innerHTML = card.back;
      if (counter) counter.textContent = `Card ${state.flashcardIndex + 1} of ${FLASHCARDS.length} (80-Card CBSE Deck)`;

      const box = document.getElementById('flashcardBox');
      if (box) {
        state.flashcardFlipped = false;
        box.classList.remove('is-flipped');
      }
    }

    function flipCurrentFlashcard() {
      state.flashcardFlipped = !state.flashcardFlipped;
      const box = document.getElementById('flashcardBox');
      if (box) box.classList.toggle('is-flipped', state.flashcardFlipped);
    }

    function nextFlashcard() {
      state.flashcardIndex = (state.flashcardIndex + 1) % FLASHCARDS.length;
      renderFlashcard();
    }

    function prevFlashcard() {
      state.flashcardIndex = (state.flashcardIndex - 1 + FLASHCARDS.length) % FLASHCARDS.length;
      renderFlashcard();
    }

    // 80-Mark Mock Timer (3 Hours = 10,800s)
    function updateMockTimerDisplay() {
      const total = Math.max(0, state.mockSecondsRemaining);
      const hrs = String(Math.floor(total / 3600)).padStart(2, '0');
      const mins = String(Math.floor((total % 3600) / 60)).padStart(2, '0');
      const secs = String(total % 60).padStart(2, '0');
      const display = document.getElementById('mockTimerDisplay');
      if (display) display.textContent = `${hrs}:${mins}:${secs}`;
    }

    function startMockTimer() {
      if (state.mockInterval) return;
      state.mockInterval = setInterval(() => {
        if (state.mockSecondsRemaining > 0) {
          state.mockSecondsRemaining--;
          updateMockTimerDisplay();
        } else {
          pauseMockTimer();
          showToast('3-Hour CBSE Mock Exam time completed!');
        }
      }, 1000);
      showToast('80-Mark Mock Timer started (3:00:00)');
    }

    function pauseMockTimer() {
      clearInterval(state.mockInterval);
      state.mockInterval = null;
    }

    function resetMockTimer() {
      pauseMockTimer();
      state.mockSecondsRemaining = 3 * 3600;
      updateMockTimerDisplay();
      showToast('Timer reset to 03:00:00');
    }

    // =====================================================================
    // THEME, SIDEBAR & TOAST UTILITIES
    // =====================================================================
    function toggleTheme() {
      const html = document.documentElement;
      const isDark = html.classList.toggle('dark');
      const icon = document.getElementById('themeIcon');
      const label = document.getElementById('themeLabel');
      if (icon) icon.setAttribute('data-lucide', isDark ? 'sun' : 'moon');
      if (label) label.textContent = isDark ? 'Chalk Light Mode' : 'Slate Dark Mode';
      initIcons();
    }

    function toggleSidebarCollapse() {
      const sidebar = document.getElementById('sidebar');
      const expandBtn = document.getElementById('desktopSidebarExpandBtn');
      if (!sidebar) return;
      state.sidebarCollapsed = !state.sidebarCollapsed;
      sidebar.style.width = state.sidebarCollapsed ? '64px' : '260px';
      document.querySelectorAll('.sidebar-label').forEach((el) => {
        el.classList.toggle('hidden', state.sidebarCollapsed);
      });
      if (expandBtn) {
        expandBtn.classList.toggle('hidden', !state.sidebarCollapsed);
      }
    }

    function toggleMobileSidebar(open) {
      const sidebar = document.getElementById('sidebar');
      const backdrop = document.getElementById('mobileBackdrop');
      if (sidebar) sidebar.classList.toggle('-translate-x-full', !open);
      if (backdrop) backdrop.classList.toggle('hidden', !open);
    }

    function showTrialInfoToast() {
      showToast('Kunal Rai • Free 60-Min Trial (Online or Gaur City 2 & VVIP Homes, 16:00–20:00 IST)');
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toastMessage');
      if (!toast || !toastMsg) return;
      toastMsg.textContent = msg;
      toast.classList.remove('hidden');
      toast.classList.add('flex');
      clearTimeout(window._toastTimer);
      window._toastTimer = setTimeout(() => {
        toast.classList.add('hidden');
        toast.classList.remove('flex');
      }, 2800);
    }

    function scrollChatToBottom() {
      const scroller = document.getElementById('chatScrollArea');
      if (scroller) scroller.scrollTop = scroller.scrollHeight;
    }

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
    }

    function formatBoardMarkdown(text) {
      return escapeHtml(text)
        .replace(/\*\*(.*?)\*\*/g, '<strong class="font-semibold text-slate-900 dark:text-white">$1</strong>')
        .replace(/`([^`]+)`/g, '<code class="px-1.5 py-0.5 rounded text-xs font-mono bg-orange-500/10 text-orange-600 dark:text-orange-300">$1</code>')
        .replace(/\n\n/g, '</p><p class="mt-2">')
        .replace(/\n/g, '<br/>');
    }
  </script>

  <style is:global>
    /* Custom Scrollbars & Theme Variables */
    :root {
      --bw-bg-primary: #F8FAFC;
      --bw-bg-secondary: #FFFFFF;
      --bw-bg-tertiary: #F1F5F9;
      --bw-text-primary: #0F172A;
      --bw-text-secondary: #475569;
      --bw-border: #E2E8F0;
      --bw-accent: #EA580C;
      --bw-cyan: #0284C7;
    }

    html.dark {
      --bw-bg-primary: #0D1117;
      --bw-bg-secondary: #161B22;
      --bw-bg-tertiary: #21262D;
      --bw-text-primary: #F0F6FC;
      --bw-text-secondary: #8B949E;
      --bw-border: #30363D;
      --bw-accent: #F97316;
      --bw-cyan: #38BDF8;
    }

    body {
      background-color: var(--bw-bg-primary);
      color: var(--bw-text-primary);
      font-family: 'Plus Jakarta Sans', sans-serif;
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    /* Reset button styling to prevent global.css theme bleed */
    button {
      background-color: transparent;
      color: inherit;
      font: inherit;
      min-height: 0;
      padding: 0;
      border: 0;
      text-decoration: none;
    }

    code, pre, .font-mono {
      font-family: 'JetBrains Mono', monospace;
      font-variant-ligatures: contextual;
    }

    /* Subtle custom scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(139, 148, 158, 0.25);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(139, 148, 158, 0.45);
    }

    /* Brand Gradient Text & Ring */
    .bw-gradient-text {
      background: linear-gradient(135deg, #F97316 0%, #38BDF8 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .bw-spark-ring {
      background: linear-gradient(135deg, rgba(249, 115, 22, 0.2), rgba(56, 189, 248, 0.2));
      border: 1px solid rgba(249, 115, 22, 0.35);
    }

    @keyframes pulseGlow {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.65; transform: scale(0.95); }
    }
    .animate-spark {
      animation: pulseGlow 1.8s infinite ease-in-out;
    }

    /* Flashcard 3D flip support */
    .perspective-1000 { perspective: 1000px; }
    .preserve-3d { transform-style: preserve-3d; transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1); }
    .backface-hidden { backface-visibility: hidden; }
    .rotate-y-180 { transform: rotateY(180deg); }
    .is-flipped .preserve-3d { transform: rotateY(180deg); }
  </style>
</Layout>
