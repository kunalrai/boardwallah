---
import Layout from "../layouts/Layout.astro";
import { loadContent, whatsappLink } from "../lib/content";
import { calBookingUrl, apiBase } from "../lib/site";
import { firebaseConfig } from "../lib/firebase";

const { provider } = loadContent();
const waChatLink = whatsappLink(
  provider.contact.whatsapp,
  `Hello ${provider.tutor_name}, I am using the BoardWallah AI Tutor and would like to ask about 1-on-1 tuition.`
);

const chatSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "BoardWallah AI Doubt Tutor",
  "description": "Free 24/7 AI CBSE Class 10 Doubt Solver and Socratic Tutor powered by Gemini 2.5 Flash. Instant hints, step-by-step model answers, and proof checking for Maths, Science, and Social Science.",
  "applicationCategory": "EducationalApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "INR"
  }
};
---

<Layout
  title="Ask Boardwallah | CBSE Class 10 AI Doubt Solver & Socratic Tutor"
  description="Ask Boardwallah - Free 24/7 CBSE Class 10 doubt solver powered by Gemini 2.5 Flash for instant Socratic hints and model answers."
  schema={chatSchema}
  isAppLayout={true}
>
  <div class="gemini-app-layout">
    <!-- ── Left Gemini-Style Sidebar ── -->
    <aside class="gemini-sidebar" id="gemini-sidebar" aria-label="Gemini Sidebar Navigation">
      <!-- Top Brand Row -->
      <div class="sidebar-brand-row">
        <button type="button" class="brand-link" id="brand-home-btn" title="BoardWallah Home (New Chat)">
          <!-- Official Multi-Color 4-Pointed Gemini Sparkle Star -->
          <svg class="gemini-star-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 0C12 6.627 6.627 12 0 12C6.627 12 12 17.373 12 24C12 17.373 17.373 12 24 12C17.373 12 12 6.627 12 0Z" fill="url(#gemini-sparkle-grad)"/>
            <defs>
              <linearGradient id="gemini-sparkle-grad" x1="0" y1="0" x2="24" y2="24" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#4285F4"/>
                <stop offset="35%" stop-color="#9B72CB"/>
                <stop offset="70%" stop-color="#D96570"/>
                <stop offset="100%" stop-color="#10B981"/>
              </linearGradient>
            </defs>
          </svg>
          <span class="brand-text">Ask Boardwallah</span>
          <span class="brand-tag">AI</span>
        </button>
        <div class="brand-controls">
          <button id="sidebar-search-btn" class="icon-control-btn" type="button" title="Search recent doubts" aria-label="Search doubts">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          </button>
          <button id="sidebar-collapse-btn" class="icon-control-btn desktop-only-control" type="button" title="Collapse sidebar" aria-label="Collapse sidebar">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="3"/><path d="M9 3v18"/></svg>
          </button>
          <button id="sidebar-close-btn" class="icon-control-btn mobile-only-close" type="button" title="Close drawer" aria-label="Close menu">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
      </div>

      <!-- Primary Action Items (Single Page In-App Controls) -->
      <nav class="sidebar-menu-nav" aria-label="Primary Navigation">
        <button id="gemini-new-chat-btn" class="sidebar-nav-item active" type="button" title="Start a fresh CBSE doubt session">
          <span class="nav-item-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
          </span>
          <span class="nav-item-label">New chat</span>
        </button>

        <button id="sidebar-library-btn" class="sidebar-nav-item" type="button" title="Class 10 56 Chapters Library">
          <span class="nav-item-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
          </span>
          <span class="nav-item-label">Library</span>
        </button>

        <button id="sidebar-images-btn" class="sidebar-nav-item" type="button" title="NCERT Science Diagrams &amp; Concept Flashcards">
          <span class="nav-item-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
          </span>
          <span class="nav-item-label">Images</span>
        </button>

        <button id="sidebar-scheduled-btn" class="sidebar-nav-item" type="button" title="1-on-1 Personalized Mentorship">
          <span class="nav-item-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </span>
          <span class="nav-item-label">Scheduled</span>
        </button>

        <button id="sidebar-students-btn" class="sidebar-nav-item" type="button" title="CBSE 80-Mark Mock Paper &amp; Formula Drill">
          <span class="nav-item-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
          </span>
          <span class="nav-item-label">Students</span>
        </button>

        <button id="sidebar-more-btn" class="sidebar-nav-item" type="button" title="CBSE Board 2026 Toolkit &amp; Passing Rubrics">
          <span class="nav-item-icon">⋯</span>
          <span class="nav-item-label">More</span>
        </button>
      </nav>

      <!-- Section: Notebooks (CBSE Class 10 Subject Collections) -->
      <div class="sidebar-section">
        <div class="section-title-row">
          <span class="section-title">Notebooks</span>
        </div>
        <div class="notebooks-list">
          <button class="notebook-item new-notebook-btn" type="button" id="new-notebook-trigger">
            <span class="item-icon">＋</span>
            <span class="item-label">New notebook</span>
          </button>
          <button class="notebook-item topic-preset-btn" data-thread="maths" type="button">
            <span class="item-icon">📄</span>
            <span class="item-label">Mathematics Standard</span>
          </button>
          <button class="notebook-item topic-preset-btn" data-thread="electricity" type="button">
            <span class="item-icon">📄</span>
            <span class="item-label">Electricity &amp; Physics</span>
          </button>
          <button class="notebook-item topic-preset-btn" data-thread="chemistry" type="button">
            <span class="item-icon">📄</span>
            <span class="item-label">Chemical Reactions &amp; Acids</span>
          </button>
          <button class="notebook-item topic-preset-btn" data-thread="sst" type="button">
            <span class="item-icon">📄</span>
            <span class="item-label">Social Science (SST)</span>
          </button>
          <button class="notebook-item" type="button" id="all-notebooks-btn">
            <span class="item-icon">⋯</span>
            <span class="item-label">All notebooks</span>
          </button>
        </div>
      </div>

      <!-- Section: Recent Doubts (Persisted CBSE Doubts History) -->
      <div class="sidebar-section recents-section">
        <div class="section-title-row">
          <span class="section-title">Recent</span>
          <div style="display: flex; gap: 4px; align-items: center;">
            <button id="print-vault-btn" class="filter-icon-btn" title="Print / Export Revision Vault as PDF" aria-label="Print Revision Vault">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="8" x="6" y="14"/></svg>
            </button>
            <button id="filter-recents-btn" class="filter-icon-btn" title="Filter history" aria-label="Filter recents">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
            </button>
          </div>
        </div>
        <div class="recents-list" id="recents-list">
          <button class="recent-item" data-thread="irrational" type="button">
            <span class="recent-text">Prove √5 is irrational</span>
            <span class="pin-icon" title="Pinned">📌</span>
          </button>
          <button class="recent-item" data-thread="electricity" type="button">
            <span class="recent-text">Ohm's Law &amp; Circuit Resistors</span>
            <span class="pin-icon" title="Pinned">📌</span>
          </button>
          <button class="recent-item" data-thread="chemistry" type="button">
            <span class="recent-text">FeSO₄ Heating Decomposition</span>
            <span class="pin-icon" title="Pinned">📌</span>
          </button>
          <button class="recent-item" data-thread="conventions" type="button">
            <span class="recent-text">Ray Diagram Cartesian Signs</span>
            <span class="pin-icon" title="Pinned">📌</span>
          </button>
        </div>
      </div>

      <!-- PWA Install Sidebar Button -->
      <button type="button" class="sidebar-pwa-install-item" id="pwa-install-sidebar-btn" style="display:none;" title="Install Boardwallah App for offline CBSE access">
        <span class="item-icon">📲</span>
        <span class="item-label">Install App</span>
      </button>

      <!-- Bottom Sign In / Student Account Button -->
      <button type="button" class="sidebar-footer-profile" id="sidebar-profile-card" title="Sign in with Google">
        <div class="profile-left">
          <div class="profile-avatar signin-avatar" id="sidebar-avatar">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="profile-info">
            <strong class="profile-name" id="sidebar-user-name">Sign in</strong>
            <span class="profile-badge" id="sidebar-user-status">Student Account</span>
          </div>
        </div>
        <div class="profile-gear-btn" title="Sign in with Google">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" x2="3" y1="12" y2="12"/></svg>
        </div>
      </button>
    </aside>

    <!-- Dark Backdrop for Mobile Sidebar Drawer -->
    <div id="sidebar-backdrop" class="sidebar-backdrop" aria-hidden="true"></div>

    <!-- ── Main Gemini Chat Canvas ── -->
    <main class="gemini-main" id="gemini-main">
      <!-- Minimalist Clean Header Bar -->
      <header class="gemini-header">
        <div class="header-left-col">
          <button id="mobile-toggle-btn" class="mobile-toggle-btn" type="button" aria-label="Open navigation menu">
            <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          </button>
          <div class="header-mobile-brand">
            <svg class="gemini-star-icon" viewBox="0 0 24 24" fill="none" style="width:19px;height:19px;flex-shrink:0;">
              <path d="M12 0C12 6.627 6.627 12 0 12C6.627 12 12 17.373 12 24C12 17.373 17.373 12 24 12C17.373 12 12 6.627 12 0Z" fill="url(#gemini-sparkle-grad-mobile)"/>
              <defs>
                <linearGradient id="gemini-sparkle-grad-mobile" x1="0" y1="0" x2="24" y2="24" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#4285F4"/>
                  <stop offset="35%" stop-color="#9B72CB"/>
                  <stop offset="70%" stop-color="#D96570"/>
                  <stop offset="100%" stop-color="#10B981"/>
                </linearGradient>
              </defs>
            </svg>
            <span class="header-mobile-brand-name">Boardwallah</span>
            <span class="header-mobile-brand-tag">AI</span>
          </div>
          <span class="active-notebook-title" id="active-notebook-title"></span>
        </div>
        <div class="header-right-col">
          <button id="pwa-install-header-btn" class="pwa-install-header-btn" type="button" style="display:none;" title="Install Boardwallah App on this device">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span>Install App</span>
          </button>
          <button id="chat-options-menu-btn" class="dots-menu-btn" type="button" aria-label="Options">
            ⋮
          </button>
        </div>
      </header>

      <!-- Scrollable Conversation Flow -->
      <div class="conversation-viewport" id="conversation-viewport">
        <!-- Centered Message Stream Container -->
        <div class="conversation-stream" id="conversation-stream">
          <!-- Default Clean Welcome Canvas (Visible on initial load / New Chat) -->
          <div class="gemini-welcome-canvas" id="gemini-welcome-canvas">
            <h1 class="welcome-heading">
              <span class="gradient-text">Hello, Class 10 Scholar</span>
              <br/>What concept can we master today?
            </h1>
            <p class="welcome-sub">
              Ask any mathematical proof, science numerical, reaction mechanism, or paste your attempted homework steps for instant CBSE-aligned guidance.
            </p>

            <!-- Starter Prompt Pills -->
            <div class="starter-cards-grid">
              <button class="starter-pill-btn" data-query="Draw a labeled diagram of Heights and Distances for a tower with 30° and 60° angles of elevation.">
                <span class="pill-icon">📐</span>
                <span class="pill-text">Draw Heights &amp; Distances Diagram</span>
              </button>
              <button class="starter-pill-btn" data-query="How do I prove that √5 is irrational by contradiction for CBSE Class 10?">
                <span class="pill-icon">📝</span>
                <span class="pill-text">Prove √5 is irrational (Contradiction)</span>
              </button>
              <button class="starter-pill-btn" data-query="Draw a circle with two tangents from an external point P and prove Theorem 10.2.">
                <span class="pill-icon">⭕</span>
                <span class="pill-text">Draw Circle &amp; Tangents (Theorem 10.2)</span>
              </button>
              <button class="starter-pill-btn" data-query="State Ohm's Law and explain the V-I graph. How do you calculate equivalent resistance in series and parallel?">
                <span class="pill-icon">⚡</span>
                <span class="pill-text">Ohm's Law &amp; Circuit Resistors</span>
              </button>
              <button class="starter-pill-btn" data-query="Give me an official CBSE Class 10 Case-Based Study Question (Section E, 4 Marks) on Science with 3 sub-parts and step-marking scheme.">
                <span class="pill-icon">📊</span>
                <span class="pill-text">CBSE Case-Based Study Drill (Sec E 4M)</span>
              </button>
              <button class="starter-pill-btn" data-query="Explain Cartesian sign conventions for concave and convex mirrors and lenses with formulas.">
                <span class="pill-icon">🔍</span>
                <span class="pill-text">Ray Diagram Cartesian Sign Conventions</span>
              </button>
            </div>
          </div>

          <!-- Active Message Feed (Hidden on default load, populates when user asks or clicks) -->
          <div class="active-messages-feed" id="active-messages-feed" style="display:none;"></div>
        </div>
      </div>

      <!-- ── Bottom Floating Input Capsule ("The Gemini Pill") ── -->
      <div class="capsule-dock-wrap">
        <form class="gemini-capsule-form" id="gemini-chat-form">
          <!-- Image Attachment Preview Bar -->
          <div id="image-preview-bar" class="image-preview-bar" style="display:none;">
            <div class="preview-thumb-box">
              <img id="image-preview-img" src="" alt="Doubt photo preview" />
              <button type="button" id="remove-image-btn" class="remove-preview-btn" title="Remove photo">✕</button>
            </div>
            <span class="preview-info-text">📷 Photo doubt attached — Gemini 2.5 Flash Vision will solve with CBSE step-marking</span>
          </div>

          <div class="capsule-container" id="capsule-container">
            <!-- Left Action Button: Camera / Photo Doubt (+) -->
            <button id="capsule-attach-btn" class="capsule-btn attach-btn" type="button" title="Upload or snap photo of textbook doubt (Camera / Upload)" aria-label="Attach photo">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
            </button>
            <input type="file" id="doubt-image-input" accept="image/*" capture="environment" style="display:none;" />

            <!-- Input Textarea with Gemini placeholder -->
            <textarea
              id="gemini-input-textarea"
              class="capsule-textarea"
              placeholder="Ask Boardwallah or paste your numerical steps..."
              rows="1"
            ></textarea>

            <!-- Right Controls: Auto Dropdown + Mic + Send -->
            <div class="capsule-controls-right">
              <div class="model-select-wrapper">
                <button type="button" id="model-dropdown-trigger" class="model-dropdown-btn">
                  <span id="current-mode-label">Auto</span>
                  <span class="chevron-down">⌵</span>
                </button>
                <div class="model-dropdown-menu" id="model-dropdown-menu" style="display:none;">
                  <button type="button" class="dropdown-item active" data-mode="hint">
                    <strong>Auto / Socratic Hint</strong>
                    <small>Guides you to think and solve</small>
                  </button>
                  <button type="button" class="dropdown-item" data-mode="step_by_step">
                    <strong>CBSE Model Answer</strong>
                    <small>Official board marking scheme</small>
                  </button>
                  <button type="button" class="dropdown-item" data-mode="find_mistake">
                    <strong>Check My Steps</strong>
                    <small>Spot calculation &amp; proof errors</small>
                  </button>
                </div>
              </div>

              <!-- Microphone Voice Input Button -->
              <button id="mic-voice-btn" class="capsule-btn mic-btn" type="button" title="Speak your doubt" aria-label="Voice input">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
              </button>

              <!-- Send Arrow Button -->
              <button id="gemini-send-btn" class="capsule-btn send-btn" type="submit" aria-label="Send message">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
              </button>
            </div>
          </div>

          <!-- Bottom Micro Disclaimer -->
          <div class="capsule-disclaimer">
            <span>Ask Boardwallah is powered by Gemini 2.5 Flash. Verify with official NCERT textbooks &amp; CBSE marking rubrics.</span>
          </div>
        </form>
      </div>
    </main>
  </div>

  <!-- 1-on-1 Mentor Modal Popover -->
  <dialog id="mentor-modal" class="mentor-dialog">
    <div class="mentor-dialog-content card">
      <div class="dialog-header">
        <h3>1-on-1 Personalized Mentorship</h3>
        <button id="close-mentor-modal-btn" class="close-dialog-btn" type="button">✕</button>
      </div>
      <p class="dialog-desc">
        Need personalized coaching for Class 10 Maths &amp; Science? Learn directly from <strong>Kunal Rai</strong> (20 yrs experience, B.Tech, ex-Samsung/HCL).
      </p>
      <ul class="dialog-perks">
        <li>✓ 1-on-1 home visits in Gaur City 2, VVIP Homes &amp; Noida Extension</li>
        <li>✓ Live interactive online classes with digital whiteboard notes</li>
        <li>✓ 100% individual attention — zero hesitation to ask doubts</li>
      </ul>
      <div class="dialog-actions">
        <button type="button" class="button" id="in-modal-book-btn">Schedule Free 60-Min Trial</button>
        <button type="button" class="button secondary" id="in-modal-whatsapp-btn">💬 Chat with Kunal Rai</button>
      </div>
    </div>
  </dialog>

  <!-- 1. CBSE Class 10 Chapter Library Modal (56 Chapters) -->
  <dialog id="library-modal" class="mentor-dialog" style="max-width: 680px; width: 95vw;">
    <div class="mentor-dialog-content card" style="max-width: 680px; max-height: 85vh; display: flex; flex-direction: column; overflow: hidden; padding: 1.25rem;">
      <div class="dialog-header" style="margin-bottom: 0.75rem;">
        <div>
          <h3 style="margin: 0; font-size: 1.15rem;">Class 10 CBSE Chapter Library</h3>
          <p style="margin: 0.2rem 0 0; font-size: 0.8rem; color: #5f6368;">Select any chapter to generate instant Socratic hints, PYQ proofs, or marking schemes.</p>
        </div>
        <button id="close-library-modal-btn" class="close-dialog-btn" type="button" aria-label="Close">✕</button>
      </div>

      <!-- Subject Filter Tabs -->
      <div class="library-filter-tabs" style="display: flex; gap: 0.4rem; overflow-x: auto; padding-bottom: 0.5rem; margin-bottom: 0.75rem; border-bottom: 1px solid #e2e8f0;">
        <button type="button" class="lib-tab active" data-subject="all" style="padding: 0.35rem 0.75rem; border-radius: 999px; border: 1px solid #dde3ea; background: #c2e7ff; color: #001d35; font-size: 0.78rem; font-weight: 600; cursor: pointer;">All (58)</button>
        <button type="button" class="lib-tab" data-subject="Maths" style="padding: 0.35rem 0.75rem; border-radius: 999px; border: 1px solid #dde3ea; background: #f0f4f9; color: #444746; font-size: 0.78rem; font-weight: 500; cursor: pointer;">Mathematics (14)</button>
        <button type="button" class="lib-tab" data-subject="Science" style="padding: 0.35rem 0.75rem; border-radius: 999px; border: 1px solid #dde3ea; background: #f0f4f9; color: #444746; font-size: 0.78rem; font-weight: 500; cursor: pointer;">Science (13)</button>
        <button type="button" class="lib-tab" data-subject="SST" style="padding: 0.35rem 0.75rem; border-radius: 999px; border: 1px solid #dde3ea; background: #f0f4f9; color: #444746; font-size: 0.78rem; font-weight: 500; cursor: pointer;">Social Science (20)</button>
        <button type="button" class="lib-tab" data-subject="English" style="padding: 0.35rem 0.75rem; border-radius: 999px; border: 1px solid #dde3ea; background: #f0f4f9; color: #444746; font-size: 0.78rem; font-weight: 500; cursor: pointer;">English (6)</button>
        <button type="button" class="lib-tab" data-subject="Hindi" style="padding: 0.35rem 0.75rem; border-radius: 999px; border: 1px solid #dde3ea; background: #f0f4f9; color: #444746; font-size: 0.78rem; font-weight: 500; cursor: pointer;">Hindi (5)</button>
      </div>

      <!-- Search Input -->
      <div style="margin-bottom: 0.75rem;">
