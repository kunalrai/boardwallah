        back: 'Distribution of power among organs/levels/social groups. <strong>Prudential reason:</strong> reduces social conflict & instability. <strong>Moral reason:</strong> essence of democracy—citizens have a stake in governance.'
      },
      {
        subject: 'HINDI COURSE A • क्षितिज',
        front: '‘नेताजी का चश्मा’ पाठ में कैप्टन कौन था और वह चश्मा क्यों बदलता था?',
        back: 'कैप्टन एक देशभक्त चश्मेवाला था। नेताजी की मूर्ति बिना चश्मे के देखकर उसे कष्ट होता था, इसलिए वह अपनी ओर से मूर्ति पर फ्रेम लगाता और किसी ग्राहक के माँगने पर उसे बदल देता था।'
      },
      {
        subject: 'SCIENCE • BIOLOGY',
        front: 'Name the two main vascular tissues in plants and their functions.',
        back: '<strong>Xylem:</strong> transports water and dissolved minerals from roots upward. <strong>Phloem:</strong> translocates prepared food (sucrose) from leaves to other parts (bidirectional).'
      }
    ];

    let state = {
      sidebarCollapsed: false,
      currentSubject: 'CBSE Board 2026',
      currentChapter: CBSE_SYLLABUS['CBSE Board 2026'][0],
      responseMode: 'hint', // 'hint' | 'solution' | 'check'
      isStreaming: false,
      streamTimer: null,
      flashcardIndex: 0,
      flashcardFlipped: false,
      mockSecondsRemaining: 3 * 3600, // 03:00:00
      mockInterval: null,
      activeRubric: STARTER_PACKS.datesheet
    };

    function initIcons() {
      if (window.lucide && typeof window.lucide.createIcons === 'function') {
        window.lucide.createIcons();
      }
    }

    window.addEventListener('DOMContentLoaded', () => {
      populateChaptersForSubject(state.currentSubject);
      renderRubric(STARTER_PACKS.datesheet);
      renderFlashcard();
      updateMockTimerDisplay();
      initIcons();

      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          resetToNewSession();
        }
        if (e.key === 'Escape') {
          const slashMenu = document.getElementById('slashMenu');
          if (slashMenu) slashMenu.classList.add('hidden');
        }
      });
    });

    // =====================================================================
    // SUBJECT, CHAPTER & RESPONSE MODE CONTROLS
    // =====================================================================
    function selectSubject(subjectName, btnEl) {
      state.currentSubject = subjectName;
      document.querySelectorAll('.subject-btn').forEach((b) => {
        b.className = 'subject-btn flex items-center justify-between px-2.5 py-2 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-[#21262D] border border-transparent transition-all';
      });
      const targetBtn = btnEl || document.querySelector(`[data-subject="${subjectName}"]`);
      if (targetBtn) {
        targetBtn.className = 'subject-btn active flex items-center justify-between px-2.5 py-2 rounded-xl text-xs font-medium bg-orange-500/10 text-orange-600 dark:text-orange-400 border border-orange-500/20 transition-all';
      }
      populateChaptersForSubject(subjectName);
      toggleMobileSidebar(false);
    }

    function populateChaptersForSubject(subjectName) {
      const chapters = CBSE_SYLLABUS[subjectName] || [];
      const select = document.getElementById('chapterSelect');
      const countBadge = document.getElementById('chapterCountBadge');
      if (countBadge) countBadge.textContent = `${chapters.length} Chapters`;

      if (select) {
        select.innerHTML = chapters
          .map((ch) => `<option value="${escapeHtml(ch)}">${escapeHtml(ch)}</option>`)
          .join('');
      }

      state.currentChapter = chapters[0] || '';
      updateActiveContextBadge();
    }

    function handleChapterChange(chapterVal) {
      state.currentChapter = chapterVal;
      updateActiveContextBadge();
      showToast(`Selected: ${chapterVal}`);
    }

    function updateActiveContextBadge() {
      const subjEl = document.getElementById('activeSubjectLabel');
      const chapEl = document.getElementById('activeChapterLabel');
      if (subjEl) subjEl.textContent = state.currentSubject;
      if (chapEl) chapEl.textContent = state.currentChapter;
    }

    function setResponseMode(mode, btnEl) {
      state.responseMode = mode;
      document.querySelectorAll('.resp-mode-btn').forEach((b) => {
        b.className = 'resp-mode-btn px-2.5 py-1 rounded-lg text-[11px] font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all';
      });
      if (btnEl) {
        btnEl.className = 'resp-mode-btn active px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-orange-500 text-white shadow-xs transition-all';
      }
      if (mode === 'check') {
        toggleStudentAttemptBox(true);
      }
    }

    function toggleStudentAttemptBox(forceOpen) {
      const box = document.getElementById('studentAttemptBox');
      if (!box) return;
      const open = typeof forceOpen === 'boolean' ? forceOpen : box.classList.contains('hidden');
      box.classList.toggle('hidden', !open);
      if (open) {
        const inp = document.getElementById('studentAttemptInput');
        if (inp) inp.focus();
      }
    }

    // =====================================================================
    // STARTER CARDS, SAMPLE CHIPS & CONVERSATION STREAM
    // =====================================================================
    function triggerStarterCard(packKey) {
      const pack = STARTER_PACKS[packKey];
      if (!pack) return;
      selectSubject(pack.subject);
      state.currentChapter = pack.chapter;
      updateActiveContextBadge();
      const chSelect = document.getElementById('chapterSelect');
      if (chSelect) chSelect.value = pack.chapter;
      renderRubric(pack);

      if (packKey === 'mockdrill') {
        openStudyDrawerTab('mock');
      }

      if (packKey === 'checksteps') {
        setResponseMode('check', document.getElementById('mode-check'));
        toggleStudentAttemptBox(true);
        const attemptInput = document.getElementById('studentAttemptInput');
        if (attemptInput) {
          attemptInput.value = 'Let √5 = p/q (co-prime). 5q² = p² ⇒ 5 divides p. Put p = 5m ⇒ 25m² = 5q² ⇒ 5 divides q.';
        }
      }

      submitDoubt(pack.question, pack);
    }

    function useSampleChip(sampleText) {
      const input = document.getElementById('promptInput');
      if (!input) return;
      input.value = sampleText;
      handlePromptInput(input);
      input.focus();
    }

    function insertSampleHindiDoubt() {
      selectSubject('Hindi Course A', document.querySelector('[data-subject="Hindi Course A"]'));
      const input = document.getElementById('promptInput');
      if (!input) return;
      input.value = '‘नेताजी का चश्मा’ पाठ में कैप्टन की देशभक्ति को स्पष्ट कीजिए (3 अंक)।';
      handlePromptInput(input);
    }

    function handlePromptInput(textarea) {
      textarea.style.height = 'auto';
      textarea.style.height = Math.min(textarea.scrollHeight, 176) + 'px';
      updateSendButtonState();

      const val = textarea.value;
      if (val === '/' || (val.endsWith(' /') && val.length < 30)) {
        toggleSlashMenu(true);
      } else if (!val.startsWith('/')) {
        toggleSlashMenu(false);
      }
    }

    function handlePromptKeydown(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        const sendBtn = document.getElementById('sendBtn');
        if (sendBtn && !sendBtn.disabled) {
          handleSendOrStop();
        }
      }
    }

    function updateSendButtonState() {
      const input = document.getElementById('promptInput');
      const btn = document.getElementById('sendBtn');
      if (btn && input) {
        btn.disabled = !state.isStreaming && input.value.trim().length === 0;
      }
    }

    function toggleSlashMenu(forceOpen) {
      const menu = document.getElementById('slashMenu');
      if (!menu) return;
      const open = typeof forceOpen === 'boolean' ? forceOpen : menu.classList.contains('hidden');
      menu.classList.toggle('hidden', !open);
    }

    function insertSlashCommand(cmd) {
      const input = document.getElementById('promptInput');
      if (!input) return;
      input.value = cmd + input.value.replace(/^\/\w+\s*/, '');
      input.focus();
      toggleSlashMenu(false);
      updateSendButtonState();

      if (cmd.startsWith('/hint')) setResponseMode('hint', document.getElementById('mode-hint'));
      else if (cmd.startsWith('/solution')) setResponseMode('solution', document.getElementById('mode-solution'));
      else if (cmd.startsWith('/check')) {
        setResponseMode('check', document.getElementById('mode-check'));
        toggleStudentAttemptBox(true);
      }
    }

    function resolveBoardQuery(raw, attemptText = '') {
      const lower = raw.toLowerCase().trim();

      // 1. Exam Dates, Timetable, Schedule (handles cbsc, cbse, class 10, datesheet, time table)
      if (
        lower.includes('date') ||
        lower.includes('datesheet') ||
        lower.includes('date sheet') ||
        lower.includes('time table') ||
        lower.includes('timetable') ||
        lower.includes('schedule') ||
        lower.includes('when is exam') ||
        lower.includes('when are exams') ||
        lower.includes('exam time') ||
        ((lower.includes('cbse') || lower.includes('cbsc') || lower.includes('board')) && (lower.includes('10') || lower.includes('exam')))
      ) {
        selectSubject('CBSE Board 2026');
        const chapter = 'Official Date Sheet & Timetable';
        state.currentChapter = chapter;
        updateActiveContextBadge();
        const chSelect = document.getElementById('chapterSelect');
        if (chSelect) chSelect.value = chapter;
        return {
          ...STARTER_PACKS.datesheet,
          question: raw
        };
      }

      // 2. Passing Criteria, 33% rule, Minimum marks
      if (
        lower.includes('pass') ||
        lower.includes('passing') ||
        lower.includes('33%') ||
        lower.includes('criteria') ||
        lower.includes('fail') ||
        lower.includes('internal assessment') ||
        lower.includes('grace') ||
        lower.includes('compartment')
      ) {
        selectSubject('CBSE Board 2026');
        const chapter = 'Passing Criteria & 33% Rule Explained';
        state.currentChapter = chapter;
        updateActiveContextBadge();
        const chSelect = document.getElementById('chapterSelect');
        if (chSelect) chSelect.value = chapter;
        return {
          ...STARTER_PACKS.passing,
          question: raw
        };
      }

      // 3. Strategy, 95%+, Roadmap, Topper, Revision
      if (
        lower.includes('strategy') ||
        lower.includes('roadmap') ||
        lower.includes('how to score') ||
        lower.includes('95%') ||
        lower.includes('90%') ||
        lower.includes('topper') ||
        lower.includes('revision') ||
        lower.includes('study plan') ||
        lower.includes('routine') ||
        lower.includes('blueprint')
      ) {
        selectSubject('CBSE Board 2026');
        const chapter = 'Last 30-Day Revision Strategy (95%+)'
        state.currentChapter = chapter;
        updateActiveContextBadge();
        const chSelect = document.getElementById('chapterSelect');
        if (chSelect) chSelect.value = chapter;
        return {
          ...STARTER_PACKS.strategy,
          question: raw
        };
      }

      // 4. Kunal Rai, Mentorship, Trial, Gaur City, Contact
      if (
        lower.includes('kunal') ||
        lower.includes('rai') ||
        lower.includes('mentor') ||
        lower.includes('trial') ||
        lower.includes('gaur city') ||
        lower.includes('contact') ||
        lower.includes('demo') ||
        lower.includes('admission') ||
        lower.includes('fee') ||
        lower.includes('batch')
      ) {
        selectSubject('CBSE Board 2026');
        const chapter = 'Exam Day Instructions & Time Management';
        state.currentChapter = chapter;
        updateActiveContextBadge();
        const chSelect = document.getElementById('chapterSelect');
        if (chSelect) chSelect.value = chapter;
        return {
          ...STARTER_PACKS.mentorship,
          question: raw
        };
      }

      // 5. Science queries
      if (
        lower.includes('hcl') || lower.includes('litmus') || lower.includes('chemical') ||
        lower.includes('ohm') || lower.includes('reaction') || lower.includes('acid') ||
        lower.includes('base') || lower.includes('respiration') || lower.includes('xylem') ||
        lower.includes('phloem') || lower.includes('lens') || lower.includes('mirror') ||
        lower.includes('electric') || lower.includes('heredity') || lower.includes('mendel') ||
        lower.includes('photosynthesis') || lower.includes('refraction') || lower.includes('reflection') ||
        lower.includes('magnetic') || lower.includes('science') || state.currentSubject === 'Science'
      ) {
        selectSubject('Science');
        let chapter = 'Chem Ch 1: Chemical Reactions and Equations';
        if (lower.includes('ohm') || lower.includes('electric') || lower.includes('current') || lower.includes('volt') || lower.includes('resistance')) {
          chapter = 'Phy Ch 11: Electricity';
        } else if (lower.includes('light') || lower.includes('lens') || lower.includes('mirror') || lower.includes('refraction') || lower.includes('reflection')) {
          chapter = 'Phy Ch 9: Light – Reflection and Refraction';
        } else if (lower.includes('acid') || lower.includes('base') || lower.includes('litmus') || lower.includes('ph') || lower.includes('salt')) {
          chapter = 'Chem Ch 2: Acids, Bases and Salts';
        } else if (lower.includes('xylem') || lower.includes('phloem') || lower.includes('heart') || lower.includes('nephron') || lower.includes('respiration') || lower.includes('life processes')) {
          chapter = 'Bio Ch 5: Life Processes';
        } else if (lower.includes('heredity') || lower.includes('mendel') || lower.includes('gene')) {
          chapter = 'Bio Ch 8: Heredity';
        }
        state.currentChapter = chapter;
        updateActiveContextBadge();
        const chSelect = document.getElementById('chapterSelect');
        if (chSelect) chSelect.value = chapter;
        return {
          ...STARTER_PACKS.chemical,
          subject: 'Science',
          chapter: chapter,
          question: raw
        };
      }

      // 6. Social Science queries
      if (
        lower.includes('germany') || lower.includes('bismarck') || lower.includes('nationalism') ||
        lower.includes('satyagraha') || lower.includes('gandhi') || lower.includes('power sharing') ||
        lower.includes('federalism') || lower.includes('democracy') || lower.includes('alluvial') ||
        lower.includes('soil') || lower.includes('social') || lower.includes('sst') || state.currentSubject === 'Social Science'
      ) {
        selectSubject('Social Science');
        let chapter = 'His Ch 1: The Rise of Nationalism in Europe';
        if (lower.includes('satyagraha') || lower.includes('gandhi') || lower.includes('non-cooperation') || lower.includes('civil disobedience')) {
          chapter = 'His Ch 2: Nationalism in India';
        } else if (lower.includes('power sharing') || lower.includes('belgium') || lower.includes('sri lanka')) {
          chapter = 'Civ Ch 1: Power-sharing';
        } else if (lower.includes('federalism')) {
          chapter = 'Civ Ch 2: Federalism';
        }
        state.currentChapter = chapter;
        updateActiveContextBadge();
        const chSelect = document.getElementById('chapterSelect');
        if (chSelect) chSelect.value = chapter;
        return {
          ...STARTER_PACKS.mockdrill,
          subject: 'Social Science',
          chapter: chapter,
          question: raw
        };
      }

      // 7. English queries
      if (
        lower.includes('letter to god') || lower.includes('lencho') || lower.includes('nelson mandela') ||
        lower.includes('apartheid') || lower.includes('anne frank') || lower.includes('analytical paragraph') ||
        lower.includes('letter writing') || lower.includes('english') || state.currentSubject === 'English'
      ) {
        selectSubject('English');
        const chapter = 'First Flight: A Letter to God & Nelson Mandela';
        state.currentChapter = chapter;
        updateActiveContextBadge();
        const chSelect = document.getElementById('chapterSelect');
        if (chSelect) chSelect.value = chapter;
        return {
          subject: 'English',
          chapter: chapter,
          marks: '3 MARKS / 5 MARKS',
          question: raw,
          hintBody: `**Socratic Hint (English Lang & Lit - CBSE Class 10):**\nWhen answering CBSE English literature questions, structure your answer with:\n1. **Context & Theme:** Mention the character's motivation or author's intent.\n2. **Textual Evidence:** Quote or paraphrase key incidents from the NCERT text.\n3. **Tone & Vocabulary:** Use formal literary terms to fetch full marks.`,
          solutionBody: `**CBSE Model Answer:**\n- **Content & Understanding (2M):** Directly address the central question using exact references from the chapter.\n- **Expression & Vocabulary (1M):** Maintain coherent sentence flow with accurate grammar, spelling, and tone.\n- **Conclusion:** Conclude with the underlying moral or thematic significance highlighted by the author.`,
          checkBody: `**Step Audit — English Marking Criteria:**\n- In CBSE Class 10 English, 1/2 mark is deducted for 2 or more grammatical or spelling errors.\n- Check word count: 3-mark questions require 40–50 words; 5-mark questions require 100–120 words.`,
          rubricSteps: [
            { mark: '2M', title: 'Content & Key Details', desc: 'Direct answering with accurate NCERT textual reference.' },
            { mark: '1M', title: 'Expression & Flow', desc: 'Coherence, rich vocabulary, and appropriate tone.' }
          ],
          examTip: 'Never exceed the word limit in English exams—concise, well-expressed answers score higher and save critical time for the reading comprehension section.'
        };
      }

      // 8. Hindi Course A queries
      if (
        lower.includes('नेताजी') || lower.includes('चश्मा') || lower.includes('कैप्टन') ||
        lower.includes('सूरदास') || lower.includes('बालगोबिन') || lower.includes('लखनवी') ||
        lower.includes('वाच्य') || lower.includes('अलंकार') || lower.includes('hindi') || lower.includes('हिंदी') || state.currentSubject === 'Hindi Course A'
      ) {
        selectSubject('Hindi Course A');
        const chapter = 'क्षितिज (गद्य): नेताजी का चश्मा, बालगोबिन भगत, लखनवी अंदाज़, मानवीय करुणा की दिव्य चमक';
        state.currentChapter = chapter;
        updateActiveContextBadge();
        const chSelect = document.getElementById('chapterSelect');
        if (chSelect) chSelect.value = chapter;
        return {
          subject: 'Hindi Course A',
          chapter: chapter,
          marks: '3 अंक (CBSE बोर्ड प्रश्न)',
          question: raw,
          hintBody: `**सोक्रेटिक संकेत (क्षितिज भाग-2):**\nसीबीएसई हिंदी 'अ' में उत्तर लिखते समय भाषा की शुद्धता, वर्तनी (spelling) और पाठ के मुख्य भाव को स्पष्ट करना अत्यंत महत्वपूर्ण है।\n- उत्तर को 30-40 शब्दों में स्पष्ट और संतुलित रखें।`,
          solutionBody: `**सीबीएसई आदर्श उत्तर (3 अंक):**\n1. **विषय-वस्तु (2 अंक):** पाठ्यपुस्तक के आधार पर प्रश्न के मूल भाव को प्रमाण सहित प्रस्तुत करना।\n2. **भाषा एवं प्रस्तुति (1 अंक):** व्याकरण सम्मत, शुद्ध हिंदी तथा वर्तनी की त्रुटि रहित प्रस्तुति।`,
          checkBody: `**मूल्यांकन जांच (Step Audit):**\n- वर्तनी (spelling) और मात्राओं की जांच करें।\n- उत्तर में मुख्य पात्र या प्रसंग का नाम सही लिखा होना चाहिए।`,
          rubricSteps: [
            { mark: '2 अंक', title: 'विषय वस्तु व पाठ संदर्भ', desc: 'प्रश्नानुसार सटीक एवं तर्कसंगत उत्तर।' },
            { mark: '1 अंक', title: 'भाषा शैली व वर्तनी शुद्धता', desc: 'व्याकरण व वर्तनी की शुद्धता।' }
          ],
          examTip: 'हिंदी की परीक्षा में उत्तर में काट-छाँट से बचें। उत्तर समाप्त होने पर पेंसिल से एक रेखा खींचें।'
        };
      }

      // 9. Mathematics queries
      if (
        lower.includes('quadratic') || lower.includes('discriminant') || lower.includes('attempt') || attemptText ||
        lower.includes('root') || lower.includes('b² - 4ac')
      ) {
        selectSubject('Mathematics');
        const chapter = 'Ch 4: Quadratic Equations';
        state.currentChapter = chapter;
