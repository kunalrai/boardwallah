  function resolveChatDoubt(question) {
    const lower = (question || '').toLowerCase().trim();

    // 1. Exam Dates & Timetable (strictly when user asks for dates or timetable)
    const isAskingDates = (
      lower.includes('datesheet') ||
      lower.includes('date sheet') ||
      lower.includes('timetable') ||
      lower.includes('time table') ||
      lower.includes('exam date') ||
      lower.includes('exam timing') ||
      lower.includes('exam schedule') ||
      ((lower.includes('date') || lower.includes('when')) && (lower.includes('exam') || lower.includes('board exam') || lower.includes('cbse') || lower.includes('cbsc')))
    );

    if (isAskingDates) {
      return {
        answer: `**Official CBSE Class 10 Board Exam Timetable 2026 (10:30 AM – 1:30 PM IST):**\n\n| Date & Day | Subject Code | Subject Name | Timings | Max Marks |\n| :--- | :--- | :--- | :--- | :--- |\n| **17 Feb 2026 (Tue)** | 041 / 241 | **Mathematics (Standard / Basic)** | 10:30 AM – 1:30 PM | 80 Marks |\n| **21 Feb 2026 (Sat)** | 184 | **English (Language & Literature)** | 10:30 AM – 1:30 PM | 80 Marks |\n| **25 Feb 2026 (Wed)** | 086 | **Science (Phy / Chem / Bio)** | 10:30 AM – 1:30 PM | 80 Marks |\n| **27 Feb 2026 (Fri)** | 402 / 417 | **Information Tech / AI** | 10:30 AM – 12:30 PM | 50 Marks |\n| **02 Mar 2026 (Mon)** | 002 / 085 | **Hindi Course 'A' / Course 'B'** | 10:30 AM – 1:30 PM | 80 Marks |\n| **07 Mar 2026 (Sat)** | 087 | **Social Science (His/Geo/Civ/Eco)**| 10:30 AM – 1:30 PM | 80 Marks |\n\n**Official CBSE Exam Day Guidelines:**\n1. **15-Minute Reading Time:** 10:15 AM to 10:30 AM is strictly reserved for reading question papers; writing on answer sheets begins only at 10:30 AM.\n2. **Passing Rule:** Minimum 33% combined marks (Theory + Internal Assessment) in each subject.\n3. **Items Allowed:** Original Admit Card, School ID card, royal blue or black ballpoint pens, transparent pouch, analog wristwatch.`,
        keyTerms: ['Date Sheet 2026', '10:30 AM Shift', '15-Min Reading Time', '33% Rule']
      };
    }

    // 2. Passing Criteria & 33% Rule
    if (
      lower.includes('pass') || lower.includes('passing') || lower.includes('33%') ||
      lower.includes('criteria') || lower.includes('fail') || lower.includes('internal assessment') ||
      lower.includes('grace') || lower.includes('compartment')
    ) {
      return {
        answer: `**CBSE Class 10 Passing Criteria (Combined 33% Rule):**\n\n1. **Combined 33% Rule:**\nUnlike Class 12 (where students must pass theory and practical separately), Class 10 students must score at least **33% combined** out of 100 marks (80 Marks Theory + 20 Marks Internal Assessment).\n\n2. **Minimum Marks Calculation:**\nTotal marks needed per subject = **33 / 100**.\n- If your school gives you **18/20** in Internal Assessment, you only need **15/80** in the Board Theory exam to pass!\n- For high target percentiles (90%+), aim for 72+/80 in theory.\n\n3. **Compartment Policy:**\nA student failing in 1 or 2 subjects is placed in the Compartment category and can appear in July 2026.`,
        keyTerms: ['33% Aggregate Rule', 'Theory + Internals Combined', 'Compartment Policy']
      };
    }

    // 3. Strategy & 95%+ Roadmap
    if (
      lower.includes('strategy') || lower.includes('roadmap') || lower.includes('how to score') ||
      lower.includes('95%') || lower.includes('90%') || lower.includes('topper') ||
      lower.includes('revision') || lower.includes('study plan') || lower.includes('routine')
    ) {
      return {
        answer: `**How to Score 95%+ in CBSE Class 10 (Last 30-Day Roadmap):**\n\n1. **Mathematics (Target 80/80):**\n- Solve 100% of NCERT examples and exercises. 75% of the paper is direct NCERT.\n- Memorize theorem proofs: Basic Proportionality Theorem (Ch 6) & Tangents from External Point (Ch 10).\n- Show formula (0.5M) + substitution (1M) + boxed final answer with units (cm², m³, etc.).\n\n2. **Science (Target 80/80):**\n- Chemistry: Balance all equations with state symbols (s, g, aq) and memorise color changes.\n- Biology: Practice neat labeled diagrams (Nephron, Neuron, Human Heart, Female Reproductive System).\n- Physics: Master ray diagrams with arrow directions + Ohm's law & Joule's heating numericals.\n\n3. **Social Science (Target 80/80):**\n- Write 3M and 5M answers in crisp bullet points with underlined keywords.\n- Practice official CBSE map work.\n\n4. **Daily Mock Routine:**\n- Solve 1 full 80-mark mock paper strictly from 10:30 AM to 1:30 PM to sync your brain with real board exam hours.`,
        keyTerms: ['NCERT Mastery', 'PYQs 2020–2025', '10:30–1:30 PM Mock Slot', 'CBSE Step Marking']
      };
    }

    // 4. Kunal Rai / Mentorship / Trial Slot
    if (
      lower.includes('kunal') || lower.includes('rai') || lower.includes('mentor') ||
      lower.includes('trial') || lower.includes('gaur city') || lower.includes('contact') ||
      lower.includes('fee') || lower.includes('batch') || lower.includes('admission')
    ) {
      return {
