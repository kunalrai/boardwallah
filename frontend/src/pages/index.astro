    .gemini-sidebar.collapsed ~ .gemini-main #mobile-toggle-btn {
      display: inline-flex !important;
    }
    .sidebar-backdrop {
      display: none !important;
    }
    .mobile-only-close {
      display: none !important;
    }
    .desktop-only-control {
      display: flex !important;
    }
    .mobile-toggle-btn {
      display: none !important;
    }
    .header-mobile-brand {
      display: none !important;
    }
    .active-notebook-title {
      display: inline !important;
    }
    .mode-pill-select {
      display: flex !important;
    }
    .gemini-header {
      padding: 0.75rem 1.75rem !important;
      border-bottom: none !important;
    }
    .conversation-viewport {
      padding: 1.25rem 2rem 8rem 2rem !important;
