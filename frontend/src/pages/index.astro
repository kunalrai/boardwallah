  let firestoreOrderBy = null;
  let firestoreLimit = null;
  let firestoreGetDocs = null;
  let firestoreServerTimestamp = null;
  let firestoreDoc = null;
  let firestoreSetDoc = null;
  let recentDoubtsMemory = [];
  let showingStarredOnly = false;

  async function syncUserToFirestore(user) {
    if (!user || !user.email) return;
    if (!firestoreDb || !firestoreDoc || !firestoreSetDoc) return;
    try {
      const emailDocId = user.email.toLowerCase().trim();
      const userRef = firestoreDoc(firestoreDb, 'users', emailDocId);
      await firestoreSetDoc(userRef, {
        email: user.email.toLowerCase().trim(),
        name: user.name || 'Student',
        picture: user.picture || '',
        sub: user.sub || '',
        lastActiveAt: firestoreServerTimestamp ? firestoreServerTimestamp() : new Date(),
        updatedAt: Date.now()
      }, { merge: true });
      console.log('Synced student profile to Firestore users collection:', user.email);
    } catch (err) {
      console.warn('Failed to sync user to Firestore:', err);
    }
  }

  async function initFirebaseClient() {
    try {
      if (!firebaseConfig || !firebaseConfig.apiKey) {
        loadRecentDoubtsFromLocalStorage();
        return;
      }
      const { initializeApp } = await import('https://www.gstatic.com/firebasejs/11.0.0/firebase-app.js');
      const {
        getFirestore,
        collection,
        addDoc,
        query,
        orderBy,
        limit,
        getDocs,
        serverTimestamp,
        doc,
        setDoc
      } = await import('https://www.gstatic.com/firebasejs/11.0.0/firebase-firestore.js');

      const app = initializeApp(firebaseConfig, 'boardwallah-client');
      firestoreDb = getFirestore(app);
      firestoreAddDoc = addDoc;
      firestoreCollection = collection;
      firestoreQuery = query;
      firestoreOrderBy = orderBy;
      firestoreLimit = limit;
      firestoreGetDocs = getDocs;
      firestoreServerTimestamp = serverTimestamp;
      firestoreDoc = doc;
      firestoreSetDoc = setDoc;

      console.log('Firebase Cloud Firestore initialized for boardwallah-cbse');
      await loadRecentDoubtsFromFirestore();

      const existingUser = getStoredUser();
      if (existingUser && existingUser.email) {
        syncUserToFirestore(existingUser);
      }
    } catch (e) {
      console.warn('Firebase client init fallback to local:', e);
      loadRecentDoubtsFromLocalStorage();
    }
  }

  async function saveDoubtToFirestore(question, answer, keyTerms) {
    if (!question || !answer) return;
    const currentUser = getStoredUser();
    const doubtObj = {
      question: question.trim(),
      answer: typeof answer === 'string' ? answer : JSON.stringify(answer),
      keyTerms: keyTerms || [],
      mode: currentMode || 'hint',
      timestamp: Date.now(),
      studentEmail: currentUser ? currentUser.email : 'anonymous',
      studentName: currentUser ? currentUser.name : 'Student'
    };

    // Keep in local cache
    recentDoubtsMemory.unshift(doubtObj);
    try {
      const stored = JSON.parse(localStorage.getItem('boardwallah_doubts_history') || '[]');
      stored.unshift(doubtObj);
      if (stored.length > 25) stored.pop();
      localStorage.setItem('boardwallah_doubts_history', JSON.stringify(stored));
    } catch (e) {}

    // Persist to Cloud Firestore
    if (firestoreDb && firestoreAddDoc && firestoreCollection) {
      try {
        await firestoreAddDoc(firestoreCollection(firestoreDb, 'doubts'), {
          ...doubtObj,
          createdAt: firestoreServerTimestamp ? firestoreServerTimestamp() : new Date()
        });
      } catch (err) {
        console.warn('Firestore write warning:', err);
      }
    }

    // Refresh user activity timestamp in users collection
    if (currentUser && currentUser.email) {
      syncUserToFirestore(currentUser);
    }
  }

  async function toggleStarDoubt(answer, keyTerms, isStarred) {
    const questionText = (activeNotebookTitle && activeNotebookTitle.textContent) || 'CBSE Board Doubt';
    const currentUser = getStoredUser();

    try {
      let starred = JSON.parse(localStorage.getItem('boardwallah_starred_doubts') || '[]');
      if (isStarred) {
        starred.unshift({
          question: questionText,
          answer: typeof answer === 'string' ? answer : '',
          keyTerms: keyTerms || [],
          starredAt: Date.now(),
          studentEmail: currentUser ? currentUser.email : 'anonymous'
        });
        if (starred.length > 50) starred.pop();
      } else {
        starred = starred.filter(item => item.question !== questionText);
      }
      localStorage.setItem('boardwallah_starred_doubts', JSON.stringify(starred));
    } catch (e) {}

    if (isStarred && firestoreDb && firestoreAddDoc && firestoreCollection) {
      try {
        await firestoreAddDoc(firestoreCollection(firestoreDb, 'starred_doubts'), {
          question: questionText,
          answer: typeof answer === 'string' ? answer.slice(0, 2000) : '',
          keyTerms: keyTerms || [],
          starredAt: Date.now(),
          studentEmail: currentUser ? currentUser.email : 'anonymous',
          studentName: currentUser ? currentUser.name : 'Student'
        });
      } catch (err) {
        console.warn('Firestore star save warning:', err);
      }
    }
  }

  function prependRecentDoubt(question, answer, keyTerms, isStarred) {
    const recentsList = document.getElementById('recents-list');
    if (!recentsList) return;

    const trimmedQ = (question || '').trim();
    if (!trimmedQ) return;

    // Check if item already exists in DOM
    const existing = Array.from(recentsList.querySelectorAll('.recent-text'));
    for (let el of existing) {
      if (el.textContent.trim().toLowerCase() === trimmedQ.toLowerCase()) {
        return;
      }
    }

    const btn = document.createElement('button');
    btn.className = 'recent-item active';
    btn.type = 'button';
    btn.title = trimmedQ;
    btn.setAttribute('aria-label', trimmedQ);
    btn.innerHTML = `
      <span class="recent-text">${escapeHtml(trimmedQ)}</span>
      <span class="pin-icon" title="${isStarred ? 'Starred' : 'Recent'}">${isStarred ? '★' : '🕒'}</span>
    `;

    btn.addEventListener('click', () => {
      document.querySelectorAll('.recent-item').forEach(r => r.classList.remove('active'));
      document.querySelectorAll('.topic-preset-btn').forEach(b => b.classList.remove('active'));
      if (newChatBtn) newChatBtn.classList.remove('active');
      btn.classList.add('active');

      if (sidebar && sidebar.classList.contains('mobile-open')) sidebar.classList.remove('mobile-open');

      if (activeNotebookTitle) activeNotebookTitle.textContent = trimmedQ.slice(0, 36) + (trimmedQ.length > 36 ? '...' : '');
      welcomeCanvas.style.display = 'none';
      activeMessagesFeed.style.display = 'flex';
      activeMessagesFeed.innerHTML = '';
      appendUserPill(trimmedQ);
      appendBotResponse(answer, keyTerms);
      scrollToBottom();
    });

    // Remove active from other items
    document.querySelectorAll('.recent-item').forEach(r => r.classList.remove('active'));
    recentsList.insertBefore(btn, recentsList.firstChild);
  }

  async function loadRecentDoubtsFromFirestore() {
    if (!firestoreDb || !firestoreCollection || !firestoreGetDocs) {
      loadRecentDoubtsFromLocalStorage();
      return;
    }
    try {
      const q = firestoreQuery(
        firestoreCollection(firestoreDb, 'doubts'),
        firestoreOrderBy('timestamp', 'desc'),
        firestoreLimit(10)
      );
      const snapshot = await firestoreGetDocs(q);
      if (!snapshot.empty) {
        const doubts = [];
        snapshot.forEach(docSnap => {
          doubts.push(docSnap.data());
        });
        // Render in chronological reverse so newest appears at top
        for (let i = doubts.length - 1; i >= 0; i--) {
          const d = doubts[i];
          if (d.question && d.answer) {
            recentDoubtsMemory.push(d);
            prependRecentDoubt(d.question, d.answer, d.keyTerms, false);
          }
        }
      } else {
        loadRecentDoubtsFromLocalStorage();
      }
    } catch (e) {
      console.warn('Error reading from Firestore, using localStorage:', e);
      loadRecentDoubtsFromLocalStorage();
    }
  }

  function loadRecentDoubtsFromLocalStorage() {
    try {
      const stored = JSON.parse(localStorage.getItem('boardwallah_doubts_history') || '[]');
      for (let i = stored.length - 1; i >= 0; i--) {
        const d = stored[i];
        if (d.question && d.answer) {
          recentDoubtsMemory.push(d);
          prependRecentDoubt(d.question, d.answer, d.keyTerms, false);
        }
      }
    } catch (e) {}
  }

