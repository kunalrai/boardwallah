  function escapeHtml(str) {
    if (!str) return '';
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // Format response with clean markdown, tables, and dark Gemini code blocks
  function formatGeminiMarkdown(text) {
    if (!text) return '';
    let parsed = text;

    // Support markdown tables
    if (parsed.includes('|')) {
      const lines = parsed.split('\n');
      let inTable = false;
      let tableRows = [];
      const newLines = [];

      for (let i = 0; i < lines.length; i++) {
        const line = lines[i].trim();
        if (line.startsWith('|') && line.endsWith('|')) {
          if (!inTable) {
            inTable = true;
            tableRows = [];
          }
          if (/^\|(\s*[:-]+[-| :]*)\|$/.test(line)) {
            continue;
          }
          const cells = line.slice(1, -1).split('|').map(c => c.trim());
          const isHeader = tableRows.length === 0;
          const tag = isHeader ? 'th' : 'td';
          const cellStyle = isHeader
            ? 'padding: 8px 12px; text-align: left; font-weight: 600; color: #ea580c; border-bottom: 2px solid #e2e8f0; background: #f8fafc;'
            : 'padding: 8px 12px; border-bottom: 1px solid #f1f5f9; color: #334155;';
          const rowHtml = `<tr>${cells.map(c => `<${tag} style="${cellStyle}">${c}</${tag}>`).join('')}</tr>`;
          tableRows.push(rowHtml);
        } else {
          if (inTable) {
            newLines.push(`<div style="overflow-x: auto; margin: 12px 0; border: 1px solid #e2e8f0; border-radius: 12px;"><table style="width: 100%; border-collapse: collapse; font-size: 13px; font-family: monospace;">${tableRows.join('')}</table></div>`);
            inTable = false;
            tableRows = [];
          }
          newLines.push(lines[i]);
        }
      }
      if (inTable) {
        newLines.push(`<div style="overflow-x: auto; margin: 12px 0; border: 1px solid #e2e8f0; border-radius: 12px;"><table style="width: 100%; border-collapse: collapse; font-size: 13px; font-family: monospace;">${tableRows.join('')}</table></div>`);
      }
      parsed = newLines.join('\n');
    }

    // Auto-heal unclosed code fences or SVG tags from network cuts or token bounds
    const fenceMatches = parsed.match(/```/g) || [];
    if (fenceMatches.length % 2 === 1) {
      if (parsed.includes('<svg') && !parsed.includes('</svg>')) {
        parsed += '\n</svg>';
      }
      parsed += '\n```';
    }

    function sanitizeSvg(rawSvg) {
      if (!rawSvg) return '';
      let clean = rawSvg.replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '');
      clean = clean.replace(/\son\w+="[^"]*"/gi, '');
      clean = clean.replace(/\son\w+='[^']*'/gi, '');
      if (clean.includes('<svg') && !clean.includes('</svg>')) {
        clean += '</svg>';
      }
      return clean;
    }

    // Dark Code Blocks & Math / Geometric Diagram Cards
    parsed = parsed.replace(/```([a-zA-Z0-9_-]*)\s*?\n?([\s\S]*?)```/g, (match, lang, code) => {
      const trimmed = code.trim();
      const svgMatch = trimmed.match(/<svg[\s\S]*?<\/svg>/i);
      if (svgMatch || ((lang === 'svg' || lang === 'xml' || !lang) && trimmed.includes('<svg'))) {
        let svgCode = svgMatch ? svgMatch[0] : trimmed;
        const cleanSvg = sanitizeSvg(svgCode);
        return `
          <div class="math-diagram-card">
            <div class="math-diagram-header">
              <div class="math-diagram-badge">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/><path d="m14.83 14.83 4.24 4.24"/><path d="m9.17 14.83-4.24 4.24"/></svg>
                <span>CBSE Mathematical Diagram (Animated)</span>
              </div>
              <div class="math-diagram-actions">
                <button type="button" class="diagram-action-btn diagram-replay-btn" title="Replay Construction Animation">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                  <span>Replay</span>
                </button>
                <button type="button" class="diagram-action-btn diagram-download-btn" title="Download SVG Drawing">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                  <span>Download SVG</span>
                </button>
              </div>
            </div>
            <div class="math-diagram-canvas animated-diagram">
              ${cleanSvg}
            </div>
          </div>
        `;
      }

      const cleanLang = lang || 'Formula / Steps';
      let escapedCode = escapeHtml(code.trim());
      return `
        <div class="gemini-dark-card">
          <div class="dark-card-header">
            <span class="dark-card-lang">${cleanLang}</span>
            <div class="dark-card-actions">
              <button type="button" class="dark-icon-btn dark-download-btn" title="Download snippet">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="8 12 12 16 16 12"/><line x1="12" x2="12" y1="8" y2="16"/></svg>
              </button>
              <button type="button" class="dark-icon-btn dark-copy-btn" title="Copy code">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
              </button>
            </div>
          </div>
          <pre class="dark-card-pre"><code>${escapedCode}</code></pre>
        </div>
      `;
    });

    // Also detect raw <svg ... </svg> outside code blocks
    parsed = parsed.replace(/<svg\b[\s\S]*?<\/svg>/gi, (raw) => {
      if (raw.includes('math-diagram-badge') || raw.includes('diagram-download-btn') || raw.includes('gemini-star-icon')) return raw;
      const cleanSvg = sanitizeSvg(raw);
      return `
        <div class="math-diagram-card">
          <div class="math-diagram-header">
            <div class="math-diagram-badge">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/><path d="m14.83 14.83 4.24 4.24"/><path d="m9.17 14.83-4.24 4.24"/></svg>
              <span>CBSE Mathematical Diagram (Animated)</span>
            </div>
            <div class="math-diagram-actions">
              <button type="button" class="diagram-action-btn diagram-replay-btn" title="Replay Construction Animation">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                <span>Replay</span>
              </button>
              <button type="button" class="diagram-action-btn diagram-download-btn" title="Download SVG Drawing">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                <span>Download SVG</span>
              </button>
            </div>
          </div>
          <div class="math-diagram-canvas animated-diagram">
            ${cleanSvg}
          </div>
        </div>
      `;
    });

    // Inline pills
    parsed = parsed.replace(/`([^`]+)`/g, '<span class="gemini-inline-pill">$1</span>');

    // Bold Headings
    parsed = parsed.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');

    // Italic
    parsed = parsed.replace(/\*([^*]+)\*/g, '<em>$1</em>');

    // Bullet items
    parsed = parsed.replace(/^\s*[-•]\s+(.+)$/gm, '<li class="gemini-li">$1</li>');
    parsed = parsed.replace(/(<li class="gemini-li">.*<\/li>)/gs, '<ul class="gemini-ul">$1</ul>');

    // Numbered items
    parsed = parsed.replace(/^\s*(\d+)\.\s+(.+)$/gm, '<h3 class="gemini-heading-h3">$1. $2</h3>');

    // Paragraphs
    parsed = parsed.split(/\n\n+/).map(p => {
      p = p.trim();
      if (!p) return '';
      if (p.startsWith('<ul') || p.startsWith('<ol') || p.startsWith('<div') || p.startsWith('<h')) return p;
      return `<p class="gemini-p">${p.replace(/\n/g, '<br/>')}</p>`;
    }).join('');

    return parsed;
  }

  function appendUserPill(text, imageSrc) {
    welcomeCanvas.style.display = 'none';
