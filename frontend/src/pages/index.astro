  let mockTimerInterval = null;
  let mockTimerSeconds = 3 * 3600; // 3 hours = 10800 seconds

  function formatTime(totalSec) {
    const h = String(Math.floor(totalSec / 3600)).padStart(2, '0');
    const m = String(Math.floor((totalSec % 3600) / 60)).padStart(2, '0');
    const s = String(totalSec % 60).padStart(2, '0');
    return `${h}:${m}:${s}`;
  }

  if (timerDisplay) {
    timerDisplay.textContent = formatTime(mockTimerSeconds);
  }

  if (timerStartBtn) {
    timerStartBtn.addEventListener('click', () => {
      if (mockTimerInterval) return;
      mockTimerInterval = setInterval(() => {
        if (mockTimerSeconds > 0) {
          mockTimerSeconds--;
          if (timerDisplay) timerDisplay.textContent = formatTime(mockTimerSeconds);
        } else {
          clearInterval(mockTimerInterval);
          mockTimerInterval = null;
          showToast('Time is up for CBSE 3-Hour Mock Paper!');
        }
      }, 1000);
      timerStartBtn.textContent = 'Running...';
    });
  }

