  async function submitQuery(question) {
    const imgData = attachedImageBase64;
    const imgMime = attachedImageMime;

    if ((!question || !question.trim()) && !imgData) return;
    if (isWaiting) return;

    const displayQuestion = (question && question.trim()) ? question.trim() : 'Solve attached doubt photo';

    try {
      appendUserPill(displayQuestion, imgData);
      if (textarea) {
        textarea.value = '';
        adjustInputHeight();
      }
      clearAttachedImage();

      if (activeNotebookTitle) {
        activeNotebookTitle.textContent = displayQuestion.slice(0, 36) + (displayQuestion.length > 36 ? '...' : '');
      }

      isWaiting = true;
      if (sendBtn) sendBtn.disabled = true;
      showTypingAnimation();

      let ans = null;
      let terms = [];

      try {
        const resp = await fetch('/api/v1/ai/doubt-tutor', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            question: displayQuestion,
            mode: currentMode,
            image: imgData,
            imageMime: imgMime
          }),
        });

        if (resp.ok) {
          const data = await resp.json();
          ans = data.answer;
          terms = data.keyTerms || [];
        }
      } catch (err) {
        console.warn('API error, falling back to local resolver:', err);
      }

      if (!ans) {
        const resolved = resolveChatDoubt(displayQuestion);
        ans = resolved.answer;
        terms = resolved.keyTerms || [];
      }

      removeTypingAnimation();
      appendBotResponse(ans, terms);

      try {
        prependRecentDoubt(question, ans, terms, false);
      } catch (e) {
        console.warn('Recent doubt prepend warning:', e);
      }

      try {
        saveDoubtToFirestore(question, ans, terms);
      } catch (e) {
        console.warn('Firestore save warning:', e);
      }
    } catch (criticalErr) {
      console.error('Critical submitQuery error:', criticalErr);
    } finally {
      removeTypingAnimation();
      isWaiting = false;
      if (sendBtn) sendBtn.disabled = false;
      if (textarea) textarea.focus();
    }
  }

