  @media (min-width: 901px) {
    .gemini-sidebar {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      bottom: auto !important;
      height: 100% !important;
      width: 260px !important;
      max-width: none !important;
      transform: none !important;
      box-shadow: none !important;
      background: #f8fafc !important;
      border-right: 1px solid #eef2f6 !important;
      z-index: 10 !important;
    }
    .gemini-sidebar.collapsed {
      width: 68px !important;
      padding-inline: 0.45rem !important;
    }
    .gemini-sidebar.collapsed .sidebar-brand-row {
      justify-content: center;
      padding: 0.25rem 0 0.45rem;
    }
    .gemini-sidebar.collapsed .brand-link {
      display: none !important;
    }
    .gemini-sidebar.collapsed .brand-controls {
      display: flex !important;
      justify-content: center;
      width: 100%;
    }
    .gemini-sidebar.collapsed #sidebar-search-btn {
      display: none !important;
    }
    .gemini-sidebar.collapsed #sidebar-collapse-btn {
      display: flex !important;
      margin: 0 auto;
    }
    .gemini-sidebar.collapsed .brand-text,
    .gemini-sidebar.collapsed .brand-tag,
    .gemini-sidebar.collapsed .nav-item-label,
    .gemini-sidebar.collapsed .section-title,
    .gemini-sidebar.collapsed .item-label,
    .gemini-sidebar.collapsed :global(.recent-text),
    .gemini-sidebar.collapsed :global(.pin-icon),
    .gemini-sidebar.collapsed .profile-info,
    .gemini-sidebar.collapsed .profile-gear-btn {
      display: none !important;
    }
    .gemini-sidebar.collapsed .sidebar-nav-item,
    .gemini-sidebar.collapsed .notebook-item,
    .gemini-sidebar.collapsed :global(.recent-item) {
      justify-content: center;
      padding: 0.6rem 0;
    }
    .gemini-sidebar.collapsed .sidebar-footer-profile {
