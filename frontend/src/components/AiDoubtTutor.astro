---
import { apiBase } from "../lib/site";
---

<!-- Floating Trigger Button -->
<aside class="ai-tutor-widget-root" aria-label="Wallah AI Doubt Tutor">
  <button
    id="ai-tutor-trigger-btn"
    class="ai-tutor-fab"
    type="button"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="ai-tutor-drawer"
    title="Open Wallah AI Doubt Tutor (CBSE Class 10 Socratic Problem Solver)"
  >
    <span class="ai-fab-icon" aria-hidden="true">🤖</span>
    <span class="ai-fab-text">
      <strong>Ask AI Tutor</strong>
      <small>Socratic CBSE Coach</small>
    </span>
    <span class="ai-pulse-dot" aria-hidden="true"></span>
  </button>

  <!-- Backdrop Overlay -->
  <div id="ai-tutor-backdrop" class="ai-tutor-backdrop" onclick="window.closeAiTutorDrawer && window.closeAiTutorDrawer()" aria-hidden="true"></div>

  <!-- Slide-Over Drawer Modal -->
  <div id="ai-tutor-drawer" class="ai-tutor-drawer" role="dialog" aria-modal="true" aria-labelledby="ai-tutor-title">
    <div class="drawer-header">
      <div class="drawer-header-left">
        <span class="drawer-avatar">🤖</span>
        <div>
          <h2 id="ai-tutor-title" class="drawer-title">Wallah AI Doubt Tutor</h2>
          <span class="drawer-subtitle">CBSE Class 10 Socratic Problem Solver</span>
        </div>
      </div>
      <button
        id="ai-tutor-close-btn"
        class="drawer-close-btn"
        type="button"
        aria-label="Close AI Doubt Tutor"
        onclick="window.closeAiTutorDrawer && window.closeAiTutorDrawer()"
      >
        ✕
      </button>
    </div>

    <!-- Mode Selector Pills -->
    <div class="ai-mode-selector-wrap" role="radiogroup" aria-label="Tutor response mode">
      <button type="button" class="ai-mode-pill active" data-mode="hint" role="radio" aria-checked="true">
        💡 Socratic Hint
      </button>
      <button type="button" class="ai-mode-pill" data-mode="step_by_step" role="radio" aria-checked="false">
        📝 CBSE Model Solution
      </button>
      <button type="button" class="ai-mode-pill" data-mode="find_mistake" role="radio" aria-checked="false">
        🔍 Check My Steps
      </button>
    </div>

    <!-- Engine Bar -->
    <div class="ai-engine-bar">
      <div class="engine-info">
        <span class="engine-badge" id="ai-engine-badge">⚡ A2UI Generative Protocol Engine</span>
        <span class="engine-sub" id="ai-engine-sub">Interactive Native Widgets · Zero Cloud Latency</span>
      </div>
    </div>

    <!-- Active Chapter Context Pill -->
    <div id="ai-context-pill" class="ai-context-pill" style="display:none;">
      <span class="context-icon">📖</span>
      <span id="ai-context-text">Chapter: Loading...</span>
    </div>

    <!-- Chat Messages Stream -->
    <div id="ai-messages-container" class="ai-messages-container" role="log" aria-live="polite">
      <!-- Welcome message -->
      <div class="ai-message ai-bot-message">
        <div class="message-meta">
          <span class="bot-badge">Wallah AI Coach</span>
          <span class="message-time">Just now</span>
        </div>
        <div class="message-body">
          <p>
            Hello! I am your <strong>CBSE Class 10 Socratic Doubt Tutor</strong>. I help you master Maths, Science, Social Science, and Languages for the 2026 board exams.
          </p>
          <p>
            Choose your mode above:
          </p>
          <ul>
            <li><strong>💡 Socratic Hint:</strong> I guide you with formulas and theorems so you learn how to solve it yourself.</li>
            <li><strong>📝 CBSE Solution:</strong> I provide the complete answer structured according to official board marking rubrics.</li>
            <li><strong>🔍 Check My Steps:</strong> Paste your attempted calculation or proof to find where you went wrong!</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Quick Starter Question Chips -->
    <div class="ai-quick-prompts-wrap">
      <span class="quick-prompts-label">Try asking:</span>
      <div id="ai-quick-chips" class="quick-chips-row">
        <button type="button" class="quick-chip" data-query="How do I prove that √5 is irrational by contradiction?">
          Prove √5 is irrational
        </button>
        <button type="button" class="quick-chip" data-query="State and prove Thales Theorem (Basic Proportionality Theorem)">
          Thales Theorem proof
        </button>
        <button type="button" class="quick-chip" data-query="Explain sign conventions for concave and convex lenses">
          Lens sign conventions
        </button>
        <button type="button" class="quick-chip" data-query="What colour changes happen when green FeSO4 is heated?">
          FeSO₄ heating reaction
        </button>
      </div>
    </div>

    <!-- Input Bar -->
    <form id="ai-tutor-form" class="ai-input-form">
      <div class="input-wrap">
        <textarea
          id="ai-question-input"
          class="ai-question-textarea"
          rows="2"
          placeholder="Ask any question, theorem proof, or paste your numerical steps..."
          aria-label="Ask your doubt to the AI Tutor"
          required
        ></textarea>
        <button id="ai-send-btn" type="submit" class="ai-send-button" aria-label="Send question">
          <span>Ask</span> &rarr;
        </button>
      </div>
      <div class="form-bottom-row">
        <span class="ai-disclaimer">Zero fluff · Socratic hint &amp; CBSE marking rubrics</span>
        <button type="button" id="ai-clear-btn" class="ai-clear-link">Clear chat</button>
      </div>
    </form>
  </div>
</aside>

<script is:inline define:vars={{ apiBase }}>
  function initAiTutor() {
    const triggerBtn = document.getElementById('ai-tutor-trigger-btn');
    const drawer = document.getElementById('ai-tutor-drawer');
    const backdrop = document.getElementById('ai-tutor-backdrop');
    const closeBtn = document.getElementById('ai-tutor-close-btn');
    const form = document.getElementById('ai-tutor-form');
    const input = document.getElementById('ai-question-input');
    const sendBtn = document.getElementById('ai-send-btn');
    const clearBtn = document.getElementById('ai-clear-btn');
    const messagesContainer = document.getElementById('ai-messages-container');
    const modePills = document.querySelectorAll('.ai-mode-pill');
    const quickChips = document.querySelectorAll('.quick-chip');
    const contextPill = document.getElementById('ai-context-pill');
    const contextText = document.getElementById('ai-context-text');

    let currentMode = 'hint';
    let isWaiting = false;

    // Detect chapter from path
    function detectChapter() {
      const path = window.location.pathname;
      if (path.startsWith('/resources/') && path !== '/resources/' && path !== '/resources/sample-papers/' && path !== '/resources/flashcards/') {
        const parts = path.split('/').filter(Boolean);
        const slug = parts[parts.length - 1];
        if (slug) {
          const formatted = slug.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
          if (contextText) contextText.textContent = `Chapter: ${formatted}`;
          if (contextPill) contextPill.style.display = 'inline-flex';
          return formatted;
        }
      }
      if (contextPill) contextPill.style.display = 'none';
      return '';
    }

    const currentChapter = detectChapter();

    function openDrawer() {
      if (!drawer) return;
      drawer.classList.add('is-open');
      if (backdrop) backdrop.classList.add('is-open');
      if (triggerBtn) triggerBtn.setAttribute('aria-expanded', 'true');
      if (input) input.focus();
    }

    function closeDrawer() {
      if (!drawer) return;
      drawer.classList.remove('is-open');
      if (backdrop) backdrop.classList.remove('is-open');
      if (triggerBtn) triggerBtn.setAttribute('aria-expanded', 'false');
    }

    window.openAiTutorDrawer = openDrawer;
    window.closeAiTutorDrawer = closeDrawer;

    if (triggerBtn) triggerBtn.addEventListener('click', openDrawer);
    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    if (backdrop) backdrop.addEventListener('click', closeDrawer);

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer && drawer.classList.contains('is-open')) {
        closeDrawer();
      }
    });

    // Mode Selector
    modePills.forEach(pill => {
      pill.addEventListener('click', () => {
        modePills.forEach(p => {
          p.classList.remove('active');
          p.setAttribute('aria-checked', 'false');
        });
        pill.classList.add('active');
        pill.setAttribute('aria-checked', 'true');
        currentMode = pill.getAttribute('data-mode') || 'hint';
      });
    });

    // Quick Chips
    quickChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const query = chip.getAttribute('data-query');
        if (query) {
          input.value = query;
          handleSend();
        }
      });
    });

    // Clear chat
    clearBtn.addEventListener('click', () => {
      messagesContainer.innerHTML = `
        <div class="ai-message ai-bot-message">
          <div class="message-meta">
            <span class="bot-badge">Wallah AI Coach</span>
            <span class="message-time">Just now</span>
          </div>
          <div class="message-body">
            <p>Chat cleared. Ask me any question, theorem, or paste your numerical steps!</p>
          </div>
        </div>
      `;
    });

    function escapeHtml(text) {
      return text
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function formatMarkdown(text) {
      let out = escapeHtml(text);
      // Bold
      out = out.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      // Inline code
      out = out.replace(/`([^`]+)`/g, '<code>$1</code>');
      // Numbered lists or bullet lines
      out = out.replace(/\n\s*•\s*/g, '<br/>• ');
      out = out.replace(/\n\s*-\s*/g, '<br/>• ');
      // Line breaks
      out = out.replace(/\n/g, '<br/>');
      return out;
    }

    // ── A2UI (Agent-to-User Interface) Protocol Renderer ──
    function renderA2UI(components, container) {
      const surface = document.createElement('div');
      surface.className = 'a2ui-surface';

      (components || []).forEach(comp => {
        if (!comp || !comp.type) return;

        switch (comp.type) {
          case 'HeroBanner': {
            const hero = document.createElement('div');
            hero.className = 'a2ui-hero-banner';
            hero.innerHTML = `
              <div class="a2ui-hero-icon">${escapeHtml(comp.icon || '🎯')}</div>
              <div class="a2ui-hero-body">
                <span class="a2ui-badge-pill">${escapeHtml(comp.tag || 'A2UI Generative Card')}</span>
                <h3 class="a2ui-hero-title">${escapeHtml(comp.title || '')}</h3>
                <p class="a2ui-hero-sub">${escapeHtml(comp.subtitle || '')}</p>
              </div>
            `;
            surface.appendChild(hero);
            break;
          }

          case 'FormulaCard': {
            const card = document.createElement('div');
            card.className = 'a2ui-card a2ui-formula-card';
            let varsHtml = '';
            if (comp.variables && comp.variables.length > 0) {
              varsHtml = `
                <div class="a2ui-var-table">
                  ${comp.variables.map(v => `
                    <div class="a2ui-var-row">
                      <span class="a2ui-var-symbol">${escapeHtml(v.symbol)}</span>
                      <span class="a2ui-var-desc">${escapeHtml(v.desc)}</span>
                    </div>
                  `).join('')}
                </div>
              `;
            }
            card.innerHTML = `
              <div class="a2ui-card-label">📐 ${escapeHtml(comp.title || 'Governing Formula / Identity')}</div>
              <div class="a2ui-formula-box">${escapeHtml(comp.formula)}</div>
              ${varsHtml}
            `;
            surface.appendChild(card);
            break;
          }

          case 'StepList': {
            const card = document.createElement('div');
            card.className = 'a2ui-card a2ui-steps-card';
            const stepsHtml = (comp.steps || []).map((s, idx) => `
              <div class="a2ui-step-item">
                <span class="a2ui-step-num">${s.num || idx + 1}</span>
                <div class="a2ui-step-body">
                  <div class="a2ui-step-text">${formatMarkdown(s.text)}</div>
                  ${s.marks ? `<span class="a2ui-step-marks">${escapeHtml(s.marks)}</span>` : ''}
                </div>
              </div>
            `).join('');
            card.innerHTML = `
              <div class="a2ui-card-label">📝 ${escapeHtml(comp.title || 'CBSE Official Marking Rubric')}</div>
              <div class="a2ui-steps-list">${stepsHtml}</div>
            `;
            surface.appendChild(card);
            break;
          }

          case 'Callout': {
            const callout = document.createElement('div');
            callout.className = `a2ui-callout ${comp.variant || 'info'}`;
            const icon = comp.variant === 'warning' ? '⚠️' : (comp.variant === 'tip' ? '💡' : 'ℹ️');
            callout.innerHTML = `
              <div class="a2ui-callout-header">
                <span class="a2ui-callout-icon">${icon}</span>
                <strong>${escapeHtml(comp.title || '')}</strong>
              </div>
              <div class="a2ui-callout-text">${formatMarkdown(comp.text || '')}</div>
            `;
            surface.appendChild(callout);
            break;
          }

          case 'InteractiveDrill': {
            const drill = document.createElement('div');
            drill.className = 'a2ui-card a2ui-drill-card';
            drill.innerHTML = `
              <div class="a2ui-drill-header">
                <span class="a2ui-drill-badge">🎯 Interactive Knowledge Drill</span>
                <span class="a2ui-drill-sub">Tap an option to check</span>
              </div>
              <div class="a2ui-drill-q">${escapeHtml(comp.question)}</div>
              <div class="a2ui-drill-options"></div>
              <div class="a2ui-drill-feedback" style="display: none;"></div>
            `;
            const optsContainer = drill.querySelector('.a2ui-drill-options');
            const feedbackEl = drill.querySelector('.a2ui-drill-feedback');

            (comp.options || []).forEach((opt, idx) => {
              const btn = document.createElement('button');
              btn.type = 'button';
              btn.className = 'a2ui-drill-btn';
              btn.textContent = opt;
              btn.addEventListener('click', () => {
                const allBtns = optsContainer.querySelectorAll('.a2ui-drill-btn');
                allBtns.forEach((b, bIdx) => {
                  b.disabled = true;
                  if (bIdx === comp.correctIndex) {
                    b.classList.add('correct');
                    b.textContent = '✅ ' + b.textContent;
                  } else if (bIdx === idx) {
                    b.classList.add('wrong');
                    b.textContent = '❌ ' + b.textContent;
                  }
                });
                feedbackEl.style.display = 'block';
                if (idx === comp.correctIndex) {
                  feedbackEl.className = 'a2ui-drill-feedback correct-feedback';
                  feedbackEl.innerHTML = `<strong>🎉 Perfect!</strong> ${escapeHtml(comp.explanation || 'Great understanding of the concept!')}`;
                } else {
                  feedbackEl.className = 'a2ui-drill-feedback wrong-feedback';
                  feedbackEl.innerHTML = `<strong>💡 Key Takeaway:</strong> ${escapeHtml(comp.explanation || 'Review the rubric steps above!')}`;
                }
              });
              optsContainer.appendChild(btn);
            });

            surface.appendChild(drill);
            break;
          }

          case 'ActionRow': {
            const row = document.createElement('div');
            row.className = 'a2ui-actions-row';
            (comp.actions || []).forEach(act => {
              const a = document.createElement('a');
              a.className = `a2ui-action-btn ${act.isPrimary ? 'primary' : 'secondary'}`;
              a.href = act.href;
              a.textContent = act.label;
              row.appendChild(a);
            });
            surface.appendChild(row);
            break;
          }

          case 'Text': {
            const p = document.createElement('div');
            p.className = 'a2ui-text-block';
            p.innerHTML = formatMarkdown(comp.content || '');
            surface.appendChild(p);
            break;
          }
        }
      });

      container.appendChild(surface);
    }

    function appendMessage(sender, content, keyTerms) {
      const msgDiv = document.createElement('div');
      msgDiv.className = `ai-message ${sender === 'user' ? 'ai-user-message' : 'ai-bot-message'}`;

      const metaDiv = document.createElement('div');
      metaDiv.className = 'message-meta';
      metaDiv.innerHTML = `
        <span class="${sender === 'user' ? 'user-badge' : 'bot-badge'}">
          ${sender === 'user' ? 'You' : 'Wallah AI Tutor'}
        </span>
        <span class="message-time">${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>
      `;
      msgDiv.appendChild(metaDiv);

      const bodyDiv = document.createElement('div');
      bodyDiv.className = 'message-body';

      if (typeof content === 'object' && content !== null && content.a2ui && Array.isArray(content.components)) {
        renderA2UI(content.components, bodyDiv);
      } else {
        bodyDiv.innerHTML = formatMarkdown(typeof content === 'string' ? content : JSON.stringify(content));
      }

      if (keyTerms && keyTerms.length > 0) {
        const termsDiv = document.createElement('div');
        termsDiv.className = 'ai-key-terms-row';
        termsDiv.innerHTML = `
          <span class="terms-title">⭐ CBSE Marking Scheme Terms:</span>
          ${keyTerms.map(t => `<span class="term-badge">${escapeHtml(t)}</span>`).join('')}
        `;
        bodyDiv.appendChild(termsDiv);
      }

      msgDiv.appendChild(bodyDiv);
      messagesContainer.appendChild(msgDiv);
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    function showTyping() {
      const typingDiv = document.createElement('div');
      typingDiv.id = 'ai-typing-indicator';
      typingDiv.className = 'ai-message ai-bot-message typing-indicator';
      typingDiv.innerHTML = `
        <div class="message-meta"><span class="bot-badge">Wallah AI Tutor</span></div>
        <div class="typing-dots">
          <span></span><span></span><span></span>
        </div>
      `;
      messagesContainer.appendChild(typingDiv);
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    function removeTyping() {
      const typing = document.getElementById('ai-typing-indicator');
      if (typing) typing.remove();
    }

    // Client-side A2UI Protocol Solver
    function clientFallbackSolve(q, mode) {
      const lower = q.toLowerCase();

      // 1. Irrational Number Proofs
      if (lower.includes('irrational') || lower.includes('√2') || lower.includes('√5') || lower.includes('root 5') || lower.includes('root 2')) {
        return {
          a2ui: true,
          components: [
            {
              type: 'HeroBanner',
              icon: '📐',
              tag: 'CBSE Class 10 Real Numbers · 3 Marks',
              title: 'Proof by Contradiction: √5 is Irrational',
              subtitle: 'Structured step-by-step proof adhering to official board marking schemes.'
            },
            {
              type: 'FormulaCard',
              title: 'Fundamental Algebraic Identity',
              formula: 'a² = 5b²  ⇒  5 divides a²  ⇒  5 divides a',
              variables: [
                { symbol: 'a, b', desc: 'Co-prime positive integers with HCF(a, b) = 1, b ≠ 0' },
                { symbol: 'c', desc: 'Positive integer quotient such that a = 5c' }
              ]
            },
            {
              type: 'StepList',
              title: 'CBSE Official Marking Steps',
              steps: [
                { num: 1, text: 'Assume to the contrary that √5 is rational. Let √5 = a/b where a, b are co-prime integers (b ≠ 0).', marks: '½ Mark' },
                { num: 2, text: 'Square both sides: 5 = a²/b² ⇒ <strong>a² = 5b²</strong>. Since 5 divides 5b², 5 divides a², and therefore <strong>5 divides a</strong>.', marks: '1 Mark' },
                { num: 3, text: 'Substitute a = 5c into (1): (5c)² = 5b² ⇒ 25c² = 5b² ⇒ <strong>b² = 5c²</strong>.', marks: '½ Mark' },
                { num: 4, text: 'Since 5 divides 5c², 5 divides b², so <strong>5 divides b</strong>.', marks: '½ Mark' },
                { num: 5, text: 'Thus 5 is a common factor of both a and b. This <strong>contradicts</strong> the fact that a and b are co-prime. Hence, <strong>√5 is irrational</strong>.', marks: '½ Mark' }
              ]
            },
            {
              type: 'Callout',
              variant: 'warning',
              title: 'Common Board Examiner Trap',
              text: 'Always write the exact phrase <em>"where a and b are co-prime integers and b ≠ 0"</em> in Step 1. Missing the word "co-prime" costs a mandatory ½ mark reduction.'
            },
            {
              type: 'InteractiveDrill',
              question: 'If p is a prime number and p divides a², which theorem guarantees that p divides a?',
              options: [
                'Fundamental Theorem of Arithmetic (Theorem 1.2)',
                'Euclid Division Lemma',
                'Basic Proportionality Theorem'
              ],
              correctIndex: 0,
              explanation: 'By the Fundamental Theorem of Arithmetic (Theorem 1.2 in NCERT), if a prime p divides a², it must divide a where a is a positive integer.'
            },
            {
              type: 'ActionRow',
              actions: [
                { label: '🎯 Practice in Arena →', href: '/resources/practice-arena/', isPrimary: true },
                { label: '📖 Real Numbers Guide', href: '/resources/real-numbers/', isPrimary: false }
              ]
            }
          ],
          keyTerms: ['Proof by Contradiction', 'Co-prime integers', 'Fundamental Theorem of Arithmetic', 'Hence Proved']
        };
      }

      // 2. Thales Theorem (BPT)
      if (lower.includes('thales') || lower.includes('bpt') || lower.includes('triangle')) {
        return {
          a2ui: true,
          components: [
            {
              type: 'HeroBanner',
              icon: '🔺',
              tag: 'CBSE Class 10 Geometry · 4-5 Marks',
              title: 'Basic Proportionality Theorem (Thales\' Theorem)',
              subtitle: 'If a line is drawn parallel to one side of a triangle intersecting other sides in distinct points, sides are divided in the same ratio.'
            },
            {
              type: 'FormulaCard',
              title: 'Theorem Statement & Ratio',
              formula: 'AD / DB = AE / EC',
              variables: [
                { symbol: 'ΔABC', desc: 'Given triangle with line DE ∥ BC' },
                { symbol: 'D, E', desc: 'Points intersecting sides AB and AC respectively' }
              ]
            },
            {
              type: 'StepList',
              title: 'CBSE Proof Rubric Steps',
              steps: [
                { num: 1, text: '<strong>Construction</strong>: Join BE and CD. Draw DM ⊥ AC and EN ⊥ AB.', marks: '1 Mark' },
                { num: 2, text: 'Area(ΔADE) / Area(ΔBDE) = (½ · AD · EN) / (½ · DB · EN) = <strong>AD / DB</strong>.', marks: '1 Mark' },
                { num: 3, text: 'Area(ΔADE) / Area(ΔCDE) = (½ · AE · DM) / (½ · EC · DM) = <strong>AE / EC</strong>.', marks: '1 Mark' },
                { num: 4, text: 'Since ΔBDE and ΔCDE lie on the same base DE and between the same parallels DE ∥ BC, <strong>Area(ΔBDE) = Area(ΔCDE)</strong>.', marks: '1 Mark' },
                { num: 5, text: 'From equations (1), (2), and (3): <strong>AD / DB = AE / EC</strong>. [Hence Proved]', marks: '1 Mark' }
              ]
            },
            {
              type: 'InteractiveDrill',
              question: 'In ΔABC, DE ∥ BC. If AD = 3 cm, DB = 4.5 cm, and AE = 2 cm, what is the length of EC?',
              options: [
                '3.0 cm',
                '3.5 cm',
                '4.0 cm'
              ],
              correctIndex: 0,
              explanation: 'Using BPT: AD/DB = AE/EC ⇒ 3/4.5 = 2/EC ⇒ EC = (2 × 4.5) / 3 = 9 / 3 = 3.0 cm.'
            },
            {
              type: 'ActionRow',
              actions: [
                { label: '🎯 Triangles Practice Arena →', href: '/resources/practice-arena/', isPrimary: true },
                { label: '📖 Triangles Revision Notes', href: '/resources/triangles/', isPrimary: false }
              ]
            }
          ],
          keyTerms: ['Basic Proportionality Theorem', 'Same base and between same parallels', 'AD / DB = AE / EC']
        };
      }

      // 3. Optics / Lens / Mirror
      if (lower.includes('lens') || lower.includes('mirror') || lower.includes('sign convention') || lower.includes('focal')) {
        return {
          a2ui: true,
          components: [
            {
              type: 'HeroBanner',
              icon: '🔬',
              tag: 'CBSE Class 10 Physics · 3-5 Marks',
              title: 'Optics: Mirror & Lens Sign Conventions',
              subtitle: 'New Cartesian Sign Convention and board numerical formulas.'
            },
            {
              type: 'FormulaCard',
              title: 'Governing Optics Formulas',
              formula: 'Mirror: 1/f = 1/v + 1/u (m = -v/u)  |  Lens: 1/f = 1/v - 1/u (m = +v/u)',
              variables: [
                { symbol: 'u', desc: 'Object distance (ALWAYS NEGATIVE for all real setups)' },
                { symbol: 'v', desc: 'Image distance (+ for real behind lens, - for virtual front)' },
                { symbol: 'f', desc: 'Focal length (+ for convex, - for concave)' },
                { symbol: 'm', desc: 'Magnification (negative = real & inverted; positive = virtual & erect)' }
              ]
            },
            {
              type: 'Callout',
              variant: 'warning',
              title: 'The #1 Sign Convention Error',
              text: 'Never assume the sign of the unknown quantity (e.g. v). Substitute given values with proper signs, and the formula will automatically yield the correct sign for the unknown!'
            },
            {
              type: 'InteractiveDrill',
              question: 'A convex lens of focal length f = +15 cm has an object at u = -30 cm (at 2F₁). Where is the image formed?',
              options: [
                'At 2F₂ (v = +30 cm), real and inverted',
                'At F₂ (v = +15 cm), real and point-sized',
                'Between F₂ and 2F₂ (v = +20 cm), diminished'
              ],
              correctIndex: 0,
              explanation: 'When an object is at 2F (twice focal length), image forms at 2F on the other side: 1/v = 1/15 + 1/(-30) = 1/30 ⇒ v = +30 cm (Real & Inverted, same size).'
            },
            {
              type: 'ActionRow',
              actions: [
                { label: '🎯 Practice Optics Numericals →', href: '/resources/practice-arena/', isPrimary: true },
                { label: '📖 Light Chapter Guide', href: '/resources/light-reflection-refraction/', isPrimary: false }
              ]
            }
          ],
          keyTerms: ['Cartesian Sign Convention', 'u is always negative', 'Lens formula: 1/f = 1/v - 1/u', 'Real and Inverted']
        };
      }

      // 4. Electricity / Ohm's Law
      if (lower.includes('ohm') || lower.includes('resistor') || lower.includes('circuit') || lower.includes('electric') || lower.includes('current')) {
        return {
          a2ui: true,
          components: [
            {
              type: 'HeroBanner',
              icon: '⚡',
              tag: 'CBSE Class 10 Physics · Electricity',
              title: 'Circuit Analysis & Ohm\'s Law Mastery',
              subtitle: 'Formulas, series/parallel combinations, and Joule\'s heating law.'
            },
            {
              type: 'FormulaCard',
              title: 'Governing Circuit Formulas',
              formula: 'V = I · R   |   R_series = R₁ + R₂   |   1/R_parallel = 1/R₁ + 1/R₂',
              variables: [
                { symbol: 'V', desc: 'Potential difference in Volts (V)' },
                { symbol: 'I', desc: 'Current in Amperes (A)' },
                { symbol: 'R', desc: 'Resistance in Ohms (Ω)' },
                { symbol: 'P, H', desc: 'Power P = VI = I²R = V²/R  |  Heat H = I²Rt' }
              ]
            },
            {
              type: 'InteractiveDrill',
              question: 'Two identical 10 Ω resistors are connected in parallel, and this combo is connected in series with a 5 Ω resistor. What is the total equivalent resistance?',
              options: [
                '10 Ω',
                '15 Ω',
                '25 Ω'
              ],
              correctIndex: 0,
              explanation: 'Parallel combo: 10 || 10 = (10 × 10) / (10 + 10) = 5 Ω. Adding in series with 5 Ω: R_total = 5 + 5 = 10 Ω.'
            },
            {
              type: 'ActionRow',
              actions: [
                { label: '🎯 Generate Circuit Problems →', href: '/resources/practice-arena/', isPrimary: true },
                { label: '📖 Electricity Guide', href: '/resources/electricity/', isPrimary: false }
              ]
            }
          ],
          keyTerms: ['Ohm\'s Law', 'V = IR', 'Equivalent Resistance', 'Joule\'s Law of Heating']
        };
      }

      // 5. Chemistry / Chemical Reactions
      if (lower.includes('feso4') || lower.includes('reaction') || lower.includes('chemical') || lower.includes('oxidation') || lower.includes('redox')) {
        return {
          a2ui: true,
          components: [
            {
              type: 'HeroBanner',
              icon: '🧪',
              tag: 'CBSE Class 10 Chemistry · 2-3 Marks',
              title: 'Thermal Decomposition of Ferrous Sulphate (FeSO₄)',
              subtitle: 'Observation, colour changes, and balanced chemical equation.'
            },
            {
              type: 'FormulaCard',
              title: 'Balanced Chemical Equation',
              formula: '2FeSO₄(s) ──Δ──> Fe₂O₃(s) + SO₂(g) + SO₃(g)',
              variables: [
                { symbol: 'FeSO₄ · 7H₂O', desc: 'Hydrated crystals (Green colour)' },
                { symbol: 'Fe₂O₃', desc: 'Ferric oxide residue (Reddish-brown solid)' },
                { symbol: 'SO₂, SO₃', desc: 'Pungent suffocating smell of burning sulphur' }
              ]
            },
            {
              type: 'Callout',
              variant: 'tip',
              title: 'Examiner Observation Checklist',
              text: 'State two distinct observations: (1) Green colour turns reddish-brown solid residue; (2) Evolution of colourless gas with characteristic odour of burning sulphur.'
            },
            {
              type: 'InteractiveDrill',
              question: 'Which type of chemical reaction occurs when green ferrous sulphate crystals are heated in a dry boiling tube?',
              options: [
                'Thermal Decomposition Reaction',
                'Displacement Reaction',
                'Double Displacement Reaction'
              ],
              correctIndex: 0,
              explanation: 'A single reactant (FeSO₄) breaks down into multiple simpler products (Fe₂O₃, SO₂, SO₃) under the influence of heat (thermal decomposition).'
            },
            {
              type: 'ActionRow',
              actions: [
                { label: '🎯 Chemistry Practice Arena →', href: '/resources/practice-arena/', isPrimary: true },
                { label: '📖 Chemical Reactions Guide', href: '/resources/chemical-reactions-equations/', isPrimary: false }
              ]
            }
          ],
          keyTerms: ['Thermal Decomposition', 'Ferric oxide', 'Sulphur dioxide', 'Endothermic']
        };
      }

      // 6. General Socratic / Model Answer
      return {
        a2ui: true,
        components: [
          {
            type: 'HeroBanner',
            icon: '💡',
            tag: 'Wallah Socratic Guidance',
            title: `CBSE Board Strategy: "${q}"`,
            subtitle: 'Structured approach to maximize step-marking in the 2026 board exam.'
          },
          {
            type: 'StepList',
            title: '3-Step Golden Rule for Board Numericals & Proofs',
            steps: [
              { num: 1, text: '<strong>State Given Quantities & Target</strong>: Always write "Given:", "To Prove / To Find:" with appropriate standard SI units.', marks: '½ Mark' },
              { num: 2, text: '<strong>State Governing Formula / Theorem</strong>: Quote the exact NCERT theorem or equation before substituting numbers.', marks: '1 Mark' },
              { num: 3, text: '<strong>Show Neat Stepwise Calculation</strong>: Highlight your final answer inside a rectangular box with final SI units.', marks: '½-1 Mark' }
            ]
          },
          {
            type: 'Callout',
            variant: 'tip',
            title: 'Try Our Instant Interactive Topics',
            text: 'Ask about <em>"Prove √5 is irrational"</em>, <em>"Thales theorem proof"</em>, <em>"Lens sign conventions"</em>, <em>"Ohm\'s law circuit numericals"</em>, or <em>"FeSO4 heating reaction"</em> to see dynamic A2UI generative widgets!'
          },
          {
            type: 'ActionRow',
            actions: [
              { label: '🎯 Enter Endless Practice Arena →', href: '/resources/practice-arena/', isPrimary: true },
              { label: '📚 Explore 56 Chapter Guides', href: '/resources/', isPrimary: false }
            ]
          }
        ],
        keyTerms: ['CBSE Marking Rubric', 'Step-by-Step Proof', 'SI Units', 'Formula State']
      };
    }

    async function handleSend() {
      const q = input.value.trim();
      if (!q || isWaiting) return;

      appendMessage('user', q);
      input.value = '';
      isWaiting = true;
      sendBtn.disabled = true;
      showTyping();

      try {
        const response = await fetch('/api/v1/ai/doubt-tutor', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            question: q,
            chapter: currentChapter,
            mode: currentMode,
          }),
        });

        if (response.ok) {
          const data = await response.json();
          removeTyping();
          appendMessage('bot', data.answer, data.keyTerms);
        } else {
          throw new Error('Server returned non-200');
        }
      } catch (err) {
        // Fallback to client-side A2UI Generative Protocol Engine
        removeTyping();
        const fallback = clientFallbackSolve(q, currentMode);
        appendMessage('bot', fallback, fallback.keyTerms);
      } finally {
        isWaiting = false;
        sendBtn.disabled = false;
        input.focus();
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      handleSend();
    });

    // Enter to submit without shift
    if (input) {
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          handleSend();
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAiTutor);
  } else {
    initAiTutor();
  }
</script>

