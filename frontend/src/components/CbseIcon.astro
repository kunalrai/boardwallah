---
// CbseIcon.astro - Unified-stroke custom SVG icons for CBSE Class 10 subjects & chapters
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className = "" } = Astro.props;
---

<svg
  class={`cbse-icon ${className}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === "math" || name === "numbers" ? (
    <g>
      <rect x="3" y="3" width="18" height="18" rx="3" />
      <path d="M7 10h3M8.5 7v6M14 8h3v2.5h-3v2.5h3" />
    </g>
  ) : name === "polynomials" || name === "chart" ? (
    <g>
      <path d="M3 3v18h18" />
      <path d="m7 15 4-5 4 3 6-7" />
    </g>
  ) : name === "linear" || name === "ruler" ? (
    <g>
      <path d="m2 22 20-20M6 8l2 2M10 12l2 2M14 16l2 2M18 20l2 2" />
    </g>
  ) : name === "parabola" || name === "quadratic" ? (
    <g>
      <path d="M3 20h18" />
      <path d="M4 5c4 14 12 14 16 0" />
    </g>
  ) : name === "ladder" || name === "ap" ? (
    <g>
      <path d="M4 21h16M4 16h13M4 11h9M4 6h5" />
    </g>
  ) : name === "triangle" || name === "thales" ? (
    <g>
      <polygon points="12 3 2 21 22 21" />
      <line x1="7" y1="12" x2="17" y2="12" />
    </g>
  ) : name === "pin" || name === "coordinate" ? (
    <g>
      <circle cx="12" cy="10" r="3" />
      <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z" />
    </g>
  ) : name === "trig" || name === "angle" ? (
    <g>
      <polygon points="3 20 21 20 21 4 3 20" />
      <path d="M17 20v-4h4" />
    </g>
  ) : name === "tower" || name === "heights" ? (
    <g>
      <line x1="12" y1="2" x2="12" y2="22" />
      <path d="m8 6 8-4M7 12l10-4M5 18l14-4M3 22h18" />
    </g>
  ) : name === "circle" || name === "tangent" ? (
    <g>
      <circle cx="12" cy="12" r="8" />
      <line x1="4" y1="20" x2="20" y2="4" />
    </g>
  ) : name === "sector" || name === "pie" ? (
    <g>
      <path d="M21 12A9 9 0 0 0 12 3v9z" />
      <path d="M12 12V3a9 9 0 1 0 9 9z" />
    </g>
  ) : name === "cube" || name === "solid" ? (
    <g>
      <path d="m21 16-9 5-9-5V8l9-5 9 5v8z" />
      <path d="m3 8 9 5 9-5M12 13v8" />
    </g>
  ) : name === "stats" || name === "bars" ? (
    <g>
      <line x1="18" y1="20" x2="18" y2="10" />
      <line x1="12" y1="20" x2="12" y2="4" />
      <line x1="6" y1="20" x2="6" y2="14" />
    </g>
  ) : name === "dice" || name === "probability" ? (
    <g>
      <rect x="3" y="3" width="18" height="18" rx="4" />
      <circle cx="8" cy="8" r="1.5" fill="currentColor" />
      <circle cx="16" cy="16" r="1.5" fill="currentColor" />
      <circle cx="12" cy="12" r="1.5" fill="currentColor" />
    </g>
  ) : name === "flask" || name === "chemistry" ? (
    <g>
      <path d="M10 2v5.5L4.5 18a2.5 2.5 0 0 0 2.2 3.5h10.6a2.5 2.5 0 0 0 2.2-3.5L14 7.5V2" />
      <path d="M8.5 2h7M7 15h10" />
    </g>
  ) : name === "test-tube" || name === "acids" ? (
    <g>
      <path d="M14.5 2v17.5c0 1.4-1.1 2.5-2.5 2.5s-2.5-1.1-2.5-2.5V2" />
      <path d="M8.5 2h7M9.5 12h5" />
    </g>
  ) : name === "metals" || name === "gear" ? (
    <g>
      <circle cx="12" cy="12" r="3" />
      <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1l2.1-2.1M17 7l2.1-2.1" />
    </g>
  ) : name === "carbon" || name === "diamond" ? (
    <g>
      <path d="M6 3h12l4 7-10 11L2 10l4-7z" />
      <path d="M2 10h20M12 21 8 10l4-7 4 7-4 11" />
    </g>
  ) : name === "light" || name === "ray" ? (
    <g>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4" />
    </g>
  ) : name === "eye" || name === "vision" ? (
    <g>
      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
      <circle cx="12" cy="12" r="3" />
    </g>
  ) : name === "bolt" || name === "electricity" ? (
    <g>
      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
    </g>
  ) : name === "magnet" ? (
    <g>
      <path d="M4 14a8 8 0 0 1 16 0v6h-4v-6a4 4 0 0 0-8 0v6H4v-6z" />
      <line x1="4" y1="17" x2="8" y2="17" />
      <line x1="16" y1="17" x2="20" y2="17" />
    </g>
  ) : name === "leaf" || name === "biology" ? (
    <g>
      <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2.5 1.5 5.5.5 8.5-1.2 3.6-4.5 6.5-8.5 7.5z" />
      <path d="M2 21c0-3 1.8-5.7 4.5-6.8" />
    </g>
  ) : name === "brain" ? (
    <g>
      <path d="M12 5a3 3 0 0 0-5.6 1.5A3.5 3.5 0 0 0 3 10a3.5 3.5 0 0 0 2 3.1A3 3 0 0 0 6 18h1a2 2 0 0 0 2-2v-4" />
      <path d="M12 5a3 3 0 0 1 5.6 1.5A3.5 3.5 0 0 1 21 10a3.5 3.5 0 0 1-2 3.1A3 3 0 0 1 18 18h-1a2 2 0 0 1-2-2v-4" />
    </g>
  ) : name === "flower" || name === "reproduce" ? (
    <g>
      <circle cx="12" cy="12" r="3" />
      <path d="M12 2a4 4 0 0 0-4 4 4 4 0 0 0 8 0 4 4 0 0 0-4-4z" />
      <path d="M12 14a4 4 0 0 0-4 4 4 4 0 0 0 8 0 4 4 0 0 0-4-4z" />
      <path d="M2 12a4 4 0 0 0 4 4 4 4 0 0 0 0-8 4 4 0 0 0-4 4z" />
      <path d="M14 12a4 4 0 0 0 4 4 4 4 0 0 0 0-8 4 4 0 0 0-4 4z" />
    </g>
  ) : name === "dna" || name === "heredity" ? (
    <g>
      <path d="m2 15 2 2 4-4-2-2zM16 3l2 2 4-4-2-2z" />
      <path d="m7 7 10 10M17 7l-3 3M7 17l3-3" />
    </g>
  ) : name === "globe" || name === "earth" ? (
    <g>
      <circle cx="12" cy="12" r="10" />
      <path d="M12 2a14.5 14.5 0 0 0 0 20M12 2a14.5 14.5 0 0 1 0 20M2 12h20" />
    </g>
  ) : name === "book" || name === "notes" ? (
    <g>
      <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
      <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
    </g>
  ) : name === "quill" || name === "feather" ? (
    <g>
      <path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L3 11.5V21h9.5z" />
      <line x1="16" y1="8" x2="2" y2="22" />
      <line x1="17.5" y1="15" x2="9" y2="15" />
    </g>
  ) : name === "pencil" || name === "write" ? (
    <g>
      <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z" />
    </g>
  ) : name === "search" ? (
    <g>
      <circle cx="11" cy="11" r="8" />
      <line x1="21" y1="21" x2="16.65" y2="16.65" />
    </g>
  ) : name === "image" || name === "diagram" ? (
    <g>
      <rect x="3" y="3" width="18" height="18" rx="2" />
      <circle cx="8.5" cy="8.5" r="1.5" />
      <polyline points="21 15 16 10 5 21" />
    </g>
  ) : (
    <g>
      <circle cx="12" cy="12" r="10" />
      <line x1="12" y1="8" x2="12" y2="12" />
      <line x1="12" y1="16" x2="12.01" y2="16" />
    </g>
  )}
</svg>

<style>
  .cbse-icon {
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
  }
</style>
