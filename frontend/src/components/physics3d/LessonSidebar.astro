---
import type { PhysicsLessonConfig } from "../../physics-engine/types/lesson";
import { getLessonsBySubject } from "../../physics-engine/registry/LessonRegistry";
import ObjectSelector from "./ObjectSelector.astro";

interface Props {
  lesson: PhysicsLessonConfig;
}
const { lesson } = Astro.props;
const allLessons = getLessonsBySubject(lesson.subject);
---

<aside class="p3d-left-sidebar" aria-label="Component anatomy and lab navigation">
  {lesson.objects.length > 0 && (
    <section class="p3d-panel-card">
      <ObjectSelector objects={lesson.objects} />
    </section>
  )}

  <section class="p3d-panel-card">
    <h3>Other 3D Labs</h3>
    <nav class="p3d-concept-nav" aria-label="Switch 3D Physics lesson">
      {allLessons.map((item) => (
        <a
          href={item.slug}
          class={`p3d-concept-link ${item.id === lesson.id ? "current" : ""}`}
          aria-current={item.id === lesson.id ? "page" : undefined}
        >
          {item.title}
        </a>
      ))}
    </nav>
  </section>
</aside>

<style>
  .p3d-left-sidebar {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .p3d-panel-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 0.9rem;
  }
  .p3d-panel-card h3 {
    margin: 0 0 0.55rem;
    font-size: 0.92rem;
    color: #0f172a;
  }
  .p3d-concept-nav {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-height: 380px;
    overflow-y: auto;
  }
  .p3d-concept-link {
    display: block;
    padding: 0.4rem 0.65rem;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 500;
    color: #1e293b;
    text-decoration: none;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    transition: all 0.15s ease;
  }
  .p3d-concept-link:hover {
    border-color: #1a73e8;
    color: #1a73e8;
    background: #eff6ff;
  }
  .p3d-concept-link.current {
    background: #eff6ff;
    border-color: #93c5fd;
    color: #1d4ed8;
    font-weight: 600;
  }
</style>
