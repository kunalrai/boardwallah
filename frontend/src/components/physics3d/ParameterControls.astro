---
import type { LessonParameterControl } from "../../physics-engine/types/lesson";

interface Props {
  controls?: LessonParameterControl[];
}
const { controls = [] } = Astro.props;
---

{controls.length > 0 && (
  <section class="p3d-panel-card p3d-params-card" aria-label="Experiment Parameters">
    <div class="p3d-params-head">
      <h3>Experimental Parameters</h3>
      <button type="button" class="p3d-reset-params-btn" data-action="reset-simulation">
        Reset
      </button>
    </div>
    <div class="p3d-params-list">
      {controls.map((ctrl) => (
        <div class="p3d-param-item">
          {ctrl.type === "range" && (
            <label class="p3d-range-label">
              <span class="p3d-param-top">
                <span>{ctrl.label}</span>
                <strong data-param-value={ctrl.key}>
                  {ctrl.defaultValue}{ctrl.unit ?? ""}
                </strong>
              </span>
              <input
                type="range"
                min={ctrl.min}
                max={ctrl.max}
                step={ctrl.step ?? 1}
                value={String(ctrl.defaultValue)}
                data-param-key={ctrl.key}
                data-param-unit={ctrl.unit ?? ""}
                data-param-type="number"
              />
            </label>
          )}
          {ctrl.type === "select" && (
            <label class="p3d-select-label">
              <span>{ctrl.label}</span>
              <select data-param-key={ctrl.key} data-param-type="string">
                {(ctrl.options ?? []).map((opt) => (
                  <option value={opt.value} selected={opt.value === ctrl.defaultValue}>
                    {opt.label}
                  </option>
                ))}
              </select>
            </label>
          )}
          {ctrl.type === "toggle" && (
            <label class="p3d-toggle-label">
              <input
                type="checkbox"
                checked={Boolean(ctrl.defaultValue)}
                data-param-key={ctrl.key}
                data-param-type="boolean"
              />
              <span>{ctrl.label}</span>
            </label>
          )}
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .p3d-panel-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 0.9rem;
  }
  .p3d-params-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }
  .p3d-params-head h3 {
    margin: 0;
    font-size: 0.92rem;
    color: #0f172a;
  }
  .p3d-reset-params-btn {
    border: 1px solid #cbd5e1;
    background: #f8fafc;
    color: #334155;
    font-size: 0.74rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    cursor: pointer;
  }
  .p3d-params-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .p3d-range-label,
  .p3d-select-label {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #1e293b;
  }
  .p3d-param-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .p3d-param-top strong {
    color: #1a73e8;
    font-variant-numeric: tabular-nums;
  }
  .p3d-range-label input[type="range"] {
    width: 100%;
    accent-color: #1a73e8;
    cursor: pointer;
  }
  .p3d-select-label select {
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 0.38rem 0.5rem;
    font-size: 0.8rem;
    background: #ffffff;
  }
  .p3d-toggle-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #1e293b;
    cursor: pointer;
  }
  .p3d-toggle-label input {
    width: 16px;
    height: 16px;
    accent-color: #1a73e8;
  }
</style>
