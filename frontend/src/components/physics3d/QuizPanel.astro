---
import type { LessonQuizQuestion } from "../../physics-engine/types/lesson";

interface Props {
  questions: LessonQuizQuestion[];
}
const { questions } = Astro.props;
---

{questions.length > 0 && (
  <section class="p3d-quiz-panel" aria-label="Concept Check Quiz">
    <div class="p3d-quiz-header">
      <div>
        <h3>CBSE Concept Check Quiz</h3>
        <p>Test your understanding after experimenting with the 3D simulation.</p>
      </div>
      <span class="p3d-quiz-score" data-quiz-score>Score: 0 / {questions.length}</span>
    </div>

    <div class="p3d-quiz-questions">
      {questions.map((q, qIdx) => (
        <div class="p3d-quiz-card" data-quiz-question={q.id} data-correct-index={q.correctIndex}>
          <p class="p3d-q-title">
            <span class="p3d-q-num">Q{qIdx + 1}.</span> {q.question}
          </p>
          <div class="p3d-q-options">
            {q.options.map((opt, optIdx) => (
              <button
                type="button"
                class="p3d-q-opt-btn"
                data-opt-index={optIdx}
              >
                <span class="p3d-opt-letter">{String.fromCharCode(65 + optIdx)}.</span>
                <span>{opt}</span>
              </button>
            ))}
          </div>
          <p class="p3d-q-explanation" hidden>
            <strong>Explanation:</strong> {q.explanation}
          </p>
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .p3d-quiz-panel {
    margin-top: 1.1rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 1.15rem;
  }
  .p3d-quiz-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.9rem;
  }
  .p3d-quiz-header h3 {
    margin: 0 0 0.2rem;
    font-size: 1.05rem;
    color: #0f172a;
  }
  .p3d-quiz-header p {
    margin: 0;
    font-size: 0.82rem;
    color: #64748b;
  }
  .p3d-quiz-score {
    font-size: 0.82rem;
    font-weight: 700;
    color: #1d4ed8;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
  }
  .p3d-quiz-questions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0.85rem;
  }
  .p3d-quiz-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 0.85rem;
  }
  .p3d-q-title {
    margin: 0 0 0.6rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: #0f172a;
  }
  .p3d-q-num {
    color: #1a73e8;
  }
  .p3d-q-options {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .p3d-q-opt-btn {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    text-align: left;
    padding: 0.45rem 0.65rem;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #1e293b;
    font-size: 0.8rem;
    cursor: pointer;
  }
  .p3d-q-opt-btn:hover:not(:disabled) {
    border-color: #1a73e8;
  }
  .p3d-q-opt-btn.correct {
    background: #ecfdf5;
    border-color: #10b981;
    color: #065f46;
    font-weight: 600;
  }
  .p3d-q-opt-btn.incorrect {
    background: #fef2f2;
    border-color: #ef4444;
    color: #991b1b;
  }
  .p3d-opt-letter {
    font-weight: 700;
  }
  .p3d-q-explanation {
    margin: 0.6rem 0 0;
    padding: 0.5rem 0.65rem;
    border-radius: 8px;
    background: #eff6ff;
    color: #1e3a8a;
    font-size: 0.78rem;
  }
</style>
