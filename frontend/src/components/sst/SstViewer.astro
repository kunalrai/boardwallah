  }
  .voice-lang-picker select:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.15);
  }
  .voice-transcript {
    font-size: 0.82rem;
    color: #475569;
    font-style: italic;
  }
  .voice-wave {
    display: flex;
    align-items: center;
