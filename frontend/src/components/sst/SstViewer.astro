    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }
  .voice-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.42rem 0.95rem;
    border-radius: 999px;
    border: 1px solid transparent;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    line-height: 1.2;
    transition: all 0.15s ease;
  }
  .voice-btn.primary {
    background: #1e3a8a;
    color: #ffffff;
    border-color: #1e3a8a;
    box-shadow: 0 1px 4px rgba(30, 58, 138, 0.2);
  }
  .voice-btn.primary:hover {
    background: #2563eb;
    border-color: #2563eb;
  }
  .voice-btn.secondary {
    background: #ffffff;
    color: #334155;
    border-color: #cbd5e1;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05);
  }
  .voice-btn.secondary:hover {
    background: #fee2e2;
    border-color: #fca5a5;
    color: #dc2626;
  }
  .voice-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .voice-lang-picker {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #334155;
  }
  .voice-lang-picker select {
    padding: 0.3rem 0.6rem;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #0f172a;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    outline: none;
    transition: border-color 0.15s ease;
  }
  .voice-lang-picker select:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.15);
  }
  .voice-transcript {
    font-size: 0.82rem;
    color: #475569;
    font-style: italic;
  }
  .voice-wave {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .voice-wave span {
    width: 3px;
    height: 12px;
    background: #2563eb;
    animation: waveAnim 0.6s infinite ease-in-out alternate;
  }
  @keyframes waveAnim {
    from { height: 4px; }
    to { height: 16px; }
  }

  /* Grid Layout */
  .sst-workspace-grid {
    display: grid;
    grid-template-columns: 290px minmax(0, 1fr) 320px;
    gap: 1rem;
