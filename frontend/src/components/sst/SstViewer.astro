    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05);
  }
  .voice-btn.secondary:hover {
    background: #fee2e2;
    border-color: #fca5a5;
    color: #dc2626;
  }
  .voice-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .voice-lang-picker {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #334155;
  }
  .voice-lang-picker select {
    padding: 0.3rem 0.6rem;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
