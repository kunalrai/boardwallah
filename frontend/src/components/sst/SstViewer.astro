---
import type { PhysicsLessonConfig } from "../../physics-engine/types/lesson";
import LessonHeader from "../physics3d/LessonHeader.astro";
import LoadingIndicator from "../physics3d/LoadingIndicator.astro";
import ErrorFallback from "../physics3d/ErrorFallback.astro";
import { CBSE_SST_MAP_PINS } from "../../data/sst/sst-map-data";

interface Props {
  lesson: PhysicsLessonConfig;
}

const { lesson } = Astro.props;
const viewerId = `bw-sst-viewer-${lesson.id}`;
const configScriptId = `bw-sst-config-${lesson.id}`;
const relevantPins = CBSE_SST_MAP_PINS.filter((p) => p.chapterId === lesson.id || lesson.id.includes(p.chapterId));
const hasVideo = Boolean(lesson.videoFallback);
const isFrenchRev = lesson.id === "sst-nationalism-europe";
---

<div class="sst-shell" id={viewerId} data-sst-viewer data-config-id={configScriptId}>
  <LessonHeader lesson={lesson} />

  <!-- SST Workstation Mode Switcher -->
  <nav class="sst-mode-bar" role="tablist" aria-label="SST Learning Modes">
    {hasVideo ? (
      <button type="button" class="sst-mode-tab active" data-mode-btn="video" aria-selected="true">
        <span class="mode-icon">🎬</span> Video Lesson
      </button>
    ) : (
      <button type="button" class="sst-mode-tab active" data-mode-btn="explore" aria-selected="true">
        <span class="mode-icon">🌐</span> 3D Interactive Stage
      </button>
    )}
    <button type="button" class="sst-mode-tab" data-mode-btn="map" aria-selected="false">
      <span class="mode-icon">🗺️</span> Interactive Map
    </button>
    <button type="button" class="sst-mode-tab" data-mode-btn="experiment" aria-selected="false">
      <span class="mode-icon">⚡</span> Virtual Experiment
    </button>
    <button type="button" class="sst-mode-tab" data-mode-btn="quiz" aria-selected="false">
      <span class="mode-icon">📝</span> Quiz Mode ({lesson.quiz.length} Qs)
    </button>
    <button type="button" class="sst-mode-tab" data-mode-btn="exam" aria-selected="false">
      <span class="mode-icon">🎯</span> CBSE Exam Mode
    </button>
  </nav>

  <div class="sst-workspace-grid">
    <!-- Left Navigation: Historical Timeline & Steps -->
    <aside class="sst-col-left">
      <!-- Historical Timeline & Steps -->
      <div class="sst-panel-card">
        <div class="card-header">
          <h3>⏳ Chronological Steps</h3>
          <span class="step-badge" data-step-counter>1 / {lesson.learningSteps.length}</span>
        </div>
        <div class="sst-steps-list">
          {lesson.learningSteps.map((step, idx) => (
            <button
              type="button"
              class={`sst-step-item ${idx === 0 ? "active" : ""}`}
              data-step-nav={idx}
            >
              <span class="step-num">{step.stepNumber}</span>
              <div class="step-text">
                <strong>{step.title.replace(/^\d+\.\s*/, "")}</strong>
                <p>{step.description}</p>
                {step.videoUrl && (
                  <span
                    class="step-video-badge"
                    data-trigger-video
                    data-video-time={step.videoTime ?? 0}
                    title={step.videoCaption ?? "Watch Scene"}
                  >
                    🎬 Watch Scene ({step.videoTime !== undefined ? `${Math.floor(step.videoTime / 60).toString().padStart(2, '0')}:${(step.videoTime % 60).toString().padStart(2, '0')}` : 'HD'})
                  </span>
                )}
              </div>
            </button>
          ))}
        </div>
      </div>

      <!-- CBSE Map Work Quick Access -->
      {relevantPins.length > 0 && (
        <div class="sst-panel-card sst-map-panel">
          <div class="card-header">
            <h3>📍 CBSE Map Work (5 Marks)</h3>
          </div>
          <ul class="sst-pin-list">
            {relevantPins.map((pin) => (
              <li>
                <button type="button" class="pin-link" data-focus-pin={pin.id}>
                  <span class="pin-dot"></span>
                  <strong>{pin.name}</strong> ({pin.state})
                </button>
                <small>{pin.mapTip}</small>
              </li>
            ))}
          </ul>
        </div>
      )}
    </aside>

    <!-- Center Interactive Stage -->
    <main class="sst-col-center">
      {hasVideo ? (
        <div class="sst-stage-card sst-video-stage" data-video-stage>
          <!-- Video Stage Toolbar -->
          <div class="sst-toolbar">
            <div class="tool-left">
              <span class="live-dot"></span>
              <strong>🎬 Interactive Video Stage</strong>
            </div>
            <div class="tool-actions">
              <button type="button" class="tool-btn" data-action="restart-video" title="Restart from 00:00">
                <svg viewBox="0 0 24 24" class="tool-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                  <path d="M3 3v5h5"/>
                </svg>
                <span>Restart</span>
              </button>
              <button type="button" class="tool-btn" data-action="toggle-play" title="Play / Pause Video">
                <svg viewBox="0 0 24 24" class="tool-icon" fill="currentColor" data-play-icon>
                  <polygon points="5 3 19 12 5 21 5 3"/>
                </svg>
                <span data-play-label>Play</span>
              </button>
              <button type="button" class="tool-btn" data-action="toggle-mute" title="Mute / Unmute Audio">
                <svg viewBox="0 0 24 24" class="tool-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
                  <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
                </svg>
                <span data-mute-label>Mute</span>
              </button>
              <button type="button" class="tool-btn" data-action="fullscreen" title="Fullscreen Video">
                <svg viewBox="0 0 24 24" class="tool-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>
                </svg>
                <span>Fullscreen</span>
              </button>
            </div>
          </div>

          {isFrenchRev && (
            <div class="video-chapters-row">
              <span class="chap-label">Milestones:</span>
              <button type="button" class="chap-pill active" data-seek="0">00:00 🥖 1. Bread Crisis</button>
              <button type="button" class="chap-pill" data-seek="4">00:04 👑 2. Three Estates</button>
              <button type="button" class="chap-pill" data-seek="14">00:14 📜 3. Tennis Court Oath</button>
              <button type="button" class="chap-pill" data-seek="24">00:24 🏰 4. Bastille Storming</button>
              <button type="button" class="chap-pill" data-seek="34">00:34 ⚖️ 5. Rights of Man</button>
              <button type="button" class="chap-pill" data-seek="54">00:54 🇫🇷 6. Republic Declared</button>
              <button type="button" class="chap-pill" data-seek="64">01:04 ⚡ 7. Reign of Terror</button>
              <button type="button" class="chap-pill" data-seek="74">01:14 ⚔️ 8. Napoleonic Code</button>
            </div>
          )}

          <!-- Primary Video Viewport -->
          <div class="sst-video-viewport" data-video-container>
            <video
              src={lesson.videoFallback}
              poster={lesson.staticImageFallback ?? "/assets/sst/history/french-revolution-master-poster.jpg"}
              controls
              playsinline
              preload="auto"
              data-main-video
              class="sst-primary-video"
            ></video>
            {isFrenchRev && (
              <div class="video-quote-banner" data-video-quote-banner>
                <div class="quote-pill" data-quote-tag>Bread Crisis</div>
                <div class="quote-text-wrap">
                  <span class="quote-french" data-quote-primary>"Du pain ! Du pain pour nos enfants !"</span>
                  <span class="quote-trans" data-quote-secondary>("Bread! Bread for our children! / रोटी! हमारे बच्चों के लिए रोटी! — Paris bread scarcity 1789")</span>
                </div>
              </div>
            )}
          </div>

          <!-- Timeline Scrubber Bar -->
          <div class="sst-timeline-bar">
            <button type="button" class="timeline-step-btn" data-step-prev title="Previous step">◀ Prev</button>
            <input
              type="range"
              class="timeline-slider"
              min="0"
              max={lesson.learningSteps.length - 1}
              value="0"
              step="1"
              data-timeline-slider
              aria-label="Timeline scrubber"
            />
            <button type="button" class="timeline-step-btn" data-step-next title="Next step">Next ▶</button>
          </div>

          {isFrenchRev && (
            <div class="video-insights-grid">
              <div class="insight-box">
                <div class="insight-icon">👑</div>
                <div class="insight-text">
                  <strong>1. Three Estates Inequality (00:04)</strong>
                  <p>Clergy (1st) &amp; Nobility (2nd) enjoyed feudal privileges and paid zero direct taxes (taille), while the Third Estate peasant bore 100% of state taxes and church tithes.</p>
                </div>
              </div>
              <div class="insight-box">
                <div class="insight-icon">📜</div>
                <div class="insight-text">
                  <strong>2. Tennis Court Oath (00:14)</strong>
                  <p>Locked out by King Louis XVI, Third Estate deputies led by Mirabeau &amp; Abbé Sieyès gathered at Versailles indoor tennis court swearing to draft a democratic constitution.</p>
                </div>
              </div>
              <div class="insight-box">
                <div class="insight-icon">🏰</div>
                <div class="insight-text">
                  <strong>3. Storming of the Bastille (00:24)</strong>
                  <p>On 14 July 1789, 7,000 armed citizens stormed the royal fortress prison to seize gunpowder, killing the governor and shattering the ultimate symbol of royal despotism.</p>
                </div>
              </div>
              <div class="insight-box">
                <div class="insight-icon">⚔️</div>
                <div class="insight-text">
                  <strong>4. Napoleonic Code (01:14)</strong>
                  <p>The Civil Code of 1804 abolished birth-based privileges, secured property rights, standardized weights and measures, and established equality before the law across Europe.</p>
                </div>
              </div>
            </div>
          )}
        </div>
      ) : (
        <div class="sst-stage-card sst-3d-stage" data-3d-stage>
          <!-- 3D Toolbar -->
          <div class="sst-toolbar">
            <div class="tool-left">
              <span class="live-dot"></span>
              <strong>🌐 3D Interactive Stage</strong>
            </div>
            <div class="tool-actions">
              <button type="button" class="tool-btn" data-action="reset-cam" title="Reset Camera View">
                <svg viewBox="0 0 24 24" class="tool-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                  <path d="M3 3v5h5"/>
                </svg>
                <span>Reset</span>
              </button>
              <button type="button" class="tool-btn" data-action="fullscreen" title="Fullscreen Stage">
                <svg viewBox="0 0 24 24" class="tool-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>
                </svg>
                <span>Fullscreen</span>
              </button>
            </div>
          </div>

          <!-- WebGL Canvas Container -->
          <div class="sst-canvas-wrap" data-canvas-container>
            <LoadingIndicator />
            <ErrorFallback
              title={lesson.title}
              staticImageFallback={lesson.staticImageFallback}
            />
          </div>

          <!-- Timeline Scrubber Bar -->
          <div class="sst-timeline-bar">
            <button type="button" class="timeline-step-btn" data-step-prev title="Previous step">◀ Prev</button>
            <input
              type="range"
              class="timeline-slider"
              min="0"
              max={lesson.learningSteps.length - 1}
              value="0"
              step="1"
              data-timeline-slider
              aria-label="Timeline scrubber"
            />
            <button type="button" class="timeline-step-btn" data-step-next title="Next step">Next ▶</button>
          </div>
        </div>
      )}

      <!-- Mode 4: Virtual Experiment Panels -->
      <section class="sst-experiment-view" data-experiment-view hidden>
        <!-- Civics: Election & Parliament Coalition Simulator -->
        {lesson.subject.toLowerCase().includes("pol") || lesson.subject.toLowerCase().includes("civic") ? (
          <div class="experiment-card">
            <div class="exp-header">
              <h3>🗳️ Lok Sabha Election &amp; Coalition Simulator (543 Seats)</h3>
              <span class="majority-tag">Majority Mark: 272 Seats</span>
            </div>
            <div class="sim-parliament-arc">
              <div class="arc-visual" data-arc-visual>
                <div class="arc-marker" style="left: 50%;"></div>
                <div class="party-bar party-a" style="width: 48%;" data-seat-a>A: 260</div>
                <div class="party-bar party-b" style="width: 32%;" data-seat-b>B: 174</div>
                <div class="party-bar party-c" style="width: 20%;" data-seat-c>Reg: 109</div>
              </div>
              <p class="gov-status" data-gov-status>Current Status: <strong>Coalition Required (Hung Parliament)</strong></p>
            </div>
            <div class="sim-controls-grid">
              <label>
                Alliance A Seats:
                <input type="range" min="100" max="400" value="260" data-sim-seat="a" />
              </label>
              <label>
                Alliance B Seats:
                <input type="range" min="50" max="300" value="174" data-sim-seat="b" />
              </label>
            </div>
          </div>
        ) : lesson.subject.toLowerCase().includes("econ") ? (
          <div class="experiment-card">
            <div class="exp-header">
              <h3>📊 National Income, Tariffs &amp; GDP Trade Balance Simulator</h3>
            </div>
            <div class="sim-controls-grid">
              <label>
                Import Tariff Rate (%):
                <input type="range" min="0" max="50" value="15" data-sim-tariff />
                <span data-readout-tariff>15%</span>
              </label>
              <label>
                Priority Sector Lending (%):
                <input type="range" min="10" max="60" value="40" data-sim-psl />
                <span data-readout-psl>40%</span>
              </label>
            </div>
            <div class="sim-metrics-row">
              <div class="sim-stat"><span>GDP Growth:</span> <strong data-stat-gdp>7.2%</strong></div>
              <div class="sim-stat"><span>Trade Deficit:</span> <strong data-stat-deficit>-$84B</strong></div>
              <div class="sim-stat"><span>Rural Credit Flow:</span> <strong data-stat-credit>High</strong></div>
            </div>
          </div>
        ) : isFrenchRev ? (
          <div class="experiment-card fr-experiment-card">
            <div class="exp-header">
              <h3>⚖️ French Revolution Interactive Simulators (CBSE Class 10)</h3>
              <span class="majority-tag">NCERT Chapter 1</span>
            </div>

            <!-- 1. Estates-General Voting Dilemma (1789) -->
            <div class="fr-sim-section">
              <h4>1. Estates-General Voting Dilemma Simulator (May 1789)</h4>
              <p class="sim-help-text">Compare King Louis XVI's feudal voting system vs the Third Estate's democratic demand:</p>
              <div class="fr-vote-toggle-row">
                <button type="button" class="fr-toggle-btn active" data-vote-mode="estate">Feudal System: 1 Estate = 1 Vote</button>
                <button type="button" class="fr-toggle-btn" data-vote-mode="member">Democracy: 1 Member = 1 Vote</button>
              </div>
              <div class="fr-vote-display">
                <div class="fr-vote-bars">
                  <div class="v-bar v-priv" data-vbar-priv style="width: 66%;">1st &amp; 2nd Estate: 2 Votes (66%)</div>
                  <div class="v-bar v-common" data-vbar-common style="width: 34%;">3rd Estate: 1 Vote (34%)</div>
                </div>
                <p class="vote-verdict" data-vote-verdict>
                  <strong>Result:</strong> Privileged orders (3% population) outvote 97% of the nation 2-to-1! All tax burdens forced onto the Third Estate.
                </p>
              </div>
            </div>

            <!-- 2. Three Estates Social & Tax Disparity Breakdown -->
            <div class="fr-sim-section">
              <h4>2. Three Estates Tax &amp; Population Disparity</h4>
              <div class="fr-disparity-grid">
                <div class="disparity-box d-1st">
                  <strong>1st Estate (Clergy)</strong>
                  <span>Population: 1% (100k)</span>
                  <span>Land Owned: 10%</span>
                  <span class="tax-tag free">Direct Tax (Taille): 0%</span>
                  <small>Collected 1/10th produce Church Tithes</small>
                </div>
                <div class="disparity-box d-2nd">
                  <strong>2nd Estate (Nobility)</strong>
                  <span>Population: 2% (400k)</span>
                  <span>Land Owned: 60%</span>
                  <span class="tax-tag free">Direct Tax (Taille): 0%</span>
                  <small>Extracted Hereditary Feudal Dues</small>
                </div>
                <div class="disparity-box d-3rd">
                  <strong>3rd Estate (Commoners)</strong>
                  <span>Population: 97% (27 Million)</span>
                  <span>Land Owned: 30%</span>
                  <span class="tax-tag taxed">Direct Tax: 100% Burden</span>
                  <small>Paid Taille, Tithes, Salt &amp; Tobacco dues</small>
                </div>
              </div>
            </div>

            <!-- 3. Declaration of the Rights of Man & Citizen (Interactive Articles) -->
            <div class="fr-sim-section">
              <h4>3. Declaration of the Rights of Man (26 August 1789) — Article Explorer</h4>
              <div class="fr-articles-picker">
                <button type="button" class="fr-art-btn active" data-art="1">Article 1: Equality at Birth</button>
                <button type="button" class="fr-art-btn" data-art="4">Article 4: Liberty</button>
                <button type="button" class="fr-art-btn" data-art="6">Article 6: General Will</button>
                <button type="button" class="fr-art-btn" data-art="11">Article 11: Free Speech</button>
                <button type="button" class="fr-art-btn" data-art="17">Article 17: Property</button>
              </div>
              <div class="fr-parchment-box" data-art-display>
                <span class="parchment-badge" data-parchment-badge>NCERT Article 1</span>
                <blockquote data-parchment-quote>"Men are born and remain free and equal in rights. Social distinctions may be founded only upon the general good."</blockquote>
                <p class="parchment-meaning" data-parchment-meaning><strong>CBSE Exam Meaning:</strong> Abolished hereditary aristocratic privilege. A peasant's child and a noble's child have identical constitutional rights before the law.</p>
              </div>
            </div>
          </div>
        ) : lesson.id === "sst-nationalism-india" ? (
          <div class="experiment-card in-experiment-card">
            <div class="exp-header">
              <h3>🇮🇳 Nationalism in India: Mass Movements &amp; Boycott Simulator (1920–1942)</h3>
              <span class="majority-tag">CBSE NCERT Chapter 2</span>
            </div>

            <!-- Movement Comparison Selector -->
            <div class="in-sim-section">
              <h4>1. Movement Strategy &amp; Mass Mobilisation Selector</h4>
              <p class="sim-help-text">Explore the shift in strategy across the three defining Gandhian nationwide movements:</p>
              <div class="in-movement-toggle-row">
                <button type="button" class="in-toggle-btn active" data-in-move="1920">1920: Non-Cooperation Movement</button>
                <button type="button" class="in-toggle-btn" data-in-move="1930">1930: Civil Disobedience &amp; Dandi March</button>
                <button type="button" class="in-toggle-btn" data-in-move="1942">1942: Quit India Movement (Do or Die)</button>
              </div>
              <div class="in-move-display" data-in-display>
                <div class="in-summary-box">
                  <strong data-in-title>Non-Cooperation Movement (1920–1922)</strong>
                  <p data-in-desc>Triggered by the Jallianwala Bagh massacre (1919), Rowlatt Act, and the Khilafat grievance. Non-violent refusal to participate in British administrative machinery, foreign cloth boycott, and surrendering titles.</p>
                </div>
                <div class="in-metrics-pills">
                  <span class="in-pill" data-in-trigger><strong>Trigger:</strong> Jallianwala Bagh &amp; Khilafat</span>
                  <span class="in-pill" data-in-tactic><strong>Core Tactic:</strong> Boycott of foreign cloth &amp; government colleges</span>
                  <span class="in-pill" data-in-turning><strong>Turning Point:</strong> Chauri Chaura violence (Feb 1922)</span>
                  <span class="in-pill" data-in-result><strong>Outcome:</strong> Suspended by Gandhi due to violence</span>
                </div>
              </div>
            </div>

            <!-- Social Classes & Participation Disparity -->
            <div class="in-sim-section">
              <h4>2. Social Classes &amp; Participation Dynamics (CBSE Analysis)</h4>
              <div class="in-classes-grid">
                <div class="in-class-box">
                  <strong>Middle Class (Towns)</strong>
                  <span>Headmasters, teachers resigned; lawyers gave up practice. Foreign cloth imports fell from ₹102 Cr to ₹57 Cr (1921–22).</span>
                  <small>Limitation: Khadi was expensive; alternative Indian institutions slow to open.</small>
                </div>
                <div class="in-class-box">
                  <strong>Peasants (Awadh)</strong>
                  <span>Led by Baba Ramchandra against talukdars. Demanded rent reduction and abolition of begar (unpaid forced labour).</span>
                  <small>Formed Oudh Kisan Sabha with Nehru (Oct 1920).</small>
                </div>
                <div class="in-class-box">
                  <strong>Tribal Peasants (Gudem Hills, AP)</strong>
                  <span>Alluri Sitaram Raju led guerrilla warfare against British forest laws preventing grazing and firewood collection.</span>
                  <small>Raju praised Gandhi but advocated armed force; captured and executed in 1924.</small>
                </div>
                <div class="in-class-box">
                  <strong>Plantation Workers (Assam)</strong>
                  <span>Defied Inland Emigration Act of 1859 which barred leaving tea gardens without permission; sought right to return home.</span>
                  <small>Believed 'Gandhi Raj' meant everyone would be given land in their villages.</small>
                </div>
              </div>
            </div>
          </div>
        ) : (
          <div class="experiment-card">
            <div class="exp-header">
              <h3>⚡ Resource Allocation &amp; Conservation Simulator</h3>
            </div>
            <div class="sim-controls-grid">
              <label>
                Conservation / Forest Target (%):
                <input type="range" min="15" max="50" value="33" data-sim-forest />
                <span data-readout-forest>33%</span>
              </label>
              <label>
                Irrigation Reservoir Level (%):
                <input type="range" min="10" max="100" value="75" data-sim-dam />
                <span data-readout-dam>75%</span>
              </label>
            </div>
          </div>
        )}
      </section>

      <!-- Mode 6: CBSE Exam Mode (Past Papers & Marking Scheme) -->
      <section class="sst-exam-view" data-exam-view hidden>
        <div class="exam-card">
          <div class="exam-header">
            <h3>🎯 CBSE Board Exam Preparation — Marking Scheme &amp; Sample Questions</h3>
            <span class="exam-badge">CBSE Class 10 Pattern</span>
          </div>

          <div class="exam-q-box">
            <span class="q-type">1-Mark MCQ</span>
            <p><strong>Q1:</strong> {lesson.quiz[0]?.question ?? "Explain the primary cause of the movement."}</p>
            <div class="answer-reveal">
              <strong>Answer:</strong> {lesson.quiz[0]?.options[lesson.quiz[0]?.correctIndex] ?? "Correct option"}
              <p class="marking-tip"><em>CBSE Rubric: 1 full mark for correct identification.</em></p>
            </div>
          </div>

          <div class="exam-q-box">
            <span class="q-type">3-Mark Analytical Question</span>
            <p><strong>Q2:</strong> Explain any three major consequences or factors that defined this chapter.</p>
            <div class="model-answer">
              <strong>CBSE Topper Model Answer:</strong>
              <ul>
                {lesson.cbseExamNotes.slice(0, 3).map((note) => (
                  <li>{note}</li>
                ))}
              </ul>
              <p class="marking-tip"><em>Marking Scheme: 1 mark for each valid, distinct point with historical/geographical context.</em></p>
            </div>
          </div>

          <div class="exam-q-box">
            <span class="q-type">5-Mark Case-Based / Map Question</span>
            <p><strong>Q3:</strong> Analyze the historical / geographical significance of the events discussed, citing specific dates, locations, and constitutional articles.</p>
            <div class="model-answer">
              <strong>Key Topper Points:</strong>
              <p>{lesson.subtitle}</p>
              <p class="marking-tip"><em>Marking Scheme: 2 marks for conceptual definition + 2 marks for factual examples + 1 mark for map or constitutional cross-reference.</em></p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- Right Sidebar: Live Metrics, CBSE Notes & Information -->
    <aside class="sst-col-right">
      <!-- Live Observation Panel -->
      <div class="sst-panel-card">
        <h3>📊 Live Metrics &amp; Context</h3>
        <p class="sim-summary" data-sim-summary>Select any part or step to inspect details.</p>
        <dl class="sst-metrics-grid" data-sim-metrics></dl>
        <ul class="sst-obs-list" data-sim-observations></ul>
      </div>

      <!-- CBSE Board Exam High-Yield Notes -->
      <div class="sst-panel-card sst-notes-card">
        <div class="card-header">
          <h3>⭐ CBSE Exam Tips &amp; Rubrics</h3>
        </div>
        <ul class="sst-exam-list">
          {lesson.cbseExamNotes.map((note) => (
            <li>{note}</li>
          ))}
        </ul>
      </div>
    </aside>
  </div>

  <!-- Quiz Panel -->
  <div class="sst-quiz-view" data-quiz-view hidden>
    <div class="quiz-card">
      <h2>📝 Interactive Concept Quiz</h2>
      <p class="quiz-score" data-quiz-score>Score: 0 / {lesson.quiz.length}</p>
      <div class="quiz-questions-grid">
        {lesson.quiz.map((q, qIdx) => (
          <div class="quiz-q-item" data-q-card data-correct-idx={q.correctIndex}>
            <p class="q-title"><strong>Q{qIdx + 1}:</strong> {q.question}</p>
            <div class="options-list">
              {q.options.map((opt, oIdx) => (
                <button type="button" class="opt-btn" data-opt-idx={oIdx}>
                  {opt}
                </button>
              ))}
            </div>
            <p class="q-exp" hidden>{q.explanation}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <script
    type="application/json"
    id={configScriptId}
    set:html={JSON.stringify(lesson)}
  ></script>
</div>

<script>
  import type { PhysicsLessonConfig } from "../../physics-engine/types/lesson";
  import type { SimulationResult } from "../../physics-engine/types/simulation";

  async function initAllSstViewers() {
    const roots = document.querySelectorAll<HTMLElement>("[data-sst-viewer]");
    if (roots.length === 0) return;

    roots.forEach(async (root) => {
      if (root.dataset.initialized === "true") return;
      root.dataset.initialized = "true";

      const configId = root.dataset.configId;
      const configEl = configId ? document.getElementById(configId) : null;
      if (!configEl?.textContent) return;

      const lesson: PhysicsLessonConfig = JSON.parse(configEl.textContent);
      const isFrenchRev = lesson.id === "sst-nationalism-europe";

      const videoEl = root.querySelector<HTMLVideoElement>("[data-main-video]");
      const container = root.querySelector<HTMLElement>("[data-canvas-container]");
      const summaryEl = root.querySelector<HTMLElement>("[data-sim-summary]");
      const metricsEl = root.querySelector<HTMLElement>("[data-sim-metrics]");
      const obsEl = root.querySelector<HTMLElement>("[data-sim-observations]");
      const counterEl = root.querySelector<HTMLElement>("[data-step-counter]");
      const timelineSlider = root.querySelector<HTMLInputElement>("[data-timeline-slider]");
      const stepItems = root.querySelectorAll<HTMLButtonElement>("[data-step-nav]");

      const stageEl = root.querySelector<HTMLElement>("[data-video-stage], [data-3d-stage]");
      const expView = root.querySelector<HTMLElement>("[data-experiment-view]");
      const examView = root.querySelector<HTMLElement>("[data-exam-view]");
      const quizView = root.querySelector<HTMLElement>("[data-quiz-view]");

      let currentStepIndex = 0;
      let engine: any = null;

      // Dynamic 3D Engine Loading (for 3D interactive stages)
      if (container) {
        try {
          const [{ PhysicsEngine: EngineClass }, { registerDefaultSimulations }] = await Promise.all([
            import("../../physics-engine/core/Engine"),
            import("../../physics-engine/registry/registerSimulations"),
          ]);
          registerDefaultSimulations();

          const loadingEl = root.querySelector<HTMLElement>("#p3d-loading");
          const renderSimulationResult = (raw: Record<string, unknown>) => {
            const res = raw as unknown as SimulationResult;
            if (summaryEl && res?.summary) summaryEl.textContent = res.summary;
            if (metricsEl && res?.metrics) {
              metricsEl.innerHTML = Object.entries(res.metrics)
                .map(([k, v]) => `<div class="metric-item"><dt>${k}</dt><dd>${String(v)}</dd></div>`)
                .join("");
            }
            if (obsEl && Array.isArray(res?.observations)) {
              obsEl.innerHTML = res.observations.map((o) => `<li>${o}</li>`).join("");
            }
          };

          if (loadingEl) loadingEl.hidden = false;
          engine = new EngineClass(container, lesson, {
            onLoadComplete: () => {
              if (loadingEl) loadingEl.hidden = true;
            },
            onSimulationUpdate: (results: any) => renderSimulationResult(results),
          });

          await engine.loadLesson(lesson);
        } catch (e) {
          console.error("Failed to load 3D engine:", e);
          const loadingEl = root.querySelector<HTMLElement>("#p3d-loading");
          if (loadingEl) loadingEl.hidden = true;
        }
      }

      // Video Chapters Configuration for French Revolution (All 8 CBSE Milestones)
      const videoChapters = [
        {
          time: 0,
          tag: "1. Bread Crisis",
          primary: '"Du pain ! Du pain pour nos enfants !"',
          secondary: '("Bread! Bread for our children! / रोटी! हमारे बच्चों के लिए रोटी! — Paris 1789")',
          stepIdx: 0,
          summary: "France Before 1789 — Severe famine, bankruptcy & subsistence crisis",
          metrics: {
            "Year": "1788–1789",
            "Monarch": "King Louis XVI (Bourbon Dynasty)",
            "Bread Price": "Skyrocketed to 80% of artisan daily wage",
            "CBSE Concept": "Subsistence Crisis — basic means of livelihood endangered"
          },
          obs: [
            "Severe drought and 1788 winter hailstorms ruined grain harvests across France.",
            "Starving crowds of peasant women stormed Parisian bakeries in bread riots.",
            "Royal treasury was exhausted from funding the American War of Independence."
          ]
        },
        {
          time: 4,
          tag: "2. Three Estates",
          primary: '"Le tiers état paie tout, les privilégiés ne paient rien !"',
          secondary: '("The Third Estate pays all taxes while Clergy & Nobility pay nothing! / 97% जनता करों के बोझ तले दबी")',
          stepIdx: 1,
          summary: "The Three Estates — Feudal privilege & extreme tax disparity",
          metrics: {
            "1st & 2nd Estates": "2% Population (Clergy & Nobility)",
            "Land Owned": "60–70% of all French land",
            "Taxes Paid": "0% (Exempt from direct royal taille)",
            "3rd Estate": "97% Population carrying 100% tax burden"
          },
          obs: [
            "The Catholic Church owned 10% of land and extracted 'tithes' (1/10th agricultural produce).",
            "Nobility held hereditary feudal rights and extracted manorial services from peasants.",
            "Abbé Sieyès published 'What is the Third Estate? Everything.'"
          ]
        },
        {
          time: 14,
          tag: "3. Tennis Court Oath",
          primary: '"Nous jurons de ne jamais nous séparer avant d\'avoir donné une constitution à la France !"',
          secondary: '("We swear never to separate until France has a written constitution! / 20 जून 1789: टेनिस कोर्ट की ऐतिहासिक शपथ")',
          stepIdx: 2,
          summary: "The Tennis Court Oath (20 June 1789) — Birth of National Assembly",
          metrics: {
            "Date": "20 June 1789 at Versailles",
            "Leaders": "Mirabeau (nobility) & Abbé Sieyès (clergy)",
            "Third Estate": "Declared themselves the National Assembly of France",
            "Democratic Demand": "1 Member = 1 Vote (Rejected feudal 1 Estate = 1 Vote)"
          },
          obs: [
            "King Louis XVI locked deputies out of the Salle des Menus-Plaisirs.",
            "Third Estate deputies assembled in an indoor tennis court at Versailles under Jean-Sylvain Bailly.",
            "Deputies swore a solemn oath never to dissolve until framing a constitution limiting royal power."
          ]
        },
        {
          time: 24,
          tag: "4. Bastille Stormed",
          primary: '"À la Bastille ! Brisez les chaînes du despotisme !"',
          secondary: '("To the Bastille! Shatter the chains of despotism! / 14 जुलाई 1789: बास्तील के किले पर जनता का धावा")',
          stepIdx: 3,
          summary: "Storming of the Bastille (14 July 1789) — Fall of Despotism",
          metrics: {
            "Date": "14 July 1789 (French National Day)",
            "Target": "Bastille Royal Fortress-Prison",
            "Citizen Militia": "7,000 Parisian men & women (National Guard)",
            "Ammunition": "Seized gunpowder & 28,000 muskets from Les Invalides",
            "CBSE Key Fact": "Bastille was hated because it stood for the despotic power of the king"
          },
          obs: [
            "Citizens stormed the fortress, freed its 7 prisoners, and killed the royal governor De Launay.",
            "The fortress was demolished stone by stone and sold as souvenirs of liberation.",
            "Marks the decisive entry of the popular masses into the French revolutionary struggle."
          ]
        },
        {
          time: 34,
          tag: "5. Rights of Man",
          primary: '"Tous les hommes naissent et demeurent libres et égaux en droits !"',
          secondary: '("Men are born and remain free and equal in rights! / सभी नागरिक जन्म से स्वतंत्र और अधिकारों में समान हैं")',
          stepIdx: 4,
          summary: "Declaration of the Rights of Man & Citizen (26 August 1789)",
          metrics: {
            "Adoption Date": "26 August 1789 by National Assembly",
            "Article 1": "Men are born and remain free and equal in rights",
            "Article 6": "Law is the expression of the general will",
            "Core Ideals": "Liberté, Égalité, Fraternité (Liberty, Equality, Fraternity)"
          },
          obs: [
            "Enshrined natural and inalienable rights: liberty, private property, security, and resistance to oppression.",
            "Abolished all hereditary feudal privileges and the feudal dues extracted by nobles.",
            "Formed the bedrock of modern democratic constitutionalism and universal human rights."
          ]
        },
        {
          time: 54,
          tag: "6. Republic Proclaimed",
          primary: '"La royauté est abolie en France ! Vive la République Française !"',
          secondary: '("Royalty is abolished in France! Long live the French Republic! / 1792: फ्रांस में राजशाही समाप्त और गणतंत्र की स्थापना")',
          stepIdx: 5,
          summary: "The French Republic Established & Monarchy Abolished (1792–1793)",
          metrics: {
            "Key Date": "21 September 1792",
            "Government": "National Convention (Abolished French Monarchy)",
            "King Louis XVI": "Tried for high treason and executed on 21 January 1793",
            "Symbolism": "Adoption of Tricolor flag & revolutionary Phrygian cap"
          },
          obs: [
            "Sans-culottes and Jacobins stormed the Tuileries Palace on 10 August 1792.",
            "Universal male suffrage granted to all men aged 21 and above, regardless of wealth.",
            "Revolutionary armies defended France against Austro-Prussian monarchical coalitions."
          ]
        },
        {
          time: 64,
          tag: "7. Reign of Terror",
          primary: '"Pain d\'égalité pour tous et maximum des prix et salaires !"',
          secondary: '("Equality bread for all and wage/price ceilings! / 1793–94: रोबेस्पिएर का आतंक राज और समानता की रोटी")',
          stepIdx: 6,
          summary: "The Reign of Terror (1793–1794) — Robespierre & Committee of Public Safety",
          metrics: {
            "Period": "September 1793 – July 1794",
            "Leader": "Maximilien Robespierre (Jacobin Club)",
            "Economic Laws": "Strict maximum ceilings on wages and prices",
            "Equality Bread": "White flour banned; mandatory 'pain d'égalité' (whole wheat)"
          },
          obs: [
            "The Revolutionary Tribunal tried and executed perceived enemies of the Republic.",
            "Churches were shut down and converted into military barracks or Temples of Reason.",
            "Robespierre was condemned by the Convention and executed in Thermidor (July 1794)."
          ]
        },
        {
          time: 74,
          tag: "8. Napoleonic Code",
          primary: '"Tous les citoyens sont égaux devant la loi. Le Code Civil est proclamé !"',
          secondary: '("All citizens are equal before the law. The Civil Code of 1804! / कानून के समक्ष समानता — नेपोलियन संहिता")',
          stepIdx: 7,
          summary: "Rise of Napoleon Bonaparte & The Civil Code of 1804",
          metrics: {
            "Coup d'état": "18 Brumaire (1799) overthrowing the Directory",
            "Coronation": "1804 as Emperor of the French",
            "Civil Code 1804": "Abolished birth privileges & established legal equality",
            "Administration": "Uniform weights, metric system, and protected property rights"
          },
          obs: [
            "Napoleon exported revolutionary administrative reforms across conquered European territories.",
            "Feudalism was abolished in Switzerland, the Netherlands, Germany, and Italy.",
            "Guild restrictions were removed in towns; transport and communication networks improved."
          ]
        }
      ];

      const renderMetricsForStep = (idx: number) => {
        const step = lesson.learningSteps[idx];
        if (!step) return;

        if (isFrenchRev) {
          const chap = videoChapters.find((c) => c.stepIdx === idx) || videoChapters[0];
          if (summaryEl) summaryEl.textContent = chap?.summary || step.title;

          if (metricsEl) {
            if (chap?.metrics) {
              metricsEl.innerHTML = Object.entries(chap.metrics)
                .map(([k, v]) => `<div class="metric-item"><dt>${k}</dt><dd>${String(v)}</dd></div>`)
                .join("");
            }
          }

          if (obsEl) {
            if (chap?.obs && chap.obs.length > 0) {
              obsEl.innerHTML = chap.obs.map((o) => `<li>${o}</li>`).join("");
            }
          }
        } else {
          if (summaryEl) summaryEl.textContent = step.title;
          if (metricsEl) {
            metricsEl.innerHTML = `
              <div class="metric-item"><dt>Historical Era</dt><dd>Step ${step.stepNumber} of ${lesson.learningSteps.length}</dd></div>
              <div class="metric-item"><dt>Focus Topic</dt><dd>${step.title.replace(/^\d+\.\s*/, "")}</dd></div>
            `;
          }
          if (obsEl) {
            obsEl.innerHTML = `<li>${step.description}</li>`;
          }
        }
      };

      const applyStep = (idx: number, seekVideo: boolean = true) => {
        if (idx < 0 || idx >= lesson.learningSteps.length) return;
        currentStepIndex = idx;

        stepItems.forEach((b, i) => b.classList.toggle("active", i === idx));
        if (counterEl) counterEl.textContent = `${idx + 1} / ${lesson.learningSteps.length}`;
        if (timelineSlider) timelineSlider.value = String(idx);

        const activeItem = stepItems[idx];
        if (activeItem) {
          activeItem.scrollIntoView({ behavior: "smooth", block: "nearest" });
        }

        const currentStep = lesson.learningSteps[idx];
        renderMetricsForStep(idx);

        // If 3D engine is active, update focus & simulation parameters
        if (engine && currentStep) {
          if (currentStep.simulationParams) {
            engine.updateParameters(currentStep.simulationParams);
          }
          if (currentStep.focusObject) {
            engine.focusObject(currentStep.focusObject);
          }
          if (currentStep.cameraPresetId) {
            engine.applyCameraPreset(currentStep.cameraPresetId);
          }
        }

        // If video element is active, seek
        if (seekVideo && videoEl && typeof currentStep.videoTime === "number") {
          videoEl.currentTime = currentStep.videoTime;
          videoEl.play().catch(() => {});
        }
      };

      // Initial render for step 0
      renderMetricsForStep(0);

      // Mode Switcher Tab Functionality
      const modeButtons = root.querySelectorAll<HTMLButtonElement>("[data-mode-btn]");
      modeButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          modeButtons.forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
          const mode = btn.dataset.modeBtn;

          if (stageEl) stageEl.hidden = mode === "experiment" || mode === "quiz" || mode === "exam";
          if (expView) expView.hidden = mode !== "experiment";
          if (examView) examView.hidden = mode !== "exam";
          if (quizView) quizView.hidden = mode !== "quiz";

          if (mode !== "video" && videoEl) {
            videoEl.pause();
          }

          if (mode === "map") {
            const mapPanel = root.querySelector(".sst-map-panel");
            mapPanel?.scrollIntoView({ behavior: "smooth", block: "start" });
          } else if (mode === "video" || mode === "explore") {
            stageEl?.scrollIntoView({ behavior: "smooth", block: "center" });
          }
        });
      });

      // Step & Timeline Navigation Click Handlers
      stepItems.forEach((b, i) => {
        b.addEventListener("click", () => applyStep(i, true));
      });

      root.querySelector("[data-step-prev]")?.addEventListener("click", () => {
        applyStep((currentStepIndex - 1 + lesson.learningSteps.length) % lesson.learningSteps.length, true);
      });

      root.querySelector("[data-step-next]")?.addEventListener("click", () => {
        applyStep((currentStepIndex + 1) % lesson.learningSteps.length, true);
      });

      timelineSlider?.addEventListener("input", (e) => {
        const idx = parseInt((e.target as HTMLInputElement).value, 10);
        applyStep(idx, true);
      });

      // 3D Toolbar Controls
      root.querySelector('[data-3d-stage] [data-action="reset-cam"]')?.addEventListener("click", () => {
        engine?.resetCamera?.();
      });

      root.querySelector('[data-3d-stage] [data-action="fullscreen"]')?.addEventListener("click", () => {
        if (container?.requestFullscreen) {
          container.requestFullscreen().catch(() => {});
        }
      });

      // Video Toolbar Controls
      const playBtn = root.querySelector<HTMLButtonElement>('[data-action="toggle-play"]');
      const playIcon = root.querySelector<HTMLElement>('[data-play-icon]');
      const playLabel = root.querySelector<HTMLElement>('[data-play-label]');
      const muteBtn = root.querySelector<HTMLButtonElement>('[data-action="toggle-mute"]');
      const muteLabel = root.querySelector<HTMLElement>('[data-mute-label]');

      const updatePlayState = () => {
        if (!videoEl || !playLabel || !playIcon) return;
        if (videoEl.paused) {
          playLabel.textContent = "Play";
          playIcon.innerHTML = '<polygon points="5 3 19 12 5 21 5 3"/>';
        } else {
          playLabel.textContent = "Pause";
          playIcon.innerHTML = '<rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>';
        }
      };

      videoEl?.addEventListener("play", updatePlayState);
      videoEl?.addEventListener("pause", updatePlayState);

      playBtn?.addEventListener("click", () => {
        if (!videoEl) return;
        if (videoEl.paused) {
          videoEl.play().catch(() => {});
        } else {
          videoEl.pause();
        }
      });

      root.querySelector('[data-action="restart-video"]')?.addEventListener("click", () => {
        if (!videoEl) return;
        videoEl.currentTime = 0;
        videoEl.play().catch(() => {});
        applyStep(0, false);
      });

      muteBtn?.addEventListener("click", () => {
        if (!videoEl || !muteLabel) return;
        videoEl.muted = !videoEl.muted;
        muteLabel.textContent = videoEl.muted ? "Unmute" : "Mute";
      });

      root.querySelector('[data-video-stage] [data-action="fullscreen"]')?.addEventListener("click", () => {
        if (!videoEl) return;
        if (videoEl.requestFullscreen) {
          videoEl.requestFullscreen().catch(() => {});
        }
      });

      // Video Chapter Seeking & Synchronization (French Revolution only)
      if (isFrenchRev && videoEl) {
        const chapPills = root.querySelectorAll<HTMLButtonElement>("[data-seek]");
        const quoteTag = root.querySelector<HTMLElement>("[data-quote-tag]");
        const quotePrimary = root.querySelector<HTMLElement>("[data-quote-primary]");
        const quoteSecondary = root.querySelector<HTMLElement>("[data-quote-secondary]");

        chapPills.forEach((pill) => {
          pill.addEventListener("click", () => {
            const seekTime = parseFloat(pill.dataset.seek || "0");
            videoEl.currentTime = seekTime;
            videoEl.play().catch(() => {});
          });
        });

        videoEl.addEventListener("timeupdate", () => {
          const t = videoEl.currentTime;
          let activeIdx = 0;
          for (let i = videoChapters.length - 1; i >= 0; i--) {
            if (t >= videoChapters[i].time - 0.5) {
              activeIdx = i;
              break;
            }
          }
          chapPills.forEach((p, idx) => {
            p.classList.toggle("active", idx === activeIdx);
          });
          const activeChap = videoChapters[activeIdx];
          if (quoteTag && activeChap) quoteTag.textContent = activeChap.tag;
          if (quotePrimary && activeChap) quotePrimary.textContent = activeChap.primary;
          if (quoteSecondary && activeChap) quoteSecondary.textContent = activeChap.secondary;

          if (activeChap && typeof activeChap.stepIdx === "number" && activeChap.stepIdx !== currentStepIndex) {
            applyStep(activeChap.stepIdx, false);
          }
        });
      }

      // Video Trigger Handlers (from sidebar steps)
      root.querySelectorAll("[data-trigger-video]").forEach((vBtn) => {
        vBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          const targetTime = parseFloat((vBtn as HTMLElement).dataset.videoTime || "0");
          const videoTab = root.querySelector<HTMLButtonElement>('[data-mode-btn="video"]');
          videoTab?.click();
          if (videoEl) {
            videoEl.currentTime = targetTime;
            videoEl.scrollIntoView({ behavior: "smooth", block: "center" });
            videoEl.play().catch(() => {});
          }
        });
      });

      // Map Pin Focus
      root.querySelectorAll<HTMLButtonElement>("[data-focus-pin]").forEach((pinBtn) => {
        pinBtn.addEventListener("click", () => {
          const pinId = pinBtn.dataset.focusPin;
          const pinObj = lesson.objects.find((o) => o.id === pinId);
          if (pinObj) {
            if (summaryEl) summaryEl.textContent = `📍 Map Location: ${pinObj.name}`;
            if (obsEl) obsEl.innerHTML = `<li>${pinObj.description}</li><li>${pinObj.cbseNote ?? ""}</li>`;
          }
          if (engine && pinId) {
            engine.focusObject?.(pinId);
          }
        });
      });

      // Virtual Experiment Controls (Civics Election Sim)
      const seatA = root.querySelector<HTMLInputElement>('[data-sim-seat="a"]');
      const seatB = root.querySelector<HTMLInputElement>('[data-sim-seat="b"]');
      const barA = root.querySelector<HTMLElement>("[data-seat-a]");
      const barB = root.querySelector<HTMLElement>("[data-seat-b]");
      const barC = root.querySelector<HTMLElement>("[data-seat-c]");
      const govStatus = root.querySelector<HTMLElement>("[data-gov-status]");

      const updateParliament = () => {
        if (!seatA || !seatB || !barA || !barB || !barC || !govStatus) return;
        const valA = parseInt(seatA.value, 10);
        const valB = parseInt(seatB.value, 10);
        const rem = Math.max(0, 543 - (valA + valB));

        barA.style.width = `${(valA / 543) * 100}%`;
        barA.textContent = `A: ${valA}`;
        barB.style.width = `${(valB / 543) * 100}%`;
        barB.textContent = `B: ${valB}`;
        barC.style.width = `${(rem / 543) * 100}%`;
        barC.textContent = `Others: ${rem}`;

        if (valA >= 272) {
          govStatus.innerHTML = `<span style="color: #16a34a; font-weight: bold;">Alliance A forms Clear Majority Government (${valA}/543 seats)</span>`;
        } else if (valB >= 272) {
          govStatus.innerHTML = `<span style="color: #2563eb; font-weight: bold;">Alliance B forms Clear Majority Government (${valB}/543 seats)</span>`;
        } else {
          govStatus.innerHTML = `<span style="color: #ea580c; font-weight: bold;">Hung Parliament! Coalition of Alliance + Regionals required for 272 majority mark</span>`;
        }
      };

      seatA?.addEventListener("input", updateParliament);
      seatB?.addEventListener("input", updateParliament);

      // Nationalism in India Movement Simulator
      if (lesson.id === "sst-nationalism-india") {
        const inMoveButtons = root.querySelectorAll<HTMLButtonElement>("[data-in-move]");
        const inTitle = root.querySelector<HTMLElement>("[data-in-title]");
        const inDesc = root.querySelector<HTMLElement>("[data-in-desc]");
        const inTrigger = root.querySelector<HTMLElement>("[data-in-trigger]");
        const inTactic = root.querySelector<HTMLElement>("[data-in-tactic]");
        const inTurning = root.querySelector<HTMLElement>("[data-in-turning]");
        const inResult = root.querySelector<HTMLElement>("[data-in-result]");

        const inMoveData: Record<string, { title: string; desc: string; trigger: string; tactic: string; turning: string; result: string }> = {
          "1920": {
            title: "Non-Cooperation Movement (1920–1922)",
            desc: "Triggered by Jallianwala Bagh massacre (1919), Rowlatt Act, and Khilafat grievances. Boycott of foreign cloth, courts, government schools, and surrendering honours.",
            trigger: "Trigger: Jallianwala Bagh & Khilafat",
            tactic: "Core Tactic: Surrender of titles & foreign goods boycott",
            turning: "Turning Point: Chauri Chaura violence (Feb 1922)",
            result: "Outcome: Suspended due to breach of non-violence",
          },
          "1930": {
            title: "Civil Disobedience Movement (1930–1934)",
            desc: "Began with the iconic 240-mile Dandi Salt March (12 March – 6 April 1930). Unlike NCM, people broke colonial laws directly (Salt Law, Forest Laws, refusing chaukidari tax).",
            trigger: "Trigger: 11 Demands rejected & Simon Commission",
            tactic: "Core Tactic: Direct defiance of colonial laws & Salt production",
            turning: "Turning Point: Gandhi-Irwin Pact & Round Table Conference",
            result: "Outcome: Mass awareness; formally ended 1934",
          },
          "1942": {
            title: "Quit India Movement — 'Do or Die' (1942)",
            desc: "Launched on 8 August 1942 at Bombay session during WW2. Demanded immediate British withdrawal with the slogan 'Karenge ya marenge' (Do or Die).",
            trigger: "Trigger: Cripps Mission failure & WW2 pressures",
            tactic: "Core Tactic: Complete general strike & underground resistance",
            turning: "Turning Point: Immediate arrest of all national leaders",
            result: "Outcome: Shook the foundations of the British Raj",
          },
        };

        inMoveButtons.forEach((btn) => {
          btn.addEventListener("click", () => {
            inMoveButtons.forEach((b) => b.classList.remove("active"));
            btn.classList.add("active");
            const moveKey = btn.dataset.inMove;
            if (moveKey && inMoveData[moveKey]) {
              const d = inMoveData[moveKey];
              if (inTitle) inTitle.textContent = d.title;
              if (inDesc) inDesc.textContent = d.desc;
              if (inTrigger) inTrigger.innerHTML = `<strong>Trigger:</strong> ${d.trigger.replace("Trigger: ", "")}`;
              if (inTactic) inTactic.innerHTML = `<strong>Core Tactic:</strong> ${d.tactic.replace("Core Tactic: ", "")}`;
              if (inTurning) inTurning.innerHTML = `<strong>Turning Point:</strong> ${d.turning.replace("Turning Point: ", "")}`;
              if (inResult) inResult.innerHTML = `<strong>Outcome:</strong> ${d.result.replace("Outcome: ", "")}`;
            }
          });
        });
      }

      // French Revolution Voting Toggle Simulator
      if (isFrenchRev) {
        const voteButtons = root.querySelectorAll<HTMLButtonElement>("[data-vote-mode]");
        const vbarPriv = root.querySelector<HTMLElement>("[data-vbar-priv]");
        const vbarCommon = root.querySelector<HTMLElement>("[data-vbar-common]");
        const voteVerdict = root.querySelector<HTMLElement>("[data-vote-verdict]");

        voteButtons.forEach((btn) => {
          btn.addEventListener("click", () => {
            voteButtons.forEach((b) => b.classList.remove("active"));
            btn.classList.add("active");
            const mode = btn.dataset.voteMode;

            if (mode === "estate") {
              if (vbarPriv) {
                vbarPriv.style.width = "66%";
                vbarPriv.textContent = "1st & 2nd Estate: 2 Votes (66%)";
              }
              if (vbarCommon) {
                vbarCommon.style.width = "34%";
                vbarCommon.textContent = "3rd Estate: 1 Vote (34%)";
              }
              if (voteVerdict) {
                voteVerdict.innerHTML = "<strong>Result:</strong> Privileged orders (3% population) outvote 97% of the nation 2-to-1! All tax burdens forced onto the Third Estate.";
              }
            } else {
              if (vbarPriv) {
                vbarPriv.style.width = "48%";
                vbarPriv.textContent = "Nobility & Clergy: 600 Votes (48%)";
              }
              if (vbarCommon) {
                vbarCommon.style.width = "52%";
                vbarCommon.textContent = "3rd Estate + Liberal Allies: 650 Votes (52%)";
              }
              if (voteVerdict) {
                voteVerdict.innerHTML = "<strong>Result:</strong> Democratic majority for the Third Estate! Popular national sovereignty achieved over royal absolutism.";
              }
            }
          });
        });

        // Rights of Man Articles Picker
        const artButtons = root.querySelectorAll<HTMLButtonElement>("[data-art]");
        const pBadge = root.querySelector<HTMLElement>("[data-parchment-badge]");
        const pQuote = root.querySelector<HTMLElement>("[data-parchment-quote]");
        const pMeaning = root.querySelector<HTMLElement>("[data-parchment-meaning]");

        const articlesData: Record<string, { badge: string; quote: string; meaning: string }> = {
          "1": {
            badge: "NCERT Article 1",
            quote: '"Men are born and remain free and equal in rights. Social distinctions may be founded only upon the general good."',
            meaning: "Abolished hereditary aristocratic privilege. A peasant's child and a noble's child have identical constitutional rights before the law.",
          },
          "4": {
            badge: "NCERT Article 4",
            quote: '"Liberty consists in the freedom to do everything which injures no one else; hence the exercise of natural rights has no limits except those which assure to other members the enjoyment of the same rights."',
            meaning: "Established modern individual freedom. Liberty is limited only by harm to fellow citizens, not by royal decree or religious dogma.",
          },
          "6": {
            badge: "NCERT Article 6",
            quote: '"Law is the expression of the general will. All citizens have the right to take part personally, or through their representatives, in its foundation. It must be the same for all, whether it protects or punishes."',
            meaning: "Sovereignty shifted from the monarch to the people. Laws are no longer the king's arbitrary commands, but democratic collective legislation.",
          },
          "11": {
            badge: "NCERT Article 11",
            quote: '"The free communication of thoughts and opinions is one of the most precious rights of man: every citizen may therefore speak, write, and print freely."',
            meaning: "Abolished royal book and newspaper censorship. Fostered revolutionary public debate, political clubs, and civic newspapers.",
          },
          "17": {
            badge: "NCERT Article 17",
            quote: '"Property being a sacred and inviolable right, no one may be deprived thereof, except when public necessity, legally certified, evidently requires it."',
            meaning: "Secured bourgeois property rights. Nobles could no longer seize commoner land through feudal claims or arbitrary royal confiscation.",
          },
        };

        artButtons.forEach((btn) => {
          btn.addEventListener("click", () => {
            artButtons.forEach((b) => b.classList.remove("active"));
            btn.classList.add("active");
            const artKey = btn.dataset.art;
            if (artKey && articlesData[artKey]) {
              const data = articlesData[artKey];
              if (pBadge) pBadge.textContent = data.badge;
              if (pQuote) pQuote.textContent = data.quote;
              if (pMeaning) pMeaning.innerHTML = `<strong>CBSE Exam Meaning:</strong> ${data.meaning}`;
            }
          });
        });
      }

      // Quiz Handling
      let quizScore = 0;
      root.querySelectorAll<HTMLElement>("[data-q-card]").forEach((card) => {
        const correctIdx = parseInt(card.dataset.correctIdx || "0", 10);
        const expEl = card.querySelector<HTMLElement>(".q-exp");
        const optButtons = card.querySelectorAll<HTMLButtonElement>("[data-opt-idx]");

        optButtons.forEach((btn, bIdx) => {
          btn.addEventListener("click", () => {
            optButtons.forEach((b) => (b.disabled = true));
            if (bIdx === correctIdx) {
              btn.classList.add("correct");
              quizScore += 1;
            } else {
              btn.classList.add("incorrect");
              optButtons[correctIdx]?.classList.add("correct");
            }
            if (expEl) expEl.hidden = false;
            const scoreReadout = root.querySelector<HTMLElement>("[data-quiz-score]");
            if (scoreReadout) scoreReadout.textContent = `Score: ${quizScore} / ${lesson.quiz.length}`;
          });
        });
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAllSstViewers);
  } else {
    initAllSstViewers();
  }
</script>

