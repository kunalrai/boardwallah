---
import "../styles/global.css";
import { loadContent, whatsappLink } from "../lib/content";
import { absoluteUrl, calBookingUrl } from "../lib/site";
import AiDoubtTutor from "../components/AiDoubtTutor.astro";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  schema?: Record<string, any> | Record<string, any>[];
  isAppLayout?: boolean;
  htmlClass?: string;
}

const { provider } = loadContent();
const {
  title = `${provider.name} | CBSE Class 10 tuition, online or at home`,
  description = `CBSE Class 10 tuition online or at home with ${provider.tutor_name}. Book a free trial slot, online or as a home visit.`,
  image,
  imageAlt,
  schema,
  isAppLayout,
  htmlClass = "",
} = Astro.props;
const path = Astro.url.pathname;
const isApp = isAppLayout ?? path.startsWith("/chat");
const canonical = absoluteUrl(path);
const links: { href: string; label: string; external?: boolean }[] = [
  { href: "/", label: "Home" },
  { href: "/chat/", label: "Ask Boardwallah 🤖" },
  { href: "/subjects/", label: "Subjects" },
  { href: "/resources/", label: "Resources" },
  { href: "/plans/", label: "Plans" },
  { href: calBookingUrl, label: "Book a trial", external: true },
  { href: "/enquiry/", label: "Enquiry" },
  { href: "/booking/", label: "Manage booking" },
  { href: "/login/", label: "Sign in" },
];
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<!doctype html>
<html lang="en-IN" class={htmlClass || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f4c5c" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={absoluteUrl(image)} />}
    {image && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {image && <meta name="twitter:card" content="summary_large_image" />}
    {image && <meta name="twitter:image" content={absoluteUrl(image)} />}
    <title>{title}</title>
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
    <Analytics />
    <SpeedInsights />
  </head>
  <body class={isApp ? "app-mode" : undefined}>
    {!isApp && <a class="skip-link" href="#main">Skip to content</a>}
    {!isApp && (
      <header class="site-header">
        <div class="wrap header-inner">
          <a class="brand" href="/" aria-label={`${provider.name} home`}>
            <span class="brand-mark" aria-hidden="true">10</span>
            <span>
              <strong>{provider.name}</strong>
              <small>CBSE Class 10, online or at home</small>
            </span>
          </a>
          <button
            type="button"
            class="mobile-menu-toggle"
            id="mobile-menu-toggle"
            aria-expanded="false"
            aria-controls="mobile-nav-drawer"
            aria-label="Open navigation menu"
          >
            <span class="hamburger-icon" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </span>
          </button>
          <nav class="desktop-nav" aria-label="Main navigation">
            <ul class="nav-list">
              {
                links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={link.external ? "_blank" : undefined}
                      rel={link.external ? "noopener noreferrer" : undefined}
                      aria-current={isActive(link.href) ? "page" : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>

        <!-- Mobile Navigation Drawer Backdrop -->
        <div class="mobile-nav-backdrop" id="mobile-nav-backdrop" aria-hidden="true"></div>

        <!-- Mobile Slide-Out Drawer -->
        <aside
          class="mobile-nav-drawer"
          id="mobile-nav-drawer"
          role="dialog"
          aria-modal="true"
          aria-label="Navigation menu"
        >
          <div class="drawer-header">
            <div class="drawer-brand">
              <span class="brand-mark" aria-hidden="true">10</span>
              <strong>{provider.name}</strong>
            </div>
            <button
              type="button"
              class="drawer-close-btn"
              id="drawer-close-btn"
              aria-label="Close navigation menu"
            >
              ✕
            </button>
          </div>
          <nav class="drawer-nav" aria-label="Mobile navigation">
            <ul class="drawer-nav-list">
              {
                links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={link.external ? "_blank" : undefined}
                      rel={link.external ? "noopener noreferrer" : undefined}
                      aria-current={isActive(link.href) ? "page" : undefined}
                      class={isActive(link.href) ? "active" : undefined}
                    >
                      <span>{link.label}</span>
                      {link.external && <span class="external-icon" aria-hidden="true">↗</span>}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <div class="drawer-footer">
            <a class="button" href={calBookingUrl} target="_blank" rel="noopener noreferrer">
              Book Free Trial Slot
            </a>
            <a
              class="button drawer-wa-btn"
              href={whatsappLink(provider.contact.whatsapp, `Hello ${provider.tutor_name}, I want to enquire about Class 10 tuition.`)}
              target="_blank"
              rel="noopener noreferrer"
            >
              💬 Chat on WhatsApp
            </a>
          </div>
        </aside>
      </header>
    )}
    <main id="main" class={isApp ? "app-main" : undefined}>
      <slot />
    </main>
    {!isApp && (
      <footer class="site-footer">
        <div class="wrap footer-grid">
          <div>
            <strong>{provider.name}</strong>
            <p>{provider.tutor_name} teaches {provider.subjects.length} CBSE Class 10 subjects online and at home in {provider.service_localities.join(" and ")}.</p>
            <p class="muted">Provider content version {provider.version}, updated {provider.last_updated}.</p>
          </div>
          <div>
            <strong>Contact</strong>
            <p>
              <a href={whatsappLink(provider.contact.whatsapp, `Hello, I would like to ask about Class 10 tuition.`)}>WhatsApp</a>
              <br />
              <a href={`mailto:${provider.contact.email}`}>{provider.contact.email}</a>
              <br />
              <a href={calBookingUrl} target="_blank" rel="noopener noreferrer">Schedule a call</a>
            </p>
          </div>
          <div>
            <strong>Policies</strong>
            <p>
              <a href="/policies/privacy/">Privacy</a><br />
              <a href="/policies/consent/">Consent</a><br />
              <a href="/policies/cancellation-refund/">Cancellation and refund</a>
            </p>
          </div>
          <div>
            <strong>For agents</strong>
            <p>
              <a href="/llms.txt">llms.txt</a><br />
              <a href="/openapi.yaml">OpenAPI</a><br />
              <a href="/spec/models/provider.schema.json">Schemas</a>
            </p>
          </div>
        </div>
      </footer>
    )}

    <!-- Wallah AI Doubt Tutor Floating Socratic Assistant (hidden in app-mode or /chat/) -->
    {!isApp && <AiDoubtTutor />}

    <!-- Global Quiz Progress & Mastery Tracker Script -->
    <script is:inline>
      (function() {
        const path = window.location.pathname;
        if (!path.startsWith('/resources/') || path === '/resources/' || path === '/resources/sample-papers/' || path === '/resources/flashcards/') {
          return;
        }

        const STORAGE_KEY = 'boardwallah_quiz_progress';

        function getSlug() {
          const parts = path.split('/').filter(Boolean);
          return parts[parts.length - 1] || '';
        }

        function saveScore(score, total) {
          if (isNaN(score) || isNaN(total) || total <= 0) return;
          const slug = getSlug();
          if (!slug) return;

          try {
            const raw = localStorage.getItem(STORAGE_KEY);
            const data = raw ? JSON.parse(raw) : {};
            const existing = data[slug];
            const pct = Math.round((score / total) * 100);

            // Save or update if better score
            if (!existing || score > existing.score) {
              data[slug] = {
                score: score,
                total: total,
                percentage: pct,
                updatedAt: Date.now()
              };
            } else {
              data[slug].lastAttemptAt = Date.now();
            }

            localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
            displayBestScorePill(data[slug]);
          } catch (e) {
            console.error('Quiz progress save error:', e);
          }
        }

        function displayBestScorePill(record) {
          if (!record) return;
          let pill = document.getElementById('bw-chapter-best-score');
          if (!pill) {
            const container = document.querySelector('.quiz-header') || document.querySelector('.quiz-card') || document.querySelector('.resource-header');
            if (container) {
              pill = document.createElement('div');
              pill.id = 'bw-chapter-best-score';
              pill.className = 'chapter-best-score-badge';
              if (container.classList.contains('quiz-header')) {
                container.appendChild(pill);
              } else {
                container.insertAdjacentElement('afterbegin', pill);
              }
            }
          }
          if (pill) {
            pill.innerHTML = `🏆 <strong>Previous Best Score:</strong> ${record.score} / ${record.total} (${record.percentage}%)`;
          }
        }

        // Display previous best on load if available
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (raw) {
            const data = JSON.parse(raw);
            const slug = getSlug();
            if (data[slug]) {
              window.addEventListener('DOMContentLoaded', () => {
                displayBestScorePill(data[slug]);
              });
            }
          }
        } catch(e) {}

        // Listen for quiz scores rendered dynamically in DOM
        const scorePatterns = [
          /You scored\s+(\d+)\s*\/\s*(\d+)/i,
          /Score:\s*(\d+)\s*\/\s*(\d+)/i,
          /Final Score:\s*(\d+)\s*\/\s*(\d+)/i,
          /(\d+)\s*\/\s*(\d+)\s*\(\d+%\)/
        ];

        function scanForScore(node) {
          if (!node || !node.textContent) return;
          const text = node.textContent;
          for (const rx of scorePatterns) {
            const m = text.match(rx);
            if (m) {
              const s = parseInt(m[1], 10);
              const t = parseInt(m[2], 10);
              if (t >= 5 && t <= 50 && s <= t) {
                saveScore(s, t);
                break;
              }
            }
          }
        }

        window.addEventListener('DOMContentLoaded', () => {
          const observer = new MutationObserver((mutations) => {
            for (const m of mutations) {
              if (m.type === 'characterData') {
                scanForScore(m.target);
              } else if (m.type === 'childList') {
                m.addedNodes.forEach(scanForScore);
                if (m.target) scanForScore(m.target);
              }
            }
          });

          observer.observe(document.body, {
            subtree: true,
            childList: true,
            characterData: true
          });
        });
      })();
    </script>

    <!-- Mobile Drawer Menu Controller -->
    <script>
      (function() {
        const toggleBtn = document.getElementById('mobile-menu-toggle');
        const closeBtn = document.getElementById('drawer-close-btn');
        const backdrop = document.getElementById('mobile-nav-backdrop');
        const drawer = document.getElementById('mobile-nav-drawer');

        function openMenu() {
          drawer?.classList.add('is-open');
          backdrop?.classList.add('is-open');
          toggleBtn?.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        }

        function closeMenu() {
          drawer?.classList.remove('is-open');
          backdrop?.classList.remove('is-open');
          toggleBtn?.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        }

        toggleBtn?.addEventListener('click', openMenu);
        closeBtn?.addEventListener('click', closeMenu);
        backdrop?.addEventListener('click', closeMenu);

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && drawer?.classList.contains('is-open')) {
            closeMenu();
          }
        });

        drawer?.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            closeMenu();
          });
        });
      })();
    </script>

    <style is:global>
      body.app-mode {
        height: 100vh !important;
        margin: 0 !important;
        padding: 0 !important;
        overflow: hidden !important;
      }
      .app-main {
        padding: 0 !important;
        margin: 0 !important;
        max-width: none !important;
        height: 100vh !important;
        overflow: hidden !important;
      }
      .chapter-best-score-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.35rem 0.8rem;
        background: #ecfdf5;
        color: #065f46;
        border: 1px solid #10b981;
        border-radius: 999px;
        font-size: 0.84rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
      }
    </style>
  </body>
</html>
